587.922,"duration":1.766999999999939,"text":"기본이 10년이시네"},{"start":589.69,"duration":3.4969999999999573,"text":"큰일 났네, 사장님 바쁘시면 안 되는데"},{"start":593.188,"duration":2.4740000000000464,"text":"내가 몸이 탈이 날까 봐 그런 거 싫어"},{"start":595.662,"duration":3.1359999999999673,"text":"이렇게 보면 진짜 착한 사람들 많아"},{"start":598.799,"duration":2.368000000000052,"text":"사장님이 좋아서 다들 좋은 손님만 오나 봐요"},{"start":601.168,"duration":3.2350000000000136,"text":"손님들 보면, 다 착하고 좋아"},{"start":622.322,"duration":2.302000000000021,"text":"맛있어..."},{"start":624.625,"duration":2.8010000000000446,"text":"튀김 식었는데도 바삭해요"},{"start":651.919,"duration":1.7670000000000528,"text":"어? 새로운 떡볶이 넣으시는 거예요?"},{"start":653.687,"duration":2.268000000000029,"text":"2차 끓여서 갖다 넣어야지"},{"start":655.956,"duration":3.1689999999999827,"text":"새 떡볶이다 우와"},{"start":659.126,"duration":1.83400000000006,"text":"- 오래될 수록 맛있죠? - 그렇지"},{"start":660.961,"duration":2.867999999999938,"text":"그래서 간이 잘 배라고 이렇게 미리 끓여놓는 거지"},{"start":665.465,"duration":1.9349999999999454,"text":"이거 다 먹으면 얼마야...?"},{"start":667.401,"duration":3.0020000000000664,"text":"전 메뉴 다 먹어도 13,000원"},{"start":674.308,"duration":2.4009999999999536,"text":") 진짜 잘 먹네..."},{"start":676.71,"duration":2.2350000000000136,"text":"아니 근데 살도 안 쪘는데 어떻게 다 먹어?"},{"start":678.946,"duration":4.23599999999999,"text":"그러게요, 어렸을 때부터 이랬어요"},{"start":683.183,"duration":1.1340000000000146,"text":"사장님!"},{"start":684.318,"duration":1.2000000000000455,"text":"저 사이다 하나랑..."},{"start":686.353,"duration":0.9660000000000082,"text":"라면도 하나 주세요!"},{"start":687.32,"duration":1.5009999999999764,"text":"사이다하고 라면?"},{"start":688.822,"duration":3.4700000000000273,"text":"집에 못 가는 거 아닌가 모르겠네 배불러서"},{"start":692.293,"duration":3.6019999999999754,"text":"사장님 저 배 하나도 안 찼어요"},{"start":713.746,"duration":2.6019999999999754,"text":"- 오 맛있겠다 - 맛있는 라면이 나왔어요"},{"start":719.553,"duration":2.0009999999999764,"text":"라면 냄새 맡고 보니 무슨 라면이야?"},{"start":721.555,"duration":2.802000000000021,"text":"냄새요? 아 냄새만 갖고는 잘..."},{"start":724.358,"duration":1.33400000000006,"text":"PD님이 물어보라고 했죠?"},{"start":725.693,"duration":3.2350000000000136,"text":"이거 무슨 라면인지 맞혀보라고 해봐야겠다, 그쵸?"},{"start":740.106,"duration":2.435000000000059,"text":"일단 신라면 아닌 것 같은데?"},{"start":756.322,"duration":2.4360000000000355,"text":"일단 진라면, 신라면 이런 거 절대 아니고"},{"start":759.46,"duration":0.5659999999999172,"text":"절대 아니고"},{"start":760.027,"duration":1.5339999999999918,"text":"삼양라면, 안성탕면 다 아니고"},{"start":761.562,"duration":2.6680000000000064,"text":"그런 유명한 류가 아닌데...?"},{"start":781.682,"duration":1.6340000000000146,"text":"아 맛있게 잘 먹었다"},{"start":783.316,"duration":3.536999999999921,"text":"축하해 아주, 너무 잘 먹어서ㅎㅎ"},{"start":786.854,"duration":3.0679999999999836,"text":"먹느라고 더운데 고생하시고"},{"start":789.923,"duration":1.8010000000000446,"text":"그래서 오늘..."},{"start":791.725,"duration":2.5019999999999527,"text":"너무 더워서 여기까지만 먹으려고요"},{"start":794.228,"duration":1.7340000000000373,"text":"사장님 저 이거 먹고..."},{"start":795.963,"duration":2.3350000000000364,"text":"닭갈비 촬영 또 하러 가요ㅎ"},{"start":798.299,"duration":2.5009999999999764,"text":"그짓말하지 마"},{"start":800.801,"duration":1.2999999999999545,"text":"정말요ㅎㅎㅎ"},{"start":812.913,"duration":1.2999999999999545,"text":"마지막 어묵!"},{"start":814.2139999999999,"duration":2.302000000000021,"text":"- 식어서 맛이 없지 - 맛있어요!"},{"start":816.517,"duration":2.4389999999999645,"text":"- 뜨뜻할 때 먹었어야지 - 너무 맛있어요"},{"start":819.285,"duration":1.79200000000003,"text":"어머 진짜 다 먹을 줄이야..."},{"start":821.078,"duration":2.15300000000002,"text":"혼자서 다 먹을 거라고 생각을 안 했어"},{"start":824.691,"duration":2.2339999999999236,"text":"- 진짜 오늘 조금 먹은 거예요 - 그래?!"},{"start":826.926,"duration":0.6669999999999163,"text":"간식...ㅎ"},{"start":827.594,"duration":2.8349999999999227,"text":"간식ㅋㅋㅋ"},{"start":830.43,"duration":1.1340000000000146,"text":"어묵 진짜 맛있다"},{"start":839.672,"duration":1.3349999999999227,"text":"맛있게 먹었습니다 사장님"},{"start":841.008,"duration":2.300999999999931,"text":"- 너무 맛있었어요 - 아유 감사해요 아주"},{"start":843.31,"duration":3.0690000000000737,"text":"촬영도 잘 안 하시는데 허락해 주셔서 너무 감사해요"},{"start":846.38,"duration":4.669999999999959,"text":"맛있는 음식 저렴하게 먹을 수 있어서 너무 좋았어요"},{"start":851.051,"duration":4.269999999999982,"text":"오늘 좀 간단하게 간식처럼 먹었는데"},{"start":855.322,"duration":3.2690000000000055,"text":"이거 먹고 이제 곧 닭갈비 먹으러 갈 거거든요"},{"start":858.592,"duration":2.802000000000021,"text":"그래서 오늘은 여기까지만 먹도록 하겠습니다"},{"start":861.395,"duration":3.6299999999999955,"text":"정말 봉사하시는 수준으로 가격을 이렇게..."},{"start":865.026,"duration":2.70900000000006,"text":"최대 3,000원... 순대가 3,000원"},{"start":867.735,"duration":2.533999999999992,"text":"진짜 말도 안 되는 가격으로 판매를 하시는데"},{"start":870.269,"duration":4.687000000000012,"text":"진짜 소스 하나까지도 막 파인애플 갈아서 만드시고"},{"start":874.957,"duration":1.9189999999999827,"text":"어묵도 좋은 거 쓰시고"},{"start":876.877,"duration":2.9329999999999927,"text":"순대도 진짜... 순대 모두가 다 드시더라고요"},{"start":879.811,"duration":1.8029999999999973,"text":"순대 진짜 신선하고 맛있었습니다"},{"start":882.248,"duration":3.436999999999898,"text":"오늘도 잘 먹었습니다~!"},{"start":885.686,"duration":1.7339999999999236,"text":"그래도 단돈 2만 원이야 알아?"},{"start":887.421,"duration":1.933999999999969,"text":"- 에?! 어... - 그렇대두ㅎㅎ"},{"start":889.355,"duration":1.4349999999999454,"text":"에...? 2만 원... 에...?"},{"start":898.766,"duration":3.1680000000000064,"text":"사이다 포함 21,000원ㄷㄷ"},{"start":901.935,"duration":3.47300000000007,"text":"촬영 도와주셨으니까 조금 더 보내드려도 괜찮을까요?"},{"start":905.409,"duration":2.4329999999999927,"text":"나는 뭐 안 줬는데..."},{"start":907.842,"duration":2.701000000000022,"text":"저희가 꼭 드리고 싶어서"},{"start":910.544,"duration":3.469000000000051,"text":"- 자리도 차지하고 했는데 - 맞아요, 감사해요"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
