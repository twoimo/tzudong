{"youtube_link":"https://www.youtube.com/watch?v=nB6QYKjrGyw","channel_name":"tzuyang","language":"ko","collected_at":"2026-08-17T02:18:29.879+09:00","transcript":[{"start":0.002,"duration":1.4989999999999999,"text":"TV에 나오셨잖아요!"},{"start":1.502,"duration":1.9680000000000002,"text":"TV에서 먹는 거 보고 깜짝 놀랐어요"},{"start":3.471,"duration":1.9340000000000002,"text":"- 거짓말인 줄 알았거든요 - 정말요?"},{"start":16.783,"duration":2.235999999999997,"text":"- 아직... 멀었죠...? - 아직요?"},{"start":23.024,"duration":2.067,"text":"그게 어디로 다 들어갔어!!!"},{"start":25.092,"duration":3.9700000000000024,"text":"거짓말인가요?"},{"start":39.373,"duration":1.6679999999999993,"text":"안녕하세요, 여러분"},{"start":41.042,"duration":2.867999999999995,"text":"제가 오늘은 지금 강동구 천호동에 왔는데-!"},{"start":43.911,"duration":1.6679999999999993,"text":"여기 예전에 온 적 있는 곳이더라고요!"},{"start":45.58,"duration":2.067,"text":"2,000원 즉석떡볶이 먹었던 곳!"},{"start":47.648,"duration":2.134999999999998,"text":"같은 건물 바로 위층이거든요"},{"start":49.784,"duration":1.7340000000000018,"text":"거기 맛있었는데 오랜만에 먹고 싶다ㅎ"},{"start":51.519,"duration":1.267000000000003,"text":"마... 맛도 없고ㅎ..."},{"start":52.787,"duration":1.801000000000002,"text":"맛이 없다고요?"},{"start":54.589,"duration":1.2000000000000028,"text":"사실 오늘은 근데..."},{"start":55.79,"duration":1.6000000000000014,"text":"비빔국수를 먹으러 왔어요"},{"start":57.391,"duration":2.2020000000000053,"text":"여름이 이제 딱 다가와서"},{"start":59.594,"duration":1.3329999999999984,"text":"좀 더워지니까"},{"start":60.928,"duration":2.8019999999999996,"text":"새빨간 비빔국수가 생각나더라고요"},{"start":63.731,"duration":3.7689999999999984,"text":"그래서 비빔국수 맛집을 이곳저곳 찾아봤는데"},{"start":67.501,"duration":2.0349999999999966,"text":"리뷰 사진 보니까 완전 제 스타일일 것 같은 거예요!"},{"start":69.537,"duration":1.766999999999996,"text":"약간 원래 비빔국수가 좀..."},{"start":71.305,"duration":2.668999999999997,"text":"양념장이 되직하게 나오는 경우가 많은데"},{"start":74.107,"duration":1.835000000000008,"text":"여긴 다 비벼져서"},{"start":76.042,"duration":4.003999999999991,"text":"약간 국물처럼 자박자박하게 먹는 비빔국수더라고요"},{"start":80.047,"duration":4.971000000000004,"text":"이름부터 벌써 약간 '풍년비빔국수'"},{"start":87.388,"duration":2.0009999999999906,"text":"브레이크 타임 때 촬영 허락해 주셔서 감사해요"},{"start":89.39,"duration":2.100999999999999,"text":"사장님 여기 가게 몇 년 됐어요?"},{"start":91.492,"duration":2.902000000000001,"text":"- 거의 한 20년 됐어요 - 20년~!"},{"start":94.39500000000001,"duration":3.401999999999987,"text":"- TV에 나오셨잖아요! - 네! 맞아요! 조금! 몇 번ㅎㅎ"},{"start":97.798,"duration":2.634999999999991,"text":"여기 손님 점심, 저녁엔 많죠?"},{"start":100.434,"duration":2.4350000000000023,"text":"- 평소에 줄을 서는 편인데요... - 아, 정말요?"},{"start":102.87,"duration":1.6339999999999861,"text":"오늘 축구 때문에 그런가"},{"start":104.505,"duration":1.3670000000000044,"text":"이상하게 손님이 없어요"},{"start":105.87299999999999,"duration":2.835000000000008,"text":"제가 항상... 어딜 가면..."},{"start":108.709,"duration":2.2680000000000007,"text":"그날은 손님 없는 날이거든요..."},{"start":110.97800000000001,"duration":1,"text":"계속 없는 거 아닌가 몰라~"},{"start":111.979,"duration":2.701999999999998,"text":"아니요, 그건 아닙니다"},{"start":114.682,"duration":1.266999999999996,"text":"오늘 하루만"},{"start":116.583,"duration":1.2009999999999934,"text":"운명인가 봐"},{"start":117.785,"duration":2.4010000000000105,"text":"- 항상 제가 촬영하는 곳은 - 점심시간에 항상"},{"start":120.187,"duration":1,"text":"- 줄 서요? - 네"},{"start":121.788,"duration":1.7349999999999994,"text":"그나저나 국수 종류가 생각보다 많네?"},{"start":123.524,"duration":2.8349999999999937,"text":"비빔국수, 열무냉국수, 잔치국수..."},{"start":126.36,"duration":1.1340000000000003,"text":"콩국수도 있어요"},{"start":127.495,"duration":1.4669999999999845,"text":"칼국수 종류도 있고"},{"start":129.196,"duration":1.3669999999999902,"text":"수제비까지 있네"},{"start":130.83,"duration":1.2349999999999852,"text":"만둣국이랑"},{"start":132.499,"duration":1.2009999999999934,"text":"다 맛있겠다"},{"start":133.701,"duration":1.4339999999999975,"text":"사장님!"},{"start":135.136,"duration":2.1340000000000146,"text":"일단 비빔국수 먼저 하나만 주세요"},{"start":137.27100000000002,"duration":1.1999999999999886,"text":"- 비빔국수 하나요? - 네"},{"start":159.46,"duration":1.7009999999999934,"text":"감사합니다"},{"start":161.162,"duration":1.032999999999987,"text":"맛있겠다"},{"start":169.036,"duration":2.8019999999999925,"text":"열무가 기본적으로 들어가고"},{"start":171.839,"duration":1.867999999999995,"text":"그리고 비빔국수가 양념장이 이렇게"},{"start":173.708,"duration":1.5670000000000073,"text":"걸쭉하게 올려서 나오는데"},{"start":175.276,"duration":1.1669999999999732,"text":"얘는 이렇게 촉촉해요"},{"start":176.44400000000002,"duration":2.734999999999985,"text":"저 이렇게 촉촉한 비빔국수 진짜 좋아하거든요"},{"start":193.193,"duration":2.6019999999999754,"text":"제 생각대로 양념장이 촉촉하거든요?"},{"start":195.796,"duration":1.9680000000000177,"text":"비빈 양념장 느낌이 아니라"},{"start":197.765,"duration":3.4020000000000152,"text":"육수가 살짝 자작하게 있는 걸 먹는데"},{"start":201.168,"duration":4.536999999999978,"text":"이제 면에 양념이 진짜 잘 밴 거죠"},{"start":234.2,"duration":1.4680000000000177,"text":"진짜 시원하거든요?"},{"start":235.66899999999998,"duration":1.6680000000000064,"text":"완전 시원한데..."},{"start":237.338,"duration":4.603000000000009,"text":"단맛도 인위적인 단맛이 아니라 진짜 맛있는 단맛이거든요"},{"start":241.942,"duration":1.867999999999995,"text":"열무까지 쓴맛도 하나도 안 나고"},{"start":243.811,"duration":1.4669999999999845,"text":"너무 잘 익었어요"},{"start":267.033,"duration":1.3009999999999877,"text":"흡입해 버렸는데?"},{"start":268.335,"duration":1.8010000000000446,"text":"다음 거 바로 시켜야겠다"},{"start":270.137,"duration":2.5020000000000095,"text":"열무냉물국수도 하나만 주세요"},{"start":272.64,"duration":1.5339999999999918,"text":"사장님 너무 맛있어요!"},{"start":274.175,"duration":2.533999999999992,"text":"- 아, 그래요? - 완전 더위 싹 날아가는 거 같아요"},{"start":276.71,"duration":2.001000000000033,"text":"고맙습니다"},{"start":278.712,"duration":4.069999999999993,"text":"여기에 따뜻한 온육수가 구비되어 있거든요"},{"start":285.618,"duration":2.8700000000000045,"text":"비빔국수 먹고 후식으로 먹기 딱 좋아요"},{"start":289.022,"duration":1.535000000000025,"text":"감사합니다"},{"start":290.558,"duration":1.8340000000000032,"text":"몰라요, 오늘 한... 5~6그릇 정도 드시지 않을까요"},{"start":292.39300000000003,"duration":3.902999999999963,"text":"TV에서 먹는 거 보고 깜짝 놀랐어요"},{"start":296.297,"duration":1.8339999999999463,"text":"TV에 계속 나와요"},{"start":298.132,"duration":1.1329999999999814,"text":"정말요?"},{"start":299.966,"duration":2.134999999999991,"text":"'쯔양몇끼'라고 하고 있는 거 있어요"},{"start":303.369,"duration":2.7029999999999745,"text":"얘는 열무냉물국수-!"},{"start":306.073,"duration":4.103000000000009,"text":"약간 육수가 들어간 거죠"},{"start":315.782,"duration":3.837000000000046,"text":"내가 생각하는 열무국수 맛이야"},{"start":320.286,"duration":1.0009999999999764,"text":"예술인데"},{"start":329.596,"duration":1.2010000000000218,"text":"이빨 시려"},{"start":331.831,"duration":2.06899999999996,"text":"이건 누구나 좋아할 맛인데?"},{"start":357.991,"duration":4.771000000000015,"text":"여름엔 이게..."},{"start":362.763,"duration":2.3010000000000446,"text":"이거 보고 참... 참... 참을 수 없지 않나요?"},{"start":365.065,"duration":2.035000000000025,"text":"여름에 어떻게 참아"},{"start":367.101,"duration":1.5670000000000073,"text":"저 업로드가 저녁 9시잖아요"},{"start":368.669,"duration":3.1020000000000323,"text":"9시에는 비빔국숫집도 많이 없을 텐데"},{"start":401.067,"duration":4.471000000000004,"text":"이거는 육수는 좀 아껴 먹고 계속"},{"start":405.539,"duration":2.4020000000000437,"text":"그래도 여기 왔으니까... 여러 가지 다 먹어볼까?"},{"start":407.942,"duration":2.1340000000000146,"text":"사실 원래 비빔국수만 먹으러 왔거든요"},{"start":410.077,"duration":2.1680000000000064,"text":"다른 칼국수나 잔치국수"},{"start":412.246,"duration":1.3670000000000186,"text":"이런 것도 맛있을 것 같아"},{"start":413.614,"duration":1.2340000000000373,"text":"잔치국수도 될까요?"},{"start":414.849,"duration":1.233000000000004,"text":"- 잔치국수요? - 네"},{"start":441.175,"duration":3.401999999999987,"text":"우와 양이 진짜 많은데?"},{"start":444.711,"duration":1.7350000000000136,"text":"안에 들어간 것도 많고"},{"start":446.447,"duration":1.1329999999999814,"text":"면량이"},{"start":451.084,"duration":1.0009999999999764,"text":"면 봐"},{"start":461.995,"duration":1.0009999999999764,"text":"열무"},{"start":488.554,"duration":1.1350000000000477,"text":"속 뜨거워"},{"start":489.69,"duration":2.0009999999999764,"text":"안에 어묵이 있네?!"},{"start":508.808,"duration":4.370999999999981,"text":"얘도 육수는 천천히 먹겠습니다"},{"start":513.18,"duration":1.9010000000000673,"text":"다음-!"},{"start":515.082,"duration":3.134999999999991,"text":"얼큰수제비?"},{"start":518.218,"duration":3.5030000000000427,"text":"얼큰수제비 하나만 주세요"},{"start":536.17,"duration":1.5330000000000155,"text":"대단하셔... 아직 멀었죠?"},{"start":537.704,"duration":1.33400000000006,"text":"아직요?"},{"start":539.039,"duration":1.7340000000000373,"text":"아직 멀었습니다"},{"start":541.207,"duration":1.802000000000021,"text":"- 뜨거워요 - 감사합니다"},{"start":543.01,"duration":1,"text":"맛있겠다!"},{"start":544.011,"duration":1.3330000000000837,"text":"- 맛있게 드세요 - 대박 사건"},{"start":559.392,"duration":1.5009999999999764,"text":"김치가 들어갔나?"},{"start":560.894,"duration":2.4349999999999454,"text":"진짜 얼큰하다...!"},{"start":563.33,"duration":2.8019999999999072,"text":"제가 또 좋아하는 손수제비예요~"},{"start":575.908,"duration":2.4689999999999372,"text":"엄청 쫄깃쫄깃한데?"},{"start":587.32,"duration":3.6369999999999436,"text":"여기 수제비 반죽이 진짜 맛있다~"},{"start":608.508,"duration":1.467999999999961,"text":"아 이거 무슨 느낌이라고 해야 될까?"},{"start":609.977,"duration":3.90300000000002,"text":"장칼국수도 아니고..."},{"start":614.447,"duration":1.3680000000000518,"text":"따로 만들어요"},{"start":615.816,"duration":2.100999999999999,"text":"- 양념장을 만들어요 - 양념장을~!"},{"start":618.985,"duration":2.56899999999996,"text":"- 저게 다 뭐예요? - 비빔국수에 들어가는 거예요"},{"start":621.555,"duration":1.3670000000000755,"text":"비빔국수에 들어가는 거예요?"},{"start":622.923,"duration":5.403999999999996,"text":"매실청을 넣는 거예요?"},{"start":628.328,"duration":2.4680000000000746,"text":"- 단맛 낼 때 - 비빔국수에다가 단맛 낼 때"},{"start":630.797,"duration":3.769999999999982,"text":"- 비빔국수에는 조미료가 1%도 안 들어가요 - 정말요?"},{"start":634.568,"duration":2.435000000000059,"text":"비빔국수가 진짜 예술이더라고요"},{"start":637.004,"duration":2.534999999999968,"text":"어떻게 MSG가 하나도 안 들어갔는데 이렇게 예술이지?"},{"start":639.54,"duration":1.9340000000000828,"text":"떡볶이라고 치자면..."},{"start":641.475,"duration":3.369000000000028,"text":"고추장 떡볶이가 있고 고춧가루만 들어간 떡볶이가 있잖아요"},{"start":644.845,"duration":5.670999999999935,"text":"고추장 떡볶이는 살짝 텁텁하면서 진한 맛이 있고"},{"start":650.517,"duration":3.602999999999952,"text":"고춧가루는 되게 개운한 떡볶이 맛이잖아요"},{"start":654.121,"duration":3.8029999999999973,"text":"얘는 고춧가루로 만든 버전이라고 해야 되나?"},{"start":657.925,"duration":1.7000000000000455,"text":"진짜 깔끔하고"},{"start":665.164,"duration":1.969000000000051,"text":"여긴 직장인분들이 진짜 많이 오실 것 같아요"},{"start":667.134,"duration":0.8999999999999773,"text":"점심시간에"},{"start":668.035,"duration":1.5339999999999918,"text":"가격도 너무 괜찮잖아요"},{"start":669.57,"duration":1.9669999999999845,"text":"비빔국수양 많이 주는데 8,000원"},{"start":690.423,"duration":1.3010000000000446,"text":"시원하다"},{"start":692.2909999999999,"duration":1.00100000000009,"text":"좋다, 좋아"},{"start":693.293,"duration":2.3350000000000364,"text":"사람들 머리에 그게 박혀있나 봐요"},{"start":695.629,"duration":2.100999999999999,"text":"콩국수를 칼국수 면으로 주면 이상하게 생각해요"},{"start":697.731,"duration":2.4009999999999536,"text":"콩국수는 칼국수로 하는 게 더 맛있지 않아요?!"},{"start":700.133,"duration":2.201999999999998,"text":"더 맛있는데 사람들이 그렇게 생각 안 해요"},{"start":702.336,"duration":4.302999999999997,"text":"아 그럼 원래 칼국수 면으로 하셨다가 소면으로 바뀐 거예요?"},{"start":706.64,"duration":2.3350000000000364,"text":"네! 원래 그렇게 하다가... 소면으로 바꾼 거예요"},{"start":708.976,"duration":1.2000000000000455,"text":"바꾸신 거예요?"},{"start":710.177,"duration":2.1340000000000146,"text":"- 칼국수 면으로 하나 해드려요? - 그래도 돼요?"},{"start":712.312,"duration":1.7010000000000218,"text":"- 칼국수요? - 좋아요!"},{"start":714.014,"duration":2.6019999999999754,"text":"- 저는 그렇게 해 먹어요ㅎㅎ - 정말요?"},{"start":716.617,"duration":1.7000000000000455,"text":"원래 있는 메뉴는 아니고요"},{"start":718.318,"duration":3.201999999999998,"text":"사장님께서 감사하게도 특별하게 해주신다고 하셔서"},{"start":721.521,"duration":1.6340000000000146,"text":"감사합니다"},{"start":723.156,"duration":3.636000000000081,"text":"개인적으로 콩국수는 면 두꺼워야 맛있거든요"},{"start":734.301,"duration":1.099999999999909,"text":"콩 물 직접 만드시는 거죠?"},{"start":735.402,"duration":1.3999999999999773,"text":"제면이요?"},{"start":736.803,"duration":1.6680000000000064,"text":"콩 물"},{"start":738.472,"duration":2.33400000000006,"text":"- 직접 하시는 거예요? - 면도 우리가 뽑는 거예요"},{"start":742.608,"duration":2.136000000000081,"text":"진짜 극한으로 고소해요"},{"start":749.549,"duration":1.3670000000000755,"text":"진짜 고소해요"},{"start":768,"duration":3.0370000000000346,"text":"이거 수제비 반죽 때부터 느꼈지만..."},{"start":771.038,"duration":1.933999999999969,"text":"면발이 이렇게 쫄깃하지...?"},{"start":772.973,"duration":1.6000000000000227,"text":"진짜 쫠깃쫠깃"},{"start":774.574,"duration":2.602000000000089,"text":"한국 사람 쫄깃쫄깃한 거 다 좋아하잖아요"},{"start":777.177,"duration":2.4009999999999536,"text":"소면보다 이게 훨씬 쫄깃쫄깃한데...?"},{"start":779.579,"duration":2.4020000000000437,"text":"근데 피디님 너무..."},{"start":781.982,"duration":3.134999999999991,"text":"콩국수 좋아하신다고 너무 열정적으로 찍으시는 거 아니에요?"},{"start":785.118,"duration":2.7349999999999,"text":"다른 거는 그냥 대충 밖에서 이렇게"},{"start":788.822,"duration":1.3669999999999618,"text":"이러고 찍고"},{"start":790.19,"duration":0.7999999999999545,"text":"콩국수는"},{"start":792.726,"duration":1.2670000000000528,"text":"쫄깃하다고 해서 보여주려고"},{"start":793.994,"duration":1.0670000000000073,"text":"얼마나 맛있어 보였으면"},{"start":795.062,"duration":1.066000000000031,"text":"한 입 드려요?"},{"start":804.537,"duration":2.1019999999999754,"text":"면 식감이 단단한 냉우동 같아요"},{"start":818.684,"duration":1.969000000000051,"text":"칼국수로 한 거 진짜 끝내주는데요?!"},{"start":820.654,"duration":1.7340000000000373,"text":"이거 메뉴에 있었으면 좋겠다"},{"start":822.389,"duration":1.2329999999999472,"text":"너무 맛있다"},{"start":823.623,"duration":2.935999999999922,"text":"- 메뉴에 한번 넣어놔 보세요ㅎㅎ~ - 정말요?"},{"start":827.728,"duration":2.1340000000000146,"text":"- 선택할 수 있게? - 생겼다"},{"start":845.111,"duration":2.9360000000000355,"text":"비빔국수도 칼국수 면으로 먹어봐ㅎㅎ"},{"start":848.048,"duration":1.933999999999969,"text":"진짜 맛있겠다"},{"start":849.983,"duration":2.1680000000000064,"text":"사장님...!"},{"start":852.152,"duration":5.070999999999913,"text":"칼국수 면에다가 비빔국수 해주실 수 있어요?"},{"start":857.224,"duration":1.1999999999999318,"text":"하나 비벼달라고요?"},{"start":858.425,"duration":2.634999999999991,"text":"- 맛이 있을까...? - 아! 너무 맛있을 것 같은데요?!"},{"start":887.053,"duration":1.3339999999999463,"text":"감사합니다"},{"start":888.388,"duration":1.3669999999999618,"text":"- 맛있겠다 - 맛있게 드세요"},{"start":889.889,"duration":1.8679999999999382,"text":"제가 먹었던 비빔칼국수는..."},{"start":891.758,"duration":2.534999999999968,"text":"비빔장처럼 돼있어서..."},{"start":894.294,"duration":2.768000000000029,"text":"약간 그런 맛이었는데"},{"start":897.063,"duration":3.5030000000000427,"text":"아무래도 소면보다 안 어울릴 확률이 크단 말이에요?"},{"start":900.567,"duration":1.8339999999999463,"text":"이론적으로 봤을 때"},{"start":903.837,"duration":1.0670000000000073,"text":"어떠려나?"},{"start":904.905,"duration":3.536000000000058,"text":"솔직히 말해서 자신 있게 시키긴 했는데 잘 모르겠어요"},{"start":910.81,"duration":2.6690000000000964,"text":"으음~ 흐흥ㅎ흫흐ㅎ흐흐"},{"start":921.487,"duration":1.4350000000000591,"text":"개인 취향이에요!"},{"start":922.923,"duration":1.5,"text":"비빔국수보다 맛있어요"},{"start":935.468,"duration":0.7340000000000373,"text":"맛이 괜찮아요?"},{"start":936.203,"duration":1.9669999999999845,"text":"- 저는 너무 맛있어요! - 그래요?"},{"start":938.171,"duration":1.266999999999939,"text":"기존 손님들이 시키셨다가"},{"start":939.439,"duration":2.134999999999991,"text":"'비빔국수로 먹을걸!!!' 이럴까 봐"},{"start":941.575,"duration":1.2999999999999545,"text":"그렇진 않아요"},{"start":942.876,"duration":2.100999999999999,"text":"그래서 말을 못 하겠어요"},{"start":944.978,"duration":3.302000000000021,"text":"많이 먹어본 사람의 입맛이 정확한 거예요"},{"start":948.281,"duration":1.50100000000009,"text":"나중에 한번"},{"start":949.783,"duration":2.467999999999961,"text":"해서 드셔보시고"},{"start":952.252,"duration":1.4340000000000828,"text":"괜찮으면"},{"start":953.687,"duration":3.6359999999999673,"text":"저처럼 약간 도톰한 면 식감을 좋아하시면 솔직히"},{"start":957.324,"duration":2.50100000000009,"text":"일반 비빔국수보다 이게 더 맛있을 거 같아요"},{"start":980.946,"duration":3.3700000000000045,"text":"면이 두꺼워서 간이 덜 밸 걱정은 안 해도 되는 게..."},{"start":984.317,"duration":3.034999999999968,"text":"간이 완전 너무 잘 뱄어요"},{"start":987.354,"duration":3.0019999999999527,"text":"차라리 비빔국수를 하나 더 시켜서 비교를 다시 한번 해볼까...?"},{"start":990.656,"duration":1.1340000000000146,"text":"사장님!"},{"start":992.058,"duration":2.73599999999999,"text":"마지막으로 비빔국수 하나만 더"},{"start":994.795,"duration":2.9680000000000746,"text":"- 비빔국수 소면으로요? - 네, 일반 소면이요"},{"start":997.764,"duration":1.5339999999999918,"text":"사장님, 감사합니다"},{"start":999.299,"duration":3.2350000000000136,"text":"이거 드세요"},{"start":1004.97,"duration":1.2010000000000218,"text":"비빔국수가 훨씬 맛있어요?"},{"start":1008.341,"duration":1.8680000000000518,"text":"확실히 이게 면이..."},{"start":1010.21,"duration":3.1689999999999827,"text":"- 양념이 착 감겨서... - 양념이 쫙 뱄어요?"},{"start":1013.38,"duration":1.5339999999999918,"text":"확실히 착 감겨요?"},{"start":1037.703,"duration":2.7029999999999745,"text":"칼국수 면보다 국수가 더 시원해요!"},{"start":1040.407,"duration":4.40300000000002,"text":"훨씬! 이 면 자체가 시원해서 더 맛있는 거 같아요"},{"start":1099.398,"duration":3.6700000000000728,"text":"양이 꽤 많은 편인데도 7그릇이나 먹었어요"},{"start":1103.235,"duration":4.371000000000095,"text":"저는 근데 개인적으로 첫입은 비빔국수가 맛있거든요?"},{"start":1107.607,"duration":3.2690000000000055,"text":"근데 마지막까지 맛있게 먹는 건 비빔칼국수였어요"},{"start":1110.877,"duration":2.5019999999999527,"text":"소면 자체가 물리는 느낌...?"},{"start":1113.38,"duration":3.0679999999999836,"text":"비빔칼국수는... 처음부터 끝까지 좀..."},{"start":1116.449,"duration":3.0019999999999527,"text":"일괄적으로 되게 쫄깃쫄깃 맛있었어요"},{"start":1119.652,"duration":1.2010000000000218,"text":"그래서 저는"},{"start":1120.854,"duration":3.7359999999998763,"text":"다음에 오면 진짜 비빔칼국수 시킬 것 같아요"},{"start":1124.591,"duration":3.90300000000002,"text":"간단하게 7그릇만 먹었어요ㅎㅎ"},{"start":1128.495,"duration":2.535000000000082,"text":"그게 어디로 다 들어갔어..."},{"start":1131.031,"duration":3.701999999999998,"text":"아 나 참... 나 신기해"},{"start":1134.734,"duration":2.3680000000001655,"text":"- 방송 보고 거짓말인 줄 알았거든요 - 정말요?"},{"start":1137.103,"duration":2.8689999999999145,"text":"거짓말인가요?"},{"start":1139.973,"duration":1.5,"text":"진짜죠?"},{"start":1141.907,"duration":2.7029999999999745,"text":"올해만 하고 저는 그만둘 거거든요"},{"start":1144.611,"duration":3.4019999999998163,"text":"- 그래서 우리 아들한테 물려주려고요 - 아들한테 물려주시고"},{"start":1148.014,"duration":2.3350000000000364,"text":"가게가 2층에 있다 보니까..."},{"start":1150.35,"duration":4.269999999999982,"text":"- 밑에만 보고 다니는 사람들은 위에 안 보거든요 - 그렇죠, 저도 잘 모를 것 같아요"},{"start":1154.621,"duration":1.3329999999998563,"text":"어떨 때는 와서"},{"start":1155.955,"duration":1.4010000000000673,"text":"여기 20년 살았는데"},{"start":1157.357,"duration":4.1030000000000655,"text":"여기에 국숫집 있는 거 처음 알았다는 사람이 많아요"},{"start":1161.461,"duration":2.701999999999998,"text":"아들이 하게 되면 밑으로 내려가요"},{"start":1164.164,"duration":3.6690000000000964,"text":"잘 전수돼서 이 맛이 똑같이 유지되면 좋겠어요"},{"start":1167.834,"duration":2.3350000000000364,"text":"- 고맙습니다 - 너무 맛있게 먹었어요, 사장님"},{"start":1170.17,"duration":2.9349999999999454,"text":"다른 콩국수나 요런 것도 너무너무 맛있는데"},{"start":1173.106,"duration":3.134999999999991,"text":"처음 방문하신다면 비빔국수를 완전 강추 드려요"},{"start":1176.242,"duration":3.6030000000000655,"text":"20년 동안 이 자리에서 쭉 장사를 해오셨다고 하는데"},{"start":1179.846,"duration":3.536000000000058,"text":"대를 잘 이으셔서 이 맛이 계속 유지됐으면 좋겠어요"},{"start":1183.383,"duration":2.8019999999999072,"text":"여름마다 와서 먹고 싶은 비빔국수 맛이었어요"},{"start":1186.186,"duration":5.336999999999989,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
