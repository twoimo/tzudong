{"youtube_link":"https://www.youtube.com/watch?v=Vo0o025xUKE","channel_name":"tzuyang","language":"ko","collected_at":"2026-08-17T02:17:14.561+09:00","transcript":[{"start":0.002,"duration":1.232,"text":"저 많이 먹어요, 사장님...!"},{"start":2.67,"duration":1.1670000000000003,"text":"아직 배고파요...!"},{"start":5.273,"duration":2.6350000000000007,"text":"혼자서 라면 5~10개씩 끓여 먹고 이래요...!"},{"start":7.909,"duration":2.601,"text":"보기엔 밥도 한 반 공기나 먹게 보이는디..."},{"start":18.386,"duration":2.6350000000000016,"text":"뭘 많이 먹었는데 어디로 들어가고 없어..."},{"start":21.022,"duration":1.333000000000002,"text":"테레비에서나 봤네 뭐..."},{"start":22.356,"duration":1.2669999999999995,"text":"쯔양이라고"},{"start":23.624,"duration":1,"text":"저 쯔양이에요...!"},{"start":24.625,"duration":0.8999999999999986,"text":"- 그래?!? - 네!"},{"start":40.708,"duration":1.767000000000003,"text":"어우 갑자기 비 와, 어떡해..."},{"start":44.11,"duration":3.838000000000001,"text":"잠시만요"},{"start":47.949,"duration":1.9669999999999987,"text":"안녕하세요, 여러분!"},{"start":49.917,"duration":3.0689999999999955,"text":"제가 오늘은 지금 용두동에 왔는데"},{"start":52.987,"duration":1.9339999999999975,"text":"용두동 하면 또 생각나는 게 있죠?"},{"start":54.922,"duration":1.2000000000000028,"text":"용두동 주꾸미"},{"start":56.123,"duration":1.3670000000000044,"text":"주꾸미 먹으러 왔어요"},{"start":57.491,"duration":1.9680000000000035,"text":"용두동 주꾸미 골목이 있거든요?"},{"start":59.46,"duration":2.1679999999999993,"text":"제가 옛날에 여기서 먹방을 한 적이 있는데..."},{"start":61.629,"duration":3.702999999999996,"text":"다른 주꾸미집은 아직 한 번도 가본 적이 없더라고요"},{"start":65.333,"duration":1.6340000000000003,"text":"주꾸미집이 여러 곳 있는데"},{"start":66.968,"duration":3.1019999999999897,"text":"'진짜 여기 용두동 주꾸미 골목의 숨은 맛집이에요'"},{"start":70.071,"duration":1.0999999999999943,"text":"하는 데를 찾아왔어요"},{"start":71.172,"duration":4.203000000000003,"text":"다들 입을 모아서 여기가 맛있다고 하시더라고요"},{"start":75.376,"duration":3.0019999999999953,"text":"그리고 여기 주차 도와주시는 분께서"},{"start":78.379,"duration":1.5339999999999918,"text":"여기가 진짜 맛있다고"},{"start":79.914,"duration":2.301000000000002,"text":"서비스도 많이 주신다고 하시더라고요"},{"start":82.21600000000001,"duration":2.5679999999999836,"text":"'고흥쭈꾸미'라는 곳이에요"},{"start":84.785,"duration":2.102000000000004,"text":"비가 쏟아질 것 같으니까 빨리 들어가 보겠습니다"},{"start":86.888,"duration":1.8999999999999915,"text":"오픈 런 왔어요, 여기 10시..."},{"start":88.789,"duration":1.4009999999999962,"text":"이게 문이구나"},{"start":90.191,"duration":2.5349999999999966,"text":"아무도 없습니다"},{"start":92.727,"duration":4.969999999999999,"text":"혹시 주꾸미 큰 판에 몇 인분까지 들어가요?"},{"start":97.69800000000001,"duration":2.968999999999994,"text":"3인분, 4인분, 4인분까지 들어가요"},{"start":100.668,"duration":2.4679999999999893,"text":"- 4인분이요? 그 이상은 안 들어가요? -"},{"start":103.137,"duration":2.335000000000008,"text":"좀 많이 해서 5인분까진 안 들어가나요?"},{"start":105.473,"duration":1.2670000000000101,"text":"4인분씩 들어갑니다"},{"start":106.741,"duration":1.433000000000007,"text":"4인분? 알겠습니다"},{"start":108.175,"duration":2.8689999999999998,"text":"그럼 4인분... 먼저 주세요!"},{"start":111.045,"duration":1.4339999999999975,"text":"세 사람이지?"},{"start":112.47999999999999,"duration":2.1340000000000146,"text":"아뇨, 저 혼자 먹어요!"},{"start":117.218,"duration":2.600999999999999,"text":"다 먹으려고요, 저 많이 먹어요, 사장님!"},{"start":122.957,"duration":2.835000000000008,"text":"- 장사하신 지... - 25년 정도 됐어요"},{"start":125.793,"duration":1.7339999999999947,"text":"엄청 오래되셨네..."},{"start":130.565,"duration":1,"text":"감사합니다"},{"start":131.566,"duration":1.733000000000004,"text":"딱 봐도 맛있겠다"},{"start":134.734,"duration":1.8019999999999925,"text":"이게 고흥 주꾸미예요?"},{"start":136.537,"duration":1.900999999999982,"text":"아니여, 고흥 주꾸미 아닌디?"},{"start":138.439,"duration":2.4680000000000177,"text":"고향이 고흥이라..."},{"start":140.90800000000002,"duration":3.73599999999999,"text":"- 드셔보셔요, 맛있나~ - 맛있나~"},{"start":144.645,"duration":2.234999999999985,"text":"진짜 맛있을 것 같아요"},{"start":146.881,"duration":1,"text":"매울 것 같아요"},{"start":152.185,"duration":2.468999999999994,"text":"홍합탕? 홍합탕이 나오네!"},{"start":154.655,"duration":2.6680000000000064,"text":"우와 사장님 이거 그냥 주시는 거예요?"},{"start":157.324,"duration":2.2679999999999723,"text":"떡 사리, 홍합탕은... 무한 리필!"},{"start":159.59300000000002,"duration":2.134999999999991,"text":"헉 떡 사리도 무한 리필이에요?"},{"start":161.72899999999998,"duration":1.467000000000013,"text":"대식가가 와도 많이 줘요"},{"start":163.197,"duration":1.5999999999999943,"text":"감사합니다"},{"start":165.198,"duration":2.102000000000004,"text":"'파김치 많이 주세요' 하는 사람도 있어요!"},{"start":167.301,"duration":1.600999999999999,"text":"아 뭐야, 파김치?!"},{"start":168.903,"duration":2.7350000000000136,"text":"때깔 봐... 한번 먹어봐야겠다!"},{"start":180.547,"duration":3.469999999999999,"text":"맛있어... 완전 촉촉하고"},{"start":184.018,"duration":4.402999999999992,"text":"양념장이 가득 있는데 안 짠 파김치예요"},{"start":188.422,"duration":1.867999999999995,"text":"홍합탕 한번 먹어볼까?"},{"start":193.226,"duration":1.5020000000000095,"text":"와 시원하다!"},{"start":194.72899999999998,"duration":3.5020000000000095,"text":"깔끔한... 개운한 맛!"},{"start":198.232,"duration":2.6680000000000064,"text":"저는 졸여서 먹는 것보다 이렇게 좀"},{"start":200.901,"duration":2.4679999999999893,"text":"자작하게 먹는 걸 좋아하는 것 같아요"},{"start":203.37,"duration":2.6689999999999827,"text":"이게 다 졸면 진짜 맛있어요"},{"start":210.477,"duration":2.501999999999981,"text":"오 맛있다..."},{"start":212.98,"duration":4.604000000000013,"text":"끝으로 갈수록 감칠맛이 점점..."},{"start":217.585,"duration":1.6999999999999886,"text":"와 매콤칼칼해!"},{"start":219.286,"duration":2.7690000000000055,"text":"홍합탕을 먹으면서 달래고 있어..."},{"start":222.05599999999998,"duration":1.7340000000000089,"text":"근데 파김치 진짜 맛있다"},{"start":227.36,"duration":5.0049999999999955,"text":"홍합이 엄청 짭조름하니 단짠단짠이에요"},{"start":232.36599999999999,"duration":1,"text":"달달하고 짜고"},{"start":234.768,"duration":2.5020000000000095,"text":"계란찜이 그냥 나와요...?"},{"start":237.27100000000002,"duration":2.234999999999985,"text":"아 계란찜 서비스로 주신 거예요?"},{"start":239.507,"duration":1.4000000000000057,"text":"감사합니다, 사장님!"},{"start":248.782,"duration":1.400999999999982,"text":"아~ 좋다!"},{"start":250.184,"duration":2.634999999999991,"text":"- 지금 먹어도 돼요, 사장님? - 예~~"},{"start":262.762,"du