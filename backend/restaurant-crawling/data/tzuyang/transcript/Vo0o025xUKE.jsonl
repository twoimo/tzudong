999999999795,"text":"얘가 콩나물이 진짜 신선하고"},{"start":406.34000000000003,"duration":2.4349999999999454,"text":"딱 물었을 때 엄청 통통하고"},{"start":408.776,"duration":1.5,"text":"채즙이 쫙 나와요"},{"start":420.386,"duration":1.968999999999994,"text":"여기는 채소가 맛있는 곳이네"},{"start":434.1,"duration":1.968999999999994,"text":"이거 홍합을..."},{"start":436.07,"duration":1.5330000000000155,"text":"이렇게 찍어 먹어도 맛있겠다"},{"start":442.20799999999997,"duration":1.4010000000000105,"text":"완전!"},{"start":463.763,"duration":1.968999999999994,"text":"홍합이랑 양념 진짜 잘 어울려요"},{"start":489.655,"duration":2.5360000000000014,"text":"주꾸미..."},{"start":492.192,"duration":2.401999999999987,"text":"다리가..."},{"start":494.595,"duration":1.766999999999996,"text":"8개..."},{"start":496.363,"duration":1.600999999999999,"text":"- 맞아...?ㅋ - 맞죠...?"},{"start":497.965,"duration":3.6690000000000396,"text":"나 진짜 바보 될 뻔했다"},{"start":501.635,"duration":1.266999999999996,"text":"- 사장님~! - 네~?"},{"start":502.903,"duration":2.8349999999999795,"text":"여기 중간에 삼겹 넣을 수 있어요?"},{"start":505.739,"duration":1.266999999999996,"text":"- 네~ - 아 정말요?!"},{"start":507.007,"duration":2.4350000000000023,"text":"일단 2개만 주세여..."},{"start":509.443,"duration":1.1330000000000382,"text":"하나만 하는 게..."},{"start":510.577,"duration":1.2010000000000218,"text":"하... 하나만 하라고요?"},{"start":511.779,"duration":1.8999999999999773,"text":"사장님 저... 아직 배고파요!"},{"start":515.949,"duration":1.8350000000000364,"text":"저 평소에 라면 막..."},{"start":517.785,"duration":3.0679999999999836,"text":"혼자서 5~10개씩 끓여 먹고 이래용..."},{"start":521.922,"duration":1.0670000000000073,"text":"- - 하나만 먹어요?"},{"start":522.99,"duration":1,"text":"- 2개 -"},{"start":525.559,"duration":3.73599999999999,"text":"- 보기엔 밥도 한 반 공기나 먹게 보이는디... - 아 저요...?"},{"start":529.296,"duration":2.0009999999999764,"text":"감사합니다"},{"start":531.298,"duration":1.3339999999999463,"text":"좋아요"},{"start":534.168,"duration":1.7999999999999545,"text":"이렇게 그냥 넣어서 익히면 돼요?"},{"start":538.438,"duration":2.435000000000059,"text":"이렇게 많이 먹는 사람..."},{"start":540.874,"duration":2.634999999999991,"text":"좀 드물어ㅎ"},{"start":543.51,"duration":2.302000000000021,"text":"이거 1인분도 다 못 먹은 사람 많어~"},{"start":545.813,"duration":2.2340000000000373,"text":"아 여기 양이 많은 것 같아요!"},{"start":548.048,"duration":2.1680000000000064,"text":"난 양 적게 안 줘요!"},{"start":550.217,"duration":3.0020000000000664,"text":"요즘 다 살기 힘든데"},{"start":553.22,"duration":1.9009999999999536,"text":"야박하게 조금씩 주고"},{"start":555.122,"duration":3.0020000000000664,"text":"돈만 많이 빼먹으면 힘들잖아요"},{"start":558.125,"duration":1.7670000000000528,"text":"많이 먹느라 힘들겠다~"},{"start":559.893,"duration":1.5009999999999764,"text":"힘들겠다고요?!?"},{"start":561.395,"duration":1.1330000000000382,"text":"아니에요~!!"},{"start":562.529,"duration":2.368000000000052,"text":"육수 약간 모자라면 이렇게 해서..."},{"start":564.898,"duration":1.2010000000000218,"text":"아 사장님 저 저..."},{"start":566.1,"duration":1.5,"text":"원래 평소에도 이렇게 먹어요"},{"start":568.301,"duration":3.169999999999959,"text":"안 믿으셔ㅋㅋ"},{"start":585.686,"duration":3.5359999999999445,"text":"여기 안 익은 것들을 이렇게 넣어버리자"},{"start":589.223,"duration":1.9010000000000673,"text":"넣어서 익혀버릴게요"},{"start":594.293,"duration":2.3360000000000127,"text":"쭈삼인데... 대패쭈삼이 아니라"},{"start":596.63,"duration":2.1680000000000064,"text":"진짜 이렇게 두꺼운 쭈삼은 처음 봐요"},{"start":598.799,"duration":1.3670000000000755,"text":"끝장나겠는걸"},{"start":611.344,"duration":3.7369999999999663,"text":"우리가 평소에 아는 그 삼겹살에다가"},{"start":615.082,"duration":2.6680000000000064,"text":"주꾸미 싸서 먹는..."},{"start":617.751,"duration":2.100999999999999,"text":"맛없을 수가 없는..."},{"start":624.79,"duration":4.638000000000034,"text":"구이 삼겹살과 수육의 중간 같아요"},{"start":629.429,"duration":3.769999999999982,"text":"이거 되게 쫄깃쫄깃하고 맛있는 삼겹살인데?"},{"start":633.2,"duration":2.7679999999999154,"text":"다른 곳은 삼겹 2인 시키면 여기 두를 정도로 나오잖아요"},{"start":635.969,"duration":0.9669999999999845,"text":"근데 얇은 걸로 나오잖아요"},{"start":636.937,"duration":2.367999999999938,"text":"여긴 두꺼운 걸로 나오니까 양이 훨씬 많아요"},{"start":670.269,"duration":3.1369999999999436,"text":"진짜 돼지고기 완벽하게..."},{"start":673.407,"duration":2.0670000000000073,"text":"익히는 스킬을 갖고 싶어요"},{"start":675.475,"duration":2.369000000000028,"text":"초능력 중에"},{"start":677.845,"duration":2.1669999999999163,"text":"고기 완벽하게 익히는 스킬"},{"start":680.013,"duration":1.4009999999999536,"text":"고기는 익힘 정도에 따라"},{"start":681.415,"duration":2.634999999999991,"text":"맛이랑 식감이 너무 다르기 때문에"},{"start":692.9590000000001,"duration":2.534999999999968,"text":"와 파김치 진짜 입양해 가고 싶다"},{"start":695.495,"duration":2.201999999999998,"text":"진짜로 집에 데려가고 싶어요"},{"start":706.172,"duration":1.8349999999999227,"text":"볶음밥 해 먹어야 되는데"},{"start":708.008,"duration":1.1999999999999318,"text":"살짝 덜고..."},{"start":709.2090000000001,"duration":3.5359999999999445,"text":"썰어서 안에 주꾸미랑 삼겹살을 넣는 거죠"},{"start":712.746,"duration":2.8350000000000364,"text":"맛있겠다"},{"start":715.582,"duration":1.7340000000000373,"text":"상추랑 깻잎이 들어가는구나"},{"start":720.253,"duration":1.1339999999999009,"text":"맛있겠다"},{"start":747.413,"duration":2.7029999999999745,"text":"볶음밥이 완전 화룡점정인데?"},{"start":750.117,"duration":4.302999999999997,"text":"깻잎 향이 솔솔 진짜 향긋하게 나면서"},{"start":754.421,"duration":2.3349999999999227,"text":"감칠맛이 진짜 엄청 깊어요"},{"start":767.734,"duration":1.8679999999999382,"text":"이게 진짜 맛있는 건데"},{"start":792.725,"duration":2.302000000000021,"text":"그리고 이거 잘 긁히네"},{"start":795.028,"duration":2.0009999999999764,"text":"좀 오래 눌렀는데 다 달라붙었을 줄 알았는데"},{"start":797.03,"duration":1.6680000000000064,"text":"엄청 잘 긁혀"},{"start":803.5360000000001,"duration":1.433999999999969,"text":"눌어붙은 거 되게 고소해"},{"start":810.576,"duration":1.0009999999999764,"text":"맛있다"},{"start":813.546,"duration":1.600999999999999,"text":"여기가 콩나물이 맛있습니다!"},{"start":815.148,"duration":5.071000000000026,"text":"진짜 많이 먹은 거예요"},{"start":842.975,"duration":1.5349999999999682,"text":"어...?"},{"start":844.511,"duration":1.5339999999999918,"text":"방금 스페야 파에야 맛 났어요..."},{"start":846.046,"duration":1.3999999999999773,"text":"습해... 스페야래...ㅋ"},{"start":847.447,"duration":1.7010000000000218,"text":"스페인 파에야 맛 났어요ㅋㅋㅋ"},{"start":849.149,"duration":1.8339999999999463,"text":"아직 스페인의 기억이 남아있나 봐요"},{"start":859.291,"duration":5.138999999999896,"text":"남은 주꾸미 다 먹고"},{"start":864.431,"duration":2.0679999999999836,"text":"- 이렇게 먹고 며칠 안 먹는 거여? - 저요?!"},{"start":866.5,"duration":2.7350000000000136,"text":"아뇨, 저 집에 가서 또 먹어요!"},{"start":869.236,"duration":2.433999999999969,"text":"집에 가서ㅋㅋ"},{"start":871.671,"duration":2.034999999999968,"text":"대체 어디로 들어가..."},{"start":873.707,"duration":3.0020000000000664,"text":"뭘... 많이 먹었는데 어디로 들어가 버리고 없어..."},{"start":876.71,"duration":1.5339999999999918,"text":"다 들어... 들어갔어요..."},{"start":878.245,"duration":2.5009999999999764,"text":"테레비에서나 봤네 뭐..."},{"start":880.747,"duration":2.100999999999999,"text":"쯔양인가 뭐 그런 사람"},{"start":882.849,"duration":1.0339999999999918,"text":"저 쯔양이에요...!"},{"start":883.884,"duration":1.1000000000000227,"text":"- 그래?!? - 네!"},{"start":887.087,"duration":2.4010000000000673,"text":"- 쯔양이 엄청 많이 먹더라고... - 저... 저예요, 쯔양이에요"},{"start":889.489,"duration":1.266999999999939,"text":"- 제가 쯔양이에요... - 그래...?"},{"start":890.757,"duration":2.0680000000000973,"text":"요즘은 나이 먹다 보니까..."},{"start":892.826,"duration":2.201000000000022,"text":"- 아가씨들이 다아아... - 똑같이 생겼어요?"},{"start":895.028,"duration":2.4349999999999454,"text":"비슷비슷하게 생겼더라고"},{"start":897.4639999999999,"duration":2.0680000000000973,"text":"그니까 이제 좀 이해가 되죠?"},{"start":899.533,"duration":1.1330000000000382,"text":"거기는 많이 먹더라고ㅋ"},{"start":902.402,"duration":1.933999999999969,"text":"아니 그렇게 유명한 쯔양이"},{"start":904.337,"duration":2.4020000000000437,"text":"왜 여기까지 왔을까..."},{"start":906.74,"duration":1.33299999999997,"text":"주꾸미 먹고 싶어서 왔어요ㅎ"},{"start":908.074,"duration":1.8350000000000364,"text":"맛있어요, 사장님, 너무 맛있게 먹었어요!"},{"start":909.91,"duration":3.869000000000028,"text":"사진을 한번 찍어야지, 그렇지?"},{"start":917.45,"duration":0.6339999999999009,"text":"인정"},{"start":918.085,"duration":2.5009999999999764,"text":"- '인정'ㅋㅋ - 정말이야"},{"start":920.587,"duration":2.768000000000029,"text":"주꾸미 먹고 싶어서 오랜만에 주꾸미 골목 왔는데"},{"start":923.356,"duration":0.6330000000000382,"text":"너무 맛있게 먹었어요"},{"start":923.99,"duration":2.6689999999999827,"text":"양념도 진짜 호불호 없이"},{"start":926.66,"duration":1.9010000000000673,"text":"누구나 좋아할 그런 맛이어서"},{"start":928.562,"duration":1.16599999999994,"text":"막 많이 맵지도 않아요"},{"start":929.729,"duration":3.06899999999996,"text":"파김치랑 먹는 조합이 되게 신박했습니다"},{"start":932.799,"duration":2.6019999999999754,"text":"재료가 되게 신선하고 홍합탕도 나오고"},{"start":935.402,"duration":1.7339999999999236,"text":"너무 맛있게 잘 먹었습니다"},{"start":937.137,"duration":3.602000000000089,"text":"아무튼 오늘도 잘 먹었습니다~!"},{"start":941.807,"duration":2.302000000000021,"text":"근데 PD 삼촌은 안 먹어서 어떡해..."},{"start":944.11,"duration":2.701999999999998,"text":"- 앉아서 밥 먹고 가! - 다들 잘 챙겨 드세요"},{"start":946.813,"duration":1.16700000000003,"text":"고생하셨습니다"},{"start":947.981,"duration":1.2670000000000528,"text":"감사합니다"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
