{"youtube_link":"https://www.youtube.com/watch?v=DA7lvECQ3Ok","channel_name":"tzuyang","language":"ko","collected_at":"2026-06-16T05:18:37.143+09:00","transcript":[{"start":0.001,"duration":1.5670000000000002,"text":"지금 새벽 6시거든요?"},{"start":1.569,"duration":1.9340000000000002,"text":"아침부터 왜 이렇게 나왔냐면"},{"start":3.504,"duration":1.501,"text":"백반집을 가고 있습니다"},{"start":10.278,"duration":1.7669999999999995,"text":"감사합니다"},{"start":12.046,"duration":1.9009999999999998,"text":"김치찌개예요"},{"start":13.948,"duration":2.067999999999998,"text":"감사합니다"},{"start":16.017,"duration":1.2330000000000005,"text":"우와 된장찌개"},{"start":17.251,"duration":1.8009999999999984,"text":"감사합니다"},{"start":21.789,"duration":1.7339999999999982,"text":"누구세요...?"},{"start":30.263,"duration":4.038,"text":"어떻게 저렇게 먹는지 신기하네..."},{"start":44.378,"duration":1.9350000000000023,"text":"안녕하세요 여러분"},{"start":46.314,"duration":1.9339999999999975,"text":"제가 오늘은 지금 여기"},{"start":48.249,"duration":2.434999999999995,"text":"청량리 경동시장 근처에 왔는데"},{"start":50.685,"duration":3.7689999999999984,"text":"밝아서 모르실 것 같은데 지금..."},{"start":54.455,"duration":1.8340000000000032,"text":"새벽 6시거든요"},{"start":56.29,"duration":2.402000000000001,"text":"목도 잠겼어... 얼굴도 붓고"},{"start":58.693,"duration":1.233000000000004,"text":"뭐 찍는 거여?"},{"start":59.927,"duration":1.7340000000000018,"text":"아 저희 먹방 찍으러 왔어요ㅎㅎ"},{"start":61.662,"duration":1,"text":"흐헤헤헤헤헿"},{"start":62.663,"duration":1.6340000000000003,"text":"- 잘 먹는 아가씨 아니야? - 잘 먹는 아가씨 맞아요"},{"start":64.298,"duration":1.6679999999999922,"text":"어떻게 아셨어요?ㅎㅎ"},{"start":65.967,"duration":0.9989999999999952,"text":"감사합니다"},{"start":67.867,"duration":3.3699999999999903,"text":"- - 지금 아침부터 왜 이렇게 나왔냐면"},{"start":71.238,"duration":1.7009999999999934,"text":"백반집을 가고 있습니다"},{"start":72.94,"duration":4.236999999999995,"text":"사실 백반은 또 아침에"},{"start":77.178,"duration":2.7010000000000076,"text":"이르게 먹어야 제맛이잖아요"},{"start":79.88,"duration":1.5010000000000048,"text":"유명한 곳인데"},{"start":81.382,"duration":4.736999999999995,"text":"경동시장 상인분들이 정말 많이 이용하시는 식당이래요"},{"start":86.12,"duration":1.9009999999999962,"text":"여기는 사실..."},{"start":88.788,"duration":2.203000000000003,"text":"쇼츠 알고리즘을 점령한 곳이에요"},{"start":90.992,"duration":3.468999999999994,"text":"제가 여기를 쇼츠 동영상으로"},{"start":94.462,"duration":1.833999999999989,"text":"한 열 번 넘게 봤거든요"},{"start":96.297,"duration":3.8029999999999973,"text":"그래서 저도 유행 따라 알고리즘 따라 찾아왔습니다"},{"start":100.101,"duration":2.6680000000000064,"text":"골목에 들어가서"},{"start":102.77000000000001,"duration":2.100999999999999,"text":"이리로 들어가야 입구가 있어요"},{"start":104.872,"duration":1.534000000000006,"text":"헷갈리실 수 있는데"},{"start":106.407,"duration":0.7999999999999972,"text":"여기 있다"},{"start":107.208,"duration":1.4339999999999975,"text":"'경동식당'"},{"start":111.912,"duration":1.5349999999999966,"text":"안녕하세요"},{"start":113.44800000000001,"duration":2.7009999999999934,"text":"흔쾌히 촬영 허가해 주셔서 감사해요"},{"start":116.15,"duration":2.134999999999991,"text":"'오늘의 백반'은 뭐예요?"},{"start":118.286,"duration":0.7990000000000066,"text":"미역국이에요"},{"start":119.086,"duration":1.4009999999999962,"text":"미역국이에요?"},{"start":120.488,"duration":1.7000000000000028,"text":"미역국 좋아하는데 맛있겠다"},{"start":122.189,"duration":1.8680000000000092,"text":"아 그리고 제가 이번에..."},{"start":124.05799999999999,"duration":1.9680000000000035,"text":"팝업 제가... 다..."},{"start":126.027,"duration":1.1659999999999968,"text":"다 끝났는데"},{"start":127.194,"duration":1.9009999999999962,"text":"팝업 방문해 주신 모든 분들께 감사드립니다"},{"start":129.096,"duration":1.4669999999999845,"text":"다들 관심 많이 주셔서"},{"start":130.564,"duration":3.3360000000000127,"text":"가든즈 팝업 성황리에 종료했습니다"},{"start":133.901,"duration":3.1359999999999957,"text":"구매하신 분들 중에서 투표하신 분들"},{"start":137.038,"duration":2.033999999999992,"text":"제가 오늘 추첨 통 가져왔거든요"},{"start":139.073,"duration":3.1359999999999957,"text":"영상 마지막에 추첨 직접 할 거니까"},{"start":142.21,"duration":1.7339999999999804,"text":"혹시 참여하셨던 분들은"},{"start":143.945,"duration":3.7360000000000184,"text":"영상 뒤쪽 확인해 보시면 좋을 거 같습니다"},{"start":147.682,"duration":2.4680000000000177,"text":"오늘의 백반 그래도 궁금하니까 먹어보고"},{"start":150.151,"duration":2.166999999999973,"text":"김치찌개, 된장찌개, 제육볶음, 오징어볶음"},{"start":152.31900000000002,"duration":0.799999999999983,"text":"다 먹어봐야겠다"},{"start":153.12,"duration":1.7680000000000007,"text":"이거는 2인 이상이야"},{"start":154.889,"duration":2.867999999999995,"text":"2인 이상 아무 문제 없죠"},{"start":157.758,"duration":1.600999999999999,"text":"오히려 좋아"},{"start":159.36,"duration":1.1329999999999814,"text":"사장님"},{"start":160.861,"duration":1.1340000000000146,"text":"그러면"},{"start":162.662,"duration":1.9019999999999868,"text":"백반 하나랑요"},{"start":169.136,"duration":1.3340000000000032,"text":"부대찌개도 주세요"},{"start":170.471,"duration":1.600999999999999,"text":"- 다... 드신다고요? - 네"},{"start":172.073,"duration":3.8019999999999925,"text":"- 아 저 좀 많이 먹어서ㅎㅎㅎ -"},{"start":175.876,"duration":0.9000000000000057,"text":"오늘의 백반"},{"start":176.777,"duration":1.8340000000000032,"text":"김치찌개 하나랑 된장찌개 하나랑"},{"start":178.612,"duration":3.069000000000017,"text":"제육볶음 하나랑 오징어볶음하나랑 부대찌개"},{"start":181.682,"duration":3.169000000000011,"text":"누구세요?"},{"start":184.852,"duration":1.4339999999999975,"text":"쯔양이라고 하는데"},{"start":186.287,"duration":0.8659999999999854,"text":"엄마야"},{"start":187.154,"duration":1.3000000000000114,"text":"누군지 아세요?"},{"start":189.055,"duration":1.6689999999999827,"text":"지금 소름 돋았어 ㄷㄷ"},{"start":240.274,"duration":2.6680000000000064,"text":"- 오징어볶음하고 제육볶음 - 감사합니다"},{"start":242.943,"duration":2.3349999999999795,"text":"김치찌개예요"},{"start":245.279,"duration":1.8010000000000161,"text":"- 감사합니다 - 부대찌개에다가"},{"start":247.081,"duration":1.600999999999999,"text":"우와 된장찌개!"},{"start":248.683,"duration":1.3000000000000114,"text":"감사합니다"},{"start":249.984,"duration":0.9669999999999845,"text":"주걱을...!"},{"start":250.952,"duration":2,"text":"- 밥을 직접 푸셔야 해요 - 네"},{"start":253.386,"duration":1.4350000000000023,"text":"잘 먹겠습니다~!"},{"start":254.822,"duration":0.8659999999999854,"text":"너무 기대돼"},{"start":255.689,"duration":4.304000000000002,"text":"냄비 봐!"},{"start":259.994,"duration":0.9329999999999927,"text":"맛있겠다"},{"start":261.394,"duration":1.7339999999999804,"text":"밥이 완전 꽉 차있네"},{"start":263.129,"duration":2.1019999999999754,"text":"원래 밥을 이렇게 솎아줘야 해"},{"start":265.665,"duration":1.2339999999999804,"text":"맛있게 퍼서"},{"start":277.777,"duration":1.3350000000000364,"text":"엄청 찰져요"},{"start":279.113,"duration":3.8360000000000127,"text":"쫀득한 식감에 씹을수록 달아요"},{"start":285.919,"duration":1.434000000000026,"text":"제육볶음 먼저 먹어볼까?"},{"start":287.354,"duration":1.9350000000000023,"text":"역시 제육볶음이지"},{"start":301.301,"duration":1.16700000000003,"text":"맛있다..."},{"start":302.936,"duration":1.434000000000026,"text":"고추장제육 맛이에요"},{"start":304.371,"duration":1.8350000000000364,"text":"고추장이 좀 많이 들어간...?"},{"start":306.207,"duration":2.2339999999999804,"text":"오히려 약간 되게 매콤하고"},{"start":308.442,"duration":0.9329999999999927,"text":"달달해요"},{"start":310.577,"duration":1.2010000000000218,"text":"맛있어"},{"start":323.756,"duration":2.7030000000000314,"text":"비계가 없는 고기라서 안 부드러울 줄 알았는데"},{"start":326.46,"duration":1.3670000000000186,"text":"고기 진짜 부드러워요"},{"start":327.828,"duration":1.2670000000000528,"text":"안 뻑뻑해요"},{"start":339.973,"duration":3.0360000000000014,"text":"진짜로 밥 비벼 먹고 싶은 맛이야"},{"start":343.01,"duration":0.8659999999999854,"text":"여기다 이렇게"},{"start":345.612,"duration":1.367999999999995,"text":"비벼서"},{"start":352.96500000000003,"duration":2.1889999999999645,"text":"와 진짜 혀에 착 감기는 맛인데?"},{"start":356.289,"duration":0.9340000000000259,"text":"와... 이건 진짜"},{"start":357.224,"duration":1.8340000000000032,"text":"맛있지 않겠다"},{"start":364.464,"duration":3.3700000000000045,"text":"김!"},{"start":367.835,"duration":1.434000000000026,"text":"어떡해"},{"start":389.589,"duration":3.069999999999993,"text":"와... 밥 한 공기 이미 끝났어..."},{"start":405.806,"duration":1.4670000000000414,"text":"밥 모자라겠는데?"},{"start":407.274,"duration":1.8009999999999877,"text":"양념이 너무 아깝다"},{"start":409.076,"duration":2.0679999999999836,"text":"양념 싹싹 먹어야 해...!"},{"start":426.06,"duration":1.6000000000000227,"text":"아직 제육볶음밖에 안 먹어봤는데"},{"start":427.661,"duration":0.8000000000000114,"text":"제육볶음이 너무 맛있어요"},{"start":428.462,"duration":2.4010000000000105,"text":"- - 싹싹 긁어 먹었어요"},{"start":430.864,"duration":1.3010000000000446,"text":"여기 몇 시까지 영업해요?"},{"start":432.166,"duration":1.766999999999996,"text":"제가 새벽 2시 30분에 나와서"},{"start":433.934,"duration":2.701999999999998,"text":"아침 9시 30분부터"},{"start":436.637,"duration":2.201000000000022,"text":"10시 50분까지 브레이크 시간"},{"start":439.874,"duration":2.200999999999965,"text":"2시 반에 나오셔서 2시 반에 닫으시는 거예요?"},{"start":442.076,"duration":1.9669999999999845,"text":"누워있으면 10시, 11시 돼요"},{"start":444.044,"duration":4.3040000000000305,"text":"하루 3~4시간? 그 정도밖에 못 자요"},{"start":448.349,"duration":1.66700000000003,"text":"잠이 부족해요"},{"start":450.017,"duration":1.66700000000003,"text":"- 그래도 잘 주무셔... - 그래도 즐거워요"},{"start":451.685,"duration":0.9340000000000259,"text":"그래요?"},{"start":452.62,"duration":1.33299999999997,"text":"너무 맛있어요, 사장님"},{"start":454.154,"duration":1.1999999999999886,"text":"잘 먹겠습니다"},{"start":455.855,"duration":3.169999999999959,"text":"된장찌개 한번, 색깔이 진한데?"},{"start":459.026,"duration":2.901999999999987,"text":"안에 바지락이랑 감자..."},{"start":461.929,"duration":3.7690000000000055,"text":"감자 들어간 된장찌개? 말 다 했다..."},{"start":471.604,"duration":1.7350000000000136,"text":"너무 잘 익은 감자야..."},{"start":473.34000000000003,"duration":0.8999999999999773,"text":"제가 지금..."},{"start":474.241,"duration":1.7010000000000218,"text":"칠성사이다 모델이잖아요"},{"start":475.943,"duration":2.367999999999995,"text":"그래서 요즘 사이다만 먹고 있습니다"},{"start":478.312,"duration":2.5679999999999836,"text":"진짜 최애 탄산이에요...!"},{"start":480.881,"duration":1.934000000000026,"text":"정말 매일 먹어요"},{"start":482.816,"duration":1.3670000000000186,"text":"매일매일 먹고 있습니다"},{"start":489.989,"duration":1.7300000000000182,"text":"캬~!"},{"start":491.72,"duration":3.6749999999999545,"text":"고기 먹을 때랑 한식 먹을 때는 칠성사이다죠"},{"start":503.