{"youtube_link":"https://www.youtube.com/watch?v=6UNFYCU0bmE","channel_name":"tzuyang","language":"ko","collected_at":"2026-03-17T22:09:10.681+09:00","transcript":[{"start":52.1,"duration":1.9699999999999989,"text":"안녕하세요, 여러분"},{"start":54.072,"duration":1.9579999999999984,"text":"제가 오늘은 지금 홍콩의..."},{"start":56.032,"duration":2.618000000000002,"text":"삼수이포라는 지역에 왔는데"},{"start":58.652,"duration":3.118000000000002,"text":"사실 여기 워낙 유명해서 한국인분들도 많이 오시고"},{"start":61.772,"duration":1.7079999999999984,"text":"여기 첫날에 아마 제가"},{"start":63.482,"duration":2.628,"text":"스테이크 먹은 지역과 같은 곳일 거예요"},{"start":66.112,"duration":4.308000000000007,"text":"근데 오늘은 제대로 된 홍콩 음식을 즐기러 왔습니다"},{"start":70.422,"duration":3.378,"text":"여기가 홍콩식 다이파이동이라고 불리는데"},{"start":73.801,"duration":1.698999999999998,"text":"사실 홍콩식 포장마차예요"},{"start":75.89,"duration":3.0700000000000074,"text":"이렇게 밖에서 조리를 직접 해주시고"},{"start":78.961,"duration":2.198999999999998,"text":"원래 코로나 전에는"},{"start":81.161,"duration":1.2289999999999992,"text":"이런 가게들이 많았대요"},{"start":82.392,"duration":2.9380000000000024,"text":"근데 코로나 이후로 이런 포장마차들이 많이 없어져서"},{"start":85.332,"duration":2.1980000000000075,"text":"그중에서도 남아있는 가게라고 하는데"},{"start":87.532,"duration":2.868000000000009,"text":"'애문생'이라는 되게 유명한 곳이에요"},{"start":90.402,"duration":1.3379999999999939,"text":"굉장히 오래됐어요"},{"start":91.741,"duration":0.9590000000000032,"text":"한 70년?"},{"start":93.03999999999999,"duration":3.170000000000016,"text":"약간 맥주 한잔하면서 간단하게 먹으러 왔습니다"},{"start":96.53999999999999,"duration":3.8400000000000034,"text":"지금 아마 이제 오픈하자마자 거의 찾아왔거든요"},{"start":100.381,"duration":1.4989999999999952,"text":"그래서 아직 손님은 없는데"},{"start":101.881,"duration":2.5690000000000026,"text":"아마 이제 저녁 시간쯤 되면 손님이 진짜 많아질 거예요"},{"start":104.452,"duration":3.878,"text":"그래서 빨리 가서 먹어보도록 하겠습니다"},{"start":108.65,"duration":1.769999999999996,"text":"아 이게 홍콩에서는"},{"start":110.422,"duration":1.6380000000000052,"text":"뜨거운 물을 갖다주시면은"},{"start":112.062,"duration":3.528000000000006,"text":"식기를 직접 씻어서 먹는 전통이 있대요"},{"start":115.592,"duration":4.778000000000006,"text":"볼에 이런 식으로 뜨거운 물을 부은 다음에"},{"start":120.372,"duration":2.6580000000000013,"text":"식기를 직접 씻어서"},{"start":123.032,"duration":1.5379999999999967,"text":"사실 설거지를 안 하는 건 아니고"},{"start":124.571,"duration":1.5990000000000038,"text":"설거지는 다 되어있는데"},{"start":126.172,"duration":2.867999999999995,"text":"약간 이런 전통이 있다고 합니다"},{"start":129.042,"duration":1.9379999999999882,"text":"이 아가씨가 많이 먹는다고?"},{"start":134.352,"duration":0.9480000000000075,"text":"메뉴판"},{"start":135.302,"duration":1.2079999999999984,"text":"여기 메뉴가"},{"start":136.512,"duration":2.038000000000011,"text":"진짜 진짜 많더라고요...ㄷㄷ"},{"start":138.552,"duration":3.2379999999999995,"text":"제가 향신료에 조금 약한 편이어서"},{"start":141.792,"duration":1.0979999999999848,"text":"걱정이 됐는데"},{"start":142.892,"duration":2.52800000000002,"text":"향신료에 강하신 분들이 계시기 때문에"},{"start":145.422,"duration":2.6680000000000064,"text":"제가 오늘 조금 맘 놓고 시키겠습니다"},{"start":148.09199999999998,"duration":2.4680000000000177,"text":"이게 좀 편한 게 이거 사실 보면 모르잖아요"},{"start":151.702,"duration":1.3979999999999961,"text":"여기 이렇게 다"},{"start":153.102,"duration":2.867999999999995,"text":"번역을 하면 한국말로 아주 잘 나오기 때문에"},{"start":155.972,"duration":1.5979999999999848,"text":"그래서 여기 일단은!"},{"start":157.572,"duration":2.2680000000000007,"text":"유명한 메뉴들 이렇게 있거든요"},{"start":159.84199999999998,"duration":2.1680000000000064,"text":"저희 시그니처 메뉴판 따로 있어요~~"},{"start":162.012,"duration":2.098000000000013,"text":"아ㅎㅎ 시그니처"},{"start":164.112,"duration":1.5980000000000132,"text":"감사해요"},{"start":165.712,"duration":2.9380000000000166,"text":"여기 시그니처가 다 이렇게 있어요"},{"start":168.652,"duration":1.568000000000012,"text":"바지락볶음"},{"start":170.222,"duration":1.7779999999999916,"text":"후추소고기안심큐브볶음"},{"start":172.002,"duration":2.397999999999996,"text":"맛조개, 비퐁당게, 새우"},{"start":174.402,"duration":1.7480000000000189,"text":"그리고 후추오징어튀김, 양저우볶음밥"},{"start":176.152,"duration":1.8080000000000211,"text":"그러면 다 먹어봐야겠는데...?"},{"start":177.962,"duration":2.098000000000013,"text":"시그니처 여덟 가지!"},{"start":183.39,"duration":1.5100000000000193,"text":"안녕하세요ㅎㅎ"},{"start":184.902,"duration":1.1280000000000143,"text":"이분 찾아볼래요?"},{"start":186.032,"duration":1.7680000000000007,"text":"저기"},{"start":187.802,"duration":1.4279999999999973,"text":"저기 그려져 계세요"},{"start":222.702,"duration":1.9979999999999905,"text":"잘 먹겠습니다~!"},{"start":224.702,"duration":3.437999999999988,"text":"이게 홍콩에서 진짜 많이 마시는 맥주래요"},{"start":228.142,"duration":2.9680000000000177,"text":"'블루걸'이라는 맥준데"},{"start":231.112,"duration":1.1280000000000143,"text":"바로 마셔보겠습니다"},{"start":241.55,"duration":2.069999999999993,"text":"진짜 시원하다"},{"start":245.79,"duration":2.9399999999999977,"text":"바로 가장 인기 메뉴 1등"},{"start":248.732,"duration":2.1680000000000064,"text":"소고기감자볶음부터 먹어볼게요"},{"start":250.902,"duration":1.9980000000000189,"text":"제가 또 감자 킬러잖아요"},{"start":258.74,"duration":1.7300000000000182,"text":"너무 잘 익었다"},{"start":260.472,"duration":2.298000000000002,"text":"감자가 두꺼워서 좀 설익지 않았을까 했는데"},{"start":262.772,"duration":2.9680000000000177,"text":"안에 되게 잘 익었네, 엄청 부드럽게 잘 익었고"},{"start":270.68,"duration":1.0699999999999932,"text":"와 감사합니다~~"},{"start":271.752,"duration":1.5279999999999632,"text":"아아... 음꺼이~"},{"start":275.602,"duration":1.698000000000036,"text":"맛조개는 나오자마자 먹어봐야겠지?"},{"start":279.42,"duration":1.0399999999999636,"text":"우와 크죠"},{"start":280.462,"duration":3.098000000000013,"text":"이렇게 맛조개는 1피스에 얼마씩 팔아요"},{"start":283.562,"duration":1.9979999999999905,"text":"가격대가 있는 큰 조개라서"},{"start":291.57,"duration":1.8700000000000045,"text":"소스 진짜 맛있다"},{"start":293.442,"duration":1.7679999999999723,"text":"이거는 한국인이면"},{"start":295.212,"duration":3.4979999999999905,"text":"호불호 없이 다 맛있게 먹을 맛이네요"},{"start":298.712,"duration":3.6680000000000064,"text":"진짜 단짠하면서도 되게 매콤한 맛도 강해요"},{"start":302.382,"duration":1.3380000000000223,"text":"꽤 매워요"},{"start":303.722,"duration":2.098000000000013,"text":"이건 오징어튀김인데"},{"start":305.822,"duration":2.367999999999995,"text":"사장님 첫 번째 추천, 두 번째 추천이었어요"},{"start":317.85,"duration":2.8999999999999773,"text":"이거 진짜 완전 맥주를 부르는 맛이다"},{"start":320.752,"duration":0.8179999999999836,"text":"짭짤해서"},{"start":326.57,"duration":3.4050000000000296,"text":"약간 마늘 플레이크를 굉장히 잘게 갈아서"},{"start":329.977,"duration":2.733000000000004,"text":"진짜 그 마늘 감칠맛이 되게 강해요"},{"start":340.25,"duration":5.509999999999991,"text":"몸통 부분은 되게 부드럽고 다리 부분은 쫄깃하네"},{"start":345.762,"duration":2.598000000000013,"text":"- 식초간장에 찍어 먹는 게 맛있대 - 식초간장?"},{"start":348.362,"duration":1.3979999999999677,"text":"이게 식초간장이구나"},{"start":349.762,"duration":1.6379999999999768,"text":"여기다 찍어 먹는 거야, 맞아"},{"start":351.402,"duration":1.1480000000000246,"text":"까먹고 있었어"},{"start":376.52,"duration":3.4399999999999977,"text":"일단 음식이 전체적으로 양념이 맛있어요"},{"start":386.43,"duration":1.740000000000009,"text":"감자볶음 너무 맛있는데?"},{"start":388.172,"duration":2.227999999999952,"text":"제가 감자 진짜 좋아하잖아요"},{"start":391.97,"duration":2.3999999999999773,"text":"껍질 벗겨서 튀겼는데"},{"start":394.372,"duration":5.637999999999977,"text":"그 튀김 부분이 되게 쫀득쫀득한 얇은 튀김이거든요?"},{"start":401.37,"duration":1.740000000000009,"text":"감자 여기"},{"start":403.112,"duration":3.9780000000000086,"text":"튀김옷이 약간 감자 껍질처럼 생긴 쫀득한"},{"start":407.092,"duration":1.02800000000002,"text":"겉에 껍질이 있거든요"},{"start":408.122,"duration":3.2679999999999723,"text":"이런 감자 좋아하시는 분들은 진짜 좋아하실 것 같아요"},{"start":411.392,"duration":2.598000000000013,"text":"저 감자 너무 좋아하거든요"},{"start":413.992,"duration":1.8979999999999677,"text":"고기도 먹어볼래"},{"start":417.4,"duration":1.7300000000000182,"text":"안심이라고 쓰여있던데?"},{"start":424.77,"duration":1.900000000000034,"text":"후추랑 소금이 굉장히 세거든요?"},{"start":426.672,"duration":1.967999999999961,"text":"고기는 엄청 짭짤해서"},{"start":428.642,"duration":1.3280000000000314,"text":"오히려 맥주랑 먹기 딱 좋고"},{"start":430.3,"duration":2.0399999999999636,"text":"감자는 원래 간이..."},{"start":432.342,"duration":1.608000000000004,"text":"안이 간이 안 되어있잖아요"},{"start":433.952,"duration":2.4979999999999905,"text":"그니까 감자는 오히려 간이 딱 좋아요"},{"start":438.12,"duration":0.8000000000000114,"text":"와..."},{"start":438.922,"duration":1.9279999999999973,"text":"나 지금 여기만 보고 있어서 몰랐어"},{"start":440.852,"duration":3.298000000000002,"text":"전혀 몰랐는데 금방 손님이 꽉 찼어요"},{"start":444.152,"duration":1.198000000000036,"text":"지금 완전 만석이에요"},{"start":445.95,"duration":1,"text":"대박이다"},{"start":449.53,"duration":1.9300000000000068,"text":"지금 순위...!"},{"start":451.462,"duration":1.268000000000029,"text":"1등"},{"start":452.73199999999997,"duration":2.0680000000000405,"text":"제가 감자 워낙 킬러라서"},{"start":454.802,"duration":1.467999999999961,"text":"소고기감자볶음이 1등이고"},{"start":456.272,"duration":0.9680000000000177,"text":"2등"},{"start":457.242,"duration":4.627999999999986,"text":"맛조개는 진짜 소스가 너무 맛있어"},{"start":468.21,"duration":2.4399999999999977,"text":"한국인분들 중에 짠 거 못 드시는 분들은"},{"start":470.652,"duration":1.698000000000036,"text":"'너무 짭짤한데?'라고 생각하실 수 있을 것 같아요"},{"start":472.352,"duration":4.138000000000034,"text":"저는 짠 걸 잘 먹어서 딱 저한테는 오히려 진짜"},{"start":476.492,"duration":1.5679999999999836,"text":"딱 맥주 마시기 좋은 간이거든요"},{"start":478.062,"duration":1.9279999999999973,"text":"맥주 한잔해야겠다"},{"start":479.992,"duration":1.8379999999999654,"text":"안주 장전"},{"start":491.2,"duration":3.5,"text":")"},{"start":494.702,"duration":0.9979999999999905,"text":"이게 무슨 일이야?"},{"start":496.91,"duration":2.329999999999984,"text":"어쩔 수 없죠 뭐, 젖은 상태로 먹겠습니다"},{"start":499.242,"duration":1.1379999999999768,"text":"날씨가 너무 좋거든요"},{"start":500.382,"duration":2.4279999999999973,"text":"지금 딱 날씨가 너무 좋아서 시원해요"},{"start":509.382,"duration":2.1680000000000064,"text":"무슨 얘기 하고 있었지?"},{"start":511.552,"duration":0.9379999999999882,"text":"맞아"},{"start":512.491,"duration":4.199000000000069,"text":"2등은 맛조개! 왜냐면 이 맛조개 진짜 커요"},{"start":516.692,"duration":4.5779999999999745,"text":"보이세요? 하나가 엄청 크죠?"},{"start":533.04,"duration":3.1399999999999864,"text":"조개 식감이 진짜 약간... 사각? 쫄깃?"},{"start":536.98,"duration":4.470000000000027,"text":"고기로 치면 항정살처럼 엄청 쫄깃거리는 식감에다가"},{"start":541.452,"duration":1.268000000000029,"text":"양념도"},{"start":542.722,"duration":1.7380000000000564,"text":"와 진짜 매운데 맛있어요"},{"start":561.47,"duration":2.0699999999999363,"text":"혀가 혹사되고 있는데 너무 맛있어"},{"start":578.19,"duration":1.5299999999999727,"text":"다른 것도 시키고 싶은데"},{"start":579.722,"duration":1.70799999999997,"text":"메뉴판 살짝 봐볼까?"},{"start":581.431,"duration":2.5289999999999964,"text":"여기 한국어로 쓰여있거든요"},{"start":583.962,"duration":2.298000000000002,"text":"한국인분들 많이 오셔서 만드셨나 봐요"},{"start":586.262,"duration":1.5680000000000973,"text":"그리고 솔직히 여기 메뉴에는 없는데"},{"start":587.832,"duration":2.038000000000011,"text":"저 궁금한 게 탕수육!"},{"start":589.872,"duration":2.3980000000000246,"text":"탕수육 비주얼이 너무 맛있어 보이는 거예요"},{"start":592.271,"duration":3.699000000000069,"text":"그리고 여기서 안 먹은"},{"start":595.972,"duration":4.168000000000006,"text":"바지락볶음도 하나 시킬게요"},{"start":645.99,"duration":2.740000000000009,"text":"뭐예요? 오돌뼈예요?"},{"start":648.732,"duration":1.59800000000007,"text":"가이드님 추천 메뉴"},{"start":653.73,"duration":0.4410000000000309,"text":"맛있다"},{"start":654.171,"duration":2.99899999999991,"text":"연골 그 오독오독한 오돌뼈 같기도 하고"},{"start":657.171,"duration":2.99899999999991,"text":"닭 연골 큰 거 먹는 느낌도 나고"},{"start":660.171,"duration":1.4689999999999372,"text":"하나만 더 먹어봐도 될까요?"},{"start":661.641,"duration":0.9990000000000236,"text":"이거 맛있다"},{"start":663.1,"duration":1,"text":"감사합니다"},{"start":668.71,"duration":3.1399999999999864,"text":"마라 향이"},{"start":671.852,"duration":2.3980000000000246,"text":"닭연골튀김 마라 향이 너무 좋아"},{"start":674.252,"duration":1.2030000000000882,"text":"짭짤한 거 좋아하고"},{"start":675.457,"duration":2.102999999999952,"text":"마라 진짜 좋아하시는 분들한테 추천해 드려요"},{"start":677.561,"duration":1.7989999999999782,"text":"그럼 메뉴 이름을 알아야 추천을 드리지"},{"start":679.362,"duration":1.6280000000000427,"text":"메뉴 이름이 뭐예요?"},{"start":680.992,"duration":1.768000000000029,"text":"까이 윳 권"},{"start":682.762,"duration":1.9980000000000473,"text":"까이 윳 권이라는 메뉴인데..."},{"start":686.962,"duration":2.038000000000011,"text":"그런 이름이라고 합니다"},{"start":689.002,"duration":1.9980000000000473,"text":"하나만 더 훔쳐 와야지"},{"start":704.28,"duration":1.9400000000000546,"text":"제 입맛에는 진짜 맛집이에요"},{"start":706.222,"duration":3.798000000000002,"text":"많이 보신 분들은 아시겠지만 저는"},{"start":710.021,"duration":2.939000000000078,"text":"짜고 자극적이고 감칠맛 많이 나고"},{"start":712.962,"duration":3.0979999999999563,"text":"아무래도 음식을 많이 먹다 보니까 그런 걸 좋아하게 돼서"},{"start":716.35,"duration":1.6100000000000136,"text":"홍콩 와서 먹어본 홍콩 음식 중에서"},{"start":717.962,"duration":1.9980000000000473,"text":"여기가 제일 맛있어요"},{"start":720.4,"duration":2.0299999999999727,"text":"바지락볶음 먼저 나왔으니까 먼저 먹어볼게요"},{"start":722.431,"duration":1.9389999999999645,"text":"바지락이 일단 굉장히 큼직합니다"},{"start":729.91,"duration":1.4300000000000637,"text":"맛조개랑 비슷한 소스네!"},{"start":731.342,"duration":2.368000000000052,"text":"근데 바지락은 좀 덜 매운 것 같은데? 맛있다"},{"start":735.41,"duration":1.4700000000000273,"text":"한마디로 정리하자면"},{"start":736.882,"duration":1.1380000000000337,"text":"굴소스"},{"start":738.021,"duration":2.229000000000042,"text":"불 향 엄청 많이 입힌 짜장에다가"},{"start":740.252,"duration":2.6980000000000928,"text":"후추를 진짜 많이 넣고 얼얼하게 만들어서"},{"start":742.952,"duration":1.20799999999997,"text":"피망을 이렇게 볶은..."},{"start":744.1610000000001,"duration":2.158999999999992,"text":"딱 그런 맛이에요"},{"start":748.85,"duration":1,"text":"마지막"},{"start":750.63,"duration":1.330000000000041,"text":"탕수육인데"},{"start":751.962,"duration":2.1680000000000064,"text":"때깔 진짜 맛있어 보이죠"},{"start":754.132,"duration":2.6980000000000928,"text":"색깔부터가 한국식이랑 다른 탕수육이에요"},{"start":756.832,"duration":1.3379999999999654,"text":"생긴 거는 비슷해요"},{"start":758.171,"duration":2.5289999999999964,"text":"튀김옷이나 이런 거는"},{"start":766,"duration":2.480000000000018,"text":"내가 생각한 식감이 전혀 아닌데?"},{"start":772.62,"duration":1.4700000000000273,"text":"얘는 또 맞네?"},{"start":774.092,"duration":1.95799999999997,"text":"비계가 있고 살코기가 있어요"},{"start":776.051,"duration":1.0989999999999327,"text":"둘이 식감이 완전 달라요"},{"start":777.151,"duration":1.469000000000051,"text":"비계 부분은 먹으면은"},{"start":778.622,"duration":4.138000000000034,"text":"약간 수비드 한 진짜 부드러운 항정살 먹는 식감이 나고요"},{"start":782.762,"duration":1.1280000000000427,"text":"살코기 부분 먹으면은"},{"start":783.891,"duration":1.969000000000051,"text":"우리가 아는 그 맛있는 살코기 식감이 나고"},{"start":786.5,"duration":2.169999999999959,"text":"탕수육 반 자른 거 보시면요"},{"start":788.671,"duration":2.5289999999999964,"text":"여기 반이 살코기고 여기 반이 비계예요"},{"start":791.202,"duration":1.2480000000000473,"text":"얘는 반반이에요"},{"start":792.452,"duration":0.9980000000000473,"text":"이런 애가 맛있어요"},{"start":797.64,"duration":3.509999999999991,"text":"와 여기는 웬만한 음식 다 맛있을 것 같은데?"},{"start":801.151,"duration":1.7590000000000146,"text":"다 먹어보고 싶다"},{"start":802.9110000000001,"duration":2.338999999999942,"text":"저기 포장마차..."},{"start":805.252,"duration":1.5680000000000973,"text":"요리하시는데 분위기가 진짜 장난 아니시더라고요"},{"start":806.822,"duration":1.5979999999999563,"text":"한번 가볼까...?"},{"start":811.89,"duration":2.240000000000009,"text":"- - 호우 호우 쉑"},{"start":814.132,"duration":1.9980000000000473,"text":"요리를 1분도 안 돼서 다 하시는 것 같아요"},{"start":816.132,"duration":3.1980000000000928,"text":"손이 엄청 빠르세요, 대박이다..."},{"start":819.332,"duration":3.967999999999961,"text":"여기서 어떤 걸 사람들이 많이 시키는지 슬쩍 본 다음에"},{"start":823.301,"duration":1.63900000000001,"text":"다음 거를 주문하는 거예요"},{"start":825.7,"duration":1.0699999999999363,"text":"저거 뭐야? 갯가재...?"},{"start":827,"duration":1.0499999999999545,"text":"갯가재네"},{"start":829.05,"duration":2.650000000000091,"text":"근데 갯가재를 살아있는 걸 쓰신다"},{"start":831.702,"duration":2.2380000000000564,"text":"이렇게 살아있는 식재료도 많고"},{"start":835.5,"duration":1.8999999999999773,"text":"이런 게 홍콩 음식이구나"},{"start":837.72,"duration":4.600000000000023,"text":"분위기가 진짜 딱 로컬 분위기라서 재밌습니다!"},{"start":842.322,"duration":2.298000000000002,"text":"맛조개 나머지 하나 먹고"},{"start":857.43,"duration":1.9700000000000273,"text":"바지락볶음 금방 먹지!"},{"start":872.521,"duration":1.8290000000000646,"text":"몇 그릇이나 먹을 수 있어요?"},{"start":874.352,"duration":1.5679999999999836,"text":"10접시는 가능할 것 같아요ㅎ"},{"start":875.921,"duration":0.6289999999999054,"text":"와"},{"start":886.55,"duration":1,"text":"맛있어"},{"start":895.65,"duration":1,"text":"너무 맛있어"},{"start":900.64,"duration":0.6699999999999591,"text":"다음!"},{"start":901.311,"duration":4.4389999999999645,"text":"아까 노란 소스가 올려진 새우가 제일 많이 나갔거든요?"},{"start":905.752,"duration":2.59800000000007,"text":"이걸 한번 시켜보겠습니다"},{"start":913.362,"duration":1.0679999999999836,"text":"소화가 빨라요ㅎ"},{"start":922.301,"duration":7.9389999999999645,"text":"다음 요리도 너무 기대되는데?"},{"start":965.801,"duration":2.0190000000000055,"text":"이건 되게 특이하다"},{"start":967.822,"duration":3.8279999999999745,"text":"노란색 이게 뭐지?"},{"start":971.651,"duration":3.2390000000000327,"text":"노란 색깔 소스를 같이 올려서"},{"start":982.79,"duration":2.5400000000000773,"text":"이게 약간 호불호가 많이 갈리는 것 같아요, 좀"},{"start":985.332,"duration":1.4980000000000473,"text":"식감이 특이해요"},{"start":986.832,"duration":3.1680000000000064,"text":"노른자를 진흙이랑 섞어서"},{"start":990.002,"duration":4.268000000000029,"text":"뭉쳐서 뭔가 소스를 만든 그런 식감이거든요"},{"start":994.271,"duration":2.299000000000092,"text":"식감 자체는 호가 아닌데"},{"start":996.572,"duration":3.70799999999997,"text":"개인적으로 노른자의 그 고소함이 맛있어요"},{"start":1005.122,"duration":1.3980000000000246,"text":"근데 여기가"},{"start":1006.521,"duration":3.4290000000000873,"text":"이 소스로 안 먹더라도 새우 요리는 필수일 것 같아요"},{"start":1009.952,"duration":4.067999999999984,"text":"탱글탱글하게 진짜 맛있는 대왕 새우거든요"},{"start":1023.6,"duration":1.0500000000000682,"text":"새우를 다 까버리자"},{"start":1026.2,"duration":1.349999999999909,"text":"새우가 엄청 잘 까져요"},{"start":1028.7,"duration":1.4500000000000455,"text":"맛있게 다 깠습니다"},{"start":1042.59,"duration":3.300000000000182,"text":"다음 뭐 먹을지 슬슬 이제 정해야 되는데"},{"start":1046.21,"duration":1.6499999999998636,"text":"볶음밥을 먹어보긴 해야겠다"},{"start":1047.861,"duration":1.5289999999999964,"text":"양저우볶음밥"},{"start":1049.392,"duration":2.467999999999847,"text":"굴튀김도 맛있어 보이던데"},{"start":1051.861,"duration":1.6989999999998417,"text":"저 아가씨 혼자 8접시째 주문이야"},{"start":1053.562,"duration":2.3079999999999927,"text":"- 에이 말도 안 돼, 뻥치지 마 - 진짜라니까, 함 봐봐 ㄱㄱ"},{"start":1055.871,"duration":2.5989999999999327,"text":"혼자서 어떻게 이렇게 많이 먹을 수 있죠?"},{"start":1058.472,"duration":1.7980000000000018,"text":"제가 이 바닥에 오래 있었지만"},{"start":1060.272,"duration":2.66800000000012,"text":"이렇게 많이 먹는 사람은 처음...!"},{"start":1065.552,"duration":0.9980000000000473,"text":"굴튀김"},{"start":1072.45,"duration":2.099999999999909,"text":"굴 맛이 생각보다 많이 안 나는데?"},{"start":1075.62,"duration":2.1000000000001364,"text":"엄청 작은 굴이에요"},{"start":1077.722,"duration":1.7380000000000564,"text":"그래서 굴 맛이 덜 느껴지나...?"},{"start":1100.375,"duration":1.8350000000000364,"text":"이게 나오자마자 냄새가"},{"start":1102.212,"duration":2.66800000000012,"text":"이거 진짜 완벽한 삼계탕 냄샌데?"},{"start":1104.882,"duration":2.6979999999998654,"text":"양이 3~4공기 정도 되는 것 같아요"},{"start":1107.581,"duration":0.9090000000001055,"text":"원래 이렇게 많아...?"},{"start":1116.32,"duration":2.7100000000000364,"text":"약간 날아다니는 밥에다가"},{"start":1124.03,"duration":4.279999999999973,"text":"삼계탕 그 특유의 인삼 냄새 같은 게 많이 나잖아요"},{"start":1128.312,"duration":1.828000000000202,"text":"그 냄새랑 맛이 여기서 나요"},{"start":1143.42,"duration":5.039999999999964,"text":"약간 슴슴하게 먹는 거 좋아하시면 그냥 드셔도 좋을 것 같고"},{"start":1148.462,"duration":3.897999999999911,"text":"간이 맞으려면 이런 소스류랑 같이 먹어도 좋을 것 같아요"},{"start":1152.361,"duration":1.5389999999999873,"text":"감자볶음이나"},{"start":1156.7,"duration":2.5,"text":"- 이거 밥에 조금 비벼 먹어도 맛있대 - 뭐예요?"},{"start":1159.202,"duration":1.4980000000000473,"text":"고추기름!"},{"start":1161.1,"duration":1.650000000000091,"text":"조금만 먹어봐"},{"start":1162.752,"duration":2.0879999999999654,"text":"고추기름인데 밥에 조금 뿌려 먹으면 맛있대요"},{"start":1168.45,"duration":1.099999999999909,"text":"처음에 살짝만"},{"start":1170.7,"duration":2.7200000000000273,"text":"매워"},{"start":1175.42,"duration":2.369999999999891,"text":"혀가 완전 얼얼해..."},{"start":1177.792,"duration":3.6980000000000928,"text":"저거 잠깐 뿌린다고 진짜 매운 볶음... 와..."},{"start":1181.75,"duration":1,"text":"매워"},{"start":1230.41,"duration":2.9700000000000273,"text":"안에 엄청 큰 새우가 들어가 있는데 진짜 탱글하다"},{"start":1233.382,"duration":2.6979999999998654,"text":"아가씨 그러다 배 터져요, 그만 먹어"},{"start":1237.51,"duration":2.1700000000000728,"text":"아직 괜찮습니다...!"},{"start":1253.06,"duration":3.3700000000001182,"text":"제가 남은 것보다 먹은 게 훨씬 많아요"},{"start":1256.432,"duration":2.1679999999998927,"text":"어떤 메뉴냐면요, 혼자서 못 먹고요"},{"start":1258.601,"duration":2.438999999999851,"text":"여러 명이서 드시는 테이블당 하나 시켜서"},{"start":1261.042,"duration":3.6980000000000928,"text":"앞접시에 떠먹는 그런 볶음밥용이라"},{"start":1264.742,"duration":2.5979999999999563,"text":"양이 진짜 5공기 정도는 들어가 있는 것 같아요"},{"start":1314.63,"duration":1.9299999999998363,"text":"마지막 남은 새우!"},{"start":1336.91,"duration":3.0699999999999363,"text":"혼자서 8그릇 먹었으니까 몸 안에 최소 8명 있는 듯 ㅇㅇ"},{"start":1339.982,"duration":2.2080000000000837,"text":"아님 그 이상이거나...?ㅎ"},{"start":1342.192,"duration":4.7280000000000655,"text":"일단 여기가 제가 처음에 오기 전에 걱정을 했던 게"},{"start":1346.922,"duration":2.13799999999992,"text":"리뷰가 정말 호불호가 많이 갈렸거든요"},{"start":1349.26,"duration":1.2999999999999545,"text":"제가 먹어본 바로는"},{"start":1350.562,"duration":2.66800000000012,"text":"간을 세게 안 드시는 분들이 드시기에는"},{"start":1353.232,"duration":2.3379999999999654,"text":"조금 어렵지 않을까 싶고"},{"start":1355.5720000000001,"duration":5.097999999999956,"text":"평소에 자극적이고 맵고 짭짤한 음식을 즐겨 드신다"},{"start":1360.672,"duration":1.3979999999999109,"text":"하시면은 정말"},{"start":1362.0720000000001,"duration":3.367999999999938,"text":"누구나 맛있게 먹을 수 있을 만한 요리라고 생각을 하면서 먹었어요"},{"start":1365.442,"duration":3.2380000000000564,"text":"저는 너무 맛있게 먹었어요"},{"start":1368.682,"duration":4.167999999999893,"text":"오늘도 잘 먹었습니다~!"},{"start":1380.591,"duration":1.3090000000001965,"text":"딤섬집에 왔어요"},{"start":1381.902,"duration":2.9479999999998654,"text":"호텔에 있는 식당처럼 되게 고급스럽게 되어있어요"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
