t":83.583,"duration":2.503,"text":"- 너무 재밌게 봤거든요 - 감사합니다"},{"start":86.086,"duration":2.2349999999999994,"text":"쯔양 님 실물도 너무 예쁘고 왜소하신데..."},{"start":88.321,"duration":0.8670000000000044,"text":"감사합니다"},{"start":89.189,"duration":1.9350000000000023,"text":"운동하시면 안 된다고..."},{"start":91.124,"duration":2.0020000000000095,"text":"- 살찌고 막 이래서... - 오 어떻게 아셨어요"},{"start":93.126,"duration":3.5019999999999953,"text":"부럽다, 나도 많이 먹고 살이 좀 안 쪘으면 좋겠는데"},{"start":96.63,"duration":1.266999999999996,"text":"아 먹는 걸 좋아하세요?"},{"start":97.89699999999999,"duration":0.8680000000000092,"text":"아잇... 먹는 걸"},{"start":98.765,"duration":2.9339999999999975,"text":"- 너무 좋아하니까 요리를 하는 것 같기도 하고... - 아 정말요?"},{"start":101.701,"duration":2.102000000000004,"text":"근데 지금 너무 마르셨어요..."},{"start":103.803,"duration":2.236000000000004,"text":"힘주고 있습니다"},{"start":106.039,"duration":1.4009999999999962,"text":"모태마름"},{"start":107.441,"duration":1.9350000000000023,"text":"난 페이크마름"},{"start":109.37700000000001,"duration":2.1669999999999874,"text":"'피자헛' 많이 먹어봤지만"},{"start":111.545,"duration":2.635000000000005,"text":"셰프님이 해주신다고 하니까 너무 기대가..."},{"start":114.18,"duration":0.799999999999983,"text":"기대해도 되나요?"},{"start":114.981,"duration":2.169000000000011,"text":"- 물론이죠, 기대하셔도 좋습니다 - 정말요?"},{"start":117.15100000000001,"duration":1.9679999999999893,"text":"- 얼마나... 얼마나 맛있길래... - 피자 정말 열심히 만들었습니다"},{"start":119.119,"duration":1.7680000000000007,"text":"배고프시죠?"},{"start":120.887,"duration":2.135000000000005,"text":"얼른 준비해 드릴게요"},{"start":188.796,"duration":0.592000000000013,"text":"감사합니다"},{"start":189.389,"duration":1.667999999999978,"text":"우와 피자 같지가 않은데?"},{"start":191.057,"duration":2.8360000000000127,"text":"아 씬 피자구나"},{"start":193.893,"duration":2.4029999999999916,"text":"진짜 피자가 아니라 요리 같아요..."},{"start":196.296,"duration":1.5670000000000073,"text":"배고프실 테니 얼른 먼저 드시고 계세요~"},{"start":197.864,"duration":1.6680000000000064,"text":"- 진짜 너무 감사합니다, 잘 먹겠습니다 - 맛있게 드십쇼"},{"start":199.532,"duration":2.469999999999999,"text":"고수 있는 거 없는 거 선택할 수 있대요"},{"start":202.002,"duration":2.501999999999981,"text":"둘 다 씬이고, 얘는 두꺼운 도우인데"},{"start":204.505,"duration":2.100999999999999,"text":"일단 비주얼이 피자랑 좀 달라요"},{"start":206.606,"duration":1.100999999999999,"text":"셰프님!"},{"start":207.707,"duration":0.6229999999999905,"text":"혹시 이거 셋 중에"},{"start":208.332,"duration":1.5109999999999957,"text":"뭐부터 먹어야 될까요?"},{"start":209.843,"duration":2.569000000000017,"text":"1. 새우 2. 풀드포크 3. 비프"},{"start":212.412,"duration":2.768999999999977,"text":"- 이렇게 순서로 드시면 좋을 거 같아요 - 알겠습니다"},{"start":215.18099999999998,"duration":1.1680000000000064,"text":"새우를 먼저"},{"start":216.349,"duration":1.2680000000000007,"text":"너무 기대되는데?"},{"start":218.018,"duration":1.3010000000000161,"text":"보이세요? 여기 접혔어요"},{"start":219.31900000000002,"duration":1.0339999999999918,"text":"엄청 바삭해요"},{"start":230.563,"duration":2.3029999999999973,"text":"내가 알던 피자가 아니야!!!"},{"start":232.867,"duration":1.3670000000000186,"text":"우와 이거 진짜 맛있다!"},{"start":238.772,"duration":2.3329999999999984,"text":"흔한 피자 맛이 아니라"},{"start":241.107,"duration":1.6999999999999886,"text":"진짜 완전 특색 있고"},{"start":242.809,"duration":1.3010000000000161,"text":"소스 진짜 맛있다!"},{"start":244.11,"duration":3.269999999999982,"text":"새우도 완전 통으로 들어가 있거든요?"},{"start":247.38,"duration":0.7669999999999959,"text":"먹어볼게요"},{"start":264.898,"duration":1.967999999999961,"text":"얘는 풀드포크예요 소스가 달라요"},{"start":277.343,"duration":2.4669999999999845,"text":"이태원 바비큐 바 가서 먹는"},{"start":279.812,"duration":1.7339999999999804,"text":"진짜 그 풀드포크 맛이에요..."},{"start":281.548,"duration":2.3349999999999795,"text":"소리 들리세요? 진짜 바삭한 거?"},{"start":292.492,"duration":1.3340000000000032,"text":"근데 진짜 찢었다"},{"start":294.928,"duration":2.73599999999999,"text":"마지막 비프까지 맛있으면 진짜 끝났다"},{"start":303.937,"duration":1.3319999999999936,"text":"제가..."},{"start":305.271,"duration":2.73599999999999,"text":"여태까지 많은 컬래버 제품을 먹어봤잖아요"},{"start":308.007,"duration":2.401999999999987,"text":"컬래버 부분 1등"},{"start":318.51800000000003,"duration":3.402999999999963,"text":"어떻게 입맛에... 맞으세요?"},{"start":321.921,"duration":1.9669999999999845,"text":"오우 소스가 특히나 너무 맛있어요!"},{"start":323.89,"duration":1.7019999999999982,"text":"다행이네요... 성공!"},{"start":325.592,"duration":1.5339999999999918,"text":"저는... 새우가 1등!"},{"start":327.126,"duration":1.6350000000000477,"text":"새우가 1등?"},{"start":328.761,"duration":1.7689999999999486,"text":"엇! 식사 안 하셨나요 혹시?"},{"start":330.531,"duration":0.9309999999999832,"text":"네 저도 아직입니다...!"},{"start":331.464,"duration":2.266999999999996,"text":"아 그래요? 그럼 이거 좀 같이..."},{"start":333.733,"duration":1.700999999999965,"text":"요거까지만 먹고"},{"start":335.435,"duration":1.9350000000000023,"text":"빠르게 먹겠습니다"},{"start":358.725,"duration":1.200999999999965,"text":"식감이 너무 좋아"},{"start":371.838,"duration":2.8559999999999945,"text":"새우가 진짜 맛있었던 이유가 안에 고구마무스가 들었네"},{"start":374.695,"duration":2.348000000000013,"text":"이거 진짜 잘 어울려요, 소스랑 너무 잘 어울려"},{"start":387.754,"duration":0.9009999999999536,"text":"맛있어"},{"start":392.759,"duration":2.834000000000003,"text":"씬 도우가 바삭한 페스츄리 파이처럼"},{"start":395.595,"duration":1.7999999999999545,"text":"이게 윗쪽은 되게 촉촉한데"},{"start":397.397,"duration":1.9019999999999868,"text":"아래쪽은 되게 바삭하니까..."},{"start":404.904,"duration":2.8700000000000045,"text":"이게 다른 씬 피자도 도우가 이래요?"},{"start":407.774,"duration":1.6680000000000064,"text":"허어...! 되게 맛있다"},{"start":409.442,"duration":1.968999999999994,"text":"'피자헛' 씬 피자가 맛있었네!"},{"start":411.411,"duration":3.569999999999993,"text":"몰랐어요, 앞으로 피자 먹을 때 씬 피자 먹어야겠다"},{"start":425.525,"duration":0.7669999999999959,"text":"아 이거..."},{"start":426.293,"duration":2.5679999999999836,"text":"부스러기 주워 먹게 되는데...?"},{"start":428.861,"duration":1.73599999999999,"text":"셰프님~!"},{"start":430.597,"duration":2.701999999999998,"text":"- 네~!!! - 같이 좀 드세요! 식사 안 하셨다고 하셔서..."},{"start":433.3,"duration":4.002999999999986,"text":"네! 저도 이제 배고프니까 같이 한입 하실까요?"},{"start":437.304,"duration":1.2000000000000455,"text":"제가 솔직히..."},{"start":438.505,"duration":1.4680000000000177,"text":"기대는 했지만..."},{"start":439.973,"duration":1.4989999999999668,"text":"'피자가 맛있어 봤자 피자지...'"},{"start":441.473,"duration":2.3029999999999973,"text":"- 요런 생각이 살짝 있었는데 - 그렇죠 그렇죠"},{"start":443.776,"duration":0.9669999999999845,"text":"진짜 맛있게 먹었어요!"},{"start":444.744,"duration":1.5679999999999836,"text":"좀 깜짝 놀랐어요! 먹고!"},{"start":446.312,"duration":1.6689999999999827,"text":"소스도 너무 맛있고"},{"start":447.98199999999997,"duration":3.0020000000000095,"text":"씬 도우랑 조화가 너무 좋더라고요"},{"start":450.984,"duration":3.0030000000000427,"text":"맨 처음에 이제 메뉴 개발하고 할 때"},{"start":453.987,"duration":1.9350000000000023,"text":"피자를 한..."},{"start":455.922,"duration":3.169999999999959,"text":"스물네 가지 종류를 사주시더라고요"},{"start":459.092,"duration":3.8029999999999973,"text":"스물네 가지를 드신 거예요?!"},{"start":462.895,"duration":3.1370000000000005,"text":"배달 음식을 내가 뭐를 어떻게 할 수 있지?"},{"start":466.033,"duration":3.034999999999968,"text":"그런 고민이 좀 엄청 있었는데"},{"start":469.068,"duration":0.8340000000000032,"text":"아 그러면..."},{"start":469.902,"duration":1.5680000000000405,"text":"저... 뉴욕에서"},{"start":471.471,"duration":2.9700000000000273,"text":"스태프 밀로 만들어서 먹었던 메뉴를"},{"start":474.442,"duration":1.2989999999999782,"text":"피자로 구현하고 싶다...!"},{"start":475.742,"duration":2.100999999999999,"text":"- 스태프 밀이 직원들끼리 먹었던 식사죠? - 예예예!"},{"start":477.844,"duration":2.4350000000000023,"text":"레스토랑은 일의 강도가 좀 세고..."},{"start":480.279,"duration":1.968999999999994,"text":"아침 10시에 출근하면"},{"start":482.249,"duration":2.2999999999999545,"text":"새벽 1~2시에 퇴근을 하거든요...?"},{"start":484.55,"duration":2.1359999999999673,"text":"하루에 한 끼를 먹어요..."},{"start":486.686,"duration":2.0670000000000073,"text":"그래서 그 한 끼를 되게..."},{"start":488.755,"duration":2.1000000000000227,"text":"맛있게 먹어야 되고..."},{"start":490.85699999999997,"duration":1.6680000000000064,"text":"맛이 없게 만들면"},{"start":492.525,"duration":2.5,"text":"귀에서 막 피가 나고, 이럴 정도여서"},{"start":495.028,"duration":3.2029999999999745,"text":"그럼 그 쓰리스타 식당에서...!"},{"start":498.23199999999997,"duration":3.736000000000047,"text":"- 모두가 만족하면서 먹었던 그 맛인 거잖아요! - 네 맞아요"},{"start":501.968,"duration":1.5679999999999836,"text":"- 그거를 이제! - 그래서 맛있구나"},{"start":503.536,"duration":1.3340000000000032,"text":"- 그래서 이렇게 맛있구나!!! - 피자의 맛으로"},{"start":504.871,"duration":1.266999999999996,"text":"혹시 무슨 맛 제일 좋아하시나요?"},{"start":506.139,"duration":1.6680000000000064,"text":"- 1등 - 어... 1등...?"},{"start":507.808,"duration":2.3009999999999877,"text":"- 아 저도 약간 새우인 것 같아요! - 아 그래요?"},{"start":510.109,"duration":1.3010000000000446,"text":"새우, 풀드포크..."},{"start":511.644,"duration":1.467999999999961,"text":"근데 다 맛있긴 해요"},{"start":513.313,"duration":0.6340000000000146,"text":"여기요"},{"start":514.7139999999999,"duration":2.703000000000088,"text":"- 잘 먹겠습니다! - 두꺼운 도우도 궁금하긴 하다!!!"},{"start":517.418,"duration":2.467999999999961,"text":"- 네! 얘도 되게 바삭하고 - 네 맞아요"},{"start":519.886,"duration":2.035000000000082,"text":"만들 때 살짝 눌러서..."},{"start":521.921,"duration":0.6009999999999991,"text":"왜냐하면"},{"start":522.523,"duration":1.399000000000001,"text":"씬 도우를 안 좋아하신는 분이"},{"start":523.923,"duration":1.768000000000029,"text":"- 있을 수도 있으니까... - 맞아요 맞아요"},{"start":534.868,"duration":2.300999999999931,"text":"어? 이것도 맛있는데요?"},{"start":537.17,"duration":3.6030000000000655,"text":"SFO 도우라고, 발효해서 만든 건데"},{"start":540.773,"duration":2.0359999999999445,"text":"얘도 굉장히 맛있습니다"},{"start":548.682,"duration":1.7289999999999281,"text":"담백한 도우가 너무 맛있는 거 같아요"},{"start":560.093,"duration":1.7350000000000136,"text":"오늘 첫 끼이신 거예요?"},{"start":561.829,"duration":1.1990000000000691,"text":"네...!"},{"start":563.029,"duration":3.036000000000058,"text":"어쩐지, 저보다 빨리 드셨어요"},{"start":566.066,"duration":1.33299999999997,"text":"근데!"},{"start":567.4,"duration":1.4010000000000673,"text":"씬 피자가 더 맛있긴 한데"},{"start":568.802,"duration":1.5339999999999918,"text":"얘도 맛있긴 해요!"},{"start":570.337,"duration":2.433999999999969,"text":"얘는 이 두꺼운 도우가 더 맛있어요!"},{"start":572.772,"duration":1.4669999999999845,"text":"- 비프가? - 네 비프가!"},{"start":574.24,"duration":4.5049999999999955,"text":"이 도우를 뭐를 발라서 굽느냐에 따라서"},{"start":578.746,"duration":2,"text":"맛이 달라지더라고요"},{"start":580.747,"duration":2.1680000000000064,"text":"뭐 브랜드마다 다를 순 있겠지만"},{"start":582.9159999999999,"duration":2.5680000000000973,"text":"이 쌀가루를 묻혀서 하니까..."},{"start":585.485,"duration":4.504000000000019,"text":"좀 바삭하고 고소한 맛이 있어서 맛있더라고요"},{"start":592.259,"duration":0.8990000000000009,"text":"하나 더 먹어도 되나요?"},{"start":593.159,"duration":1.0339999999999918,"text":"당연하죠"},{"start":594.76,"duration":2.8700000000000045,"text":"쯔양 님 위해서 넉넉히 준비했으니까"},{"start":597.63,"duration":1.1340000000000146,"text":"감사합니다"},{"start":603.77,"duration":1.4350000000000591,"text":"이게 장점이..."},{"start":605.206,"duration":0.9650000000000318,"text":"같은 거 먹으면 질리는데"},{"start":606.172,"duration":1.7350000000000136,"text":"이렇게 세 가지 맛이어서 너무 좋은 것 같아요"},{"start":607.908,"duration":1.16599999999994,"text":"미국 같은 경우에는..."},{"start":609.075,"duration":3.703999999999951,"text":"알레르기가... 항상 많아서"},{"start":612.78,"duration":0.6660000000000537,"text":"뭐를 하든"},{"start":613.447,"duration":1.9669999999999845,"text":"세 가지는 다 조금씩은 가지고 있어야 해요!"},{"start":615.415,"duration":2.1680000000000064,"text":"그래서 한 판에 세 가지 맛을"},{"start":617.583,"duration":2.8360000000000127,"text":"즐기실 수 있게 준비해 봤습니다"},{"start":620.42,"duration":1.2000000000000455,"text":"딱 좋은 것 같아요"},{"start":621.621,"duration":2.8700000000000045,"text":"원래 저의 킥이 여기에..."},{"start":624.492,"duration":1.6000000000000227,"text":"고수를 넣어서 먹는 건데"},{"start":626.092,"duration":1.8350000000000364,"text":"고수가 있더라고요"},{"start":627.927,"duration":2.73599999999999,"text":"쯔양 님이 고수를 못 드신다고 하니까"},{"start":630.663,"duration":2.90300000000002,"text":"이거는 저희끼리 따로 먹고"},{"start":633.567,"duration":2.6019999999999754,"text":"고수 없이 따로 준비해 드려서"},{"start":636.17,"duration":2.100999999999999,"text":"- 저는 뿌려서 먹도록 할게요 - 좋아요"},{"start":638.272,"duration":1.33299999999997,"text":"저도...!"},{"start":639.606,"duration":2.634999999999991,"text":"- 1개만 뿌려 먹어볼게요! - 1개만? 그럼요!"},{"start":642.242,"duration":1.3010000000000446,"text":"여기 페퍼로니가..."},{"start":643.544,"duration":3.73599999999999,"text":"아까 왜 못 봤지?"},{"start":647.281,"duration":1.5670000000000073,"text":"다 들어있어요!"},{"start":648.848,"duration":3.1700000000000728,"text":"아까는 없었던 것 같은데...? 아닌가?"},{"start":652.019,"duration":1.4669999999999845,"text":"미국 전통 페퍼로니"},{"start":653.487,"duration":2.368000000000052,"text":"생각보다 되게 좋은 재료들을 많이 쓰더라고요"},{"start":657.123,"duration":1.5339999999999918,"text":"아까 실수로 안 넣으신 거 아니에요?"},{"start":658.658,"duration":1.8009999999999309,"text":"아까 페퍼로니 있었어요?"},{"start":660.46,"duration":0.9329999999999927,"text":"어...?"},{"start":661.394,"duration":2.134999999999991,"text":"제가 만들어서 있었어요"},{"start":663.53,"duration":2.1680000000000064,"text":"페퍼로니가 새우 쪽에만 들어가 있어요"},{"start":665.699,"duration":2.033999999999992,"text":"어? 새우 쪽에 페퍼로니가 있었나?"},{"start":667.734,"duration":1.3679999999999382,"text":"네, 제가 다 넣었어요"},{"start":669.103,"duration":0.8000000000000682,"text":"아 그래요?"},{"start":669.904,"duration":1.1330000000000382,"text":"안 빠졌다에!!!"},{"start":671.038,"duration":2.100999999999999,"text":"제 손 모두와 손가락을"},{"start":673.14,"duration":1.66700000000003,"text":"걸게요"},{"start":675.241,"duration":1.3669999999999618,"text":"그럼 안 빠진 걸로ㅎ"},{"start":676.609,"duration":1.0009999999999764,"text":"빠졌으면...!!!"},{"start":677.611,"duration":0.8990000000000009,"text":"연락 주십쇼...!!!"},{"start":678.511,"duration":2.636000000000081,"text":"제 손 한쪽 드리겠습니다"},{"start":681.148,"duration":1.8679999999999382,"text":"어떠세요? 약간..."},{"start":683.017,"duration":1.599999999999909,"text":"곧 출시되는데..."},{"start":684.618,"duration":3.335999999999899,"text":"뭐를 만들지 고민을 많이 하고"},{"start":687.955,"duration":2.7350000000000136,"text":"연습을 많이 하니까"},{"start":690.691,"duration":2.467999999999961,"text":"사실 경연 프로그램 할 때는 하나도 떨리지 않았고"},{"start":693.16,"duration":2.8350000000000364,"text":"저도 이름 걸고 하는 게"},{"start":695.996,"duration":2.634999999999991,"text":"또 컬래버는 처음이고 하다 보니까..."},{"start":698.632,"duration":0.9670000000000982,"text":"아 그래요?"},{"start":699.6,"duration":1.1999999999999318,"text":"반응 너무 좋을 것 같아요!"},{"start":700.801,"duration":3.6019999999999754,"text":"토마토소스도 이제 캘리포니아에서 재배된 거고..."},{"start":704.404,"duration":1.7000000000000455,"text":"그다음에 아까 그..."},{"start":706.105,"duration":0.9009999999999536,"text":"제가..."},{"start":707.007,"duration":1.8010000000000446,"text":"빠뜨리지 않았던!"},{"start":708.808,"duration":2.3029999999999973,"text":"페퍼로니 이것도 미국에서"},{"start":711.112,"duration":3.701999999999998,"text":"1935년대부터 만든 전통 스파이시"},{"start":714.814,"duration":1.8350000000000364,"text":"공장 재료들이 아니라"},{"start":716.65,"duration":1.5339999999999918,"text":"다 제대로 공수해 온 재료들이네요?"},{"start":718.185,"duration":1.5340000000001055,"text":"되게 좋은 재료들"},{"start":719.719,"duration":1.9689999999999372,"text":"뭐를 너무 많이 넣어서"},{"start":721.689,"duration":2.1680000000000064,"text":"관계자분들은 좀 안 좋아하시는 것 같기도 하고"},{"start":723.858,"duration":0.7650000000001,"text":"그래요?"},{"start":724.624,"duration":2.201999999999998,"text":"하지만 소비자분들에게는 좋은 거니까~"},{"start":726.827,"duration":3.534999999999968,"text":"포장 할인가 2만 7,900원이니까 안 비싸네"},{"start":730.363,"duration":2.034999999999968,"text":"빨리 한 판 더 구워서 올 테니까..."},{"start":732.399,"duration":1.768000000000029,"text":"식사 마저 하고 계세요!"},{"start":739.072,"duration":1.9009999999999536,"text":"풀드포크 왜 이렇게 많이 들어갔어?"},{"start":760.36,"duration":2.9700000000000273,"text":"매콤한 새우"},{"start":770.47,"duration":2.302000000000021,"text":"핫소스랑 너무 잘 어울려요 진짜!"},{"start":776.175,"duration":4.471000000000004,"text":"맛있어"},{"start":780.647,"duration":1.0329999999999018,"text":"와 나왔다!"},{"start":782.748,"duration":1.600999999999999,"text":"이번 거 더 맛있어 보여요"},{"start":784.617,"duration":1.8350000000000364,"text":"고수를 못 드신다고 해서"},{"start":787.453,"duration":1.5020000000000664,"text":"고수가 없는 버전으로"},{"start":788.956,"duration":1.8009999999999309,"text":"도전을 한번 해볼까...?"},{"start":790.758,"duration":0.7989999999999782,"text":"하나만 해볼까?"},{"start":791.557,"duration":1.3350000000000364,"text":"뭐랑 제일 잘 어울려요?"},{"start":792.893,"duration":2.2999999999999545,"text":"고수는 사실 다 잘 어울리긴 하는데"},{"start":795.194,"duration":2.73599999999999,"text":"그래도 새우를 제일 좋아하시니까..."},{"start":797.931,"duration":2.9349999999999454,"text":"- 새우에 조금 뿌려서... - 조금만 뿌려주실 수 있나요?"},{"start":800.867,"duration":1.1680000000000064,"text":"조금 더...?"},{"start":802.635,"duration":1.4010000000000673,"text":"많다"},{"start":804.037,"duration":1.9669999999999845,"text":"저는 고수 좋아하니까"},{"start":806.539,"duration":3.07000000000005,"text":"이 정도?"},{"start":813.179,"duration":3.136000000000081,"text":"넣은 게 훨씬 맛있으세요?"},{"start":816.316,"duration":1.5009999999999764,"text":"안 먹어볼 수 없지~!"},{"start":818.217,"duration":1.802000000000021,"text":"냄새는 아직까지 괜찮은데?"},{"start":820.02,"duration":1.33400000000006,"text":"- 도전! - 도전"},{"start":833.533,"duration":2.5019999999999527,"text":"여태까지 알던 고수의 맛이 아닌가요...?"},{"start":836.0360000000001,"duration":1.8679999999999382,"text":"쪼끔만 더 뿌려볼까요...?"},{"start":837.905,"duration":0.9660000000000082,"text":"쪼꿈..."},{"start":838.872,"duration":0.7990000000000919,"text":"쪽!... 쪽!!!"},{"start":839.672,"duration":2.06899999999996,"text":"쫍!!! 꾸움... 만..."},{"start":841.742,"duration":2.1340000000000146,"text":"고수 맛이 확! 올라오는 게 아니라"},{"start":843.877,"duration":5.238000000000056,"text":"다른 맛이랑 잘 섞이는 느낌이 있거든요?"},{"start":849.116,"duration":5.504000000000019,"text":"재도전"},{"start":854.621,"duration":0.8000000000000682,"text":"맛있죠?"},{"start":855.422,"duration":1.8009999999999309,"text":"- 맛있네용...? - 맛있죠?"},{"start":858.124,"duration":1.0679999999999836,"text":"음 되게..."},{"start":859.193,"duration":1.4329999999999927,"text":"향긋한뎅?..."},{"start":860.627,"duration":2.035000000000082,"text":"이거 고수 아니라 파슬리 아니에요?"},{"start":865.399,"duration":1.4660000000000082,"text":"거북하지 않아요"},{"start":866.866,"duration":1.3000000000000682,"text":"고수 못 먹는 사람"},{"start":868.167,"duration":2.302000000000021,"text":"여기 조금 얹어서 먹을 수 있을 것 같아요!"},{"start":870.47,"duration":2.701000000000022,"text":"최초로 고수를 드시게 한 거예요...!"},{"start":873.172,"duration":2.935999999999922,"text":"사실상... 못 먹는 고수를..."},{"start":876.109,"duration":2.033999999999992,"text":"먹게 하기는 쉽지 않은데..."},{"start":878.144,"duration":4.403999999999996,"text":"- 그 어려운 걸 제가 해냈네요 - 네ㅎㅎㅎ"},{"start":882.549,"duration":2.134999999999991,"text":"평소보다 좀 거북하지 않았고"},{"start":884.685,"duration":2.1340000000000146,"text":"그리고 몇 입 씹으니까 없어졌어요!"},{"start":886.82,"duration":4.036999999999921,"text":"저도 맨 처음에 고수를 안 먹어서..."},{"start":890.858,"duration":5.004000000000019,"text":"어떤 마음으로 고수를 안 드시는지 알고 있거든요!"},{"start":905.037,"duration":2.1019999999999754,"text":"피디님 굉장히 놀라시는데요...?"},{"start":907.139,"duration":1.5670000000000073,"text":"진짜 처음 보니까요"},{"start":908.707,"duration":0.8680000000000518,"text":"'이 사람이 고수를...?'"},{"start":909.576,"duration":4.236999999999966,"text":"- 저랑 식사를 몇백 번이 뭐야 - 그렇죠"},{"start":913.813,"duration":1.9350000000000591,"text":"몇천 번을 하셨을 텐데"},{"start":916.149,"duration":2.469000000000051,"text":"지금 여러분들은 세계 최초로 쯔양 님이"},{"start":918.619,"duration":3.201999999999998,"text":"고수를 자의로 드시는 모습을 보고 계십니다"},{"start":922.088,"duration":0.9680000000000746,"text":"저요? 저는 이제"},{"start":923.057,"duration":2.5,"text":"배가 좀 차서"},{"start":925.558,"duration":1.969000000000051,"text":"이게... 생각보다..."},{"start":927.528,"duration":0.7980000000000018,"text":"묵직하네요...!"},{"start":929.529,"duration":1.0670000000000073,"text":"감사합니다"},{"start":931.263,"duration":1.3679999999999382,"text":"제가 잘못 찍어 먹어서"},{"start":936.903,"duration":1.967999999999961,"text":"피디님이 되게 신기하신 거 같아"},{"start":939.505,"duration":2.6359999999999673,"text":"나 입맛이 바뀌고 있는 건가?"},{"start":948.347,"duration":0.8010000000000446,"text":"이상하다"},{"start":960.493,"duration":3.8700000000000045,"text":"따듯하게 드셔야 하니까"},{"start":964.364,"duration":2.2679999999999154,"text":"- 다시 데워드릴게요 - 감사합니다!"},{"start":966.633,"duration":2.367999999999938,"text":"- 데워 왔으니까 마저 맛있게 드십쇼 - 감사합니다"},{"start":970.603,"duration":1.1340000000000146,"text":"2개 헷갈릴 수 있는데"},{"start":971.738,"duration":1.5339999999999918,"text":"얘가 비프고, 얘가 풀드포크거든요?"},{"start":973.273,"duration":3.0359999999999445,"text":"제 취향으로만 따지면 비프가 좀 더 제 취향인데"},{"start":976.31,"duration":2.2340000000000373,"text":"달짝지근한"},{"start":978.545,"duration":1.7010000000000218,"text":"갈비 같은 맛이라..."},{"start":980.247,"duration":2.634999999999991,"text":"근데 풀드포크가 좀 확실히"},{"start":982.883,"duration":1.66599999999994,"text":"특색 있는 맛이긴 해요"},{"start":984.55,"duration":2.703000000000088,"text":"전체적으로 너무 완성도가 높은 피자 같아요!"},{"start":993.125,"duration":1.5349999999999682,"text":"피자는 따뜻하게 먹어야 맛있지"},{"start":1027.894,"duration":3.5039999999999054,"text":"일단은 제가 피자 먹고 되게 놀란 게"},{"start":1031.399,"duration":3.369000000000142,"text":"도우가 엄청 바삭바삭 맛있고"},{"start":1034.769,"duration":1.6669999999999163,"text":"진짜 이 피자만의 맛이 있어요!"},{"start":1036.437,"duration":2.701000000000022,"text":"이국적이면서"},{"start":1039.138,"duration":3.73700000000008,"text":"뭔가 피자 같으면서 피자 같지 않은 그런 매력의 피자였어요"},{"start":1042.876,"duration":1,"text":"특히..."},{"start":1043.877,"duration":1.7010000000000218,"text":"제가 고수를..."},{"start":1045.579,"duration":1.8669999999999618,"text":"이렇게 먹어본 적이 없었는데"},{"start":1047.447,"duration":3.303000000000111,"text":"처음으로 이렇게 먹어서 당황스러웠어요"},{"start":1050.751,"duration":2.768000000000029,"text":"요걸로 입문하실 수 있지 않을까..."},{"start":1053.52,"duration":1.6340000000000146,"text":"할 정도로!!!"},{"start":1055.155,"duration":2.701999999999998,"text":"고수랑 너무너무 잘 어울리는 피자였어요!"},{"start":1059.825,"duration":0.8999999999998636,"text":"제 건가요?"},{"start":1060.726,"duration":1.5679999999999836,"text":"와 진짜..."},{"start":1062.295,"duration":2.268000000000029,"text":"고수를 제가 심었어요"},{"start":1064.564,"duration":1.8339999999998327,"text":"나 정말 고수..."},{"start":1066.399,"duration":1.5350000000000819,"text":"어떻게 먹었지...?"},{"start":1067.935,"duration":3.7360000000001037,"text":"이거 완전 마니아층 가득 생길 것 같아요!"},{"start":1071.672,"duration":1.7000000000000455,"text":"메뉴 안 없어졌으면 좋겠어요!!!"},{"start":1073.773,"duration":3.4370000000001255,"text":"안 없어졌으면 좋겠다네요...?"},{"start":1077.31,"duration":1.6000000000001364,"text":"- 오늘 너무너무 감사합니다 - 아닙니다"},{"start":1078.911,"duration":1.5349999999998545,"text":"진짜 맛있게 잘 먹었습니다"},{"start":1080.447,"duration":1.7670000000000528,"text":"- 감사합니다 - 제가 감사합니다"},{"start":1082.815,"duration":1.2000000000000455,"text":"제가 '오늘도~' 하면..."},{"start":1084.016,"duration":1.1340000000000146,"text":"'잘 먹었습니다~' 하고 같이해 주시면 돼요!"},{"start":1085.15,"duration":1.3019999999999072,"text":"아 '잘 먹었습니다~'를요?"},{"start":1086.453,"duration":1.066000000000031,"text":"오늘도"},{"start":1087.519,"duration":3.0699999999999363,"text":"잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
