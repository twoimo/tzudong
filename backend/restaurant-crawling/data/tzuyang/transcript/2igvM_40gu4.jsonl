{"youtube_link":"https://www.youtube.com/watch?v=2igvM_40gu4","channel_name":"tzuyang","language":"ko","collected_at":"2026-04-23T22:06:06.140+09:00","transcript":[{"start":1.902,"duration":0.998,"text":"여기 전화가 계속 와"},{"start":3.58,"duration":1.2400000000000002,"text":"돼지갈비가 진짜 맛있대요"},{"start":4.822,"duration":1.7279999999999998,"text":"동네 분들 맛집이라고 하더라고요"},{"start":14.662,"duration":1.388,"text":"지역에서 잘 나가는 음식들인데 다 잘 나가요"},{"start":16.052,"duration":1.2830000000000013,"text":"다 잘 나가는 거예요?"},{"start":19.337,"duration":2.1930000000000014,"text":"직원 있으니까 우린 핑 안 받아요"},{"start":21.532,"duration":1.8079999999999998,"text":"공짜 배달해 주세요?"},{"start":23.342,"duration":1.6280000000000001,"text":"다회용기에 주시나 보다"},{"start":28.872,"duration":1.5380000000000003,"text":"그게 다 들어가요...?"},{"start":30.412,"duration":4.167999999999999,"text":"먹방도 인정한 맛집-!"},{"start":49.032,"duration":1.7680000000000007,"text":"안녕하세요, 여러분"},{"start":50.802,"duration":2.463000000000001,"text":"제가 오늘은 지금 여기 반포에 왔는데-!"},{"start":53.267,"duration":1.7029999999999959,"text":"2-3년 전에 발견한 곳이었나?"},{"start":54.972,"duration":2.4979999999999976,"text":"되게 와보고 싶었던 돼지갈빗집이 있었거든요?"},{"start":57.472,"duration":2.128,"text":"제가 돼지갈비 먹방을 한 적이"},{"start":59.602,"duration":1.9980000000000047,"text":"2021년도가 마지막이더라고요"},{"start":61.602,"duration":1.368000000000002,"text":"무한 리필 제외하고"},{"start":62.972,"duration":2.868000000000002,"text":"제가 돼지갈비 진짜 좋아하는 메뉴 중에 하나거든요?"},{"start":65.842,"duration":1.6380000000000052,"text":"근데 제가 오늘 시간이 없습니다"},{"start":67.482,"duration":1.7360000000000042,"text":"좀 이따 중요한 약속이 있어서"},{"start":69.22,"duration":3.5349999999999966,"text":"점심을 먹으러 왔는데 좀 빨리 먹고 가야 되거든요"},{"start":72.756,"duration":2.543999999999997,"text":"1시 5분인데 3시까지 끝내야 돼서"},{"start":75.301,"duration":1.5189999999999912,"text":"타임 어택을 하려고 합니다"},{"start":76.821,"duration":2.168999999999997,"text":"2시간 동안 얼마나 먹을지...!"},{"start":78.991,"duration":3.274000000000001,"text":"오늘도 가든즈 모자를 쓰고 왔습니다"},{"start":82.267,"duration":4.063000000000002,"text":"오늘 바지도 핑크거든요"},{"start":86.332,"duration":2.608000000000004,"text":"여기는 이제 '감미옥'이라는 곳인데"},{"start":88.94200000000001,"duration":1.8579999999999899,"text":"반포에서 되게 오래된 곳이래요"},{"start":90.801,"duration":3.3689999999999998,"text":"거의 50년 가까이 된 엄청 오래된 노포고"},{"start":94.172,"duration":1.3780000000000001,"text":"돼지갈비가 진짜 맛있대요"},{"start":95.551,"duration":2.0990000000000038,"text":"동네 분들 맛집이라고 하더라고요"},{"start":97.652,"duration":0.9980000000000047,"text":"빨리 가보겠습니다"},{"start":99.74000000000001,"duration":2.4399999999999977,"text":"한... 10인분 먹고 싶은데..."},{"start":102.182,"duration":2.4680000000000035,"text":"- 10인분이고 100인분이고 일단 잡숴봐요ㅎ - 네"},{"start":104.652,"duration":1.1979999999999933,"text":"고기는 뭐..."},{"start":105.851,"duration":2.3689999999999998,"text":"엄청나게 맛있어요-ㅎ"},{"start":108.22200000000001,"duration":1.6979999999999933,"text":"여기 점심 메뉴 엄청 인기 있나 봐요"},{"start":109.922,"duration":2.742999999999995,"text":"점심에 손님이 가득 차서"},{"start":112.667,"duration":1.9279999999999973,"text":"제가 원래 12시에 오려고 했는데"},{"start":114.59700000000001,"duration":1.3979999999999961,"text":"1시까지 지금 기다렸어요"},{"start":115.997,"duration":2.10799999999999,"text":"사장님-! 찌개 뭐가 제일 잘 나가요?"},{"start":118.107,"duration":2.5630000000000024,"text":"고기 먹을 때는 김치찌개, 된장찌개가 제일 잘 나가고"},{"start":120.672,"duration":0.7280000000000086,"text":"식사는 뭐..."},{"start":121.402,"duration":2.667999999999992,"text":"- 지역에서 잘 나가는 음식들인데 다 잘 나가요 - 다 잘 나가는 거예요?"},{"start":124.071,"duration":1.1290000000000049,"text":"다 잘 나가는데? 너무 많은데?"},{"start":125.202,"duration":1.4980000000000047,"text":"염소탕도 있어요"},{"start":126.95,"duration":1.2600000000000051,"text":"이 자리에서 계속했어요"},{"start":128.212,"duration":2.068000000000012,"text":"내 젊은 꽃다운 청춘에"},{"start":130.282,"duration":2.197999999999979,"text":"와~ 정말요? 47년 내내 하셨어요?"},{"start":132.482,"duration":1.203000000000003,"text":"1대 사장님이시네요ㅎㅎ"},{"start":133.687,"duration":2.062999999999988,"text":"잉~ 1대ㅎ"},{"start":135.752,"duration":1.4979999999999905,"text":"- 청국장 좋아해요? - 네-! 좋아해요"},{"start":137.252,"duration":1.627999999999986,"text":"- 그럼 청국장 해줄게요ㅎ - 감사합니다"},{"start":138.882,"duration":2.367999999999995,"text":"고기는 일단 빨리빨리 구울게요!"},{"start":141.8,"duration":2.25,"text":"근데 딱 봐도 고기 때깔이 너무 좋아 보인다"},{"start":144.052,"duration":1.6980000000000075,"text":"- 네, 고기 진짜 맛있어요 - 맛있어요?"},{"start":145.752,"duration":3.697999999999979,"text":"숯불로 하기 때문에"},{"start":149.452,"duration":3.4480000000000075,"text":"숯 맛하고 고기하고 어우러져서 정말 괜찮습니다"},{"start":152.902,"duration":2.52800000000002,"text":"근데... '감미옥'을 어떻게 알고 왔는데요??"},{"start":155.43200000000002,"duration":2.742999999999995,"text":"2년 전에 알았는데 계속 와보고 싶었거든요"},{"start":158.177,"duration":2.723000000000013,"text":"근데 계속 뭔가 안 맞아서 못 왔었는데"},{"start":160.902,"duration":2.498000000000019,"text":"진짜 너무 와보고 싶어서 지금 완전 기대하고 있어요"},{"start":163.61,"duration":2.5999999999999943,"text":"아 근데 고기 때깔이..."},{"start":166.212,"duration":2.7680000000000007,"text":"누가 봐도 이건 맛있어 보인다"},{"start":168.982,"duration":2.4679999999999893,"text":"갈비는 양념이 있어서 구울 때 계속 뒤집어 줘야 돼요"},{"start":171.452,"duration":2.0430000000000064,"text":"뒤집지 않으면 실례입니다ㅎ"},{"start":179.6,"duration":1.1500000000000057,"text":"고기가 두꺼운데?"},{"start":181.62,"duration":8.680000000000007,"text":"두툼해요, 갈비치고 엄청 두툼한 갈비네"},{"start":190.302,"duration":1.1980000000000075,"text":"살짝..."},{"start":191.502,"duration":3.0079999999999814,"text":"살짝 덜 익었을 때 먹어볼까-?"},{"start":200.52,"duration":2.1599999999999966,"text":"와"},{"start":203.21,"duration":6.119,"text":"분명히 달짝지근하고 짭조름한 갈비 맛인데"},{"start":209.331,"duration":2.029000000000025,"text":"간이 너무 달지도 않고 딱 적당해요"},{"start":211.362,"duration":2.397999999999996,"text":"갈비는 무조건 밥이죠~"},{"start":220.63,"duration":4.314999999999998,"text":"- 제가 딱 먹고 싶었던 갈비 맛이에요 - 그저 살도 안 찌고..."},{"start":224.947,"duration":1.252999999999986,"text":"갈비는 살 안 쪄요?"},{"start":226.202,"duration":2.6680000000000064,"text":"- 그렇게 많이 먹어도 살이 안 찐다고요ㅎ - 많이 먹어도 살 안 쪄요?"},{"start":228.872,"duration":1.4779999999999802,"text":"갈비 너무 맛있어요, 사장님-"},{"start":230.352,"duration":2.9279999999999973,"text":"- 양념도 맛있고 고기도 맛있고 - 네, 안 짜면서"},{"start":235.05,"duration":2.6699999999999875,"text":"여기 반월초등학교 아이들이 좋아해요ㅎ"},{"start":237.722,"duration":2.0279999999999916,"text":"초등학교 아이들이 좋아해요ㅎㅎ?"},{"start":239.752,"duration":2.542999999999978,"text":"학생 아이들이 좋아해요ㅎ"},{"start":242.297,"duration":1.5529999999999973,"text":"이게 하나도 안 짜요"},{"start":243.852,"duration":1.9979999999999905,"text":"하나도 안 짜서 쌈장 넣어 먹어도 될 정도로"},{"start":246.35,"duration":1,"text":"갈비가"},{"start":249.15,"duration":1,"text":"맛있어"},{"start":259.68,"duration":4.904999999999973,"text":"돼지갈비 2인분 더 주세요"},{"start":264.587,"duration":2.992999999999995,"text":"감사합니다"},{"start":267.582,"duration":2.52800000000002,"text":"오늘 시간이 없으니까 빨리 구우면서 먹어야 돼요"},{"start":279.35,"duration":1,"text":"너무 맛있다"},{"start":280.76,"duration":3.9700000000000273,"text":"돼지갈비는 이 간장 양념에 양파가 제일 잘 어울리거든요"},{"start":293.175,"duration":1.1750000000000114,"text":"청국장 여기죠?"},{"start":294.352,"duration":1.0980000000000132,"text":"감사합니다"},{"start":296.98,"duration":2.319999999999993,"text":"청국장 냄새 진하다"},{"start":299.302,"duration":1.6479999999999677,"text":"엄청 진해"},{"start":300.952,"duration":4.4979999999999905,"text":"요즘 청국장 시키면 약간 된장 반, 청국장 반인 느낌이 많았는데"},{"start":305.452,"duration":2.1480000000000246,"text":"얘는 진짜 찐 청국장 냄새 난다"},{"start":312.69,"duration":4.5400000000000205,"text":"된장찌개 맛이 아니라 진짜 청국장 맛"},{"start":325.775,"duration":1.670000000000016,"text":"여기 상추가 엄청 잘 어울리네...!"},{"start":327.447,"duration":1.3929999999999723,"text":"어머머머낫 안 돼 안 돼 안 돼"},{"start":329.075,"duration":0.6700000000000159,"text":"앟..."},{"start":329.747,"duration":1.9979999999999905,"text":"쌈 싸 먹다가 한눈팔았어"},{"start":331.747,"duration":1.1030000000000086,"text":"뒤집지 않으면 실례입니다"},{"start":332.852,"duration":0.7580000000000382,"text":"뭐야"},{"start":360.13,"duration":0.7300000000000182,"text":"음~"},{"start":360.862,"duration":1.0579999999999927,"text":"으음~~"},{"start":361.922,"duration":1.4529999999999745,"text":"으으음~"},{"start":363.377,"duration":2.50299999999