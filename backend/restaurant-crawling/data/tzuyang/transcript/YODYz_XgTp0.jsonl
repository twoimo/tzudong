8999999999851,"text":"육수 끓일 때까지 제가 완자 빚어드릴 거고"},{"start":1131.545,"duration":1.1799999999998363,"text":"근데 만약에..."},{"start":1132.726,"duration":0.8179999999999836,"text":"네?"},{"start":1133.546,"duration":2.2210000000000036,"text":"엑설런트 시킨다고 해도..."},{"start":1135.769,"duration":0.91599999999994,"text":"혼자서..."},{"start":1136.687,"duration":1.8610000000001037,"text":"이 정도 먹고 가면은"},{"start":1138.55,"duration":1.5330000000001291,"text":"적자죠?"},{"start":1140.388,"duration":1.75200000000018,"text":"모든 분이 그렇게 드신다면..."},{"start":1142.142,"duration":2.9579999999998563,"text":"살짝은 식은땀이 흐를 수도 있는데"},{"start":1145.327,"duration":1.6179999999999382,"text":"거의 없으시죠..."},{"start":1146.947,"duration":1.80800000000022,"text":"보통 몇 판 드세요? 궁금해요!"},{"start":1148.757,"duration":1.6979999999998654,"text":"4~5판 정도...?"},{"start":1150.456,"duration":2.2350000000001273,"text":"1판에 100g이라고 보시면 되거든요"},{"start":1152.693,"duration":1.6030000000000655,"text":"그 정도로 계량을 하니까"},{"start":1160.1,"duration":1.3480000000001837,"text":"소면, 소면...?!"},{"start":1161.45,"duration":2.6749999999999545,"text":"완자탕'면'이라서"},{"start":1164.127,"duration":1.8730000000000473,"text":"소면이 들어갑니다!"},{"start":1166.002,"duration":2.5730000000000928,"text":"면도 저희가 생면을 내는 게 아니고"},{"start":1168.577,"duration":1.8050000000000637,"text":"한 번 삶아서 낸 거라서"},{"start":1170.875,"duration":2.400000000000091,"text":"이제 위에는 텐카스라는"},{"start":1173.277,"duration":1.224999999999909,"text":"알아요"},{"start":1174.504,"duration":0.7880000000000109,"text":"튀김 가루"},{"start":1175.293,"duration":0.8350000000000364,"text":"맞아요"},{"start":1179.13,"duration":2.713999999999942,"text":"진짜 이 후식이 정말 좋은 것 같아요"},{"start":1181.846,"duration":1.9090000000001055,"text":"약간 가격대가 있다고 생각했는데"},{"start":1183.757,"duration":1.788000000000011,"text":"후식에서 진짜 돈이 안 아깝더라고요"},{"start":1191.325,"duration":3.589999999999918,"text":"이거 약간 그 XO소스 이런 거 같은데?"},{"start":1211.269,"duration":1.0609999999999218,"text":"여섯, 여덟"},{"start":1212.331,"duration":1.7690000000000055,"text":"아직 20판도 안 먹었어?!"},{"start":1214.101,"duration":2.6399999999998727,"text":"30판은 먹어야 되지 않나?"},{"start":1227.547,"duration":2.798000000000002,"text":"제가 유자 청양 육수를 사실 한 번 먹어본 적이 있거든요?"},{"start":1230.347,"duration":1.3830000000000382,"text":"근데 그때는..."},{"start":1231.732,"duration":2.768000000000029,"text":"얘 매력을 약간 느끼려다"},{"start":1234.502,"duration":1.2960000000000491,"text":"못 느꼈는데"},{"start":1235.8,"duration":2.0550000000000637,"text":"오늘 한번 다시 느껴볼게요"},{"start":1242.474,"duration":1.7260000000001128,"text":"오늘은 또 괜찮네?"},{"start":1244.202,"duration":4.468000000000075,"text":"이거 여러 번 먹어봐야 매력을 느낄 맛인 거 같아요"},{"start":1248.672,"duration":2.4329999999999927,"text":"근데 고기는 생각보다 잘 어울려요"},{"start":1251.107,"duration":2.9480000000000928,"text":"왜냐하면은 얘가 새콤해서"},{"start":1254.057,"duration":2.9710000000000036,"text":"약간 레몬소스 살짝 찍어 먹는 맛도 나거든요?"},{"start":1257.509,"duration":2.2460000000000946,"text":"너무 시큼한 거 안 좋아하시는 분들은"},{"start":1259.757,"duration":2.0879999999999654,"text":"나오자마자 레몬 빼시고"},{"start":1261.847,"duration":1.678000000000111,"text":"고기를 팍팍 넣어서 먹으면"},{"start":1263.527,"duration":1.3579999999999472,"text":"또 다른 매력이거든요?"},{"start":1270.843,"duration":1.6419999999998254,"text":"오늘 살치 당첨!"},{"start":1288.658,"duration":1.98700000000008,"text":"1분 더 기다릴게요"},{"start":1290.647,"duration":2.94399999999996,"text":"제가 안 넣어드리고 기호에 맞게 조금씩 넣어 드시라고"},{"start":1293.592,"duration":1.4179999999998927,"text":"- 이렇게 조금씩 드리고 있고요 - 감사합니다"},{"start":1301.547,"duration":0.6679999999998927,"text":"아 혹시..."},{"start":1302.216,"duration":1.70900000000006,"text":"이르케 9개 다 드시고 간 분이 계신가요...?"},{"start":1303.927,"duration":1.11200000000008,"text":"9개 다 드신 분은"},{"start":1305.041,"duration":1.400000000000091,"text":"- 없으세요... -"},{"start":1306.443,"duration":1.4950000000001182,"text":"저도 오늘 처음이라서..."},{"start":1307.94,"duration":3.214999999999918,"text":"오히려 저한테도 약간 성장의 기회인 듯한"},{"start":1314.31,"duration":0.7899999999999636,"text":"감사합니다"},{"start":1315.101,"duration":1.7989999999999782,"text":"제가 그날"},{"start":1316.902,"duration":2.01299999999992,"text":"입에 살짝 안 맞아서"},{"start":1318.917,"duration":2.0830000000000837,"text":"어떻게 먹었냐면요"},{"start":1321.467,"duration":1.5960000000000036,"text":"간장소스가 이 뒤에 있습니다"},{"start":1323.065,"duration":2.93100000000004,"text":"간장소스를 과감하게 넣어줍니다"},{"start":1325.998,"duration":7.3969999999999345,"text":"다진 마늘도 긁어서 과감하게 넣고 섞어줍니다"},{"start":1340.407,"duration":2.5930000000000746,"text":"이렇게 하면 확실히 진짜 대중적인 맛이 돼요"},{"start":1366.107,"duration":2.54300000000012,"text":"토마토 먼저 넣어드릴게요"},{"start":1370.595,"duration":2.2180000000000746,"text":"토마토는 먹어봤는데"},{"start":1372.815,"duration":1.4400000000000546,"text":"후식이 진짜 맛있어요!!!"},{"start":1374.257,"duration":2.717999999999847,"text":"- 맞아요, 파스타가 정말 맛있어요 - 파스타가 정말 맛있어요!"},{"start":1376.976,"duration":0.8999999999998636,"text":"- 실패할 수가 없어요! - 솔직히 말해서"},{"start":1377.878,"duration":2.4220000000000255,"text":"버섯리소또보다 파스타가 맛있어요"},{"start":1380.302,"duration":1.643000000000029,"text":"그것도 맞는 말이네요!"},{"start":1381.947,"duration":3.16800000000012,"text":"토마토는 좀 끓는 데 걸려요"},{"start":1385.117,"duration":1.3830000000000382,"text":"얘가 얼어있어서"},{"start":1386.502,"duration":2.04300000000012,"text":"얼린 토마토예요"},{"start":1388.547,"duration":1.0640000000000782,"text":"근데 토마토에는 뭔가"},{"start":1389.613,"duration":2.518000000000029,"text":"돼지고기가 어울릴 거 같아서 돼지고기로 시켰어요"},{"start":1401.145,"duration":2.2000000000000455,"text":"토마토치고 좀 가벼운 맛이라서 좋아요"},{"start":1403.347,"duration":1.836999999999989,"text":"맑고 가벼운 토마토"},{"start":1416.2,"duration":0.8479999999999563,"text":"맛있어"},{"start":1422.455,"duration":3.6010000000001128,"text":"고기가 1판당 100g 정도라고 하셨거든요?"},{"start":1426.058,"duration":2.1420000000000528,"text":"그럼 지금 한 2.4kg 정도 됩니다"},{"start":1441.399,"duration":3.2630000000001473,"text":"토마토는 약간 육수랑 먹을 때보다"},{"start":1444.664,"duration":1.780999999999949,"text":"토마토 상큼함이 배서 고기랑 굉장히 잘 어울려요"},{"start":1454.083,"duration":1.1549999999999727,"text":"치즈"},{"start":1462.185,"duration":1.581000000000131,"text":"치즈가 