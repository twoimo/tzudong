000016,"text":"무한 리필이어도"},{"start":67.246,"duration":1.8090000000000117,"text":"그리고 시간제한이 없어요!"},{"start":69.057,"duration":3.128,"text":"정말 저처럼 대식가분들한테는"},{"start":72.187,"duration":1.4950000000000045,"text":"좀 괜찮은 곳이 아닌가"},{"start":73.684,"duration":2.561000000000007,"text":"들어가 봅시다"},{"start":82.577,"duration":2.1680000000000064,"text":"이거 셋 다 돼지고기류는 똑같아요"},{"start":84.747,"duration":3.5559999999999974,"text":"근데 소고기 등급이랑 소고기 부위가 달라요"},{"start":88.606,"duration":2.038000000000011,"text":"총 이렇게 육수 아홉 가지가 있는데"},{"start":90.912,"duration":4.037999999999997,"text":"버섯 육수 그리고 유자 청양 그리고 김치, 된장"},{"start":94.952,"duration":3.0930000000000035,"text":"코코넛그린커리, 밀키 크림, 새우"},{"start":98.047,"duration":1.5280000000000058,"text":"토마토, 스키야키 이렇게 있어요"},{"start":100.025,"duration":2.859999999999985,"text":"제가 오늘 이거 다 먹어 보겠습니다"},{"start":102.887,"duration":2.195999999999998,"text":"이게 후식 식사가 있거든요?"},{"start":105.08500000000001,"duration":2.2299999999999898,"text":"뭐 우동도 있고 여러 가지 있거든요"},{"start":107.31700000000001,"duration":1.5079999999999956,"text":"이게 진짜 좋은 거 같아요"},{"start":108.827,"duration":2.0279999999999916,"text":"기본 좋아하시면은"},{"start":110.857,"duration":1.288000000000011,"text":"버섯 육수 추천드리고요"},{"start":112.146,"duration":2.0390000000000015,"text":"매콤한 거 좋아하시면은"},{"start":114.187,"duration":1.2279999999999944,"text":"된장라면 맛있어요"},{"start":115.417,"duration":3.3329999999999984,"text":"버섯 육수 먼저 준비 도와드리겠습니다"},{"start":122.684,"duration":3.331000000000003,"text":"육수가 끓으면 기본 야채 중에서 단단한 야채 먼저 넣어서"},{"start":126.017,"duration":1.7210000000000036,"text":"채수 끓여주시면 되시고요"},{"start":127.74,"duration":2.159000000000006,"text":"고기는 붉은 색깔이 소고기"},{"start":129.901,"duration":1.6569999999999823,"text":"분홍 색깔이 돼지고기인데"},{"start":131.56,"duration":1.1949999999999932,"text":"소고기는"},{"start":132.757,"duration":2.2579999999999814,"text":"부챗살과 알목심"},{"start":135.017,"duration":2.828000000000003,"text":"돼지고기는 목살과 삼겹살 제공해 드렸습니다"},{"start":137.847,"duration":1.3979999999999961,"text":"- 식사 맛있게 하세요 - 감사합니다"},{"start":139.247,"duration":0.907999999999987,"text":"여기는..."},{"start":140.157,"duration":0.6879999999999882,"text":"정말..."},{"start":140.847,"duration":1.828000000000003,"text":"너무 월등히 친철하세요!"},{"start":142.677,"duration":2.4380000000000166,"text":"평상시엔 맨날 모자 눌러쓰고 가는데"},{"start":145.117,"duration":2.046999999999997,"text":"진짜 약간 5성급 호텔처럼"},{"start":147.166,"duration":1.2729999999999961,"text":"응대를 해주시거든요"},{"start":148.441,"duration":1.9699999999999989,"text":"약간 친철 끝판왕?"},{"start":150.413,"duration":2.218999999999994,"text":"이게 시그니처 코스거든요"},{"start":152.63400000000001,"duration":1.4849999999999852,"text":"근데 제가 엑설런트를 시켰어요"},{"start":154.121,"duration":2.8739999999999952,"text":"액설런트 시키면 시그니처랑 스페셜 다 먹을 수 있대요"},{"start":156.997,"duration":1.7479999999999905,"text":"사실 원래 채소 잘 안 먹는데"},{"start":158.747,"duration":2.5679999999999836,"text":"조금만 넣을게요ㅎ"},{"start":163.378,"duration":2.0360000000000014,"text":"여기는 만가닥버섯이 있네?"},{"start":165.416,"duration":2.968999999999994,"text":"매장마다 채소가 살짝씩 다른 거 같아요"},{"start":168.387,"duration":1.2379999999999995,"text":"거의 비슷한데"},{"start":169.627,"duration":1.7709999999999866,"text":"만가닥 있는 데는 처음 봐"},{"start":174.188,"duration":0.6009999999999991,"text":"진짜..."},{"start":174.791,"duration":1.320999999999998,"text":"그때 추천해 주신 분..."},{"start":176.114,"duration":2.040999999999997,"text":"복 받으실 거예요"},{"start":178.15699999999998,"duration":2.6880000000000166,"text":"이거가 폰즈소스인데 여기 소스가"},{"start":180.847,"duration":1.2779999999999916,"text":"소스가 진짜 맛있어요"},{"start":182.127,"duration":2.1929999999999836,"text":"간장소스, 폰즈소스에는"},{"start":184.322,"duration":2.6779999999999973,"text":"이 태국 고추 넣으면 시큼하게 맛있거든요"},{"start":187.002,"duration":2.242999999999995,"text":"이거 맛있어서 요즘에"},{"start":189.247,"duration":3.0179999999999723,"text":"집에서 샤부샤부 먹을 때 맨날 먹거든요"},{"start":192.267,"duration":2.608000000000004,"text":"비셰프 거에다가 다진 마늘 넣어 먹으면"},{"start":194.877,"duration":1.8079999999999927,"text":"다르긴 한데 비슷합니다"},{"start":196.687,"duration":1.2549999999999955,"text":"거기 거 맛있던데?"},{"start":197.944,"duration":1.2560000000000002,"text":"참깨소스"},{"start":202.324,"duration":3.3409999999999798,"text":"근데 여기가 좀 신맛이 덜해서 확실히 맛있긴 하다"},{"start":205.667,"duration":1.4329999999999927,"text":"고기를 아까"},{"start":207.102,"duration":1.8729999999999905,"text":"저는 항상 그냥 소고기부터 때려 넣는데"},{"start":208.977,"duration":2.4480000000000075,"text":"돼지고기부터 넣으면 국물이 담백하게 맛있대요"},{"start":212.617,"duration":1.2720000000000198,"text":"돼지고기 목살"},{"start":235.197,"duration":1.9579999999999984,"text":"돼지고기 목살이 진짜..."},{"start":237.15699999999998,"duration":1.0910000000000082,"text":"진짜 맛있다"},{"start":238.25,"duration":3.7050000000000125,"text":"진짜 얇아서 돼지고기인데 엄청 금방 익거든요?"},{"start":241.957,"duration":1.8120000000000118,"text":"이번에는 참깨소스"},{"start":251.5,"duration":1.0250000000000057,"text":"참깨소스는 약간"},{"start":252.527,"duration":1.2980000000000018,"text":"도파민 도는 맛이야...!"},{"start":269.185,"duration":2.1399999999999864,"text":"내가 봤을 때 이게 부챗살이고"},{"start":271.327,"duration":1.358000000000004,"text":"이 밑에 게 알목심 같거든요?"},{"start":272.687,"duration":1.478999999999985,"text":"부챗살 먼저 한번 먹어볼게요"},{"start":274.168,"duration":2.5219999999999914,"text":"근데 시그니처 고기는 되게 오랜만에 먹어요"},{"start":276.692,"duration":2.15300000000002,"text":"가면 항상 엑설런트 시켜서"},{"start":286,"duration":2.545000000000016,"text":"샤부샤부 고기 중에 진짜 최상급이에요!"},{"start":288.547,"duration":3.9359999999999786,"text":"근데 얘는 기름기가 많이 없는데도 되게 부드럽다"},{"start":298.065,"duration":1.420000000000016,"text":"이건 알목심"},{"start":307.325,"duration":1.1890000000000214,"text":"근데 저는"},{"start":308.516,"duration":2.8389999999999986,"text":"제일 비싼 엑설런트를 먹어봤잖아요"},{"start":311.35699999999997,"duration":2.368000000000052,"text":"오히려 시그니처가 취향인 사람도 많을 것 같아요"},{"start":313.727,"duration":2.8980000000000246,"text":"담백한 기름기 없는 것을 좋아하시면"},{"start":316.627,"duration":1.968999999999994,"text":"오히려 가격대 있는 것보다"},{"start":318.598,"duration":1.6870000000000118,"text":"시그니처가 맛있을 거 같아요"},{"start":332.9,"duration":2.4850000000000136,"text":"오늘은 제가 육수를 다 먹어볼 것이기 때문에"},{"start":335.387,"duration":1.3280000000000314,"text":"바로 후식 가보겠습니다"},{"start":336.717,"duration":1.7030000000000314,"text":"여기 진짜 좋은 점 하나 더 있어요!"},{"start":338.422,"duration":1.8029999999999973,"text":"그릇을 먹자마자 원래 치워주세요!"},{"start":340.227,"duration":1.8280000000000314,"text":"그래서 아무도 많이 먹은 줄 몰라요"},{"start":342.057,"duration":1.3949999999999818,"text":"근데!"},{"start":343.454,"duration":2.606999999999971,"text":"오늘은 제가 몇 개 먹는지 알기 위해서"},{"start":346.063,"duration":1.84699999999998,"text":"그냥 여기 두겠습니다!"},{"start":365.661,"duration":1.884999999999991,"text":"진짜 맛있겠다"},{"start":370.687,"duration":2.7679999999999723,"text":"원래 여기다가 트러플 쫙 올려주시거든요"},{"start":373.457,"duration":2.233000000000004,"text":"근데 오일 있는 거랑 없는 거랑"},{"start":375.692,"duration":1.3079999999999927,"text":"둘 다 다르게 맛있어서"},{"start":377.002,"duration":1.2129999999999654,"text":"전 따로 받아요!"},{"start":378.217,"duration":1.0680000000000405,"text":"감사합니다"},{"start":379.287,"duration":1.0980000000000132,"text":"네, 감사합니다"},{"start":380.387,"duration":2.098000000000013,"text":"일단 안 뿌리고 한 입 먹어볼게요"},{"start":390.585,"duration":1.1650000000000205,"text":"맛있다"},{"start":395.21500000000003,"duration":2.5299999999999727,"text":"엄청 눅진하고"},{"start":397.747,"duration":2.6779999999999973,"text":"육수 원래..."},{"start":400.427,"duration":3.149000000000001,"text":"'고기 우렸던 육수에다가 먹으면 더 맛있을 텐데?'"},{"start":403.578,"duration":1.2240000000000464,"text":"이런 생각을 했었는데"},{"start":405.199,"duration":1.315999999999974,"text":"막상 먹으면 '아!'"},{"start":406.517,"duration":3.4279999999999973,"text":"'새로 하는 게 맛있구나'라고 느낄 거 같아요"},{"start":409.947,"duration":2.6779999999999973,"text":"이게 엄청 이 자체만으로 진해서"},{"start":412.627,"duration":5.6299999999999955,"text":"오일 여기다가 살짝 뿌려서 먹을게요"},{"start":423.455,"duration":1.2250000000000227,"text":"와 진해"},{"start":426.422,"duration":1.30499999999995,"text":"진짜 맛있다"},{"start":433.145,"duration":1.4790000000000418,"text":"아니 올 때마다 레시피가 바뀌나?"},{"start":434.626,"duration":1.5990000000000464,"text":"점점 맛있어지는 것 같아!"},{"start":436.227,"duration":1.358000000000004,"text":"트러플 오일 안 뿌리면 약간"},{"start":437.587,"duration":4.1129999999999995,"text":"짭쪼롬하니 되게 맛있는 맛이 나고"},{"start":441.702,"duration":1.600999999999999,"text":"트러플 오일 뿌리면은"},{"start":443.305,"duration":2.3829999999999814,"text":"진짜 트러플 향이..."},{"start":457.365,"duration":1.8199999999999932,"text":"된장 육수로 한번 먹어보겠습니다!"},{"start":459.187,"duration":2.4180000000000064,"text":"매콤 된장 육수 준비 도와드릴게요"},{"start":466.845,"duration":1.7159999999999513,"text":"동일하게 붉은 색깔이 소고기"},{"start":468.563,"duration":3.3240000000000123,"text":"그다음에 분홍 색깔이 돼지고기입니다"},{"start":476.1,"duration":2.294999999999959,"text":"된장 맛보다 얼큰한 맛이 더 강해서"},{"start":478.397,"duration":1.948000000000036,"text":"그냥 얼큰 육수라고 생각하시면 될 것 같아요"},{"start":480.347,"duration":1.6510000000000105,"text":"거기에 된장을 살짝 풀었다?"},{"start":482,"duration":1.3799999999999955,"text":"살치살"},{"start":484.072,"duration":3.225999999999999,"text":"근데 살치살치고는 기름기가 많이 없네?"},{"start":487.3,"duration":2.298999999999978,"text":"약간 담백한 살치살 부분인가 봐"},{"start":495.48,"duration":1.2269999999999754,"text":"맛있다"},{"start":497.45799999999997,"duration":2.157000000000039,"text":"확실히 좀 더 맛있다!"},{"start":499.617,"duration":3.4839999999999804,"text":"확실히 조금 더 기름지고 확실히 조금 더 부드럽고"},{"start":503.103,"duration":4.7690000000000055,"text":"층마다 지방이 조금씩 조금씩 껴있어 풍미가 좋고 되게 부드럽고"},{"start":513.315,"duration":1.2149999999999181,"text":"맛있네"},{"start":529.065,"duration":2.009999999999991,"text":"꽤 매우니까"},{"start":531.077,"duration":2.768000000000029,"text":"매운 거 아예 못 드시는 분들은 좀 힘드실 거예요"},{"start":533.847,"duration":3.258000000000038,"text":"근데 제가 다른 육수 많이 먹어봤잖아요"},{"start":537.107,"duration":4.048000000000002,"text":"얘랑 버섯 육수가 가장 고기 맛을 안 해치고 맛있게 하더라고요"},{"start":541.156,"duration":2.3290000000000646,"text":"제가 봤을 때 원래 된장은"},{"start":543.487,"duration":1.2280000000000655,"text":"아까처럼 육수를 새로 해주는 게 아니라"},{"start":544.717,"duration":2.038000000000011,"text":"여기다가 라면을 끓여주시거든요?"},{"start":546.757,"duration":1.7080000000000837,"text":"그러니까..."},{"start":548.467,"duration":2.8210000000000264,"text":"고기를 좀 이따 같이 넣어서 고기라면을 먹는 거야!"},{"start":554.485,"duration":1.8759999999999764,"text":"된장 육수도 맛있게 드셨나요?"},{"start":556.363,"duration":0.8369999999999891,"text":"너무 맛있습니다"},{"start":557.202,"duration":1.0330000000000155,"text":"감사합니다"},{"start":558.237,"duration":1.8179999999999836,"text":"저희가 한 번 생면을 삶아서 내온 거라서"},{"start":560.056,"duration":2.2659999999999627,"text":"1분 정도만 따로 조리하겠습니다"},{"start":563.888,"duration":2.1159999999999854,"text":"고기랑 같이 넣어 먹으려고 남겨놨어요"},{"start":573.415,"duration":1.1200000000000045,"text":"감사합니다"},{"start":574.5360000000001,"duration":1.4089999999999918,"text":"맛있게 드십시오"},{"start":575.947,"duration":1.4750000000000227,"text":"어? 이거 넣으면 그거 아니야?"},{"start":577.424,"duration":1.6610000000000582,"text":"약간 차슈 느낌인데?"},{"start":579.087,"duration":3.3279999999999745,"text":"라면 먹을 때 이렇게 차슈 올라가 있잖아요"},{"start":582.4159999999999,"duration":1.08400000000006,"text":"괜찮다"},{"start":599.208,"duration":2.6970000000000027,"text":"이거를 이제 안에 넣자"},{"start":611.275,"duration":2.340000000000032,"text":"다음은 제일 비싼 엑설런트 고기로 먹어볼게요"},{"start":613.617,"duration":2.1820000000000164,"text":"아무도 안 시킬 거 같은 거 하나 시켜볼까...?"},{"start":615.8,"duration":2.900000000000091,"text":"그린커리 드셔보신 분 있으세요?"},{"start":618.702,"duration":3.2799999999999727,"text":"그린커리 여기 마니아이셔도 잘 안 드셔보셨을 거 같은데"},{"start":621.983,"duration":1.9820000000000846,"text":"그린커리로 한번 도전"},{"start":623.967,"duration":0.9210000000000491,"text":"궁금하다"},{"start":624.89,"duration":1.1680000000000064,"text":"혹시..."},{"start":626.06,"duration":3.955000000000041,"text":"코코넛그린커리 육수는 잘 나가나요?"},{"start":630.016,"duration":2.719000000000051,"text":"마니아층이 두터운 육수예요"},{"start":632.737,"duration":1.5480000000000018,"text":"직원들이 매장에서 식사할 때"},{"start":634.2860000000001,"duration":0.9839999999999236,"text":"꼭 먹는 육수기도 하고요"},{"start":635.271,"duration":1.2140000000000555,"text":"- 아 정말요? - 네, 네"},{"start":636.487,"duration":0.9460000000000264,"text":"히든 메뉴구나?"},{"start":637.435,"duration":0.75,"text":"네 맞습니다"},{"start":638.186,"duration":2.5810000000000173,"text":"- 어떤 색이지? - 코코넛그린커리 육수 준비해 드리겠습니다"},{"start":640.769,"duration":1.0190000000000055,"text":"어?"},{"start":641.79,"duration":1.3150000000000546,"text":"초록색이 아니네?"},{"start":643.107,"duration":0.8330000000000837,"text":"연..."},{"start":643.942,"duration":1.5430000000000064,"text":"노란 연두색?"},{"start":645.487,"duration":3.802000000000021,"text":"바질 그런 막 그런 향도 나고 무슨"},{"start":649.29,"duration":3.275000000000091,"text":"뭔가 허브 같은 냄새도 나고"},{"start":655.516,"duration":1.3120000000000118,"text":"비주얼이 이상해"},{"start":656.829,"duration":2.0150000000001,"text":"더 초록색이 됐어"},{"start":658.846,"duration":1.05499999999995,"text":"살짝 먹어볼게요"},{"start":668.455,"duration":4.599999999999909,"text":"커리 향보다 되게 엄청 중후한 스모크한 향이"},{"start":673.056,"duration":1.7509999999999764,"text":"확 나는 게 있거든요?"},{"start":684.975,"duration":2.0799999999999272,"text":"제가 생각했을 때 이 육수는"},{"start":687.056,"duration":1.4139999999999873,"text":"빨리 우동을 시킬게요"},{"start":706.801,"duration":2.106999999999971,"text":"진짜 좀 궁금하다...!"},{"start":720.105,"duration":1.26400000000001,"text":"맛있다"},{"start":721.855,"duration":3.4600000000000364,"text":"육수는 살짝 새콤한 맛이 나서 저한테는"},{"start":725.317,"duration":2.8220000000000027,"text":"좀 약간 독특하다고 느꼈는데"},{"start":728.141,"duration":2.074000000000069,"text":"얘는 좀 커리 향이 강하고"},{"start":738.645,"duration":4.225000000000023,"text":"육수보다는 개인적으로 얘는 후식 볶음우동이 훨씬 더 맛있어요"},{"start":743.155,"duration":2.173000000000002,"text":"김치 육수 준비 도와드리겠습니다"},{"start":745.745,"duration":1.7010000000000218,"text":"김치 육수도 많이 나가나요?"},{"start":747.448,"duration":0.6520000000000437,"text":"네 맞아요"},{"start":748.102,"duration":2.0230000000000246,"text":"많이들 찾으시는 육수 중의 하나이고요"},{"start":750.127,"duration":2.7420000000000755,"text":"소고기 부챗살과 알목심 준비해 드렸습니다"},{"start":752.871,"duration":1.0880000000000791,"text":"감사합니다"},{"start":753.96,"duration":2.0849999999999227,"text":"김치가 되게 좀 대중적일 것 같은데"},{"start":756.046,"duration":2.5,"text":"아직 안 먹어봐서 좀 궁금하더라고요"},{"start":758.548,"duration":1.9669999999999845,"text":"고기는 제가 일부러"},{"start":760.516,"duration":2.939000000000078,"text":"제일 저렴한 시그니처로 다시 준비를 했어요!"},{"start":763.457,"duration":3.34699999999998,"text":"엑설런트를 먹고 시그니처를 먹으면 과연 어떤가...!"},{"start":766.805,"duration":1.8910000000000764,"text":"김치랑 돼지도 괜찮겠다"},{"start":768.698,"duration":2.923999999999978,"text":"맞네, 김치찌개라 돼지고기도 맛있겠는데?"},{"start":771.623,"duration":2.4319999999999027,"text":"돼지, 돼지고기 추가할래"},{"start":774.056,"duration":3.798999999999978,"text":"육수에 한돈 목살이랑 삼겹살 준비 도와드렸습니다"},{"start":777.857,"duration":1.586999999999989,"text":"- 맛있게 드세요 - 감사합니다"},{"start":786.525,"duration":2.243000000000052,"text":"일단 돼지랑은 확실히 잘 어울려요!"},{"start":788.77,"duration":2.774000000000001,"text":"김치찌개 시큼함이 뒤에 빡 때리네!"},{"start":791.545,"duration":0.9940000000000282,"text":"김칫국 맛도 많이 나는데"},{"start":792.54,"duration":2.105000000000018,"text":"약간 토마토 육수 맛도 나요!"},{"start":814.998,"duration":1.0679999999999836,"text":"맛있네"},{"start":817.675,"duration":1.3430000000000746,"text":"얘는 고기가"},{"start":819.845,"duration":2.669999999999959,"text":"시그니처가 소고기치고 엄청 담백한 부위라서"},{"start":822.516,"duration":1.822999999999979,"text":"김치 육수랑 되게 잘 어울려요"},{"start":841.485,"duration":1.5389999999999873,"text":"이것도 너무 기대된다"},{"start":846.806,"duration":3.1369999999999436,"text":"로제리소또에는 돼지고기가 들어갑니다"},{"start":852.055,"duration":2.7490000000000236,"text":"생크림이랑 가염 버터 들어갈 겁니다"},{"start":858.995,"duration":1.891999999999939,"text":"그리고 완두콩도 들어갈 거예요"},{"start":862.245,"duration":0.9230000000000018,"text":"파르메산 치즈랑"},{"start":863.17,"duration":1.375,"text":"그다음에 파 다시 한번 뿌려드릴 거예요"},{"start":864.546,"duration":1.5569999999999027,"text":"감사합니다"},{"start":866.104,"duration":1.54099999999994,"text":"김치로제?"},{"start":867.646,"duration":1.4429999999999836,"text":"신기한데?"},{"start":869.091,"duration":1.3039999999999736,"text":"먹어보겠습니다"},{"start":874.755,"duration":3.302000000000021,"text":"파르메산 치즈가 굉장히 좀 강해서"},{"start":878.059,"du