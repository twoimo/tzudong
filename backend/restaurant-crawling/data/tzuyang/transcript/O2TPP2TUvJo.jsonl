854,"text":"잘못된 것 같다"},{"start":1236.001,"duration":2.502999999999929,"text":"버섯 육수를 중간중간 부으면"},{"start":1238.505,"duration":1.4329999999999927,"text":"짠 게 방지가 된대요!"},{"start":1246.513,"duration":1.2330000000001746,"text":"고기 20판 드셔서 지금..."},{"start":1247.747,"duration":1.5009999999999764,"text":"2kg 정도 드신 거거든요"},{"start":1249.249,"duration":1.7709999999999582,"text":"지금 2kg 먹었어요?"},{"start":1251.021,"duration":1.7519999999999527,"text":"- 아 그래요? - 20판 드셔서"},{"start":1266.332,"duration":2.1499999999998636,"text":"스키야키에는 소바가 맛있대요"},{"start":1268.483,"duration":4.855000000000018,"text":"먹어볼까?"},{"start":1287.62,"duration":2.2350000000001273,"text":"면이 완전 꾸덕꾸덕한데?"},{"start":1299.766,"duration":2.7349999999999,"text":"혹시 사이드 메뉴..."},{"start":1302.502,"duration":2.268000000000029,"text":"냉소바가 좋을까요, 들기름소바가 좋을까요?"},{"start":1304.771,"duration":2.701000000000022,"text":"- 들기름소바! - 들기름소바? 들기름소바로 그럼 바로"},{"start":1307.473,"duration":2.936000000000149,"text":"개인적으로 다섯 가지 육수 다 먹어봤는데"},{"start":1310.41,"duration":1.8669999999999618,"text":"준하 님께서 가장 추천해 주신 거는"},{"start":1312.278,"duration":1.1340000000000146,"text":"버섯 육수였고요"},{"start":1313.413,"duration":1.6669999999999163,"text":"제가 가장 맛있었던 거는"},{"start":1315.081,"duration":1.1670000000001437,"text":"얼큰 육수입니다"},{"start":1316.249,"duration":1.83400000000006,"text":"해장하기 딱 좋은"},{"start":1318.084,"duration":1.933999999999969,"text":"나 어제도 술 먹었잖아요"},{"start":1320.019,"duration":1.9349999999999454,"text":"감사합니다"},{"start":1321.96,"duration":3.7670000000000528,"text":"참깨 간 거랑 통들깨가 이렇게 들어가 있고"},{"start":1325.728,"duration":2.8989999999998872,"text":"냄새가 진짜 나오자마자 엄청 좋아요"},{"start":1337.47,"duration":2.4680000000000746,"text":"진짜 향이 엄청 좋게 메밀 향이"},{"start":1339.939,"duration":1.7010000000000218,"text":"진하게 올라오고"},{"start":1341.641,"duration":1.5339999999998781,"text":"들기름이 엄청 고소해요"},{"start":1343.176,"duration":3.7029999999999745,"text":"입에서 약간 껍질처럼 팍팍 터지거든요"},{"start":1346.88,"duration":1.8669999999999618,"text":"그것도 식감이 되게 좋네"},{"start":1365.498,"duration":3.201999999999998,"text":"와 이거 진짜 디저트인데?"},{"start":1368.701,"duration":2.56899999999996,"text":"감사합니다, 시원하게 나오네"},{"start":1377.71,"duration":1.5679999999999836,"text":"완전 디저트 오미자차네"},{"start":1379.279,"duration":1.599999999999909,"text":"그냥 진짜 마지막에 나오는"},{"start":1380.88,"duration":1.6339999999997872,"text":"달달한 매실차처럼 나와요"},{"start":1382.515,"duration":1.6009999999998854,"text":"다 먹었어요"},{"start":1384.951,"duration":1.7010000000000218,"text":"많이는 안 먹었어요"},{"start":1386.653,"duration":2.9680000000000746,"text":"누가 봐도 아님..."},{"start":1389.622,"duration":1.8009999999999309,"text":"쯔양이니까 뭐 늘 이렇게 먹지 않아?"},{"start":1391.424,"duration":1.1669999999999163,"text":"저는 사실..."},{"start":1392.592,"duration":0.8659999999999854,"text":"더 먹죠ㅎ"},{"start":1394.961,"duration":1.0670000000000073,"text":"맛은 괜찮았어?"},{"start":1396.029,"duration":1.3669999999999618,"text":"근데 진짜 너무 맛있었어요!"},{"start":1397.397,"duration":1.066000000000031,"text":"그래도 제가..."},{"start":1398.464,"duration":2.035000000000082,"text":"계산을 하고 가야 되지 않을까..."},{"start":1400.5,"duration":1.3669999999999618,"text":"말도 안 되는 말을..."},{"start":1401.868,"duration":2.5009999999999764,"text":"총 54만 원 나왔는데"},{"start":1404.37,"duration":3.201999999999998,"text":"계산적인 얘기를 하고 그랭..."},{"start":1407.573,"duration":1.6009999999998854,"text":"와주신 것도 감사한데!"},{"start":1409.175,"duration":2.5019999999999527,"text":"다음에 대결해서 그때..."},{"start":1411.678,"duration":0.7679999999998017,"text":"네가 지면 내"},{"start":1412.4470000000001,"duration":1.2979999999997744,"text":"아 정말요?"},{"start":1413.746,"duration":5.804999999999836,"text":"여자 혼자 먹은 것치고 많이 나오긴 했네"},{"start":1419.552,"duration":1.4010000000000673,"text":"제가 너무 감사해요"},{"start":1420.954,"duration":1.4329999999999927,"text":"진짜 너무 감사해요!"},{"start":1422.789,"duration":1.5,"text":"제가..."},{"start":1424.29,"duration":1.433999999999969,"text":"질 것 같진 않아서..."},{"start":1426.793,"duration":2.5010000000002037,"text":"갑자기 불타오르네"},{"start":1429.295,"duration":2.4349999999999454,"text":"너무 감사합니다, 진짜"},{"start":1431.731,"duration":2.4010000000000673,"text":"감사합니다"},{"start":1434.133,"duration":2.3019999999999072,"text":"샤부샤부 워낙 좋아하니까 진짜"},{"start":1436.436,"duration":2.0009999999999764,"text":"꼭 와보고 싶었거든요, 진짜로"},{"start":1438.438,"duration":3.3019999999999072,"text":"육수가 다섯 종류가 있어서"},{"start":1441.741,"duration":1.8669999999999618,"text":"선택해서 먹기도 좋고"},{"start":1443.609,"duration":3.3740000000000236,"text":"고기도 열 종류나 있어서 골라 먹기 되게 좋아요"},{"start":1446.984,"duration":2.29300000000012,"text":"그리고 원래 샤부샤부집엔 샤부샤부밖에 없는데"},{"start":1449.278,"duration":1.9710000000000036,"text":"여기 사이드 메뉴가 진짜 많거든요"},{"start":1451.25,"duration":2.8019999999999072,"text":"전체적으로 음식은 다 너무 맛있게 먹었습니다"},{"start":1454.053,"duration":3.8029999999998836,"text":"특히 얼큰 육수 다시 또 먹고 싶네요"},{"start":1457.857,"duration":1.4670000000000982,"text":"준하 님께 너무너무 감사드립니다"},{"start":1459.325,"duration":2.7690000000000055,"text":"아 진짜 얻어먹으려니까 너무 죄송한데"},{"start":1462.095,"duration":0.7989999999999782,"text":"여튼 감사합니다"},{"start":1462.895,"duration":4.104000000000042,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
