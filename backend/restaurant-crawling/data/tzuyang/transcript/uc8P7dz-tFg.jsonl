,{"start":479.065,"duration":1.0810000000000173,"text":"이상할 것 같은데"},{"start":489.555,"duration":1.801999999999964,"text":"특이하긴 한데"},{"start":491.35699999999997,"duration":0.7680000000000291,"text":"맛있어요"},{"start":492.125,"duration":2.6689999999999827,"text":"일반 김밥은 게장을 받쳐주는 느낌인데"},{"start":494.794,"duration":1.968999999999994,"text":"얘는 참치김밥 맛이 더 세다!"},{"start":501.66700000000003,"duration":2.06899999999996,"text":"동네가 좁다 보니까..."},{"start":503.736,"duration":1.634999999999991,"text":"단톡방에 그냥 쫙 다 퍼져서"},{"start":505.371,"duration":1.5030000000000427,"text":"단톡방에요?"},{"start":506.874,"duration":1.2999999999999545,"text":"배에서 내리는 순간"},{"start":509.509,"duration":2.301999999999964,"text":"아니, 저는 다들 어디서 들으셨나..."},{"start":511.811,"duration":1.9699999999999704,"text":"되게 궁금했거든요"},{"start":513.781,"duration":1.8670000000000755,"text":"이번엔 치즈김밥과 가봅시다!"},{"start":527.093,"duration":2.201999999999998,"text":"치즈 맛이 거의 묻혀요"},{"start":529.295,"duration":1.802000000000021,"text":"내장이 너무 진해서 그런지"},{"start":531.097,"duration":4.471000000000004,"text":"1등 기본 김밥, 2등 치즈김밥, 3등 참치김밥"},{"start":535.568,"duration":1.8350000000000364,"text":"진짜 알이 어떻게 이렇게 많냐?"},{"start":553.319,"duration":2.3360000000000127,"text":"우와... 이거 뭐야?"},{"start":555.655,"duration":2.536000000000058,"text":"우와... 차돌이 뭉텅이로 들어가 있어"},{"start":558.191,"duration":2.6689999999999827,"text":"매출 1위 메뉴"},{"start":560.86,"duration":0.7340000000000373,"text":"1위래"},{"start":567.467,"duration":1.7010000000000218,"text":"으아 너무 좋다"},{"start":573.673,"duration":2.302000000000021,"text":"진짜 혀부터 매콤해지는"},{"start":575.975,"duration":2.0019999999999527,"text":"얼큰, 시원, 칼칼함"},{"start":584.484,"duration":1.100999999999999,"text":"끝내준다"},{"start":585.885,"duration":1.7019999999999982,"text":"아! 음료수 시켜야지!"},{"start":587.587,"duration":2.2690000000000055,"text":"카페 음료 먹는 거를"},{"start":589.856,"duration":1.5339999999999918,"text":"너무 좋아하는데"},{"start":591.39,"duration":2.1689999999999827,"text":"식당에서 시킬 수 있으니까 완전 최고다"},{"start":603.807,"duration":2.532000000000039,"text":"구워 먹는 퀄리티의 차돌인데?"},{"start":616.315,"duration":1.6019999999999754,"text":"순두부 진짜 맛있다..."},{"start":624.991,"duration":2.802000000000021,"text":"겉에만 익고 반 쫀득하게 익은 쫀득 노른자"},{"start":633.866,"duration":1.2350000000000136,"text":"진짜 맛있다"},{"start":639.272,"duration":2.3349999999999227,"text":"저 왕돈가스 주세요"},{"start":644.577,"duration":2.5019999999999527,"text":"이런 게 맛있거든, 내장"},{"start":651.5840000000001,"duration":2.0019999999999527,"text":"이런 거는 한입에...!"},{"start":681.314,"duration":2.2690000000000055,"text":"엄청 크다, 감사합니다"},{"start":685.351,"duration":1.802000000000021,"text":"맛있겠다, 감사합니다"},{"start":694.36,"duration":1.9349999999999454,"text":"초록매실인데... 좋아하시죠?!"},{"start":696.295,"duration":1.9020000000000437,"text":"아 감사합니다ㅎㅎ!!"},{"start":698.197,"duration":3.102999999999952,"text":"근데... 휴가를 내고 연평도까지 오냐...??"},{"start":701.3,"duration":2.536000000000058,"text":"너 진짜 대단하다"},{"start":703.836,"duration":1.3009999999999309,"text":"회사에서 알고 있지?"},{"start":705.138,"duration":0.8009999999999309,"text":"알고 있어ㅎㅎ"},{"start":705.939,"duration":1.2670000000000528,"text":"- 쯔양 님 보러 온 거? - 웅"},{"start":718.317,"duration":2.7029999999999745,"text":"좀 놀랄 정도로 맛있다...!"},{"start":721.02,"duration":2.7690000000000055,"text":"고기 육즙도 어느 정도 있고요"},{"start":723.789,"duration":2.937000000000012,"text":"바삭함은 제대로인데 부드러워요"},{"start":742.208,"duration":2.969000000000051,"text":"돈가스 쪽은 10년 넘게 납품했죠"},{"start":745.177,"duration":2.2690000000000055,"text":"소불고기, 수제 돈가스"},{"start":747.446,"duration":3.7369999999999663,"text":"홈플러스, 롯데마트, 백화점에 다 납품하고 다녔어요"},{"start":751.183,"duration":2.7029999999999745,"text":"저는 솔직히 수제라고 생각도 못 한 게"},{"start":753.886,"duration":4.071000000000026,"text":"메뉴가 400개인데 수제라니ㅎㅋ"},{"start":757.957,"duration":2.7690000000000055,"text":"그래서 돈가스가 맛있구나~?"},{"start":760.726,"duration":2.769999999999982,"text":"뭐야, 메뉴 나오면 다 한 번에 순삭하네"},{"start":763.496,"duration":2.2690000000000055,"text":"맛있어"},{"start":765.765,"duration":2.40300000000002,"text":"혹시 떡볶이 돼요?"},{"start":768.168,"duration":1.66700000000003,"text":"정말요? 감사합니다"},{"start":769.835,"duration":1.5349999999999682,"text":"떡볶이 진짜 먹고 싶었어"},{"start":778.744,"duration":1.134999999999991,"text":"감사합니다"},{"start":780.112,"duration":2.3350000000000364,"text":"딱 분식집에서 나오는 떡볶이네"},{"start":782.448,"duration":3.8039999999999736,"text":"떡볶이 제가 1인분만 부탁드려서 해주셨습니다"},{"start":795.394,"duration":1.8690000000000282,"text":"옛날 분식집 떡볶이인데..."},{"start":797.263,"duration":3.2369999999999663,"text":"간이 좀 약한...? 그런 떡볶이일 줄 알았거든요"},{"start":800.5,"duration":1.7010000000000218,"text":"아주 자극적이고 얼큰해요"},{"start":812.945,"duration":1.634999999999991,"text":"와 매워...!"},{"start":814.58,"duration":1.4349999999999454,"text":"매워!"},{"start":842.608,"duration":3.0370000000000346,"text":"엄청 정성스레 타주시는 거 봤어요"},{"start":845.645,"duration":2.268000000000029,"text":"자두 에이드, 파인애플주스, 수박 주스"},{"start":847.914,"duration":1.5339999999999918,"text":"감사합니다, 오 수박 주스"},{"start":854.22,"duration":1.5679999999999836,"text":"여름 수박 최고"},{"start":855.788,"duration":1.6019999999999754,"text":"아 근데 여기 라면 없지...?"},{"start":857.39,"duration":2.1019999999999754,"text":"사장님 여기 라면은 없죠...?"},{"start":859.492,"duration":1.7010000000000218,"text":"있어요ㅎㅎㅎ!"},{"start":861.193,"duration":1.268000000000029,"text":"해주실 수 있나요...?"},{"start":862.461,"duration":2.1359999999999673,"text":"여긴 짜장면 빼고 다 팔아요"},{"start":864.597,"duration":1.4680000000000746,"text":"짜장면 빼고 다 판다고요?"},{"start":866.065,"duration":1.100999999999999,"text":"모든 음식이 다 있어"},{"start":867.166,"duration":3.102999999999952,"text":"요거... 흰밥 딱 있거든요! 돈가스에 있는 거"},{"start":870.836,"duration":1.0009999999999764,"text":"넣고"},{"start":878.111,"duration":2.0679999999999836,"text":"이거 진짜 고소하겠는데?"},{"start":880.746,"duration":2.036000000000058,"text":"참기름 범벅을 해주셨어"},{"start":882.782,"duration":1.802000000000021,"text":"바로... 와! 고소한 냄새"},{"start":885.017,"duration":1.4349999999999454,"text":"그냥 참기름은 아닌 거 같아...!"},{"start":888.02,"duration":1.0670000000000073,"text":"엄청 고소한..."},