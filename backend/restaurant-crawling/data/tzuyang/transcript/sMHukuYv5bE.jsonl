:1,"text":"밥에 넣고"},{"start":849.39,"duration":3.07000000000005,"text":"아니 불고기 3kg이라고 그래서"},{"start":852.462,"duration":2.8079999999999927,"text":"사실 저 소고기나 돼지고기 3kg은"},{"start":855.271,"duration":1.2990000000000919,"text":"순식간에 먹거든요"},{"start":856.572,"duration":2.4329999999999927,"text":"불고기는 양념이 되어있잖아요"},{"start":859.007,"duration":2.438000000000102,"text":"사실 3kg까지는 많이 먹기 힘들어요"},{"start":861.447,"duration":1.1929999999999836,"text":"좀 긴장했거든요"},{"start":862.641,"duration":1.6040000000000418,"text":"'아 다 못 먹을 것 같은데' 이러면서"},{"start":864.247,"duration":2.133000000000038,"text":"진짜 술술 넘어간다"},{"start":871.62,"duration":4.789999999999964,"text":"뭐 했다고 벌써 마지막이야?"},{"start":876.4110000000001,"duration":1.2089999999999463,"text":"진짜 순식간이네"},{"start":877.622,"duration":2.4680000000000746,"text":"뚝배기불고기 근본은 당면이지"},{"start":894.54,"duration":3.5,"text":"진짜 이 당면 어디 거지?"},{"start":898.0409999999999,"duration":2.439000000000078,"text":"당면 진짜 맛있어"},{"start":900.482,"duration":2.6280000000000427,"text":"잡채밥 하기 좋은 당면이라니까요"},{"start":910.45,"duration":2.2099999999999227,"text":"여기가 안 질리기로는 1등인 것 같아요"},{"start":912.661,"duration":1.399000000000001,"text":"이제 간이 세서"},{"start":914.061,"duration":2.3689999999999145,"text":"내가 여러 번 말했네, 오늘 이 얘기 한 열 번 했어"},{"start":916.431,"duration":1.399000000000001,"text":"안 물려"},{"start":917.832,"duration":1.2279999999999518,"text":"물리지가 않아"},{"start":919.7,"duration":1.4499999999999318,"text":"완전 국밥이야"},{"start":929.01,"duration":4.176000000000045,"text":"나머지를"},{"start":933.188,"duration":0.8920000000000528,"text":"제가 워낙에"},{"start":934.082,"duration":2.727999999999952,"text":"80년 전통, 100년 전통, 120년 전통"},{"start":936.811,"duration":1.1089999999999236,"text":"이렇게 가니까"},{"start":937.921,"duration":1.8289999999999509,"text":"사실 20년 하면은"},{"start":939.752,"duration":2.2380000000000564,"text":"뭔가 그렇게 많아 보인다는 느낌은 없었는데"},{"start":941.992,"duration":1.7980000000000018,"text":"생각해 보면 제가"},{"start":943.7909999999999,"duration":1.7290000000000418,"text":"10살 때부터 있었던 곳이잖아요"},{"start":945.521,"duration":2.469000000000051,"text":"초등학교 때 맛있게 먹었던 곳 중에"},{"start":947.992,"duration":2.298000000000002,"text":"지금까지 장사하는 곳 진짜 잘 없거든요"},{"start":950.2909999999999,"duration":3.469000000000051,"text":"진짜 20년만 해도 사실..."},{"start":955.95,"duration":1,"text":"맛있다"},{"start":968.68,"duration":1.400000000000091,"text":"와 이게 또 엑기스지"},{"start":1006.02,"duration":3.1000000000000227,"text":"흐에에에에에엑"},{"start":1009.122,"duration":2.838000000000079,"text":"대단하세요, 진짜 다 드시는구나..."},{"start":1013.6659999999999,"duration":1.4940000000000282,"text":"저희 신랑인데"},{"start":1015.1610000000001,"duration":1.7989999999999782,"text":"건대 축산대 나왔어요ㅎㅎ"},{"start":1016.962,"duration":2.3880000000000337,"text":"그래서 고기가 좋구나"},{"start":1019.352,"duration":1.7480000000000473,"text":"'78학번 축산대'"},{"start":1022.07,"duration":3.299999999999841,"text":"사장님 너무 맛있게 잘 먹었습니다"},{"start":1025.371,"duration":3.6989999999998417,"text":"여기가 특징이 뭔가 맛이 강하지 않고"},{"start":1029.071,"duration":3.0389999999999873,"text":"잘 어우러져서 계속 넘어가는 맛이거든요"},{"start":1032.111,"duration":2.7690000000000055,"text":"느끼하거나 짜거나 입이 달거나"},{"start":1034.882,"duration":1.52800000000002,"text":"지금 이런 게 하나도 없어요"},{"start":1036.412,"duration":2.63799999999992,"text":"오히려 뭔가 되게 개운하고 깔끔한 느낌?"},{"start":1039.051,"duration":4.704000000000178,"text":"제가 생각하는 불고기랑은 완전 달랐던 것 같아요"},{"start":1043.757,"duration":5.032999999999902,"text":"아무튼 오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
