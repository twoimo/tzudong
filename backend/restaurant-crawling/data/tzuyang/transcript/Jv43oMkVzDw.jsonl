.399000000000001,"text":"국물 먹을 때마다 톡톡톡톡톡 터지는데"},{"start":605.299,"duration":1.899000000000001,"text":"구수한 국물인데?"},{"start":607.2,"duration":3.048000000000002,"text":"구수하고 시원한!"},{"start":613.75,"duration":1.2980000000000018,"text":"아 좋다"},{"start":615.049,"duration":2.4990000000000236,"text":"돌이 좀 좋은 거 같아요, 확실히"},{"start":617.549,"duration":0.9990000000000236,"text":"계속 끓고"},{"start":618.549,"duration":0.8990000000000009,"text":"계속 뜨겁고"},{"start":619.45,"duration":0.9979999999999336,"text":"계속 연기 나고"},{"start":620.45,"duration":2.197999999999979,"text":"어디에다가 하느냐에 따라서 또 맛이 다르거든요?"},{"start":622.649,"duration":2.399000000000001,"text":"돌솥은 돌솥만의 맛이 있는데"},{"start":625.049,"duration":4.199000000000069,"text":"진짜 속까지 뜨끈해지는 그런 맛이에요"},{"start":629.25,"duration":1.4980000000000473,"text":"알도 맛있으려나?"},{"start":649.598,"duration":1.150000000000091,"text":"맛있어"},{"start":652.048,"duration":7.0499999999999545,"text":"김치알밥 하려고"},{"start":659.1,"duration":4.298000000000002,"text":"뒤집어! 김치가 익도록 냅두겠습니다"},{"start":671.798,"duration":2,"text":"국물이 같이 이렇게 후루룩 들어오잖아요"},{"start":673.799,"duration":3.949000000000069,"text":"그러면 알이 원래 살짝 빡빡한 느낌이 들어야 되는데"},{"start":677.75,"duration":2.697999999999979,"text":"국물에 알이 막 흩어져요! 입안으로"},{"start":695.498,"duration":3.599999999999909,"text":"살짝 이렇게 말아서"},{"start":699.1,"duration":1.8980000000000246,"text":"이거 알탕 진짜 맛있다!"},{"start":707.298,"duration":0.75,"text":"알탕이"},{"start":708.049,"duration":2.199000000000069,"text":"알이 큼직하게 진짜 많이 들어가 있거든요"},{"start":710.25,"duration":1.5979999999999563,"text":"근데 알탕 가격이 진짜 괜찮았어요"},{"start":711.85,"duration":1.8479999999999563,"text":"알탕 1만 4,000원이거든요"},{"start":713.7,"duration":1.3479999999999563,"text":"진짜 괜찮다"},{"start":715.049,"duration":3.399000000000001,"text":"사실 우동도 1만 4,000원 하면 좀..."},{"start":718.45,"duration":2.4979999999999336,"text":"약간 금액대가 많이 있어 보이잖아요, 사실 여기가"},{"start":720.95,"duration":0.9979999999999336,"text":"서래마을이라서..."},{"start":721.95,"duration":3.5979999999999563,"text":"여기는 서래마을 중에서도 약간 가성비가 있는 집입니다!"},{"start":725.549,"duration":2.699000000000069,"text":"물론 '우동 1만 4,000원이 어떻게 가성비야' 할 수 있겠지만"},{"start":728.25,"duration":3.3479999999999563,"text":"그래도 안에 고구마튀김 2개에..."},{"start":731.6,"duration":3.197999999999979,"text":"새우튀김에... 어묵에... 이것저것 들어가니까"},{"start":734.799,"duration":2.899000000000001,"text":"어? 알 간장이 있었네"},{"start":750.398,"duration":1.1999999999999318,"text":"아 끝내줘"},{"start":754.149,"duration":0.9990000000000236,"text":"맛있겠다"},{"start":767.298,"duration":2.7999999999999545,"text":"김치의 상큼함이 딱 가미돼서"},{"start":770.1,"duration":0.8980000000000246,"text":"아주 좋아요!"},{"start":773.5,"duration":1.8479999999999563,"text":"마늘도 하나 넣고"},{"start":781.598,"duration":2.75,"text":"요즘에 진짜 알 이렇게까지 많이 넣어주는 곳 없거든요"},{"start":784.35,"duration":1.3980000000000246,"text":"알이 빽빽해요, 진짜"},{"start":785.75,"duration":1.6480000000000246,"text":"밥 반, 알 반"},{"start":787.399,"duration":2.649000000000001,"text":"알밥 말아 먹으면 별로이려나...?"},{"start":790.05,"duration":2.7480000000000473,"text":"몰라, 맛있지 않을까?"},{"start":792.799,"duration":2.149000000000001,"text":"완전 알알밥인 거지"},{"start":799.898,"duration":1.1999999999999318,"text":"너무 맛있는데??"},{"start":810.298,"duration":1.75,"text":"전복죽이랑..."},{"start":812.049,"duration":3.2490000000000236,"text":"사장님 혹시 대구매운탕이 나을까요"},{"start":815.299,"duration":1.2989999999999782,"text":"도미매운탕이 나을까요?"},{"start":816.6,"duration":1.0480000000000018,"text":"아~ 오늘은 대구매운탕이요!"},{"start":817.649,"duration":1.899000000000001,"text":"- 대구매운탕이요? 그럼 대구매운탕으로 부탁드립니다! - 네"},{"start":819.549,"duration":1.4490000000000691,"text":"아우~ 8개??"},{"start":821,"duration":3.3479999999999563,"text":"와 신기하네요, 진짜"},{"start":824.35,"duration":2.048000000000002,"text":"맛있겠다, 감사합니다"},{"start":826.399,"duration":3.2490000000000236,"text":"이 뚝배기는 얼마나 강한 걸까?"},{"start":829.649,"duration":1.1989999999999554,"text":"대구 제대로인데?"},{"start":833.048,"duration":2.2999999999999545,"text":"와...! 색깔이! 색깔이 너무 좋아요"},{"start":837.149,"duration":1.3490000000000464,"text":"색깔 너무 좋아"},{"start":844.248,"duration":2.3999999999999773,"text":"진짜 살이 탱글! 탱글!"},{"start":846.649,"duration":1.7490000000000236,"text":"너무 탱글탱글하잖아...!"},{"start":855.098,"duration":1.0500000000000682,"text":"뜨거워"},{"start":865.898,"duration":2.7999999999999545,"text":"알탕, 대구매운탕 강추!"},{"start":868.7,"duration":3.3479999999999563,"text":"엄청 큰 대구인데 살이 입에서 녹아요"},{"start":872.049,"duration":2.2490000000000236,"text":"약간 매끄덩 하면서 녹는다고 해야 되나?"},{"start":876.998,"duration":1.9499999999999318,"text":"아... 시원하다..."},{"start":895.898,"duration":3.25,"text":"살을 모아서 한입에 먹을래"},{"start":899.149,"duration":1.2490000000000236,"text":"너무 맛있겠지?"},{"start":913.848,"duration":2.050000000000068,"text":"이제 슬슬 먹어봐야 되는 전복죽!"},{"start":915.899,"duration":1.8490000000000464,"text":"어서 오세요"},{"start":927.698,"duration":2.9500000000000455,"text":"어우 쫄깃해! 전복이 다 들어가 있고"},{"start":930.649,"duration":1.6989999999999554,"text":"되게 엄청 고소한 맛이에요"},{"start":932.35,"duration":1.5480000000000018,"text":"들기름 같은 그런 맛인데??"},{"start":937.848,"duration":1.8500000000000227,"text":"이거 먹으면 먹을수록 맛있다"},{"start":939.7,"duration":4.048000000000002,"text":"10곳 가면 1곳 마음에 들까 말까 하는데..."},{"start":943.75,"duration":2.048000000000002,"text":"사실 여기도 딱 처음 먹었을 때"},{"start":945.799,"duration":1.5990000000000464,"text":"그 1곳은 아니었거든요"},{"start":947.399,"duration":2.149000000000001,"text":"먹으면 먹을수록 입에서 엄청 고소하다"},{"start":949.549,"duration":2.199000000000069,"text":"진짜 매력 있는 전복죽이에요"},{"start":956.648,"duration":2.25,"text":"죽에다 낙지젓갈을 안 넣다니"},{"start":970,"duration":0.9479999999999791,"text":"아따 맛있네"},{"start":981.948,"duration":2.1499999999999773,"text":"됴 이지"},{"start":984.1,"duration":2.697999999999979,"text":"살을... 뼈를 다 발라서"},{"start":986.799,"duration":1.649000000000001,"text":"푹푹 퍼먹어야 맛있거든요"},{"start":992.048,"duration":1.25,"text":"으깨듯이 이렇게"},{"start":1009.799,"duration":0.8490000000000464,"text":"잘 먹었습니다"},{"start":1010.649,"duration":3.298999999999978,"text":"8뚝배기면 뭐 나쁘지 않네"},{"start":1013.95,"duration":1.2479999999999336,"text":"다 먹었어요!!"},{"start":1015.2,"duration":1.2479999999999336,"text":"허허허허허"},{"start":1016.45,"duration":1.5979999999999563,"text":"대단하시네"},{"start":1018.049,"duration":4.298999999999978,"text":"어우 놀랐어요, 진짜 다 드시네!"},{"start":1022.35,"duration":2.09800000000007,"text":"전체적으로 다 너무 맛있고..."},{"start":1024.45,"duration":1.8979999999999109,"text":"특히 저는 탕 종류가 진짜 맛있었어요"},{"start":1026.35,"duration":1.1480000000001382,"text":"알탕이랑..."},{"start":1027.5,"duration":4.998000000000047,"text":"매운탕이 진짜 좀 깜짝 놀랄 정도로 맛있게 먹었고"},{"start":1032.5,"duration":4.748000000000047,"text":"알밥도 알 조금 들어가는 게 아니라 진짜 가득 넣어줘서"},{"start":1037.25,"duration":3.548000000000002,"text":"진짜 푸짐하게 넣은 알밥이어서 굉장히 맛있게 먹었습니다"},{"start":1040.799,"duration":5.149000000000115,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
