{"youtube_link":"https://www.youtube.com/watch?v=jEROOI-A-9A","channel_name":"tzuyang","language":"ko","collected_at":"2026-03-14T23:19:12.127+09:00","transcript":[{"start":23.901,"duration":0.7989999999999995,"text":"대박인데?"},{"start":24.702,"duration":0.7479999999999976,"text":"대단해..."},{"start":25.452,"duration":0.5479999999999983,"text":"왘!"},{"start":26.002,"duration":0.6479999999999997,"text":"어메이징..."},{"start":26.651,"duration":1.399000000000001,"text":"으흫ㅎ하ㅏㅏ핳ㅎ핳ㅎㅎㅎ"},{"start":36.452,"duration":2.4980000000000047,"text":"제가 오늘은 홍콩에 왔습니다"},{"start":40.152,"duration":3.647999999999996,"text":"진짜 여기는 건물이랑 분위기부터가 달라요"},{"start":43.802,"duration":3.6980000000000004,"text":"삼수이포 인근에 있는 스테이크집을 먹으러 왔습니다"},{"start":47.502,"duration":2.7479999999999976,"text":"제가 해산물을 보여드릴게요, 진짜 깜짝 놀라실걸요?"},{"start":50.252,"duration":0.9480000000000004,"text":"이거 엄청 커!"},{"start":51.202,"duration":3.6980000000000004,"text":"제대로 된 홍콩 음식을 즐기러 왔습니다"},{"start":54.902,"duration":1.7980000000000018,"text":"70년 정도 된 곳이거든요"},{"start":56.702,"duration":1.847999999999999,"text":"완전 로컬 느낌이거든요?"},{"start":58.552,"duration":1.847999999999999,"text":"그냥 피자가 아니라 대왕 피자예요"},{"start":60.402,"duration":1.7980000000000018,"text":"저 진짜 40분 안에 못 먹을 것 같아요"},{"start":62.202,"duration":1.8979999999999961,"text":"딤섬을 먹으러 왔습니다"},{"start":64.101,"duration":1.8490000000000038,"text":"드디어 딤섬을 먹으러 왔어요"},{"start":65.952,"duration":2.298000000000002,"text":"제가 100만 원 정도 두둑이 챙겨왔는데"},{"start":68.252,"duration":1.3980000000000103,"text":"한번 다 써볼까?"},{"start":105.601,"duration":1.7990000000000066,"text":"안녕하세요 여러분"},{"start":107.402,"duration":1.0480000000000018,"text":"제가 오늘은"},{"start":108.452,"duration":2.597999999999999,"text":"홍콩의 삼수이포 인근에 있는"},{"start":111.051,"duration":1.7989999999999924,"text":"스테이크집을 먹으러 왔습니다"},{"start":112.851,"duration":2.7489999999999952,"text":"제가 옛날 대만에서 철판스테이크 먹었었거든요"},{"start":115.601,"duration":1.198999999999998,"text":"그런 거처럼"},{"start":116.801,"duration":2.899000000000001,"text":"철판스테이크 파는 곳이 좀 많은데"},{"start":119.702,"duration":2.347999999999999,"text":"사장님께서 다행히 양해를 해주셔서"},{"start":122.051,"duration":2.2489999999999952,"text":"가게를 또 1시간 일찍 열어주셨어요"},{"start":124.301,"duration":2.198999999999998,"text":"왜냐면 여기가 손님이 워낙 많은 곳이라서"},{"start":126.502,"duration":2.3980000000000103,"text":"여기 스테이크집이 진짜 유명한 곳이거든요?"},{"start":128.902,"duration":1.6480000000000246,"text":"스타분들도 정말 많이 오시고"},{"start":130.552,"duration":1.8979999999999961,"text":"1969년에 오픈했으니까"},{"start":132.452,"duration":1.7980000000000018,"text":"지금 57년 전통인 곳인데"},{"start":134.252,"duration":2.0979999999999848,"text":"2대째 사장님이 또 하고 계신대요"},{"start":136.352,"duration":2.0979999999999848,"text":"철판스테이크 중에선 정말"},{"start":138.452,"duration":4.798000000000002,"text":"원조 중에 1곳이라고 불릴 정도로 되게 유명한 곳인데"},{"start":143.252,"duration":2.147999999999996,"text":"빨리 먹어야 되니까 일단 가볼게요!"},{"start":151.752,"duration":1.9979999999999905,"text":"스테이크 제일 많이 드신 분은..."},{"start":153.752,"duration":0.8979999999999961,"text":"3개 정도?"},{"start":156.602,"duration":1.7980000000000018,"text":"어제 유튜브에서 봤어요ㅎ"},{"start":160.7,"duration":2.950000000000017,"text":"여기 1대 사장님이신가...?"},{"start":163.652,"duration":1.4980000000000189,"text":"가장 많이 드시는 건"},{"start":165.152,"duration":1.8980000000000246,"text":"필렛스테이크랑"},{"start":167.052,"duration":4.248000000000019,"text":"노블스테이크 이렇게 2개를 추천드립니다"},{"start":171.302,"duration":2.147999999999996,"text":"이거 하나 주시고요..."},{"start":173.452,"duration":6.147999999999996,"text":"세례...)"},{"start":181.702,"duration":1.9979999999999905,"text":"저는 여기 사장 언니예요!"},{"start":188.352,"duration":3.2479999999999905,"text":"홍콩에 오신 걸 환영합니다!"},{"start":248.702,"duration":1.2980000000000018,"text":"여자분이면 더더욱!"},{"start":250.002,"duration":2.2479999999999905,"text":"스테이크 1판도 보통 여자분은 다 못 드세요"},{"start":276.752,"duration":2.197999999999979,"text":"그리고 양이 진짜 많다!"},{"start":293.852,"duration":2.1480000000000246,"text":"우와 양 진짜 많다!"},{"start":296.002,"duration":1.0480000000000018,"text":"얘가 후추소스"},{"start":297.052,"duration":1.2980000000000018,"text":"얘가 마늘소스거든요?"},{"start":298.352,"duration":1.7980000000000018,"text":"소스 제가 한번 비교도 해볼게요"},{"start":300.152,"duration":2.548000000000002,"text":"잘 먹겠습니다~!"},{"start":302.702,"duration":2.1480000000000246,"text":"얘가 또 시그니처래요"},{"start":323.1,"duration":1.3999999999999773,"text":"너무 맛있다..."},{"start":324.502,"duration":1.2479999999999905,"text":"다 못 먹을 것 같은데..."},{"start":325.752,"duration":1.6479999999999677,"text":"혼자서 다 드시는 거예요?"},{"start":337.2,"duration":3.0500000000000114,"text":"진짜 입에서 너무 부드럽게 녹아요"},{"start":344.252,"duration":2.798000000000002,"text":"시그니처인 이유를 바로 알겠다"},{"start":347.052,"duration":2.548000000000002,"text":"안에 이거 보이세요, 이 자태가?"},{"start":355.45,"duration":1.4499999999999886,"text":"와 제가..."},{"start":369.3,"duration":2.0500000000000114,"text":"- - 하나만 다 먹고 얘기할게요"},{"start":375.452,"duration":2.6480000000000246,"text":"말캉말캉해요, 약간 식감이"},{"start":378.102,"duration":1.8980000000000246,"text":"막 녹는 맛은 아닌데"},{"start":380.002,"duration":2.947999999999979,"text":"몰캉몰캉한 고기 식감이 진짜"},{"start":382.952,"duration":1.5480000000000018,"text":"진짜 예술이다"},{"start":384.502,"duration":1.0980000000000132,"text":"하나도 안 질기고"},{"start":385.602,"duration":2.798000000000002,"text":"300g 좀 더 될 것 같은데 진짜 순삭했어요"},{"start":389.6,"duration":4.399999999999977,"text":"- - 너무 부드럽다"},{"start":394.002,"duration":0.6979999999999791,"text":"처음에 먹었을 때"},{"start":394.702,"duration":2.3980000000000246,"text":"'어 약간 카레랑 살짝 비슷하네'라고 느꼈던 게"},{"start":397.102,"duration":1.8480000000000132,"text":"원래 카레에 후추 향이 강하잖아요"},{"start":398.952,"duration":2.3980000000000246,"text":"고기가 살짝 느끼할 수 있는데 이거를"},{"start":401.352,"duration":2.9980000000000473,"text":"다 후추 향으로 잡아줘서"},{"start":404.352,"duration":2.7480000000000473,"text":"진짜 느끼함도 훨씬 덜하고 맛있네요"},{"start":407.102,"duration":2.6480000000000246,"text":"마늘 맛, 얘는 마늘 맛이거든요?"},{"start":409.752,"duration":3.197999999999979,"text":"마늘 맛을 먹어야 하니까 양고기를..."},{"start":427.1,"duration":2.3999999999999773,"text":"여기 고기가 왜 다 말캉말캉하지?"},{"start":429.502,"duration":2.848000000000013,"text":"퍽퍽함이나 결 같은 게 하나도 없고"},{"start":432.352,"duration":4.598000000000013,"text":"뭔가 그 고기에 뭔가 그..."},{"start":441.45,"duration":2.3000000000000114,"text":"양 못 드시는 분들이 오히려 드실 수 있을 것 같아요"},{"start":443.752,"duration":2.298000000000002,"text":"이게 양 향이 진짜"},{"start":446.052,"duration":2.6479999999999677,"text":"엄청 미세하게 나는 수준?"},{"start":457.75,"duration":1.4499999999999886,"text":"진짜 맛있다"},{"start":462.1,"duration":0.5,"text":"와..."},{"start":462.602,"duration":2.098000000000013,"text":"만석이에요, 오픈하자마자 만석"},{"start":464.702,"duration":1.947999999999979,"text":"진짜 인기가 많은 곳이구나"},{"start":468.85,"duration":1.8999999999999773,"text":"홍콩 하면 역시 밀크티죠"},{"start":470.752,"duration":1.3979999999999677,"text":"어딜 와서 먹어도 맛있다"},{"start":472.152,"duration":3.1480000000000246,"text":"마늘소스는 후추랑 완전 다르네"},{"start":475.302,"duration":2.0979999999999563,"text":"후추 칼칼한 맛 안 좋아하시는 분들은"},{"start":477.402,"duration":2.548000000000002,"text":"마늘소스 드시면 될 것 같은데"},{"start":497.65,"duration":2.8000000000000114,"text":"그런데 마늘은 알싸하게 강하지 않고"},{"start":500.452,"duration":1.947999999999979,"text":"그 마늘 특유의 단맛이랑"},{"start":502.402,"duration":4.2479999999999905,"text":"약간 특유의 마늘 향이랑 섞여서"},{"start":506.652,"duration":3.1480000000000246,"text":"되게 약간 후추보다는 훨씬 크리미한 느낌?"},{"start":509.802,"duration":3.798000000000002,"text":"아까 스테이크 서빙 완료된 사진을"},{"start":513.602,"duration":4.197999999999979,"text":"가족들 단톡방에다가 공유했었는데"},{"start":521.852,"duration":4.148000000000025,"text":"시아버님도 혼자 먹는다니 대단하다고 놀라셨어요"},{"start":526.002,"duration":2.3980000000000246,"text":"엄청 부드러운 부위라고 하셔서 기대하고 시켰어요"},{"start":528.401,"duration":2.3490000000000464,"text":"약간 등심 같아요, 등심"},{"start":543.45,"duration":1.599999999999909,"text":"이거는 등심스테이크인데"},{"start":545.051,"duration":3.048999999999978,"text":"우리가 딱 생각하는 그 등심!"},{"start":548.102,"duration":2.8980000000000246,"text":"다른 거는 뭔가 몰캉몰캉하면서 되게 부드러운데"},{"start":551.002,"duration":2.1980000000000928,"text":"얘는 확실히 고기 식감이 있어요"},{"start":568.45,"duration":1.599999999999909,"text":"여기다가 마늘을..."},{"start":593.3,"duration":2.25,"text":"애호박이 되게 말캉말캉..."},{"start":598.95,"duration":1.5,"text":"왜 맛있지?"},{"start":600.452,"duration":1.5979999999999563,"text":"엄청 촉촉하네?"},{"start":617.25,"duration":1.2999999999999545,"text":"이 녀석..."},{"start":618.551,"duration":2.4489999999999554,"text":"양고기가 히든 메뉴였어, 진짜"},{"start":633.7,"duration":2.5,"text":"진짜 해외 맛집 검색할 때..."},{"start":636.202,"duration":2.548000000000002,"text":"1곳 찾는 데 몇 시간씩 걸리거든요?"},{"start":638.752,"duration":3.59800000000007,"text":"글이랑 이런 걸 보고 제가 골라서 온 곳이거든요."},{"start":642.352,"duration":1.0480000000000018,"text":"너무 만족스럽다"},{"start":643.401,"duration":2.2490000000000236,"text":"이건 치킨입니다"},{"start":645.651,"duration":1.1990000000000691,"text":"맛있겠다"},{"start":646.852,"duration":1.5480000000000018,"text":"잘 먹겠습니다"},{"start":659.4,"duration":1.4500000000000455,"text":"진짜 살이..."},{"start":660.852,"duration":1.5480000000000018,"text":"말캉말캉 야들야들"},{"start":662.401,"duration":3.149000000000001,"text":"진짜 이만한 닭 다리를 분해해 놓은 건가?"},{"start":665.551,"duration":3.149000000000001,"text":"부드러운 식감에다가 촉촉하기까지 하고"},{"start":668.702,"duration":2.8479999999999563,"text":"여기 소스가 진짜 맛있다"},{"start":677.1,"duration":1.1000000000000227,"text":"진짜 맛있어요!"},{"start":679.252,"duration":2.048000000000002,"text":"체하지 않게 천천히 드세요!"},{"start":694.3,"duration":3.3500000000000227,"text":"겉에 껍질은 바삭한 껍질은 아니고요"},{"start":699.75,"duration":4.75,"text":"육즙 진짜 많고 진짜 말랑 촉촉한..."},{"start":704.502,"duration":1.09800000000007,"text":"오븐치킨에!"},{"start":705.602,"duration":2.34800000000007,"text":"고기양이 일단 진짜 많네요"},{"start":707.952,"duration":3.548000000000002,"text":"일반 많이 못 드시는 분들은"},{"start":711.502,"duration":4.398000000000025,"text":"여성분들은 하나 못 드실 것 같아요"},{"start":715.901,"duration":2.299000000000092,"text":"지금 제가 사실 빨리 먹고 싶거든요"},{"start":718.202,"duration":0.8980000000000246,"text":"이게 밖에..."},{"start":719.102,"duration":3.1480000000000246,"text":"웨이팅이 많이 계셔서, 한 10분 정도?"},{"start":722.252,"duration":2.548000000000002,"text":"좀 빨리 스퍼트를 내서 먹어보겠습니다"},{"start":739.65,"duration":7.100000000000023,"text":"와 이게 빵이..."},{"start":747.05,"duration":2.7000000000000455,"text":"닭을 넣어서..."},{"start":765.8,"duration":0.900000000000091,"text":"이거를..."},{"start":774.85,"duration":2.8999999999999773,"text":"우리나라에서 수프랑 크게 다를 게 없어요"},{"start":777.752,"duration":2.2480000000000473,"text":"이게 백후추였네?"},{"start":786.3,"duration":1.5,"text":"수프 아주 좋습니다"},{"start":787.801,"duration":3.0989999999999327,"text":"한국인 입맛에 아주 익숙한 크림수프예요"},{"start":790.901,"duration":1.399000000000001,"text":"스테이크는 따듯한 게 맛있으니까"},{"start":792.301,"duration":1.7989999999999782,"text":"조금씩 데워서 먹고 있습니다"},{"start":796.9,"duration":3.300000000000068,"text":"이게 소의 어깨 살 쪽이라고 하는데"},{"start":801.3,"duration":0.75,"text":"신기하네"},{"start":809.3,"duration":3.3500000000000227,"text":"얘 아까 처음에 먹었던 필렛이랑 되게 비슷하다"},{"start":817.55,"duration":1.8500000000000227,"text":"얘는 좀 더 쫄깃 말캉이면"},{"start":819.401,"duration":2.299000000000092,"text":"필렛스테이크는 좀 더 부드러운 말캉이었어요"},{"start":821.702,"duration":2.5979999999999563,"text":"살짝 다른데 거의 흡사한?"},{"start":836.45,"duration":2.75,"text":"보니까 밀크티를 따듯한 걸 많이 드시더라고요?"},{"start":839.202,"duration":1.3479999999999563,"text":"좀 만드는 방법도 특이하고?"},{"start":840.551,"duration":10.49899999999991,"text":"따뜻한 걸 한번 시켜볼게요"},{"start":853.15,"duration":1,"text":"아 설탕 더 필요해"},{"start":854.151,"duration":2.199000000000069,"text":"오 맛있다"},{"start":856.352,"duration":1.2480000000000473,"text":"안 단데 맛있다!"},{"start":857.602,"duration":1.2980000000000018,"text":"돼지!"},{"start":858.901,"duration":1.4990000000000236,"text":"한번 먹어볼까?"},{"start":868.3,"duration":1,"text":"너무 맛있다"},{"start":873.15,"duration":3.3999999999999773,"text":"돈가스인데 엄청 고소한 돈가스에 튀김옷이 없어요"},{"start":876.551,"duration":3.5989999999999327,"text":"와 돼지도 진짜 맛있다, 이걸 어떻게 추천해야 돼?"},{"start":880.151,"duration":0.5490000000000919,"text":"다 맛있는데"},{"start":880.702,"duration":1.697999999999979,"text":"닭도 맛있고 돼지도 맛있고 소도 맛있고"},{"start":882.401,"duration":1.649000000000001,"text":"양도 맛있으면 어떡해?"},{"start":884.051,"duration":3.649000000000001,"text":"와 여기 뼈도 같이 있거든요?"},{"start":896.9,"duration":1.8999999999999773,"text":"이거 심지어 불 향도 너무 좋아"},{"start":898.801,"duration":1.149000000000001,"text":"너무 맛있다"},{"start":910.1,"duration":3.6000000000000227,"text":"두껍게 조리하면 엄청 퍽퍽해야 정상이거든요?"},{"start":913.702,"duration":2.9980000000000473,"text":"근데 이거는 무슨 닭고기처럼 부드러워요"},{"start":916.702,"duration":2.798000000000002,"text":"전체적으로 모든 요리가"},{"start":919.502,"duration":2.7480000000000473,"text":"부드럽게 조리가 잘됐어요, 정말 부드럽게"},{"start":922.252,"duration":3.3980000000000246,"text":"이제 티본을 먹어볼까, 티본도 제대로네"},{"start":925.651,"duration":3.2490000000000236,"text":"티본이 이게 등심, 여기가 안심이거든요?"},{"start":928.901,"duration":1.7490000000000236,"text":"두 가지 부위를 한 번에 먹을 수 있어요"},{"start":930.651,"duration":2.7490000000000236,"text":"티본이 다른 거에 비해 비싸지 않길래"},{"start":933.401,"duration":1.9490000000000691,"text":"좀 되게 작은 티본인가 했는데"},{"start":935.352,"duration":1.8980000000000246,"text":"티본이 굉장히 커서 놀랐어요"},{"start":944.95,"duration":1.6999999999999318,"text":"시그니처 소고기들에 비해서는"},{"start":946.651,"duration":2.149000000000001,"text":"살짝 식감이 있는 편"},{"start":948.801,"duration":3.5989999999999327,"text":"시그니처로 나오는 소고기들이"},{"start":952.401,"duration":1.4990000000000236,"text":"되게 부드러운 거 같아요"},{"start":967.75,"duration":4.5499999999999545,"text":"사실 제가 저거 하나를 포장하고"},{"start":972.301,"duration":2.048999999999978,"text":"진짜 맛있었던 걸로 먹고 싶어서"},{"start":974.352,"duration":1.9980000000000473,"text":"제가 아파트형 숙소라서 데워 먹을 수 있거든요"},{"start":976.352,"duration":2.798000000000002,"text":"그래서 저거를 숙소 가서 따듯하게 데워 먹고"},{"start":979.151,"duration":4.149000000000001,"text":"아 고민돼... 양고기냐 치킨이냐"},{"start":989.901,"duration":1.7490000000000236,"text":"우열을 가릴 수가 없는데?"},{"start":991.651,"duration":1.9490000000000691,"text":"하 나 진짜 고를 수가 없네"},{"start":993.602,"duration":1.59800000000007,"text":"와 진짜 못 고르겠다"},{"start":995.202,"duration":1.5979999999999563,"text":"양고기? 소고기?"},{"start":996.801,"duration":1.399000000000001,"text":"다 너무 먹고 싶어..."},{"start":1004.051,"duration":1.649000000000001,"text":"내가 먹는 상상을 해보자"},{"start":1007.702,"duration":0.9980000000000473,"text":"말랑말랑해"},{"start":1013.352,"duration":2.84800000000007,"text":"시그니처로 가겠습니다, 필렛 주십셔!"},{"start":1019.901,"duration":1.0990000000000464,"text":"1,300만 명...?"},{"start":1021.002,"duration":1.1980000000000928,"text":"예쁘시네요...!"},{"start":1040.65,"duration":1.199999999999818,"text":"아 양고기 먹을 걸 그랬ㄴ..."},{"start":1047.4,"duration":1.449999999999818,"text":"육즙 여기 보이세요?"},{"start":1048.851,"duration":1.7989999999999782,"text":"이렇게 포크에 막 고이는 거?"},{"start":1050.652,"duration":2.4479999999998654,"text":"이거 보이세요?"},{"start":1067.75,"duration":1.400000000000091,"text":"엄청 야들야들해"},{"start":1076.55,"duration":3.9500000000000455,"text":"마늘도 위에 부어서-"},{"start":1093.7,"duration":1.7999999999999545,"text":"뭔가 홍콩 와서는 뭔가"},{"start":1095.502,"duration":3.2480000000000473,"text":"이런 스테이크를"},{"start":1098.752,"duration":2.0979999999999563,"text":"다른 먹어볼 게 너무 많아서"},{"start":1100.851,"duration":2.3989999999998872,"text":"못 드셔보신 분들이 꽤 계실 것 같은데"},{"start":1103.252,"duration":2.5979999999999563,"text":"확실히 한국 스테이크랑은"},{"start":1105.851,"duration":2.9989999999997963,"text":"식감도 그렇고 먹는 방법도 그렇고 소스도 그렇고"},{"start":1108.851,"duration":1.1989999999998417,"text":"완전 달라서"},{"start":1110.052,"duration":4.998000000000047,"text":"굉장히 먹을만하다고 생각해요"},{"start":1122.45,"duration":3.3999999999998636,"text":"대부분 1판 드시고 저렇게 못 드시는데..."},{"start":1129.601,"duration":1.5989999999999327,"text":"- -"},{"start":1131.202,"duration":1.3479999999999563,"text":"보기만 해도 배부르네요..."},{"start":1132.552,"duration":3.548000000000002,"text":"저 콜라만 다 마셔도 배부를 텐데...ㅎ"},{"start":1149.402,"duration":1.8479999999999563,"text":"감사합니다ㅎㅎ"},{"start":1151.252,"duration":1.9480000000000928,"text":"진짜로 거의 다 드셨네요...!"},{"start":1157.402,"duration":2.798000000000002,"text":"콜라도 저만큼 드시다니..."},{"start":1160.5,"duration":2.2000000000000455,"text":"지금 거의 다 먹었는데..."},{"start":1162.702,"duration":2.7480000000000473,"text":"지금 점심시간이 지났는데"},{"start":1165.452,"duration":1.9480000000000928,"text":"아직까지 웨이팅이 있거든요?"},{"start":1167.402,"duration":2.4980000000000473,"text":"제가 빨리 자리를 비워드려야 될 것 같습니다"},{"start":1169.902,"duration":2.548000000000002,"text":"아직도 순위를 못 정했어요..."},{"start":1173.952,"duration":0.7980000000000018,"text":"1등이 양고기"},{"start":1174.752,"duration":2.048000000000002,"text":"2등이 치킨"},{"start":1176.802,"duration":2.0980000000001837,"text":"3등이 필렛스테이크였습니다"},{"start":1178.902,"duration":3.1979999999998654,"text":"근데 셋 다 너무너무 맛있어서 우열을 가릴 수 없었어요"},{"start":1182.101,"duration":3.298999999999978,"text":"오늘도 잘 먹었습니다~!"},{"start":1196.101,"duration":1.5489999999999782,"text":"오늘은 해산물을 먹으러 왔습니다"},{"start":1197.652,"duration":2.548000000000002,"text":"제가 해산물을 보여드릴게요, 진짜 깜짝 놀라실걸요?"},{"start":1200.202,"duration":1.6479999999999109,"text":"엄청 크거든요? 가리비가 이렇게 커요"},{"start":1201.851,"duration":1.4489999999998417,"text":"엄청 큰 코끼리조개도 있고"},{"start":1204.05,"duration":1.0499999999999545,"text":"말도 안 돼"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
