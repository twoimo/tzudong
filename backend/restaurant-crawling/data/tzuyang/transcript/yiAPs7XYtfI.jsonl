ion":1.7000000000000455,"text":"이게 머드크랩인데"},{"start":784.632,"duration":3.5680000000000973,"text":"해외 나가서 머드크랩 제가 여러 번 먹어봤거든요"},{"start":788.202,"duration":1.9279999999999973,"text":"먹어본 머드크랩 중에 제일 맛있어요"},{"start":791.4,"duration":1.3000000000000682,"text":"엄~청 꽉 차있고"},{"start":792.702,"duration":1.4379999999999882,"text":"살이 달아요"},{"start":802.55,"duration":2.800000000000068,"text":"사실 아까 다른 테이블에서"},{"start":805.352,"duration":2.4980000000000473,"text":"다른 음식 먹고 계시길래 여쭤봤는데"},{"start":807.852,"duration":3.368000000000052,"text":"다른 데에서 음식 가져오는 거 괜찮다고 하셔서"},{"start":811.222,"duration":3.0679999999999836,"text":"사실 지금 컵라면 같은 게 너무 먹고 싶거든요"},{"start":814.2909999999999,"duration":2.4090000000001055,"text":"편의점이 저기 있는데"},{"start":816.702,"duration":2.618000000000052,"text":"한번 다녀와 보도록 하겠습니다"},{"start":819.322,"duration":2.008000000000038,"text":"사 왔는데 신라면 하나랑"},{"start":821.332,"duration":2.518000000000029,"text":"여기 POP MIE 진짜 맛있어요"},{"start":823.852,"duration":1.8179999999999836,"text":"저는 이 핫 핑크색 좋아합니다"},{"start":825.671,"duration":1.7789999999999964,"text":"그리고 이건 신기해서 사봤어요"},{"start":827.452,"duration":1.7480000000000473,"text":"POP MIE에서 나온 한국라면이더라고요"},{"start":829.71,"duration":2.3299999999999272,"text":"신라면부터 먹어야겠어"},{"start":835.252,"duration":1.6980000000000928,"text":"너무 감사하다, 물까지"},{"start":839.752,"duration":1.0480000000000018,"text":"빈 껍데기가 많아"},{"start":841.6,"duration":1,"text":"잘 부탁드립니다"},{"start":844.585,"duration":1.2749999999999773,"text":"라면 먹어야 돼, 라면"},{"start":845.862,"duration":2.52800000000002,"text":"제가 인도네시아 음식이 잘 맞아서"},{"start":848.391,"duration":3.408999999999992,"text":"해외 오면 원래 라면을 매일 먹는데 며칠째 라면을 잘 안 먹었거든요"},{"start":851.801,"duration":1.6589999999999918,"text":"되게 오랜만에 먹는 것 같아"},{"start":860.54,"duration":3.07000000000005,"text":"이 특유의 인스턴트 맛"},{"start":863.612,"duration":0.9980000000000473,"text":"좋다"},{"start":878.4,"duration":1,"text":"게살을 얹어서"},{"start":882.25,"duration":6.6200000000000045,"text":"게살라면"},{"start":918.735,"duration":2.6649999999999636,"text":"게살을 안에 이렇게 담아서"},{"start":921.401,"duration":0.9990000000000236,"text":"살을 우려내"},{"start":943.6,"duration":2.8999999999999773,"text":"이거 어떡해"},{"start":946.502,"duration":1.4980000000000473,"text":"완전 난리 났어"},{"start":948.19,"duration":3.669999999999959,"text":"TV 방송 때 너무 후줄근하게 가면 안 되니까"},{"start":951.862,"duration":3.3079999999999927,"text":"아웃렛 가서 산 되게 비싼 옷이거든요"},{"start":955.171,"duration":1.6589999999999918,"text":"가격 듣고 '엥?' 이러고서"},{"start":956.832,"duration":3.6680000000000064,"text":"다시 돌려놓기 민망해서 산 옷인데"},{"start":960.502,"duration":1.768000000000029,"text":"지금 저기서 저희 매니저님이"},{"start":962.271,"duration":1.8690000000000282,"text":"열심히 게를 발라주고 계시는데"},{"start":964.141,"duration":3.1689999999999827,"text":"저거랑 조개랑 같이 양념이랑 볶아서"},{"start":967.311,"duration":1.4689999999999372,"text":"먹으면 되게 맛있을 것 같아서"},{"start":968.781,"duration":1.899000000000001,"text":"다 볶아볼게요!"},{"start":971.4,"duration":1.580000000000041,"text":"아 이거 맛조개 진짜 맛있는 건데"},{"start":972.982,"duration":2.868000000000052,"text":"이거 홍콩에서 먹었던 맛조개잖아요"},{"start":1000.602,"duration":1.70799999999997,"text":"감사합니다!"},{"start":1006.78,"duration":1.6399999999999864,"text":"볶아주신 거 한번 먹어볼까?"},{"start":1010.85,"duration":1,"text":"킹크랩 크기 봐"},{"start":1049.992,"duration":2.7380000000000564,"text":"아마 새벽까지 하는 걸로 알고 있는데"},{"start":1052.732,"duration":1.7380000000000564,"text":"지금 시간이..."},{"start":1054.472,"duration":2.298000000000002,"text":"12시야?"},{"start":1056.772,"duration":2.298000000000002,"text":"영업시간이 언제까지지?"},{"start":1059.0720000000001,"duration":2.1679999999998927,"text":"어머 12시까지네?"},{"start":1061.242,"duration":1.3679999999999382,"text":"7분 남았어요"},{"start":1062.611,"duration":1.8289999999999509,"text":"새벽까진 줄 알았는데..."},{"start":1064.442,"duration":1.3679999999999382,"text":"이건 제가 포장해 가서"},{"start":1065.812,"duration":1.568000000000211,"text":"맛있게 잘 먹도록 하겠습니다"},{"start":1078.351,"duration":1.1489999999998872,"text":"국물 끝내준다"},{"start":1080.23,"duration":1.4600000000000364,"text":"1분 남았어"},{"start":1081.692,"duration":2.367999999999938,"text":"저 때문에 지금 퇴근을 못 하고 계실 것 같아서"},{"start":1084.062,"duration":2.1380000000001473,"text":"제가 빨리 자리를 비워드리겠습니다"},{"start":1086.202,"duration":3.897999999999911,"text":"아무튼 오늘도 잘 먹었습니다~!"},{"start":1090.101,"duration":1.5989999999999327,"text":"감사합니다"},{"start":1091.702,"duration":5.63799999999992,"text":"- 맛있게 잘 먹었습니다 - 감사합니다ㅎㅎ"},{"start":1098.5,"duration":2.910000000000082,"text":"인도네시아 최고 기록이에요"},{"start":1101.412,"duration":2.3379999999999654,"text":"해산물들은 비싸지 않은데"},{"start":1103.752,"duration":1.3679999999999382,"text":"킹크랩이 원래 구하기가 힘들대요"},{"start":1105.121,"duration":1.1289999999999054,"text":"최고 기록을 세웠습니다"},{"start":1123.87,"duration":1,"text":"잘 먹겠습니다"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
