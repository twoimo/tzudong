{"youtube_link":"https://www.youtube.com/watch?v=2gyc0Q7iUw4","channel_name":"tzuyang","language":"ko","collected_at":"2026-07-02T04:44:33.785+09:00","transcript":[{"start":0.001,"duration":1.6,"text":"달인! 라면의 달인"},{"start":7.008,"duration":1.9010000000000007,"text":"근데 저도 중독될 것 같아요 지금"},{"start":25.892,"duration":3.8369999999999997,"text":"국물이 너무 맛있어서 멈출 수가 없어!"},{"start":34.568,"duration":1.7680000000000007,"text":"안녕하세요 여러분"},{"start":36.337,"duration":2.434999999999995,"text":"제가 지금 수원에 왔는데"},{"start":38.773,"duration":1.833999999999996,"text":"여기 성균관대 근처거든요?"},{"start":40.608,"duration":3.3019999999999996,"text":"학생분들이 되게 많이 지나다니시는 거 같더라고요"},{"start":43.911,"duration":1.1999999999999957,"text":"오늘 뭐 먹으러 왔냐면"},{"start":45.112,"duration":1.3009999999999948,"text":"라면 먹으러 왔습니다"},{"start":46.414,"duration":1.533999999999999,"text":"제가 또 라면 매니아잖아요"},{"start":47.949,"duration":2.635000000000005,"text":"전국에 있는 라면가게 다 가보는 게 꿈인데"},{"start":50.585,"duration":1.1539999999999964,"text":"이번엔 수원으로 왔어요"},{"start":51.74,"duration":1.5790000000000006,"text":"여기 되게 오래된 곳이더라고요"},{"start":53.32,"duration":2.402000000000001,"text":"학생분들도 많이 애용하는 곳이고"},{"start":55.723,"duration":1.4669999999999987,"text":"좀 특이한 이름이 많더라고요"},{"start":57.191,"duration":1.266999999999996,"text":"이름도 특이하고"},{"start":58.459,"duration":1.5670000000000002,"text":"라면 종류도 되게 여러 가지 있고 해서"},{"start":60.027,"duration":1.2340000000000018,"text":"좀 궁금해서 찾아왔어요!"},{"start":61.262,"duration":1.6340000000000003,"text":"바로 가보겠습니다"},{"start":62.897,"duration":1.6000000000000014,"text":"안녕하세요"},{"start":64.497,"duration":2.3029999999999973,"text":"브레이크 타임인데 너무 감사해요"},{"start":78.144,"duration":4.838999999999999,"text":"엇? 달인! 라면의 달인"},{"start":82.98400000000001,"duration":1.3999999999999915,"text":"어려서부터"},{"start":84.385,"duration":1.9009999999999962,"text":"라면 장사 하면 라면 실컷 먹겠구나!"},{"start":86.287,"duration":1.266999999999996,"text":"그 생각에..."},{"start":87.555,"duration":1.5,"text":"라면 먹고 싶어서 했는데"},{"start":89.056,"duration":2.4350000000000023,"text":"요즘엔 몸이 안 받네..."},{"start":91.492,"duration":2.067999999999998,"text":"장사한 지 22년 정도 됐어요"},{"start":93.561,"duration":4.036000000000001,"text":"마흔 넘어서 시작하셨는데 20년을 하셨다고요?"},{"start":97.598,"duration":1.034000000000006,"text":"그럼 지금..."},{"start":98.63300000000001,"duration":2.400999999999982,"text":"65세고 여기는 64세"},{"start":101.035,"duration":4.503,"text":"두 분 너무 동안이신 거 아니에요?"},{"start":105.539,"duration":1.2010000000000076,"text":"라면 많이 먹어도 막..."},{"start":106.741,"duration":2.801000000000002,"text":"늙진 않나 봐요! 많이 먹어야겠다!"},{"start":109.543,"duration":2.3349999999999937,"text":"뭐 그렇게 많이 먹어도 날씬한데..."},{"start":116.31700000000001,"duration":2.701999999999998,"text":"배에 블랙홀이 있나 봅니다ㅎ"},{"start":119.02000000000001,"duration":1.9669999999999845,"text":"근데 라면 중에는 뭐가 제일 잘 나가요?"},{"start":120.988,"duration":3.102000000000004,"text":"라면 중에는 '이라면'이 제일 잘 나가요~"},{"start":124.091,"duration":1.2670000000000101,"text":"여기 사장님이 '이' 씨여서!"},{"start":125.359,"duration":2.368000000000009,"text":"아 그래서 가게가 '이'라면이구나"},{"start":127.728,"duration":4.737000000000009,"text":"일단은 시그니처 이라면 먼저 하나만 주세요"},{"start":143.043,"duration":1.3009999999999877,"text":"감사합니다"},{"start":144.344,"duration":1.634999999999991,"text":"잘 먹겠습니다~!"},{"start":145.98,"duration":1.5670000000000073,"text":"냄비 라면"},{"start":147.548,"duration":3.3360000000000127,"text":"역시 라면은 전 냄비 라면을 가장 좋아해요"},{"start":154.621,"duration":1.1339999999999861,"text":"어우 너무 좋다"},{"start":158.358,"duration":2.0020000000000095,"text":"오늘 술도 안 먹었는데 해장하는 것 같애!"},{"start":163.997,"duration":1.9019999999999868,"text":"바지락이 들어가서"},{"start":165.899,"duration":3.3360000000000127,"text":"국물이 해물 육수가 제대로 우러났거든요?"},{"start":181.014,"duration":0.8009999999999877,"text":"뭔가 비법..."},{"start":181.816,"duration":1.4669999999999845,"text":"비법 수프 같은 걸 좀"},{"start":183.284,"duration":1.233000000000004,"text":"넣으신 것 같은데?"},{"start":184.518,"duration":0.967000000000013,"text":"약간..."},{"start":185.486,"duration":2.2350000000000136,"text":"맛이 깊어요 일반 라면보다!"},{"start":187.722,"duration":1.4000000000000057,"text":"사장님! 뭐가 들어가요?"},{"start":189.123,"duration":1.233000000000004,"text":"- 그... 수프 같은 게... - 네~! 들어가요~!"},{"start":190.357,"duration":2.0010000000000048,"text":"- 아! 수프가 따로 들어가죠?! - 네"},{"start":192.359,"duration":1.8349999999999795,"text":"잘 아시네..."},{"start":194.195,"duration":2.9020000000000152,"text":"- 많이 드셔보셔서... - 저 라면을 수도 없이 먹어봐서"},{"start":217.784,"duration":2.201999999999998,"text":"안에 오징어랑 새우랑"},{"start":219.987,"duration":1.266999999999996,"text":"바지락이 들어있어요"},{"start":221.255,"duration":3.3360000000000127,"text":"양파랑~"},{"start":225.291,"duration":1.5020000000000095,"text":"바지락 완전 많아요"},{"start":237.137,"duration":3.7700000000000102,"text":"라면이 이렇게 끝맛이 엄청 개운하지 않은데"},{"start":240.908,"duration":5.471000000000004,"text":"청양고추랑 시원한 거 다 때려 넣어서..."},{"start":246.38,"duration":2.4350000000000023,"text":"진짜 짬뽕처럼 완전 시원해~"},{"start":257.757,"duration":1.535000000000025,"text":"와 진짜 너무 맛있다..."},{"start":259.293,"duration":1.5339999999999918,"text":"솔직히 밥 말아 먹고 싶거든요?"},{"start":260.828,"duration":2.1680000000000064,"text":"근데 국물이 너무 맛있어서 다 먹어버렸어요"},{"start":262.997,"duration":2.334000000000003,"text":"치즈 깻잎 면?"},{"start":265.331,"duration":1.0679999999999836,"text":"신기하다..."},{"start":266.4,"duration":3.1690000000000396,"text":"사장님 깻치면도 하나만 주세요"},{"start":285.28499999999997,"duration":3.8700000000000045,"text":"깻잎이랑 치즈가 어울리나?"},{"start":289.155,"duration":1.8350000000000364,"text":"치즈 가득 있는 부분을..."},{"start":302.735,"duration":1.7690000000000055,"text":"와! 이것도 양념 들어갔죠?"},{"start":305.338,"duration":1.0009999999999764,"text":"깻잎 면"},{"start":316.883,"duration":1.802000000000021,"text":"근데 깻잎 들어가니까 진짜 매력적이다..."},{"start":318.952,"duration":1.266999999999996,"text":"국물이 너무 진해"},{"start":320.887,"duration":1.3340000000000032,"text":"여기는 국물 자체가 맛있다"},{"start":330.296,"duration":2.468999999999994,"text":"뭔가 치즈가 살짝 느끼하잖아요"},{"start":332.766,"duration":3.6359999999999673,"text":"그 느끼함을 깻잎의 향긋함이 다 감싸줘요!"},{"start":347.113,"duration":1.9019999999999868,"text":"원래 저 라면 국물은 살짝씩 남겨놓고"},{"start":349.016,"duration":2.3349999999999795,"text":"나중에 먹고, 나중에 먹고 이러거든요?"},{"start":351.352,"duration":2.0340000000000487,"text":"국물이 너무 맛있어서 멈출 수가 없어!"},{"start":353.387,"duration":2.4010000000000105,"text":"수프 개발 얼마 만에 하신 거예요?"},{"start":355.789,"duration":1.5679999999999836,"text":"10년은 넘게 했어요!"},{"start":364.632,"duration":2.367999999999995,"text":"'생활의 달인' 나갈 때하고"},{"start":367.001,"duration":1.3000000000000114,"text":"- 이 맛하고 조금 맛이 달라요! - 아 그래요?"},{"start":368.301,"duration":2.201999999999998,"text":"- 나가고 나서도 또 연구하고... - 더 맛있어진 거예요?"},{"start":379.346,"duration":2.9359999999999786,"text":"고르질 못하더라고요 메뉴가 너무 많으니까..."},{"start":385.486,"duration":1.766999999999996,"text":"7개 라면이 탄생한 거죠"},{"start":387.254,"duration":2.634999999999991,"text":"그러면 다음은 계란면 하나 부탁드립니다"},{"start":397.63,"duration":3.569999999999993,"text":"계란이 막 이렇게 들어가네? 신기하다"},{"start":403.87,"duration":1.5009999999999764,"text":"이렇게 먹으니까 확실히 다르다!"},{"start":417.283,"duration":3.169999999999959,"text":"계란이 이렇게 좀 특이하게, 막 풀린 게 아니라"},{"start":420.453,"duration":3.604000000000042,"text":"몽글몽글하게 들어가 있어요 이렇게 큼직하게"},{"start":424.057,"duration":1.9350000000000023,"text":"완벽한 라면 같아요"},{"start":450.95,"duration":2.302000000000021,"text":"너무 라면 맛인데 너무 맛있어!"},{"start":453.253,"duration":3.7700000000000387,"text":"- 이 동네 사람들 다 중독시켜서ㅎ - 아 정말요?ㅋㅋㅋ"},{"start":457.024,"duration":1.7010000000000218,"text":"결혼해서"},{"start":458.726,"duration":2.334000000000003,"text":"와이프 데리고 오고 애기 낳아서도 오고"},{"start":461.061,"duration":2.035000000000025,"text":"근데 저도 중독될 것 같아요 지금!"},{"start":463.097,"duration":0.8660000000000423,"text":"이거 수프!"},{"start":463.964,"duration":2.9350000000000023,"text":"따로 나중에 파시면 안 돼요?ㅋㅎㅎ"},{"start":466.9,"duration":2.469000000000051,"text":"사장님 부대면 하나만 주세요"},{"start":484.884,"duration":3.437000000000012,"text":"와 얘는 부대찌개 냄새가 확 올라오는데?"},{"start":494.293,"duration":1.9019999999999868,"text":"햄 맛! 엄청 강해!"},{"start":506.472,"duration":1.302000000000021,"text":"맛이 완전 다르네?"},{"start":507.775,"duration":2.5340000000000487,"text":"가짜 햄이 아니라 진짜 햄 맛이 진하게 나요!"},{"start":510.31,"duration":1.3340000000000032,"text":"완전 부대찌개!"},{"start":511.645,"duration":1.600999999999999,"text":"먹자마자 부대찌개예요!"},{"start":521.654,"duration":1.7690000000000055,"text":"와! 국물 끝내준다..."},{"start":529.295,"duration":3.0030000000000427,"text":"저는 치즈가 위에 안 보이길래"},{"start":532.299,"duration":1.3669999999999618,"text":"치즈가 없는 줄 알았어요!"},{"start":533.667,"duration":2.3349999999999227,"text":"근데 국물에 치즈가 다 녹아있는 것 같아요!"},{"start":545.211,"duration":3.6369999999999436,"text":"라면 맛있다, 너무 맛있어"},{"start":548.849,"duration":2.200999999999908,"text":"중독성 1위"},{"start":560.46,"duration":1.6680000000000064,"text":"으아 맛있어"},{"start":562.129,"duration":1.0670000000000073,"text":"다음은"},{"start":563.196,"duration":1.3339999999999463,"text":"매치면?"},{"start":564.53,"duration":2.036000000000058,"text":"매치면으로 부탁드립니다"},{"start":566.567,"duration":1.8339999999999463,"text":"둘 다 매운맛이에요, 이제 매운맛만 남았어요"},{"start":568.401,"duration":4.137000000000057,"text":"그냥 매운맛 있고 덜 매운맛 있고 매치면이 있네요"},{"start":581.647,"duration":0.9679999999999609,"text":"우와 맛있겠다"},{"start":582.616,"duration":1.7670000000000528,"text":"이거 매운맛 치즈라면"},{"start":584.383,"duration":2.7029999999999745,"text":"매운맛? 많이 매우려나? 궁금해"},{"start":595.895,"duration":4.104000000000042,"text":"그냥 가볍게 느껴지는 고춧가루로써의 매운맛이 아니라"},{"start":600,"duration":3.8700000000000045,"text":"속에서 이렇게 목까지 칼칼한 그런 매운맛이에요"},{"start":603.871,"duration":1.7340000000000373,"text":"치즈가 들어갔는데도 이 정도라고?"},{"start":618.351,"duration":1.5349999999999682,"text":"와! 근데 진짜 맵다 이거!"},{"start":626.093,"duration":2.4340000000000828,"text":"상당히 맵습니다 상당히"},{"start":635.435,"duration":3.303000000000111,"text":"다른 거는 너무 중독적이고 너무 맛있어서 그런데"},{"start":638.739,"duration":3.0679999999999836,"text":"얘도 국물이 맛있긴 한데 매워서..."},{"start":641.807,"duration":1.0339999999999918,"text":"살짝 망설이게 되네..."},{"start":642.843,"duration":1.5339999999999918,"text"