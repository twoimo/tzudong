886.419,"duration":3.1359999999999673,"text":"이렇게 크림소스에다가"},{"start":889.555,"duration":1.3350000000000364,"text":"양파를 이렇게"},{"start":891.257,"duration":0.9340000000000828,"text":"요렇게 먹어볼게요"},{"start":902.068,"duration":2.433999999999969,"text":"와앜 고소해-!"},{"start":904.504,"duration":1.9329999999999927,"text":"엄청 고소한 마요 크림이라서"},{"start":906.439,"duration":3.3010000000000446,"text":"기름지게 크리미한 게 아니라"},{"start":909.742,"duration":2.703000000000088,"text":"담백하게 크리미하다고 해야 되나?"},{"start":948.881,"duration":1.0009999999999764,"text":"양파 범벅"},{"start":964.096,"duration":2.100999999999999,"text":"그게 매력이다"},{"start":966.199,"duration":3.768000000000029,"text":"꾸덕한 마요 소스가 아니라 촉촉한 소스라서"},{"start":969.969,"duration":1.90199999999993,"text":"소스 맛있어요!"},{"start":986.686,"duration":2.6689999999999827,"text":"이름이 블랙버스터예요!"},{"start":989.355,"duration":3.102999999999952,"text":"마늘, 파"},{"start":992.458,"duration":2.703000000000088,"text":"숙성 간장"},{"start":999.465,"duration":0.7009999999999081,"text":"달아"},{"start":1005.171,"duration":2.134999999999991,"text":"여기 사장님이 숙성을 좋아하시나 봐요"},{"start":1014.313,"duration":1.302000000000021,"text":"진짜 요게 딱"},{"start":1015.615,"duration":2.1689999999999827,"text":"제가 봤을 때 아이들 원 픽이에요"},{"start":1017.784,"duration":1.7010000000000218,"text":"제가 여태까지 먹은 것 중에서"},{"start":1019.485,"duration":2.90300000000002,"text":"마늘 후레이크를 딱 얹어서"},{"start":1048.948,"duration":3.1679999999998927,"text":"이 마늘 후레이크가 향이 진짜 좋거든요?"},{"start":1052.118,"duration":4.070000000000164,"text":"되게 막 감칠맛 응축된..."},{"start":1090.656,"duration":4.102000000000089,"text":"근데 아까 천 원의 행복 중 하나 먹었잖아요"},{"start":1094.76,"duration":1.634999999999991,"text":"하나 더 먹어야 되지 않겠어요?"},{"start":1096.395,"duration":4.605000000000018,"text":"화살볶음밥? 화살볶음밥 주문하겠습니다-"},{"start":1101.936,"duration":2.933999999999969,"text":"이거 약간 아리까리한데... 누룽지?"},{"start":1104.87,"duration":3.3370000000002165,"text":"조청 냄새?"},{"start":1118.184,"duration":1.7999999999999545,"text":"이 맛은...?"},{"start":1119.986,"duration":1.8329999999998563,"text":"보통 닭강정 하면..."},{"start":1121.821,"duration":5.4050000000002,"text":"후라이드, 양념, 간장 이 정도로 팔잖아요"},{"start":1127.226,"duration":0.9009999999998399,"text":"근데 얘는"},{"start":1128.661,"duration":1.4659999999998945,"text":"꿀강정...?"},{"start":1130.129,"duration":2.300000000000182,"text":"꿀만 들어갔다기엔 엄청 달지도 않고..."},{"start":1132.431,"duration":1.634999999999991,"text":"고소함보단 구수함...!"},{"start":1134.066,"duration":2.6030000000000655,"text":"감사하니다"},{"start":1136.669,"duration":2.8029999999998836,"text":"맛있는 냄새 나"},{"start":1144.41,"duration":2.132999999999811,"text":"고추기름이 이 밥알에..."},{"start":1146.545,"duration":2.1009999999998854,"text":"밥알 하나하나에 돼있어서...!"},{"start":1148.648,"duration":2.102000000000089,"text":"진짜 중화 볶음밥처럼"},{"start":1155.955,"duration":2.3350000000000364,"text":"인도네시아 스타일~"},{"start":1171.337,"duration":0.83400000000006,"text":"너무 맛있어"},{"start":1172.605,"duration":3.002999999999929,"text":"이거 먹다 이거 먹고 x3"},{"start":1176.375,"duration":0.9010000000000673,"text":"최고예요"},{"start":1199.665,"duration":3.4020000000000437,"text":"달달한 누룽지 같은 매력인 맛이에요"},{"start":1203.069,"duration":4.371000000000095,"text":"여기 치킨들이 다 평범한 맛은 아니에요"},{"start":1207.44,"duration":3.936999999999898,"text":"후라이드부터 차별화돼 있는 맛!"},{"start":1211.377,"duration":4.23700000000008,"text":"맛이나 이런 거에 대해서 '다사랑'만의 확실한 맛이 있어요"},{"start":1243.476,"duration":1.0009999999999764,"text":"잘 먹었다"},{"start":1249.048,"duration":1.4010000000000673,"text":"맛있으셨나요?!"},{"start":1250.449,"duration":1.4659999999998945,"text":"너무 맛있게 잘 먹었습니다ㅎㅎ"},{"start":1251.917,"duration":2.768000000000029,"text":"치킨 먹방은 진짜 오랜만인 거 같은데"},{"start":1254.687,"duration":3.1360000000001946,"text":"다는 아니지만 아직 저도 많이 못 먹어봤겠지만"},{"start":1257.823,"duration":3.7369999999998527,"text":"왠만한 유명하다는 치킨 많이 먹어보고 했는데"},{"start":1261.56,"duration":2.036000000000058,"text":"다사랑은"},{"start":1263.596,"duration":3.06899999999996,"text":"다사랑 특유의 맛이 있어서 좋았어요"},{"start":1266.665,"duration":3.6690000000000964,"text":"그래서 기억에 확 남을 거 같은 그런 맛 있잖아요"},{"start":1270.336,"duration":4.9379999999998745,"text":"천 원 화살볶음밥과 천 원 오븐치즈스파게티는...!"},{"start":1275.274,"duration":1.6350000000002183,"text":"가성비 짱이지 않나요?"},{"start":1276.909,"duration":2.535999999999831,"text":"너무너무 좋은 메뉴 같아요"},{"start":1279.445,"duration":2.433999999999969,"text":"진짜 제가 안 먹어본 메뉴가 많은데"},{"start":1281.881,"duration":1.765999999999849,"text":"다 먹어보고 싶을 정도로"},{"start":1283.649,"duration":1.566000000000031,"text":"엄청 많은 메뉴들이 있더라고요"},{"start":1285.217,"duration":2.6340000000000146,"text":"골뱅이무침도 맛있다고 추천을 해주셨는데"},{"start":1287.853,"duration":1.4659999999998945,"text":"오늘 못 먹어서 아쉬운데..."},{"start":1289.321,"duration":2.4340000000001965,"text":"다음에 술 한잔 하러 와야겠어요"},{"start":1291.757,"duration":2.5670000000000073,"text":"익산에는 굉장히 많다고 하지만"},{"start":1294.326,"duration":2.9680000000000746,"text":"아직 다른 지역이나 서울엔 많이 들어오지 않았거든요"},{"start":1297.296,"duration":2.7029999999999745,"text":"좀 많이 이곳저곳 생기면 좋을 것 같아요!"},{"start":1299.999,"duration":4.904999999999973,"text":"오늘도 잘 먹었습니다~!"},{"start":1304.904,"duration":2.6359999999999673,"text":"화살촉 먼저 먹을까요? 아님 순살 먹을까요?"},{"start":1307.541,"duration":2.3680000000001655,"text":"화살은 매운 거고 강정은 달고..."},{"start":1309.909,"duration":1.6009999999998854,"text":"아 화살치킨인가요 혹시?"},{"start":1311.51,"duration":2.6359999999999673,"text":"화살촉은 어디서 나온 거야ㅋㅋㅋ"},{"start":1314.147,"duration":1.6340000000000146,"text":"'괴물'인가 거기 나오는..."},{"start":1315.782,"duration":1.4010000000000673,"text":"BJ 이름 아니야?"},{"start":1317.183,"duration":1.5350000000000819,"text":"몰라ㅋㅋㅋ"},{"start":1318.718,"duration":1.768000000000029,"text":"맞네, 맞네, 맞네"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
