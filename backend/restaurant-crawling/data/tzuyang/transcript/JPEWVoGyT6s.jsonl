{"youtube_link":"https://www.youtube.com/watch?v=JPEWVoGyT6s","channel_name":"tzuyang","language":"ko","collected_at":"2026-08-17T02:18:08.504+09:00","transcript":[{"start":0,"duration":2.636,"text":"치킨 드시면 깜짝 놀라실 거예요-!"},{"start":13.046,"duration":2.136000000000001,"text":"세뇌 당했거든요, 맛있다에!"},{"start":15.182,"duration":1.767999999999999,"text":"'진짜 맛있다 진짜 맛있다'"},{"start":19.72,"duration":0.7000000000000028,"text":"이 맛은...!"},{"start":24.224,"duration":3.3369999999999997,"text":"어디서 먹어보지도 못한 그런 치킨이에요"},{"start":32.533,"duration":2.033999999999999,"text":"안녕하세요 여러분"},{"start":34.568,"duration":1.4350000000000023,"text":"제가 오늘은...!"},{"start":36.003,"duration":1.8350000000000009,"text":"치킨을 먹으러 왔습니다"},{"start":37.838,"duration":1.8659999999999997,"text":"부산에 '이재모피자'가 있다면"},{"start":39.706,"duration":2.5700000000000003,"text":"익산에는 '다사랑치킨'이 있다...!"},{"start":42.276,"duration":1.2009999999999934,"text":"익산에는"},{"start":43.477,"duration":2.3670000000000044,"text":"'다사랑치킨' 사거리도 있대요!"},{"start":45.846,"duration":1.7000000000000028,"text":"그리고 서울에도 꽤 있거든요?"},{"start":47.548,"duration":2.668999999999997,"text":"저는 서울에 있는 지점으로 왔습니다"},{"start":50.217,"duration":0.9669999999999987,"text":"왠지 모르겠지만"},{"start":51.185,"duration":2.134999999999998,"text":"기회가 없어서 한 번도 못 먹어봤는데"},{"start":53.32,"duration":1.5679999999999978,"text":"오늘 처음으로 먹으러 왔어요"},{"start":54.888,"duration":3.0700000000000003,"text":"아주... 다 털어보고 가겠습니다-"},{"start":57.958,"duration":2.201999999999998,"text":"뭐가 되게 많네?"},{"start":60.16,"duration":2.970000000000006,"text":"반반, 트리플콤보, 패밀리세트 이렇게 해서"},{"start":63.131,"duration":2.1680000000000064,"text":"여러 가지 맛볼 수 있는 것도 있고"},{"start":65.299,"duration":2.6019999999999897,"text":"골뱅이, 무뼈닭발, 닭똥집 이런 것도 있고"},{"start":67.901,"duration":2.8700000000000045,"text":"메뉴 종류가 거의 맥주집처럼 엄청 많은데"},{"start":72.239,"duration":1.6329999999999956,"text":"최애 메뉴가 뭐예요?ㅎㅎ"},{"start":73.874,"duration":3.3360000000000127,"text":"후라이드 치킨, 양념치킨, 화살치킨이요"},{"start":77.21000000000001,"duration":1.968999999999994,"text":"화살치킨은 좀 매-콤해요!"},{"start":79.18,"duration":3.4029999999999916,"text":"익산에서 언제 시작한 거예요?"},{"start":82.584,"duration":3.602000000000004,"text":"1993년도 조그맣게 대학로에서 시작했는데"},{"start":86.186,"duration":1.0349999999999966,"text":"이렇게 퍼진 거예요?"},{"start":87.221,"duration":2.7689999999999912,"text":"네"},{"start":89.99,"duration":4.972000000000008,"text":"다사랑치킨 하나씩 자랑 좀 해주세요~ 직원분들!"},{"start":95.729,"duration":1.7019999999999982,"text":"직원분들요? 저는..."},{"start":97.431,"duration":0.965999999999994,"text":"손님인뎁..."},{"start":98.999,"duration":0.9000000000000057,"text":"손님ㅎㅎㅎ"},{"start":100.701,"duration":2.736000000000004,"text":"저는 다 반반으로"},{"start":103.438,"duration":2.667999999999992,"text":"한 여덟 가지 맛을 보면 딱 좋을 것 같은데요"},{"start":106.106,"duration":2.834000000000003,"text":"일단 다 나왔는데 제가 시킨 거"},{"start":108.94200000000001,"duration":3.667999999999992,"text":"독특한 게 보통 치킨집 가면..."},{"start":112.612,"duration":1.433000000000007,"text":"치킨무만 주거나"},{"start":114.047,"duration":2.236000000000004,"text":"좀 더 준다 하면 샐러드까지 주잖아요"},{"start":116.283,"duration":2.299999999999997,"text":"여긴 기본으로 콘치즈까지...!"},{"start":118.58500000000001,"duration":2.668999999999997,"text":"그리고 이 알새우칩도 기본이에요"},{"start":121.254,"duration":2.3699999999999903,"text":"소스도 네 가지"},{"start":123.624,"duration":1.4660000000000082,"text":"아니 진짜 제가..."},{"start":125.092,"duration":1.0990000000000038,"text":"지금 세뇌 당했거든요?"},{"start":126.193,"duration":0.7990000000000066,"text":"맛있다에!"},{"start":126.994,"duration":1.8009999999999877,"text":"'진짜 맛있다 진짜 맛있다'"},{"start":128.795,"duration":2.5700000000000216,"text":"'깜짝 놀란다'라고 하셔서"},{"start":131.365,"duration":2.201999999999998,"text":"지금 너무 기대돼요"},{"start":147.247,"duration":3.10299999999998,"text":"후라이드 치킨"},{"start":150.35,"duration":1.568000000000012,"text":"잘 먹겠습니다!"},{"start":171.538,"duration":1.8999999999999773,"text":"너무 맛있다...!"},{"start":173.44,"duration":0.9669999999999845,"text":"진짜 맛있다!"},{"start":174.40800000000002,"duration":3.3029999999999973,"text":"튀김옷이 엄청 얇거나 두껍거나 하지 않고"},{"start":177.711,"duration":1.8349999999999795,"text":"진짜 완벽하게 적당해요"},{"start":179.546,"duration":2.766999999999996,"text":"속살이 진짜 부드럽고 촉촉하거든요?"},{"start":182.315,"duration":3.73599999999999,"text":"근데 염지를 뭔가 여기만의 방법이 있는 건지"},{"start":186.053,"duration":3.8009999999999877,"text":"뭔가 딱 그 특유의 향이 있어요"},{"start":189.856,"duration":3.0030000000000143,"text":"닭가슴살이 그렇게 맛있다고 자신하셨거든요?"},{"start":192.859,"duration":3.4039999999999964,"text":"속살이 숙성돼서 가슴살 같은 경우가"},{"start":196.264,"duration":1.9669999999999845,"text":"되게 촉촉하니 맛있어요!"},{"start":202.002,"duration":4.503999999999991,"text":"뭔가 좀 촉촉한 거 같은데"},{"start":218.852,"duration":2.3689999999999998,"text":"어? 저 금방 삼켰어요"},{"start":221.222,"duration":0.9329999999999927,"text":"왜 부드럽지?"},{"start":236.97,"duration":3.033999999999992,"text":"와... 이것도 염지가 진짜 완벽하다"},{"start":240.006,"duration":2.436000000000007,"text":"보통 닭가슴살 먹으면 싱겁거든요"},{"start":242.442,"duration":1.8019999999999925,"text":"24시간 숙성한대요"},{"start":244.244,"duration":2.3360000000000127,"text":"그래서 이게 속까지 완전 다 배어있구나"},{"start":246.947,"duration":2.0679999999999836,"text":"양념에 푹 찍어서"},{"start":282.149,"duration":3.201000000000022,"text":"여기 보이세요? 이 촉촉한 육즙?"},{"start":285.352,"duration":3.7700000000000387,"text":"새우살처럼 진짜 탱글탱글...!"},{"start":305.872,"duration":3.367999999999995,"text":"이게 왜 인기가 많은지 알겠다...!"},{"start":309.242,"duration":2.334000000000003,"text":"여기만의 특유의 맛이 있어서"},{"start":311.578,"duration":2.6340000000000146,"text":"한번 빠지면 계속 먹을 거 같아요"},{"start":314.214,"duration":2.468999999999994,"text":"날개에 찍어 먹어봐야지~"},{"start":327.16,"duration":2.366999999999962,"text":"시큼하고 매콤함이 확 때리다가"},{"start":329.529,"duration":4.069000000000017,"text":"마지막에 약간 마요네즈의 고소함?"},{"start":333.6,"duration":2.7690000000000055,"text":"근데 마요네즈... 그냥 마요네즈 아니야?"},{"start":337.404,"duration":0.7339999999999804,"text":"아닌가?"},{"start":344.678,"duration":2.201999999999998,"text":"요거트 소스 같은 거네~"},{"start":350.984,"duration":1.268000000000029,"text":"잘 어울린다!"},{"start":390.056,"duration":1.302000000000021,"text":"양념 먹기 전에"},{"start":391.358,"duration":1.867999999999995,"text":"콘치즈 때리고 가겠습니다"},{"start":393.226,"duration":1.968999999999994,"text":"저 치킨집에서 콘치즈를..."},{"start":395.196,"duration":3.7029999999999745,"text":"횟집에서는 봤어도 치킨집에서 콘치즈를 주는 곳은..."},{"start":424.658,"duration":2.6339999999999577,"text":"본 베이스 자체가 살짝 집에서 만든..."},{"start":427.294,"duration":2.7690000000000055,"text":"맛의 느낌이 있다고 해야 되나... 고추장?"},{"start":430.063,"duration":4.972000000000037,"text":"입에 착 붙는 고추장 감칠맛이 매력적-!"},{"start":483.95,"duration":3.4680000000000177,"text":"치뿌린 소스...! 이거 두 개 진짜 잘 어울릴 거 같아요"},{"start":487.42,"duration":1.367999999999995,"text":"얘가 꽤 매콤해서"},{"start":516.349,"duration":4.6049999999999045,"text":"우와! 이게 탕수육인데 순살 치킨탕수육!"},{"start":520.954,"duration":2.8029999999999973,"text":"진짜 찐 탕수육인데? 이것 보세요"},{"start":523.757,"duration":2.800000000000068,"text":"순살은 제가 가장 좋아하는"},{"start":526.559,"duration":2.136000000000081,"text":"100% 닭다리 순살입니다"},{"start":542.542,"duration":2.5670000000000073,"text":"새콤달콤 맛있는 탕수육 소스에다가"},{"start":545.112,"duration":4.23599999999999,"text":"닭다리살이라 입에서 촉촉하게 부드럽거든요"},{"start":549.349,"duration":3.1359999999999673,"text":"그래서 탕수육이랑은 완전 다른 매력이에요"},{"start":566.366,"duration":2.6019999999999754,"text":"근데 여기 진짜 대박인 게 있어요!"},{"start":568.968,"duration":2.4360000000000355,"text":"'천 원의 행복'이라고 있거든요"},{"start":571.404,"duration":2.0019999999999527,"text":"오븐치즈스파게티, 화살볶음밥"},{"start":573.406,"duration":1.6690000000000964,"text":"감자튀김, 소떡소떡, 귀채"},{"start":575.075,"duration":2.134999999999991,"text":"다섯 가지의 메뉴가"},{"start":577.21,"duration":1.90199999999993,"text":"치킨 한 마리당 천 원으로 사이드 선택 가능해요"},{"start":579.112,"duration":3.203000000000088,"text":"오븐치즈스파게티 먹어봐야지, 천 원인데!"},{"start":582.315,"duration":1.1679999999998927,"text":"바로 주문해 봅니다"},{"start":591.724,"duration":3.603999999999928,"text":"꿔바로우처럼 시큼함을 잘 살렸어...!"},{"start":605.806,"duration":2.8349999999999227,"text":"감사합니다, 대박!"},{"start":608.641,"duration":4.205000000000041,"t