"},{"start":1198.063,"duration":2.769999999999982,"text":"다른 데보다 더 많은 거 같아... ㄷㄷ"},{"start":1212.177,"duration":1.768000000000029,"text":"콩 국물 엄청 고소하다"},{"start":1220.452,"duration":1.80600000000004,"text":"사장님 너무 맛있게 잘 먹었어요"},{"start":1222.26,"duration":1.2950000000000728,"text":"진짜 다 맛있었어요"},{"start":1223.555,"duration":0.7339999999999236,"text":"감사해요"},{"start":1224.303,"duration":3.7359999999998763,"text":"- 진짜 어떡해, 손맛이 너무 좋으셔 - 아니야~"},{"start":1228.039,"duration":2.824000000000069,"text":"진짜 먹는 동안 계속 생각이 든 게..."},{"start":1230.863,"duration":2.0349999999998545,"text":"가격 생각이 계속 나더라고요"},{"start":1232.898,"duration":2.2360000000001037,"text":"제가 진짜 저렴한 곳도 엄청 많이 가봤잖아요"},{"start":1235.134,"duration":0.9010000000000673,"text":"말도 안 되는"},{"start":1236.035,"duration":1.7010000000000218,"text":"1,000원짜리 김밥집부터 해서"},{"start":1237.736,"duration":1.3679999999999382,"text":"2,000원짜리 짜장면"},{"start":1239.104,"duration":2.0019999999999527,"text":"3,000원짜리 김치찌개"},{"start":1241.106,"duration":1.8019999999999072,"text":"여러 곳을 많이 가 봤는데"},{"start":1242.908,"duration":4.706000000000131,"text":"다양한 한식 백반 메뉴에서 이렇게 저렴한 곳은"},{"start":1247.614,"duration":1.5670000000000073,"text":"여기가 1등인 것 같아"},{"start":1249.181,"duration":1.4349999999999454,"text":"보통 1명이서 하나씩 시킨다고 하면"},{"start":1250.616,"duration":1.9020000000000437,"text":"8명이서 먹을 양이잖아요"},{"start":1252.518,"duration":2.0019999999999527,"text":"근데 가격이..."},{"start":1254.52,"duration":1.7010000000000218,"text":"34,500원"},{"start":1256.221,"duration":3.4700000000000273,"text":"8그릇 먹고 이런 가격 진짜 처음이에요"},{"start":1259.691,"duration":5.638999999999896,"text":"여기 더 내고 가야겠다"},{"start":1265.33,"duration":2.5700000000001637,"text":"사장님 항상 건강하셨으면 좋겠고"},{"start":1267.9,"duration":3.30399999999986,"text":"손님들이 가게를 좋아하시는 게 너무 느껴졌고"},{"start":1271.204,"duration":2.4349999999999454,"text":"너무 감사한 식당인 것 같습니다"},{"start":1273.639,"duration":4.070000000000164,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
