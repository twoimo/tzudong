{"youtube_link":"https://www.youtube.com/watch?v=W8zkwvIrWoY","channel_name":"tzuyang","language":"ko","collected_at":"2026-08-17T02:17:20.862+09:00","transcript":[{"start":0.033,"duration":2.603,"text":"이 동네에서 제일 싸, 없어 없어"},{"start":2.636,"duration":1.3689999999999998,"text":"- 없죠 - 저도 처음 봐요"},{"start":4.005,"duration":1.2999999999999998,"text":"정말 착한 가게야"},{"start":5.305,"duration":2.5360000000000005,"text":"가격이 진짜 말도 안 된다"},{"start":7.841,"duration":1.3340000000000005,"text":"청국장이 4,000원"},{"start":9.276,"duration":1.3019999999999996,"text":"제일 비싼 게 5,000원?"},{"start":10.578,"duration":1.4000000000000004,"text":"5,000원 다 아래더라고요"},{"start":11.978,"duration":1.7029999999999994,"text":"5,000원이 넘어가는 게 없고"},{"start":13.681,"duration":2.0170000000000012,"text":"살면서 본 청국장 중 제일 싸요"},{"start":15.698,"duration":1.5859999999999985,"text":"이 가격에 어디 가서 먹어요"},{"start":17.284,"duration":2.5020000000000024,"text":"사장님 남아요? 안 남지 않아요?"},{"start":19.786,"duration":1.5359999999999978,"text":"언니 다 드시려고...?"},{"start":21.322,"duration":1.0670000000000002,"text":"많이 시키면 안 돼요?"},{"start":22.389,"duration":1.9690000000000012,"text":"시켜요, 시켜~"},{"start":24.358,"duration":3.3550000000000004,"text":"청국장, 들깨순두부, 오징어볶음, 김치볶음밥이랑 라쫄볶이"},{"start":27.713,"duration":1.7159999999999975,"text":"뚝배기불고기랑 라면 하나만 주세요"},{"start":34.301,"duration":0.6670000000000016,"text":"이 맛은..."},{"start":34.968,"duration":0.9009999999999962,"text":"맛있는데?"},{"start":36.069,"duration":3.469999999999999,"text":"진짜 이게 4,000원? 말도 안 돼"},{"start":39.539,"duration":3.237000000000002,"text":"오늘 들어가서 한번 파헤쳐보도록 하겠습니다"},{"start":51.651,"duration":2.0689999999999955,"text":"여러분 안녕하세요"},{"start":53.72,"duration":1.301000000000002,"text":"제가 오늘은"},{"start":55.021,"duration":2.1019999999999968,"text":"지금 여기 성내동에 왔는데"},{"start":57.19,"duration":1.6020000000000039,"text":"오늘 백반 먹으러 왔거든요"},{"start":58.792,"duration":4.036999999999999,"text":"여기가 백반집인데 가격이 진짜 말도 안 되거든요?"},{"start":62.996,"duration":2.5689999999999955,"text":"여기 '상록분식'입니다"},{"start":65.565,"duration":1.8020000000000067,"text":"청국장이 4,000원"},{"start":67.367,"duration":3.905000000000001,"text":"다른 찌개류도 4,000원, 제일 비싼 게 5,000원?"},{"start":71.272,"duration":3.201999999999998,"text":"5,000원이 넘어가는 게 없고 5,000원 다 아래더라고요"},{"start":74.541,"duration":3.2369999999999948,"text":"가격 보고 '서울이 맞나? 성내동?'"},{"start":77.77799999999999,"duration":2.260000000000005,"text":"'성내동이 서울인가?' 했다니까요?"},{"start":80.038,"duration":1.3760000000000048,"text":"진짜 너무 싸서"},{"start":81.515,"duration":3.513999999999996,"text":"제가 오늘 들어가서 한번 파헤쳐보도록 하겠습니다"},{"start":90.39099999999999,"duration":2.034000000000006,"text":"사장님 안녕하세요!"},{"start":92.425,"duration":1.6700000000000017,"text":"아~ 언니구나ㅎㅎ 테레비~~"},{"start":94.095,"duration":1.835000000000008,"text":"오 저 아세요 누군지?"},{"start":95.93,"duration":1.4679999999999893,"text":"- 알지~~ - 정말요?"},{"start":97.398,"duration":2.301000000000002,"text":"웬일이야~~"},{"start":99.699,"duration":2.736000000000004,"text":"1년에 뭐... 식사비만"},{"start":102.435,"duration":1.634999999999991,"text":"4천만 얼마라고...?!"},{"start":104.07,"duration":2.9710000000000036,"text":"1년에 배달비 4천만 원인 거까지 알고 계시면..."},{"start":107.041,"duration":1.266999999999996,"text":"'라스'를 보셨군요"},{"start":108.375,"duration":2.2539999999999907,"text":"가격이 이게 말이 되나요?"},{"start":110.631,"duration":1.9809999999999945,"text":"사장님 이게 맞아요?"},{"start":112.612,"duration":2.936000000000007,"text":"청국장 4,000원, 들깨순두부 4,000원"},{"start":115.815,"duration":2.102000000000004,"text":"살면서 본 청국장 중 제일 싸요"},{"start":118.318,"duration":3.0700000000000074,"text":"아니 근데 가격을 몇 년 동안 안 올리신 거예요?"},{"start":121.388,"duration":3.9029999999999916,"text":"이게 3,500원에서 4,000원으로 올린 지가"},{"start":125.291,"duration":1.9690000000000083,"text":"코로나 지나고 나서..."},{"start":127.26,"duration":1.9030000000000058,"text":"- 원래 3,500원이었어요?! - 네, 그때는"},{"start":129.163,"duration":2.5349999999999966,"text":"사장님 남아요? 안 남지 않아요?"},{"start":131.698,"duration":2.549999999999983,"text":"혼자 하는 거니까 하는 거지 뭐"},{"start":137.871,"duration":1.2339999999999804,"text":"언니 예쁘다ㅎ"},{"start":139.105,"duration":2.904000000000025,"text":"정말요? 사장님 감사합니다"},{"start":142.00900000000001,"duration":2.0909999999999798,"text":"방송국이라고 그래서"},{"start":144.102,"duration":2.2620000000000005,"text":"내가 '그냥 안 할래요'"},{"start":146.364,"duration":2.384999999999991,"text":"- 정말요? - 응, 그랬어"},{"start":148.749,"duration":2.602000000000004,"text":"원래 요즘 촬영 안 하시다가"},{"start":151.351,"duration":2.8029999999999973,"text":"이제 저희가 연락드렸는데 그때 마침!"},{"start":154.154,"duration":1.6680000000000064,"text":"저 진짜 운이 좋다니까요ㅎㅎ"},{"start":155.922,"duration":2.537000000000006,"text":"저희 또 촬영하러 왔는데 빈손으로..."},{"start":158.459,"duration":2.3360000000000127,"text":"진짜 웬일이야, 아니야"},{"start":160.79500000000002,"duration":2.900999999999982,"text":"식사하고 가시는 건데 뭐, 나 처음이네"},{"start":164.175,"duration":1.7579999999999814,"text":"- 그래도... - 감사해요"},{"start":165.933,"duration":3.2690000000000055,"text":"촬영하게 해주셔서 제가 감사합니다"},{"start":169.202,"duration":4.647999999999996,"text":"사장님 그럼 청국장, 들깨순두부, 오징어볶음 이렇게 먼저 될까요?"},{"start":173.85,"duration":2.693000000000012,"text":"식지 않게 조금씩 시켜 먹겠습니다"},{"start":194.046,"duration":1.9569999999999936,"text":"감사합니다"},{"start":196.003,"duration":2.0260000000000105,"text":"오징어는 맛있는 부분이야, 좋은 거예요"},{"start":198.029,"duration":1.1030000000000086,"text":"정말요?"},{"start":199.132,"duration":1.9019999999999868,"text":"- 반찬도 직접 다 하신 거예요? - 예"},{"start":201.346,"duration":1.5559999999999832,"text":"다 거의 국내산이야"},{"start":203.069,"duration":2.90300000000002,"text":"- 김치도, 배추랑 고춧가루도 국내산이에요? - 예"},{"start":206.239,"duration":1.6020000000000039,"text":"사장님 잘 먹겠습니다~!"},{"start":207.841,"duration":2.8689999999999998,"text":"콩이 진짜 많이 들어있거든요?"},{"start":220.086,"duration":1.4019999999999868,"text":"맛있는데?"},{"start":221.488,"duration":2.6359999999999957,"text":"사장님 원래 이렇게 콩이 많이 들어가요?"},{"start":224.124,"duration":1.4679999999999893,"text":"네, 많이 들어가요"},{"start":225.59199999999998,"duration":1.3680000000000234,"text":"콩이 진짜 많은데요?"},{"start":227.227,"duration":2.969999999999999,"text":"- 서비스로 조금 더 넣어드렸어~ - 정말요?"},{"start":230.197,"duration":1.5339999999999918,"text":"더 많이 주신 거예요?"},{"start":231.731,"duration":1.7350000000000136,"text":"가격이 너무 싼데 제가 어떻게..."},{"start":233.466,"duration":2.502999999999986,"text":"더 많이 주시면 안 되죠~~"},{"start":235.969,"duration":1.568000000000012,"text":"감사합니다!ㅎㅎ"},{"start":239.439,"duration":4.104000000000013,"text":"콩이 엄청 고소하고 씹는 식감이 되게 좋아요"},{"start":243.543,"duration":1.3009999999999877,"text":"살아있어"},{"start":244.844,"duration":1.6350000000000193,"text":"그리고 약간 국물이 보통"},{"start":246.479,"duration":2.5689999999999884,"text":"청국장은 걸쭉하고 찐득찐득하잖아요"},{"start":249.048,"duration":1.0349999999999966,"text":"얘는 맑아요"},{"start":250.083,"duration":3.3029999999999973,"text":"맑은데 안에 구수한 게 다 담겨있어요"},{"start":264.931,"duration":1.4010000000000105,"text":"국내산 김치"},{"start":266.332,"duration":1.8360000000000127,"text":"직접 담그신, 딱 봐도 맛있어 보이는데"},{"start":278.077,"duration":2.002999999999986,"text":"이 맛은...!"},{"start":280.08,"duration":2.5020000000000095,"text":"우리 집 김치랑 맛이 진짜 비슷한데?"},{"start":282.582,"duration":2.401999999999987,"text":"라면에다가 먹으면 딱 너무 맛있겠다"},{"start":284.984,"duration":1.035000000000025,"text":"라면 있던데...!"},{"start":286.019,"duration":1.634999999999991,"text":"라면에다가 좀 이따 먹어야겠어"},{"start":288.788,"duration":1.0679999999999836,"text":"떡이 있어요"},{"start":290.223,"duration":3.170000000000016,"text":"떡이 신기하게, 좀 든든하게 먹으라고 넣어줬나?"},{"start":308.842,"duration":1.867999999999995,"text":"안에 순두부가 들어있어요"},{"start":310.71,"duration":1.8690000000000282,"text":"그냥 두부가 아니라 순두부예요"},{"start":312.579,"duration":2.502999999999986,"text":"그래서 엄청 부드러워"},{"start":315.082,"duration":2.441000000000031,"text":"여기다 김치 얹어서 먹으면"},{"start":325.144,"duration":1.382000000000005,"text":"들깨도 먹어봐야겠다"},{"start":326.926,"duration":4.437999999999988,"text":"들깨순두부? 처음 먹어보는 거 같아요"},{"start":336.87,"duration":1.5679999999999836,"text":"군더더기 없는 맛이에요"},{"start":338.438,"duration":1.802000000000021,"text":"들깨 맛이 엄청 강하게 나고"},{"start":342.075,"duration":2.73599999999999,"text":"색깔이 빨갛지가 않고 연해 보이잖아요"},{"start":344.811,"duration":2.5360000000000014,"text":"간이 약간 슴슴할 줄 알았는데 아니에요"},{"start":347.347,"duration":2.035000000000025,"text":"간이 아주 완벽하게 잘 되어있어요"},{"start":349.382,"duration":1.535000000000025,"text":"짜지도 않고"},{"start":355.388,"duration":1.1680000000000064,"text":"딱 좋네..."},{"start":367.7,"duration":1.0010000000000332,"text":"국물 좋다"},{"start":369.636,"duration":1.9009999999999536,"text":"이거는 밥을 말아 먹어야 될 맛이에요"},{"start":374.073,"duration":1.1680000000000064,"text":"진짜 맛있어"},{"start":375.642,"duration":1.5010000000000332,"text":"여기도 안에 떡이 들어가"},{"start":377.14300000000003,"duration":2.301999999999964,"text":"든든하게 먹으라고 넣어주시나 봐"},{"start":384.484,"duration":1.9680000000000177,"text":"주방 진짜 깨끗하다"},{"start":386.452,"duration":2.237000000000023,"text":"저기 벽에 뭐 하나 튄 게 없어요"},{"start":388.689,"duration":2.2679999999999723,"text":"주방이 너무 청결한 거 아니에요?"},{"start":390.957,"duration":1.4010000000000105,"text":"아니에요"},{"start":392.358,"duration":1.4019999999999868,"text":"너무 깨끗한데요?"},{"start":393.89300000000003,"duration":1.9879999999999427,"text":"저기 후앙에 때 하나 안 꼈어요"},{"start":395.883,"duration":2.4150000000000205,"text":"말도 안 돼"},{"start":398.298,"duration":1.5009999999999764,"text":"아니 이 가격에"},{"start":399.799,"duration":1.2350000000000136,"text":"직접 만든 반찬에"},{"start":401.034,"duration":1.367999999999995,"text":"위생까지 청결하고"},{"start":402.402,"duration":2.73599999999999,"text":"여기 근처 사시는 분들은 진짜 많이 오실 것 같아요"},{"start":405.138,"duration":4.504000000000019,"text":"아니, 솔직히 반찬이 들어가는 가격인 게 말이 안 돼요"},{"start":409.642,"duration":2.769999999999982,"text":"반찬이 다섯 가지나 나와..."},{"start":412.412,"duration":2.3350000000000364,"text":"이건 뭐야? 열무김치?"},{"start":414.747,"duration":2.23599999999999,"text":"시금치인가?"},{"start":416.983,"duration":1.2679999999999723,"text":"이거 시금치?"},{"start":418.251,"duration":4.105000000000018,"text":"상추, 시골에서 농사지은 거"},{"start":422.356,"duration":2.4350000000000023,"text":"상추 무친 거예요"},{"start":424.791,"dur