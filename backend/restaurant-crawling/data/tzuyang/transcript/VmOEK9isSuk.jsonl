{"youtube_link":"https://www.youtube.com/watch?v=VmOEK9isSuk","channel_name":"tzuyang","language":"ko","collected_at":"2026-04-04T22:34:11.049+09:00","transcript":[{"start":0.002,"duration":1.588,"text":"손이 이만하신 거 아닐까요?"},{"start":1.592,"duration":2.308,"text":"주방에서 안 나와요"},{"start":17.741,"duration":2.6389999999999993,"text":"이거 일반 돈가스"},{"start":20.381,"duration":2.6290000000000013,"text":"이거 한 손으로 못 들어요"},{"start":23.012,"duration":1.7379999999999995,"text":"도전 수준인데?"},{"start":28.422,"duration":1.2800000000000011,"text":"안 줄어요..."},{"start":30.05,"duration":4.470000000000002,"text":"나를 당황스럽게 한 중식집은 처음이야"},{"start":44.702,"duration":2.1380000000000052,"text":"안녕하세요 여러분"},{"start":46.842,"duration":1.328000000000003,"text":"제가 오늘은"},{"start":48.172,"duration":3.038000000000004,"text":"촬영 때문에 어제 부안에 와서"},{"start":51.212,"duration":1.5579999999999998,"text":"부안에서 자고"},{"start":52.772,"duration":2.338000000000001,"text":"그래서 지금 아침에 밥 먹으러 나왔거든요"},{"start":55.112,"duration":3.397999999999996,"text":"늦게 자서 일어나자마자 엄청 부었어요...ㅎ"},{"start":58.512,"duration":2.7680000000000007,"text":"여기가 왜 이렇게 부었지?"},{"start":61.282,"duration":1.7380000000000067,"text":"오늘 엄청 유명한 곳에 왔어요"},{"start":63.022,"duration":2.5279999999999987,"text":"중식집인데... 제가 중식 진짜 좋아하잖아요"},{"start":65.551,"duration":3.3389999999999986,"text":"동네 분들도 많이 오시고 실제로 여기..."},{"start":68.892,"duration":3.9680000000000035,"text":"이 가게를 방문하러 부안에도 많이 오신다고 하더라고요"},{"start":72.862,"duration":2.2680000000000007,"text":"메뉴가 특이한 게 유명해요!"},{"start":75.131,"duration":1.168999999999997,"text":"돈가스"},{"start":76.301,"duration":2.728999999999999,"text":"진짜 이만한 왕돈가스가 유명하고"},{"start":79.032,"duration":1.7680000000000007,"text":"비빔간짜장이 또 유명하대요"},{"start":80.801,"duration":2.649000000000001,"text":"오픈 런은 기본으로 항상 있다고 하고"},{"start":83.452,"duration":3.1970000000000027,"text":"주말에는 항상 대기도 필수고"},{"start":87.01,"duration":2.089999999999989,"text":"길 한복판에 있어요"},{"start":89.101,"duration":3.8089999999999975,"text":"원래 이런 중국집이 맛있거든요"},{"start":93.33,"duration":3.2900000000000063,"text":"지금 머리도 못 감고 나와서 모자를 쓰고 왔는데"},{"start":96.622,"duration":0.8780000000000001,"text":"짜잔"},{"start":97.50200000000001,"duration":1.2479999999999905,"text":"저희 모자입니다"},{"start":98.75200000000001,"duration":2.407999999999987,"text":"커서 얼굴 가리기 굉장히 좋아요"},{"start":101.161,"duration":2.5689999999999884,"text":"10시 40분쯤에 도착했거든요?"},{"start":103.732,"duration":3.097999999999999,"text":"근데 벌써 손님분들이 와계시더라고요"},{"start":106.832,"duration":3.7680000000000007,"text":"저기 옆 가게 대기 공간도 있대요"},{"start":110.601,"duration":2.0289999999999964,"text":"슈퍼마켓이 아니라 진짜 대기 공간이네?"},{"start":112.631,"duration":2.938999999999993,"text":"우와 옆 가게를 사셨나 보다"},{"start":115.571,"duration":2.2990000000000066,"text":"대기실까지 너무 잘해주셨어요"},{"start":117.872,"duration":3.0379999999999967,"text":"대기실에 커피도 있어"},{"start":127.502,"duration":1.1799999999999926,"text":"안녕하세요"},{"start":129.05,"duration":2.289999999999992,"text":"치즈돈가스가 이렇게 두꺼운데?"},{"start":131.342,"duration":1.5,"text":"다들 돈가스 시키시네요...!"},{"start":132.844,"duration":0.9060000000000059,"text":"치즈돈가스 3개요~"},{"start":133.752,"duration":3.377999999999986,"text":"돈가스를 제일 많이 드시나 봐"},{"start":137.132,"duration":3.6680000000000064,"text":"일반 중식집처럼 칠리새우 이런 게 있는 게 아니라"},{"start":140.802,"duration":5.1980000000000075,"text":"메뉴가 중식집치고 많지 않아요"},{"start":146.002,"duration":1.4679999999999893,"text":"안녕하세요, 사장님~"},{"start":147.472,"duration":1.7980000000000018,"text":"치즈돈가스가 엄청 두껍네요?!"},{"start":149.272,"duration":1.4980000000000189,"text":"이건 일반 돈가스!"},{"start":150.772,"duration":2.7680000000000007,"text":"우리 쯔왕돈가스보다 큰 거 같은데...?"},{"start":155.512,"duration":1.4579999999999984,"text":"- 감사합니다 - 맛있어요~ 아침에 만들어요ㅎ~~"},{"start":158.88,"duration":2.6999999999999886,"text":"대왕 시리즈는 항상 실제로는 엄청 큰데 화면으론 작아 보이더라고요"},{"start":161.582,"duration":2.2680000000000007,"text":"진짜 커요, 이만해요"},{"start":163.852,"duration":1.8979999999999961,"text":"- 아침에 다 만들어요 - 아침에요?!"},{"start":165.752,"duration":2.7079999999999984,"text":"많이 팔지는 못 해요"},{"start":168.462,"duration":3.52800000000002,"text":"- 늦게 오시는 분들은 못 드셔요 - 아-! 하루에 몇 장 정도 파세요?"},{"start":171.992,"duration":2.538000000000011,"text":"하루에 나가는 건 60~70개 정도 나가요"},{"start":174.53199999999998,"duration":2.9680000000000177,"text":"하루에 60개 나가는 돈가스"},{"start":177.502,"duration":0.6680000000000064,"text":"ㅎㅎㅎㅎㅎ"},{"start":178.172,"duration":1.038000000000011,"text":"진짜 날씬하다~~"},{"start":179.8,"duration":2.5999999999999943,"text":"- 반가워용 - 안녕하세요"},{"start":182.402,"duration":2.568000000000012,"text":"전주에서 여기 출장 가끔가다가 오는데"},{"start":184.972,"duration":0.6979999999999791,"text":"오늘 뵌 거예요"},{"start":185.672,"duration":3.2379999999999995,"text":"해물짬뽕, 돈가스 드세요!"},{"start":192.612,"duration":5.108000000000004,"text":"사장님 그럼 일단 비빔간짜장이랑 수제 돈가스 하나씩 주세요"},{"start":197.722,"duration":2.867999999999995,"text":"와 지금 제가 주문하는 사이에..."},{"start":200.59199999999998,"duration":1.5980000000000132,"text":"가게가 꽉 찼어요-!"},{"start":202.192,"duration":3.2579999999999814,"text":"웨이팅이 있는 거 같아요"},{"start":205.452,"duration":3.147999999999996,"text":"11시 반 정도 되면 웨이팅이 시작되는 것 같습니다"},{"start":208.602,"duration":2.397999999999996,"text":"시간대 안 맞으신 분들은 2~3시간씩 기다리세요"},{"start":211.002,"duration":1.3979999999999961,"text":"2~3시간 기다리세요?"},{"start":212.402,"duration":3.4480000000000075,"text":"딱 12시에 맞춰서 오시면..."},{"start":256.57,"duration":3.6399999999999864,"text":"감사합니다"},{"start":260.212,"duration":2.6070000000000277,"text":"이거 약간 도전 수준인데?"},{"start":262.821,"duration":3.328999999999951,"text":"저희 옛날에 제가 돈가스집 했잖아요"},{"start":266.152,"duration":1.2379999999999995,"text":"그거보다 크다"},{"start":267.392,"duration":3.0679999999999836,"text":"일단 그래도 명색이 중식집이잖아요"},{"start":270.462,"duration":1.4979999999999905,"text":"비빔간짜장 먼저 먹어볼게요"},{"start":271.962,"duration":4.53000000000003,"text":"이게 비빔간짜장이라는 건데 원래 간짜장은 부어서 먹잖아요"},{"start":276.494,"duration":2.4559999999999604,"text":"얘는 비벼 나와서 비빔간짜장인가 봐"},{"start":278.952,"duration":3.77800000000002,"text":"비주얼은 오히려 고추짜장인데?"},{"start":295.08,"duration":2.240000000000009,"text":"무의식적으로 짜장 맛일 거라고 생각했는데"},{"start":297.322,"duration":2.627999999999986,"text":"간짜장이네~ 진짜 비볐을 뿐..."},{"start":299.952,"duration":3.208000000000027,"text":"간짜장 특유의 뭉친 소스 맛이랑"},{"start":303.162,"duration":3.367999999999995,"text":"기름 맛이 진짜 딱 간짜장이에요"},{"start":306.532,"duration":1.367999999999995,"text":"고추간짜장 맛-!"},{"start":315.35,"duration":1.176999999999964,"text":"맛있다"},{"start":325.65,"duration":2.57000000000005,"text":"처음 먹었을 때 뭔가 그..."},{"start":328.222,"duration":2.8280000000000314,"text":"고추 맛이 입에서 때리는 맛이 있는데"},{"start":331.052,"duration":2.4699999999999704,"text":"먹으면 먹을수록 안에서"},{"start":333.524,"duration":2.2660000000000196,"text":"감칠맛이 조금씩 올라오거든요"},{"start":345.4,"duration":2.3740000000000236,"text":"와 돈가스"},{"start":347.776,"duration":1.2939999999999827,"text":"거짓말이지?"},{"start":351.48,"duration":2.4049999999999727,"text":"단면, 진짜 엄청 두꺼워"},{"start":353.887,"duration":1.5129999999999768,"text":"4등분한 거 제가 먹어볼게요"},{"start":355.402,"duration":2.2479999999999905,"text":"4등분한 게 일반 돈가스 크기네"},{"start":357.652,"duration":3.1480000000000246,"text":"근데 이게 1만 3,000원? 거짓말"},{"start":360.802,"duration":2.0679999999999836,"text":"이 가격에 팔 수가 있나?"},{"start":362.872,"duration":1.2789999999999964,"text":"거짓말"},{"start":373.53,"duration":2.430000000000007,"text":"소스 맛있어..."},{"start":390.31,"duration":1.4490000000000123,"text":"경양식 돈가스가 아니라"},{"start":391.761,"duration":2.488999999999976,"text":"진짜 웬만한 일본 돈가스 뺨 쳐요"},{"start":394.252,"duration":2.627999999999986,"text":"제가 봤던 돈가스 중에 양은 제일 많아요"},{"start":396.882,"duration":1.8079999999999927,"text":"근데 가격이 말이 안 돼요"},{"start":398.692,"duration":1.8980000000000246,"text":"1만 3,000원에 어떻게 이게 돼...?!"},{"start":400.592,"duration":2.771000000000015,"text":"나 돈가스집 사장이었잖아"},{"start":403.365,"duration":1.6949999999999932,"text":"이거 안 될 텐데?"},{"start":405.062,"duration":3.538000000000011,"text":"이 건물은 사장님 건물이다-!"},{"start":413.64,"duration":2,"text":"육즙 같은 거 살짝 보이세요?"},{"start":420.58,"duration":1.4710000000000036,"text":"속살 뽀얀 것 봐-!