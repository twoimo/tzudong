939999999999372,"text":"진짜 오랜만에 먹을 생각에"},{"start":512.545,"duration":0.9669999999999845,"text":"너무 설렙니다"},{"start":513.513,"duration":1.1999999999999318,"text":"진짜 유명한 곳이고"},{"start":514.7139999999999,"duration":2.3350000000000364,"text":"제가 조금 여기 앞에서 기다렸어요"},{"start":517.05,"duration":1.6020000000000891,"text":"손님이 너무 많이 계셔서"},{"start":518.652,"duration":1.5009999999999764,"text":"웨이팅도 너무 많고"},{"start":520.154,"duration":1.8659999999999854,"text":"기다리시는 분들 너무 많아서"},{"start":522.021,"duration":2.3010000000000446,"text":"조금 사그라들어서 이제..."},{"start":524.324,"duration":1.3680000000000518,"text":"번호표를 뽑으러 가야 돼요ㅎㅎㅎ"},{"start":526.026,"duration":1.3010000000000446,"text":"- 웨이팅... - 저희 대기 있어요"},{"start":527.328,"duration":1.1000000000000227,"text":"- 대기 있어요? - 네"},{"start":528.429,"duration":1.8680000000000518,"text":"- 여기 이름 적으면 되나요? - 네"},{"start":530.297,"duration":1.634999999999991,"text":"감사합니다"},{"start":532.165,"duration":2.136000000000081,"text":"여기 앞에 앉아서 기다려야겠다"},{"start":534.301,"duration":1.3339999999999463,"text":"여기 웨이팅 자리도 있어요"},{"start":536.102,"duration":2.036000000000058,"text":"지금 오늘 평일인데"},{"start":538.139,"duration":1.9669999999999845,"text":"이 시간대에 항상 웨이팅이 있나 봐요"},{"start":542.142,"duration":3.23599999999999,"text":"어 제 이름 불렸다ㅎㅎ"},{"start":548.014,"duration":0.9339999999999691,"text":"너무 좋은데"},{"start":548.948,"duration":2.23599999999999,"text":"일단은 주문을 먼저 할게요"},{"start":551.184,"duration":1.2350000000000136,"text":"어...?"},{"start":552.419,"duration":1.100999999999999,"text":"말도 안 돼..."},{"start":553.52,"duration":1.9680000000000746,"text":"수육이 사라졌어요..."},{"start":555.488,"duration":3.5039999999999054,"text":"여기 수육 진짜 맛있었는데"},{"start":559.426,"duration":1.1669999999999163,"text":"말도 안 돼"},{"start":560.593,"duration":2.2340000000000373,"text":"막국수는 종류가 하나예요"},{"start":562.829,"duration":1.0680000000000973,"text":"막국수 일단 먼저"},{"start":563.897,"duration":2.3019999999999072,"text":"'오이 빼기'로 담고"},{"start":566.199,"duration":2.8360000000000127,"text":"사이드: 전병, 전병 진짜 맛있어요"},{"start":569.035,"duration":1.6019999999999754,"text":"일단 이렇게만 시키겠습니다"},{"start":571.404,"duration":1.3010000000000446,"text":"감사합니다"},{"start":573.506,"duration":1.268000000000029,"text":"맛있겠다"},{"start":576.443,"duration":1.0670000000000073,"text":"감사합니다"},{"start":577.51,"duration":2.4669999999999845,"text":"맞아, 여기 위에 이렇게 수육이 있었어"},{"start":579.979,"duration":3.134999999999991,"text":"수육을 못 먹어서 아쉽지만 이걸로 만족하겠습니다"},{"start":583.116,"duration":1.0990000000000464,"text":"이게 매력이에요"},{"start":584.217,"duration":2.034999999999968,"text":"족발 껍데기처럼..."},{"start":596.396,"duration":3.937000000000012,"text":"이렇게 먹으면 완전 비빔막국수 느낌이거든요"},{"start":600.333,"duration":2.3360000000000127,"text":"여기도 육수 먼저 한입 일단 먹어볼게요"},{"start":608.441,"duration":2.4669999999999845,"text":"처음에 먹었을 때는 동치미 육수처럼"},{"start":610.91,"duration":3.0370000000000346,"text":"시원하고 상큼한데..."},{"start":613.947,"duration":2.2999999999999545,"text":"이 끝 맛은 뭔가 그..."},{"start":616.249,"duration":3.169999999999959,"text":"소고기 육수에서 나는 그런 감칠맛이 조금 나요"},{"start":644.21,"duration":4.937000000000012,"text":"면이 일반 막국수 면이랑은 좀 다른 게"},{"start":649.148,"duration":3.7379999999999427,"text":"엄청 통통하고 되게 쫄깃쫄깃하거든요?"},{"start":652.886,"duration":2.2690000000000055,"text":"근데 사실 오랜만에 와서..."},{"start":655.155,"duration":1.3680000000000518,"text":"약간 처음 먹는 느낌이 나요 지금"},{"start":656.523,"duration":1.967999999999961,"text":"'어? 이런 맛이었나?' 이러면서"},{"start":658.491,"duration":3.169999999999959,"text":"맛은 사실 정확하게 기억은 안 났었거든요"},{"start":672.338,"duration":4.636000000000081,"text":"전에 왔을 때는 이렇게 달달함은 못 느꼈던 것 같은데"},{"start":676.976,"duration":2.1689999999999827,"text":"오늘도 되게 매력 있고 맛있어요"},{"start":689.222,"duration":2.3360000000000127,"text":"전병! 맛있겠다"},{"start":703.436,"duration":1.5330000000000155,"text":"이 전병이 은근 매콤하거든요"},{"start":704.971,"duration":2.366999999999962,"text":"꽤 매운맛이 치고 오는데"},{"start":707.34,"duration":2.1689999999999827,"text":"겉바속촉하고 안에..."},{"start":709.509,"duration":2.0670000000000073,"text":"속도 엄청 부드럽게 잘 갈려있고"},{"start":711.578,"duration":2.1680000000000064,"text":"뭔가 김치전 같은 맛도 나고..."},{"start":740.406,"duration":1.2350000000000136,"text":"여기는..."},{"start":741.641,"duration":2.4669999999999845,"text":"왜 손님이 많은지 알 수 있을 정도로"},{"start":744.11,"duration":2.2999999999999545,"text":"면발도 되게 쫄깃쫄깃하고"},{"start":746.412,"duration":2.800999999999931,"text":"이 양념장도 약간 새콤달콤해서"},{"start":749.215,"duration":1.6329999999999245,"text":"대중적인 그런 맛이었어요"},{"start":750.85,"duration":1.5679999999999836,"text":"다음 집으로 가시죠"},{"start":752.418,"duration":1.2010000000000218,"text":"잘 먹었습니다"},{"start":758.358,"duration":2.2350000000000136,"text":"지금 마지막 집에 왔습니다"},{"start":760.593,"duration":2.8360000000000127,"text":"오래된 포스를 이미 풍기고 있어요"},{"start":763.429,"duration":2.0670000000000073,"text":"여기는 엄청 유명한 곳이에요"},{"start":765.498,"duration":2.099999999999909,"text":"사실... 가평 3대가 아니라"},{"start":767.6,"duration":2.199999999999932,"text":"전국에서 유명하다고 할 정도로"},{"start":769.802,"duration":2.769999999999982,"text":"대기실도 있어요 이렇게, 유명한 곳답게"},{"start":772.572,"duration":1.802000000000021,"text":"시내에 있는 게 아니라"},{"start":774.374,"duration":1.600999999999999,"text":"이렇게 약간 농촌...?"},{"start":775.975,"duration":3.3029999999999973,"text":"이렇게 밭도 있고... 이런 곳에 이렇게"},{"start":779.278,"duration":1.2329999999999472,"text":"지나가다가 먹을 수 있는 곳은 아니고"},{"start":780.513,"duration":2.2690000000000055,"text":"일부러 여기를 찾아서 와야 되는 곳이거든요"},{"start":782.982,"duration":2.536000000000058,"text":"지금 제가 점심시간을 피해서 왔거든요"},{"start":785.519,"duration":3.5019999999999527,"text":"그래서 지금은 이제 손님이 많이 빠진 것 같아요"},{"start":789.989,"duration":2.602999999999952,"text":"여기 완전 가정집 같다"},{"start":792.592,"duration":1.433999999999969,"text":"포스가 장난 아닌데?"},{"start":794.427,"duration":1.4009999999999536,"text":"거의 4대 개념이 아닐까요?"},{"start":795.828,"duration":1.969000000000051,"text":"4대...! 4대째세요 지금?"},{"start":801.467,"duration":1.6330000000000382,"text":"오 좋아..."},{"start":803.102,"duration":2.036000000000058,"text":"온육수가 있는 곳은 처음이야"},{"start":806.639,"duration":1.5019999999999527,"text":"와 이거 완전 해장이야"},{"start":808.141,"duration":2.701999999999998,"text":"오 싹 내려갔어, 천연 소화제야"},{"start":812.879,"duration":1.467999999999961,"text":"종류가 뭐가 많은데?"},{"start":814.347,"duration":1.8350000000000364,"text":"그래도 녹두전은 먹어봐야겠지?"},{"start":849.515,"duration":3.1030000000000655,"text":"감사합니다"},{"start":852.619,"duration":0.9669999999999845,"text":"오 녹두전"},{"start":855.355,"duration":2.768000000000029,"text":"여기 일단 비주얼이 짱이네"},{"start":858.124,"duration":1.6329999999999245,"text":"여기 원래 쏙갓이 들어가는데"},{"start":859.759,"duration":2.366999999999962,"text":"제가 쑥갓을 못 먹어서 빼달라고 부탁드렸습니다"},{"start":862.128,"duration":3.169999999999959,"text":"살얼음이네 여기는 또?"},{"start":876.976,"duration":2.9360000000000355,"text":"진하다..."},{"start":884.317,"duration":2.8010000000000446,"text":"이건 80% 고기 육수인데..."},{"start":887.12,"duration":2.869000000000028,"text":"사장님 이게 무슨 육수 베이스예요?"},{"start":889.989,"duration":0.9329999999999927,"text":"어 이게 저희가 그..."},{"start":890.923,"duration":1.9020000000000437,"text":"사골육수로 만들었습니다"},{"start":898.164,"duration":2.8360000000000127,"text":"얘는 약간 비빔막국수 느낌이 강한 것 같아요"},{"start":914.747,"duration":2.50100000000009,"text":"여름에 먹기 최고의 막국수"},{"start":917.25,"duration":2.2999999999999545,"text":"얘는 밑에 살얼음이 들어가서"},{"start":919.552,"duration":3.5009999999999764,"text":"면 자체도 입에 들어오자마자 진짜 차갑게"},{"start":923.055,"duration":1.7019999999999982,"text":"진짜 시원해요"},{"start":940.606,"duration":2,"text":"일단 시원하니까 너무 맛있어"},{"start":942.608,"duration":2.3360000000000127,"text":"너무 시원해"},{"start":946.212,"duration":1.3010000000000446,"text":"녹두전도 한입"},{"start":958.024,"duration":1.8999999999999773,"text":"겉바속꾸"},{"start":959.926,"duration":2.4329999999999927,"text":"겉은 바삭하고 속은 꾸덕꾸덕한데"},{"start":962.361,"duration":2.669999999999959,"text":"기름기를 아주 잘 빼서 하나도 기름지지 않아요"},{"start":976.809,"duration":2.0020000000000664,"text":"이거 서비스로 드리라고 하시네요!"},{"start":978.811,"duration":1.40199999999993,"text":"너무 감사합니다"},{"start":980.213,"duration":1.969000000000051,"text":"- 무채랑 같이 드셔보세요 - 감사합니다"},{"start":992.592,"duration":1.4990000000000236,"text":"와 이거 맛있다"},{"start":994.093,"duration":1.6330000000000382,"text":"서비스로 주신 이유를 알겠다!"},{"start":995.728,"duration":2.50100000000009,"text":"엄청 고소한데..."},{"start":998.231,"duration":1.6660000000000537,"text":"진짜 바삭..."},{"start":999.899,"duration":0.7989999999999782,"text":"와 이거..."},{"start":1000.7,"duration":1.9349999999999454,"text":"약간 디저트 같은 매력이 있는데?"},{"start":1002.635,"duration":2.0019999999999527,"text":"토종 디저트"},{"start":1017.083,"duration":2.2670000000000528,"text":"아 여기..."},{"start":1019.352,"duration":2.302000000000021,"text":"먹을수록 매력 있네?"},{"start":1049.949,"duration":0.9009999999998399,"text":"녹두전"},{"start":1051.717,"duration":1.3009999999999309,"text":"한입씩 드셔보세요"},{"start":1063.93,"duration":2.268000000000029,"text":"전도 엄청 담백해서 맛있네"},{"start":1077.477,"duration":1.1340000000000146,"text":"아 잘 먹었다"},{"start":1079.011,"duration":2.6010000000001128,"text":"아 여기는 일단..."},{"start":1081.614,"duration":1.8679999999999382,"text":"첫 번째로 분위기가 너무 좋아요"},{"start":1083.482,"duration":2.303000000000111,"text":"나무도 엄청 많아서 풍경도 너무 좋고"},{"start":1085.785,"duration":2.3019999999999072,"text":"약간 할머니 집 온 것 같은 느낌도 들고"},{"start":1088.087,"duration":1.4660000000001219,"text":"그리고 이제 두 번째로"},{"start":1089.555,"duration":3.5349999999998545,"text":"살얼음 육수가 들어가서 면 자체가 되게 시원하고"},{"start":1093.092,"duration":1.0989999999999327,"text":"맛도 전체적으로 맛있고"},{"start":1094.193,"duration":1.7999999999999545,"text":"온육수도 있어서 굉장히 좋은 것 같습니다"},{"start":1095.995,"duration":1.768000000000029,"text":"겨울에 오기도 좋을 것 같아요"},{"start":1097.897,"duration":3.4680000000000746,"text":"와... 지금 3개 다 먹고 나왔는데"},{"start":1101.367,"duration":2.2360000000001037,"text":"1등을 고른다고 해서..."},{"start":1103.603,"duration":3.168999999999869,"text":"아 진짜 너무 고민되는데? 어떡하지?"},{"start":1106.772,"duration":1.7019999999999982,"text":"첫 번째 집은요"},{"start":1108.474,"duration":1.9020000000000437,"text":"진짜 딱 그 집만의 맛이 있었어요"},{"start":1110.376,"duration":3.1369999999999436,"text":"간장 베이스의 맛, 처음 먹어본 육수"},{"start":1113.513,"duration":2.701999999999998,"text":"채소로 만들었다는 것도 되게 인상 깊었고요"},{"start":1116.215,"duration":1.969000000000051,"text":"두 번째 집은"},{"start":1118.184,"duration":1.4010000000000673,"text":"면발이 일단 굵고"},{"start":1119.585,"duration":3.1700000000000728,"text":"예전에 먹었을 때랑 맛이 살짝 뭔가 다른 것 같긴 한데"},{"start":1122.756,"duration":2.8689999999999145,"text":"약간 달달한 양념이 특징이었고"},{"start":1125.625,"duration":2.0679999999999836,"text":"그리고 세 번째 집은"},{"start":1127.693,"duration":2.0370000000000346,"text":"분위기가 일단 끝장이었고"},{"start":1129.73,"duration":2.367999999999938,"text":"곁들여 먹을 수 있는 사이드 메뉴도 너무 좋았고"},{"start":1132.099,"duration":1.9010000000000673,"text":"그리고 진짜 시원해요"},{"start":1134,"duration":2.6359999999999673,"text":"그래서 제 1등은요"},{"start":1136.636,"duration":1.8350000000000364,"text":"첫 번째 집이 괜찮았던 것 같아요"},{"start":1138.471,"duration":4.067999999999984,"text":"다 너무 막상막하여서 고르기 너무 힘들었는데"},{"start":1142.541,"duration":3.104000000000042,"text":"제 입맛에는 거기가 생각이 나더라고요"},{"start":1145.911,"duration":2.8689999999999145,"text":"그 독특한 간장 육수와"},{"start":1148.781,"duration":2.201999999999998,"text":"쫄깃한 면발과"},{"start":1150.983,"duration":2.1359999999999673,"text":"그런 것들이 계속 생각나서"},{"start":1153.119,"duration":1.9329999999999927,"text":"제가 갔던 세 곳 말고도"},{"start":1155.054,"duration":3.0679999999999836,"text":"가평에 진짜 맛있는 막국수집들이 많거든요"},{"start":1158.124,"duration":3.2029999999999745,"text":"다들 오셔서 맛있는 막국수 드시고 가십쇼"},{"start":1161.327,"duration":3.769999999999982,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
