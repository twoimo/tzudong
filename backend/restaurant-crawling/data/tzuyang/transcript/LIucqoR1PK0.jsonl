,{"start":71.851,"duration":2.198999999999998,"text":"기내식 라면 미방분이 있었는데"},{"start":74.051,"duration":3.399000000000001,"text":"기내식에서 먹는 그 맛을 제가 구현해 내보겠다고"},{"start":77.452,"duration":4.048000000000002,"text":"여러 가지 넣고 이것저것 해서 먹고 그랬었는데"},{"start":81.502,"duration":2.8980000000000103,"text":"그 기내식 라면이 세상에 나왔습니다아-!!!"},{"start":84.402,"duration":2.4980000000000047,"text":"그래서 오늘 보러 갈 거예요"},{"start":92.101,"duration":1.2489999999999952,"text":"짠!"},{"start":94.35,"duration":2.200000000000003,"text":"와 근데 이거 진짜 대박이다"},{"start":96.551,"duration":1.5990000000000038,"text":"보이세요? 여기도 제 얼굴"},{"start":98.152,"duration":4.748000000000005,"text":"여기도 제 얼굴"},{"start":102.902,"duration":0.847999999999999,"text":"짱이죠?"},{"start":103.75200000000001,"duration":2.4979999999999905,"text":"사실 제가 이거 맛본 거..."},{"start":106.25200000000001,"duration":1.3979999999999961,"text":"제품당 한 열 번은 될걸요?"},{"start":107.652,"duration":1.1979999999999933,"text":"게속 '아 이건...'"},{"start":108.851,"duration":0.8990000000000009,"text":"'아 이건...'"},{"start":109.75200000000001,"duration":1.3479999999999848,"text":"'아 이건...' 이래서"},{"start":111.101,"duration":2.7489999999999952,"text":"드디어 제가 맛있다고 했습니다"},{"start":113.851,"duration":1.0490000000000066,"text":"아 맞아여 맞아여"},{"start":114.902,"duration":1.3979999999999961,"text":"컨펌받기 좀 쉽지 않았고..."},{"start":116.301,"duration":2.149000000000001,"text":"맛 잡는 것도 조금 많이 어려웠고..."},{"start":118.452,"duration":1.847999999999999,"text":"솔직히 까다로운 편이었나요?"},{"start":120.301,"duration":1.5990000000000038,"text":"- 아닙니다 아닙니다 - 솔직히"},{"start":121.902,"duration":3.097999999999999,"text":"- 저희 내부에서 그런 말 한 번도 일어난 적이 없었던! - 그래요?"},{"start":125.002,"duration":1.8980000000000103,"text":"그런 걸 까다롭다고 생각하기보다"},{"start":126.902,"duration":2.2480000000000047,"text":"오히려 정확한 피드백을 주셔서"},{"start":129.152,"duration":3.048000000000002,"text":"- 저희가 되게 많이 도움이 됐어요-! - 감사합니다"},{"start":132.202,"duration":1.4480000000000075,"text":"닭강정도..."},{"start":133.652,"duration":3.098000000000013,"text":"양이 너무 많아서