79999999999848,"text":"간장 먼저"},{"start":203.45,"duration":2.1000000000000227,"text":"집에서 맥주 안주로 진짜 좋아요"},{"start":210.55,"duration":5,"text":"치킨 순살 1마리 중량"},{"start":215.552,"duration":3.348000000000013,"text":"순살치킨 1마리 중량이 약 350~500g이래요"},{"start":218.902,"duration":1.6980000000000075,"text":"근데 얘가 600g이에요"},{"start":220.602,"duration":2.0979999999999848,"text":"근데! 9,900원!"},{"start":222.702,"duration":1.2479999999999905,"text":"진짜 괜찮죠?"},{"start":223.952,"duration":2.7479999999999905,"text":"얘는 확실히 매콤한 맛이고"},{"start":226.702,"duration":2.098000000000013,"text":"얘는 되게 달달한 간장 맛이라서"},{"start":228.802,"duration":2.1980000000000075,"text":"취향이 나뉘는 둘이서도 먹을 수 있고"},{"start":231.002,"duration":0.9979999999999905,"text":"- -"},{"start":232.002,"duration":2.947999999999979,"text":"사실 이게 진짜 치킨 1마리 양인 거잖아요"},{"start":234.952,"duration":3.4979999999999905,"text":"오늘 아침에 해서 그런가 너무 맛있는데요?"},{"start":244.502,"duration":1.8979999999999961,"text":"드디어 기내식 라면-!"},{"start":246.402,"duration":3.1480000000000246,"text":"양이 또 많거든요? 엄청 커 보이지 않잖아요, 근데 양이 많아요"},{"start":249.552,"duration":2.647999999999996,"text":"이제... 110g! 110g입니다"},{"start":252.3,"duration":3.1999999999999886,"text":"블록에 고추랑 계란이랑 북어채랑"},{"start":255.502,"duration":2.098000000000013,"text":"막 이것저것 많이 들어가 있거든요?"},{"start":257.602,"duration":4.548000000000002,"text":"여기 무도 있어요, 원래 북엇국 큐브에 무가 들어가거든요"},{"start":262.75,"duration":1.3999999999999773,"text":"잘 먹겠습니다"},{"start":264.85,"duration":0.8999999999999773,"text":"대박이죠?"},{"start":265.752,"duration":3.1479999999999677,"text":"저 진짜 라면 내는 거 약간 꿈이었거든요"},{"start":278,"duration":3.3500000000000227,"text":"제가 만들어서 그런지 너무 내 취향인데?"},{"start":281.352,"duration":1.7480000000000473,"text":"처음에 보내주셨을 때..."},{"start":283.102,"duration":3.298000000000002,"text":"제 기준에서 북어 맛이랑 고추 맛이 너무 약해서..."},{"start":286.402,"duration":2.3980000000000246,"text":"여러 번 막 했거든요, 근데"},{"start":288.802,"duration":3.5979999999999563,"text":"지금 북어랑 고추 향이 먹자마자 싹 올라와요, 진짜"},{"start":313.05,"duration":2.25,"text":"와 국물 진짜 시원해"},{"start":315.302,"duration":2.697999999999979,"text":"북어가 이렇게 큼직큼직하게 들어가 있는 것도 있고요"},{"start":324.5,"duration":2.0500000000000114,"text":"컬래버를 많이 하시는 편이잖아요"},{"start":326.552,"duration":2.7479999999999905,"text":"쯔양 님이 피드백을 많이 주시는 편인가요?"},{"start":329.302,"duration":1.0979999999999563,"text":"많이"},{"start":330.402,"duration":2.198000000000036,"text":"- 그저 많이... - 제가요? 정말요?"},{"start":332.602,"duration":2.2480000000000473,"text":"1단계에서 10단계가 있으면..."},{"start":334.852,"duration":2.048000000000002,"text":"제가 까다로움이 한 어느 정도..."},{"start":339.652,"duration":2.598000000000013,"text":"아 근데 그래서 훨씬 맛이 잘 잡혀서...!"},{"start":342.252,"duration":2.598000000000013,"text":"- 저희가 더 감사하죠-! - 제가 죄송합니다"},{"start":344.852,"duration":1.7980000000000018,"text":"아-! 제가 컨펌 안 했던 거 하나 있어요"},{"start":346.652,"duration":1.5480000000000018,"text":"이거 BIG 꿀호떡"},{"start":348.202,"duration":3.048000000000002,"text":"어렸을 때 먹었던 요만한 꿀호떡 있잖아요"},{"start":351.252,"duration":1.5480000000000018,"text":"그게 빅 사이즈로 나온 거예요"},{"start":352.802,"duration":1.5979999999999563,"text":"먹어보고 이거는 바로 오케이 했어요!"},{"start":354.402,"duration":2.4979999999999905,"text":"너무 맛있어서... 원래 먹던 그 맛이 있으니까"},{"start":356.902,"duration":2.1480000000000246,"text":"과대 포장지가 아니라 진짜 이렇게 커요"},{"start":359.052,"duration":2.697999999999979,"text":"진짜 이렇게 딱 맞춰서 들어있어요"},{"start":370.552,"duration":2.697999999999979,"text":"꿀 가득 입에 차요-!"},{"start":373.252,"duration":3.197999999999979,"text":"그리고 기존보다 꿀이 40% 많이 들어갔대요!"},{"start":376.452,"duration":1.8480000000000132,"text":"평소에 꿀호떡을 좋아하는데"},{"start":378.302,"duration":1.947999999999979,"text":"'꿀이 좀 더 많았으면 좋겠다'라고"},{"start":380.252,"duration":2.848000000000013,"text":"생각하셨던 분들이 드시면 굉장히 만족할 만한"},{"start":383.102,"duration":1.7980000000000018,"text":"꿀이 가득 들어있습니다"},{"start":388.25,"duration":1.8500000000000227,"text":"이걸로 케이크 만들면 맛있을 거 같아요"},{"start":390.102,"duration":2.098000000000013,"text":"낮은 미니 케이크 같은 거 있잖아요"},{"start":392.202,"duration":1.7479999999999905,"text":"그런 거 딱 만들어서 먹으면 좋을 것 같아요"},{"start":393.952,"duration":2.548000000000002,"text":"그래서 제가 또 아이스크림이 나왔잖아요"},{"start":396.502,"duration":3.947999999999979,"text":"짜란~ 이거 진짜 맛있어요, 진짜 예술이에요"},{"start":406.35,"duration":1.7999999999999545,"text":"우유랑..."},{"start":408.152,"duration":1.5980000000000132,"text":"생크림 얼린 느낌?"},{"start":409.752,"duration":1.8480000000000132,"text":"그런 맛이 나거든요?"},{"start":414.15,"duration":3.650000000000034,"text":"그래서 약간 카페 디저트 같아요"},{"start":417.802,"duration":3.298000000000002,"text":"한 번 녹았다 얼면 덜 바삭하거든요"},{"start":421.102,"duration":2.598000000000013,"text":"편의점에 나갈 때는 완전 바삭한 상태일 테니까"},{"start":423.702,"duration":2.298000000000002,"text":"녹기 전에 사자마자 바로 드셔야 돼요!"},{"start":430.9,"duration":2,"text":"이렇게 떼서... 우와"},{"start":434.35,"duration":1.7999999999999545,"text":"반을 이렇게 접어"},{"start":437.1,"duration":1.0499999999999545,"text":"맛있겠죠?"},{"start":441.85,"duration":0.6499999999999773,"text":"이거 봐"},{"start":442.502,"duration":4.048000000000002,"text":"너무! 너무 맛있다!!"},{"start":446.552,"duration":5.647999999999968,"text":"우유생크림? 그런 맛이어서 잘 어울려요"},{"start":458.6,"duration":3.75,"text":"진짜 많다"},{"start":462.352,"duration":1.6480000000000246,"text":"제가 지금 나온 거 말고도"},{"start":464.002,"duration":1.4979999999999905,"text":"계속 더 나올 예정이거든요-!"},{"start":465.502,"duration":1.5480000000000018,"text":"대왕 삼각김밥이랑"},{"start":467.052,"duration":2.5979999999999563,"text":"이것저것 또 여러 가지 준비 중인 게 있거든요?"},{"start":469.652,"duration":2.298000000000002,"text":"많은 기대 부탁드립니다"},{"start":482.4,"duration":2.2000000000000455,"text":"맛도 맛, 양도 양, 다 신경 썼지만"},{"start":484.602,"duration":2.298000000000002,"text":"가격도 엄청 말씀을 드렸거든요"},{"start":486.902,"duration":3.4979999999999905,"text":"무조건 싸고 맛있고 양 많아야 한다고"},{"start":490.402,"duration":2.048000000000002,"text":"샌드 아이스크림이 3,000원 넘는 세상인데..."},{"start":492.452,"duration":1.8480000000000132,"text":"2,500원에 해주셔서"},{"start":494.302,"duration":2.7479999999999905,"text":"진짜 너무너무 싸게 해주셨습니다"},{"start":497.052,"duration":2.3979999999999677,"text":"짜란"},{"start":499.452,"duration":2.1480000000000246,"text":"매콤치즈랑 얘는 그냥 치즈예요"},{"start":501.602,"duration":1.7480000000000473,"text":"이건 왜 치즈로 나왔냐면요"},{"start":503.352,"duration":2.098000000000013,"text":"제가 치즈핫바 아니면 안 먹거든요"},{"start":505.452,"duration":4.148000000000025,"text":"요런 느낌으로다가"},{"start":509.602,"duration":2.348000000000013,"text":"고기 함량이 무려 86%가 들어갔습니다-!"},{"start":511.952,"duration":2.447999999999979,"text":"거의 90% 가까이 들어가서"},{"start":514.401,"duration":2.549000000000092,"text":"진짜 고기 씹는 식감도 나고..."},{"start":516.952,"duration":4.148000000000025,"text":"얘가 3,500원인데 양이 거의 4~5배예요"},{"start":521.102,"duration":4.197999999999979,"text":"일반 소시지가 65g, 뭐 70g 이런 것도 있고"},{"start":525.301,"duration":1.8489999999999327,"text":"좀 더 많으면 80g인 것도 있는데"},{"start":527.151,"duration":3.299000000000092,"text":"얘는 250g이거든요?"},{"start":530.452,"duration":3.298000000000002,"text":"적어도 한 3배에서 5배까지도 가는 거라"},{"start":533.752,"duration":1.1480000000000246,"text":"이거 50초 돌리면 맛있습니다!"},{"start":534.901,"duration":1.2490000000000236,"text":"50초 돌려올게요"},{"start":537.95,"duration":1.6499999999999773,"text":"닭강정 머거야지~"},{"start":552.2,"duration":1.9499999999999318,"text":"안에 치즈 터진 거 보이세요?"},{"start":555.3,"duration":1.400000000000091,"text":"짜란"},{"start":566.55,"duration":2.1000000000000227,"text":"잘게 다져진 느낌이 아니라 약간"},{"start":568.651,"duration":2.8490000000000464,"text":"듬성듬성 다져져서 되게 식감이 있어요"},{"start":571.502,"duration":1.2980000000000018,"text":"그런 느낌이에요"},{"start":572.801,"duration":2.9489999999999554,"text":"안에 이렇게 체더치즈도 듬뿍"},{"start":575.752,"duration":2.1980000000000928,"text":"편의점에 이런 거 막 요즘 팔아요"},{"start":577.952,"duration":0.9479999999999791,"text":"콘치즈도 있고"},{"start":617.35,"duration":3,"text":"얘는 매콤한 버전이라서 꽤 매워요"},{"start":620.352,"duration":3.197999999999979,"text":"매운 거 못 드시는 분들이 드시기엔 좀 매우실 거예요"},{"start":625.05,"duration":1.650000000000091,"text":"이렇게 약간 빨갛습니다"},{"start":627.45,"duration":1.3999999999999773,"text":"육즙 흐르는 것 봐"},{"start":629.25,"duration":5.649999999999977,"text":"이렇게 밥반찬으로 먹어도"},{"start":634.901,"duration":1.8490000000000464,"text":"이런 식으로"},{"start":636.752,"duration":3.1480000000000246,"text":"그 제가 어렸을 때 빅팜 엄청 좋아했거든요"},{"start":639.901,"duration":2.699000000000069,"text":"그 고기 꽉꽉 뭉친 그 맛!"},{"start":642.602,"duration":3.1480000000000246,"text":"소시지로 만든 그런 버전? 좀 비슷해요"},{"start":645.752,"duration":5.34800000000007,"text":"빅팜을 뭔가 진짜 고기 제대로 함량 해서 만든 약간 고급 빅팜?"},{"start":656.4,"duration":1.6499999999999773,"text":"치즈가 들어있어서"},{"start":658.051,"duration":3.74899999999991,"text":"매콤한 맛도 강추드립니다-!"},{"start":661.801,"duration":2.9489999999999554,"text":"오늘 먹으니까 매콤한 맛이 더 맛있는 것 같아"},{"start":664.752,"duration":4.548000000000002,"text":"제가 봤을 때 이 닭강정도 치밥 잘 어울릴 거 같거든요?"},{"start":688.7,"duration":1.5499999999999545,"text":"맛이 계속 똑같아"},{"start":696.45,"duration":2.2999999999999545,"text":"드디어 다 먹었어요, 드디어"},{"start":698.752,"duration":2.1480000000000246,"text":"이번엔 돌려서 먹어볼게요"},{"start":700.901,"duration":1.6990000000000691,"text":"요즘 GS25에서"},{"start":702.602,"duration":1.6480000000000246,"text":"저 이거 완전 빠졌거든요?"},{"start":704.252,"duration":1.34800000000007,"text":"진짜 보이면 사 먹어요"},{"start":705.602,"duration":6.548000000000002,"text":"냄새부터 좋아, 후추 냄새"},{"start":712.151,"duration":3.799000000000092,"text":") 주문하신 기내식 라면 나왔숩니다"},{"start":715.952,"duration":2.1480000000000246,"text":"맛있게 잡수세여 고갱님"},{"start":718.102,"duration":3.298000000000002,"text":"랍스터XO?"},{"start":721.401,"duration":2.8490000000000464,"text":"날치알명란계란말이 여기다 먹으면 맛있겠는데?"},{"start":727.5,"duration":1.2999999999999545,"text":"김도 바삭해"},{"start":729.6,"duration":1,"text":"맛있다"},{"start":730.95,"duration":3.199999999999932,"text":"혹시... 저 삼각김밥 낼 때 있잖아여"},{"start":734.151,"duration":2.299000000000092,"text":"어떻게 하고 싶냐면요ㅎㅎ"},{"start":736.452,"duration":3.697999999999979,"text":"흰밥 부분도 간이 살짝 돼 있으면 좋겠어요"},{"start":740.151,"duration":4.749000000000024,"text":"김은 되게 약간 두텁고 바삭한 김... 좋아하구여"},{"start":744.901,"duration":3.149000000000001,"text":"그리고 밥은 고슬고슬하게..."},{"start":748.051,"duration":2.8489999999999327,"text":"- - 노력해 보겠습니다"},{"start":767.6,"duration":3.5499999999999545,"text":"이번엔 데운 거!"},{"start":775.15,"duration":3.8500000000000227,"text":"근데 기내식 라면이 진짜 삼각김밥이랑 찰떡궁합이에요"},{"start":840.25,"duration":1.6499999999999773,"text":"아 좋다"},{"start":853.6,"duration":3.75,"text":"라면은 근데 아직 왜 끝난 게 아닌 거 같을까요...?"},{"start":857.352,"duration":1.6480000000000246,"text":"너무 만족스러워요...!"},{"start":859.002,"duration":2.1980000000000928,"text":"근데 핫바가..."},{"start":861.202,"duration":2.2480000000000473,"text":"핫바가... 왜요...?"},{"start":863.452,"duration":1.697999999999979,"text":"장난이에요"},{"start":865.151,"duration":2.299000000000092,"text":"저 진짜인 줄 알고ㅎㅋ"},{"start":867.452,"duration":1.3980000000000246,"text":"한번 테스트해 보자!"},{"start":868.852,"duration":3.2480000000000473,"text":"라면이 저기에 올라가 있으면 어떤 느낌인지"},{"start":872.102,"duration":2.1480000000000246,"text":"이상할 것 같은데"},{"start":875.5,"duration":1.7000000000000455,"text":"아 이게 뭐야!"},{"start":877.55,"duration":3.1000000000000227,"text":"와 나 얼굴이 너무 적나라하게 빡 있는데?"},{"start":882.651,"duration":1.5490000000000919,"text":"(NO 적응] 이상하지 않아여...?"},{"start":884.202,"duration":1.3980000000000246,"text":"이상한 거 같은데..."},{"start":885.602,"duration":1.7980000000000018,"text":"저대로 두자"},{"start":887.401,"duration":1.5990000000000464,"text":"예쁘다"},{"start":892.102,"duration":2.34800000000007,"text":"저 파란색에 노란색 조합 좋아하거든요"},{"start":894.452,"duration":1.5480000000000018,"text":"제 마음을 어떻게 아셨는지"},{"start":908.75,"duration":2.7000000000000455,"text":"안에 크림이 약간 생크림 같은 느낌이라"},{"start":911.452,"duration":1.947999999999979,"text":"잘 못 드시는 분들은 약간 느끼할 수 있거든요?"},{"start":913.401,"duration":4.199000000000069,"text":"이제 곧 있으면 또 딸기... 그건 상큼하고 맛있습니다"},{"start":929.3,"duration":4.550000000000068,"text":"제가 진짜 6개월 동안 주고받고 준비를 하면서"},{"start":933.852,"duration":2.697999999999979,"text":"GS25에서도 엄청 열심히 해주셨거든요"},{"start":936.551,"duration":3.149000000000001,"text":"막 진짜 가격도 최대한 내려주시고"},{"start":939.702,"duration":3.5979999999999563,"text":"재료도 최대한 