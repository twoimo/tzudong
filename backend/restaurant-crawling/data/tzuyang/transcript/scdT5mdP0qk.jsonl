{"youtube_link":"https://www.youtube.com/watch?v=scdT5mdP0qk","channel_name":"tzuyang","language":"ko","collected_at":"2026-03-23T21:03:56.696+09:00","transcript":[{"start":14.989,"duration":0.8059999999999992,"text":"한번 다 써볼까?"},{"start":15.797,"duration":1.6379999999999981,"text":"홍콩 야시장 100만 원 털기 해보겠습니다-!"},{"start":24.438,"duration":0.5869999999999997,"text":"저게 뭐야?"},{"start":25.026,"duration":1.0620000000000012,"text":"우와 맛있겠다"},{"start":26.09,"duration":1.065999999999999,"text":"먹어야지"},{"start":43.458,"duration":1.1240000000000023,"text":"자 1, 2, 3"},{"start":44.584,"duration":1.3189999999999955,"text":"1, 2, 3"},{"start":45.905,"duration":1.506999999999998,"text":"어?"},{"start":74.336,"duration":1.8089999999999975,"text":"안녕하세요, 여러분"},{"start":76.146,"duration":4.128,"text":"제가 오늘은 지금 홍콩의 야우마테이라는 지역에 왔는데"},{"start":80.276,"duration":2.206000000000003,"text":"오늘 홍콩 야시장에 왔어요"},{"start":82.48400000000001,"duration":2.089999999999989,"text":"사실 지금 아직 날이 밝잖아요"},{"start":84.576,"duration":3.348000000000013,"text":"해가 지기 전에 좀 풍경을 담으러 왔습니다"},{"start":87.926,"duration":1.9309999999999974,"text":"이제 템플 스트리트라고 해서"},{"start":89.85900000000001,"duration":3.2860000000000014,"text":"틴하우 사원이 있었는데 그 유명한 사원 앞에"},{"start":93.146,"duration":3.823999999999998,"text":"1920년도에 생긴 '템플 스트리트 야시장'이라고 합니다"},{"start":96.97200000000001,"duration":3.0279999999999916,"text":"여기는 약간 노점들이 형상된 야시장이라서"},{"start":100.00200000000001,"duration":1.6929999999999836,"text":"관광객분들이 정말 많이 오신대요"},{"start":101.696,"duration":4.222000000000008,"text":"그래서 실제로 올 때마다 인파가 정말 많거든요"},{"start":105.92,"duration":1.284000000000006,"text":"1, 2"},{"start":107.205,"duration":2.043999999999997,"text":"3, 4, 5"},{"start":109.25,"duration":2.365000000000009,"text":"제가 100만 원 정도 두둑이 챙겨왔는데"},{"start":111.616,"duration":0.7420000000000044,"text":"한번 다 써볼까?"},{"start":112.36,"duration":3.198999999999998,"text":"제가 한 번도 시장에서 100만 원 털기를 성공해 본 적이 없거든요"},{"start":115.561,"duration":2.7889999999999873,"text":"홍콩은 물가가 좀 있는 편이라..."},{"start":118.351,"duration":1.6509999999999962,"text":"한번 도전해 볼 법도 한데..."},{"start":120.003,"duration":1.820999999999998,"text":"아 근데 못 하지 않을까?"},{"start":121.826,"duration":3.0330000000000013,"text":"일단 100만 원 털기 도전해 보겠습니다-!"},{"start":124.86,"duration":2.965999999999994,"text":"와... 진짜 인파가 장난 아니에요"},{"start":127.827,"duration":1.6740000000000066,"text":"주스, 밀크티"},{"start":129.503,"duration":2.7590000000000146,"text":"홍콩 하면 떠오르는 밀크티도 여기 있고"},{"start":139.385,"duration":3.1779999999999973,"text":") 뭐 이런 꼬치류 같은 것도 팔고요"},{"start":142.565,"duration":1.8530000000000086,"text":"에그타르트다"},{"start":144.42000000000002,"duration":1.8599999999999852,"text":"이거 완전 홍콩식 에그타르트 같은데?"},{"start":146.282,"duration":2.1149999999999807,"text":"어? 이거 그거! 홍콩와플-!"},{"start":148.399,"duration":1.100999999999999,"text":"홍콩와플이네~"},{"start":149.502,"duration":2.0989999999999895,"text":"아 근데 디저트를 먼저 먹어도 되나...?"},{"start":151.603,"duration":2.3930000000000007,"text":"처음 먹어보는 거니까 오리지널로 한번 먹어볼게요"},{"start":160.078,"duration":2.884999999999991,"text":"에그와플은 '가이단자이'라고 한대요"},{"start":162.965,"duration":2.1570000000000107,"text":"저 진짜 홍콩와플..."},{"start":165.124,"duration":2.301000000000016,"text":"그렇게 유행했었는데 처음 먹어봐요...!"},{"start":180.432,"duration":1.6129999999999995,"text":"우와 되게 맛있어 보인다"},{"start":182.5,"duration":1.4000000000000057,"text":"윤기가 잘잘 흐르는데?"},{"start":183.902,"duration":1.100999999999999,"text":"기대된다"},{"start":185.745,"duration":1.0979999999999848,"text":"내 거 됐다"},{"start":191.254,"duration":2.781000000000006,"text":"커스터드빵처럼 부들부들할 줄 알았는데"},{"start":194.037,"duration":2.8079999999999927,"text":"겉에가 코팅된 것처럼 엄청 매끈매끈한데?"},{"start":196.847,"duration":1.0279999999999916,"text":"무슨 초콜릿 같아...!"},{"start":197.877,"duration":2.1219999999999857,"text":"- - 이렇게 초콜릿같이 생겼어"},{"start":207.785,"duration":2.930000000000007,"text":"안에 오히려 살짝 공갈빵처럼..."},{"start":213.888,"duration":1.7769999999999868,"text":"맛은 약간 카스텔라?"},{"start":215.667,"duration":1.3479999999999848,"text":"모양대로 떼 먹는 재미가 있어요"},{"start":217.017,"duration":1.608000000000004,"text":"우와 맛있다"},{"start":218.627,"duration":1.9279999999999973,"text":"먹으면서 이동할까?"},{"start":220.55700000000002,"duration":1.7649999999999864,"text":"맛있는 거 되게 많아 보인다ㅎ"},{"start":222.324,"duration":1.6239999999999952,"text":"어?! 꼬치 요리도 있네?"},{"start":223.95,"duration":1.6020000000000039,"text":"어 탕후루다"},{"start":225.554,"duration":1.8290000000000077,"text":"아니야, 좀 이따, 디저트 좀 이따"},{"start":229.53300000000002,"duration":0.9989999999999668,"text":"맛있겠다"},{"start":230.9,"duration":1.5,"text":"우와... 맛있겠다"},{"start":232.402,"duration":1.2930000000000064,"text":"굴 먹어야지"},{"start":235.677,"duration":2.1880000000000166,"text":"굴이 진짜 이만해"},{"start":242.865,"duration":2.3899999999999864,"text":"우리나라에서 파는 삼배체굴보다 더 큰 거 같은데?"},{"start":245.257,"duration":2.852000000000004,"text":"통영 자연산 굴 사이즈예요...! 이만한 거...!"},{"start":255.515,"duration":1.4630000000000223,"text":"진짜 크다"},{"start":256.98,"duration":2.562000000000012,"text":"이렇게 큰 굴은 뭔가 처음 먹어보는 거 같은데...?"},{"start":265.285,"duration":2.7199999999999704,"text":"안에 이렇게 내장에도"},{"start":281.782,"duration":3.915999999999997,"text":"안에 소스도 호불호 없이 딱 맛있는...!"},{"start":285.7,"duration":1.8600000000000136,"text":"맛있다"},{"start":287.562,"duration":2.7899999999999636,"text":"제가 굴을 진짜 좋아하는데 너무 맛있어요"},{"start":290.354,"duration":3.77800000000002,"text":"굴이 크니까 그 야들야들한 식감이 더 맛있게 느껴지네"},{"start":294.134,"duration":1.6409999999999627,"text":"과일주스?"},{"start":301.837,"duration":1.8950000000000387,"text":"수박주스 맛있어라~~ 제발~~"},{"start":303.734,"duration":1.8140000000000214,"text":"달아라!! 달아라!!"},{"start":305.55,"duration":1.3949999999999818,"text":"감사합니다~"},{"start":309.975,"duration":2,"text":"어우 수박주스 맛있다"},{"start":311.977,"duration":3.798000000000002,"text":"지금 한국은 수박 철이 아니라서... 수박이"},{"start":315.777,"duration":2.9680000000000177,"text":"안 단데 여기는 그래도 달달하네"},{"start":318.747,"duration":4.392999999999972,"text":"약간 남대문시장처럼 이것저것 기념품들이 있어요"},{"start":323.142,"duration":1.4429999999999836,"text":"아이러브홍콩"},{"start":324.587,"duration":2.649000000000001,"text":"아이러브홍콩 티 사야 되는데"},{"start":327.238,"duration":2.1170000000000186,"text":"먹을 걸 찾아서 떠나보겠습니다"},{"start":333.354,"duration":1.6310000000000286,"text":"뭔가 시장을 좀 벗어난 것 같은데?"},{"start":334.987,"duration":0.4609999999999559,"text":"엇-!"},{"start":335.45,"duration":1.0529999999999973,"text":"맛있겠다"},{"start":336.505,"duration":2.2100000000000364,"text":"꼬치"},{"start":338.717,"duration":1.4780000000000086,"text":"우와 맛있겠다"},{"start":341.1,"duration":3.2450000000000045,"text":"막창 종류도 있고 닭고기, 대창"},{"start":344.347,"duration":1.4980000000000473,"text":"완자 같은 것도 있네"},{"start":349.087,"duration":2.858000000000004,"text":"얘는 뭔가 약간 카레 맛 나는 돼지고기 같고!"},{"start":351.947,"duration":1.8079999999999927,"text":"이건 뭔가 막창 같아요!"},{"start":353.757,"duration":1.5649999999999977,"text":"생긴 게 돼지막창!"},{"start":367.566,"duration":1.0780000000000314,"text":"여기 너무 맛있다"},{"start":380.808,"duration":1.51400000000001,"text":"잘 먹겠습니다-!"},{"start":382.324,"duration":1.7110000000000127,"text":"뭐부터 먹지? 이거 무슨 맛일까..."},{"start":384.037,"duration":1.3620000000000232,"text":"얘는 돼지 같은데?"},{"start":389.685,"duration":1.863999999999976,"text":"완벽한 맥주 안주야...!"},{"start":391.551,"duration":4.093999999999994,"text":"진짜 짭짤하고 맛있어"},{"start":400.722,"duration":0.7630000000000337,"text":"멋지다"},{"start":401.487,"duration":4.787999999999954,"text":"양고기인데 양 향이 엄청 안 세고 딱 은은하게 나서 너무 맛있다"},{"start":411.185,"duration":1.579999999999984,"text":"꼬치 맛있어"},{"start":418.615,"duration":3.339999999999975,"text":"근데 홍콩만의 소고기 식감이 있나 봐요"},{"start":421.957,"duration":2.29200000000003,"text":"부드럽다기보단 말캉말캉?"},{"start":427.513,"duration":0.8320000000000505,"text":"맛있어"},{"start":428.347,"duration":2.312000000000012,"text":"이건 닭 같은데?"},{"start":446.055,"duration":1.7300000000000182,"text":"다음 거 빨리 먹으러 가야 돼!"},{"start":447.787,"duration":1.9350000000000023,"text":"길거리 음식 먹었던 곳은"},{"start":449.724,"duration":1.9990000000000236,"text":"이렇게 쭈욱 시장 골목이고"},{"start":451.725,"duration":2.6749999999999545,"text":"그 옆에 골목이 엄청 많이 형성되어 있는데"},{"start":454.402,"duration":2.923000000000002,"text":"양옆 골목 사이사이 먹을 식당이 진짜 많거든요?"},{"start":462.9,"duration":1,"text":"뭐야?"},{"start":463.902,"duration":2.0430000000000064,"text":"되게 맛있어 보인다"},{"start":466.645,"duration":0.9650000000000318,"text":"카레구나-!"},{"start":467.612,"duration":2.0849999999999795,"text":"생긴 게 되게 비주얼이 좋은데?"},{"start":471.887,"duration":2.201000000000022,"text":"아~! 여기 풍자 님 오신 곳이구나~"},{"start":474.09000000000003,"duration":3.151999999999987,"text":"약간 믿고 갈 수 있는 곳 아닌가?"},{"start":481.558,"duration":1.3829999999999814,"text":"그냥 카레가 아니라"},{"start":482.943,"duration":1.8500000000000227,"text":"홍콩식 카레래요"},{"start":484.795,"duration":3.349999999999966,"text":"그래서 이런 좀 특이한 비주얼인데"},{"start":488.147,"duration":2.323000000000036,"text":"왕새우카레 먹어야겠어요"},{"start":491.901,"duration":4.1129999999999995,"text":"내가 아는 카레랑은 비주얼이 완전히 다른데?"},{"start":501.5,"duration":1.3949999999999818,"text":"어? 카레인데..."},{"start":502.897,"duration":1.40300000000002,"text":"한국 카레도 아니고..."},{"start":504.302,"duration":2.551999999999964,"text":"일본 카레도 아니고..."},{"start":506.854,"duration":1.872000000000014,"text":"인도 카레도 아니고..."},{"start":508.728,"duration":1.9799999999999613,"text":"뭔가 다 그 중간쯤?"},{"start":510.71,"duration":2.391999999999996,"text":"토마토 같은 맛도 살짝 나고요"},{"start":513.103,"duration":2.261000000000081,"text":"혀끝이 얼얼한 매콤함도 있고"},{"start":515.366,"duration":0.9460000000000264,"text":"독특한데?"},{"start":525.485,"duration":1.405999999999949,"text":"여기 밥은 좀 맛있다"},{"start":526.892,"duration":1.9639999999999418,"text":"아 근데 되게 맵다...!"},{"start":528.858,"duration":1.802000000000021,"text":"중간 맛이 이렇게 맵다고?"},{"start":534,"duration":1.6870000000000118,"text":"매운탕도 막 갑자기 생각나고"},{"start":535.689,"duration":2.2530000000000427,"text":"매운탕 맛도 뭔가 나는 거 같기도 해요"},{"start":541,"duration":4.55499999999995,"text":"얼큰한 매운탕 국물에다가..."},{"start":545.556,"duration":2.24899999999991,"text":"카레를 넣은 거 같은 맛이기도 하고..."},{"start":555.761,"duration":1.6929999999999836,"text":"새우 진짜 크다"},{"start":557.455,"duration":0.9739999999999327,"text":"맵다"},{"start":565.845,"duration":2.937999999999988,"text":"개인적으로 저는 먹다 보니까 호입니다-!"},{"start":568.785,"duration":1.4500000000000455,"text":"약간 매력 있어요"},{"start":575.773,"duration":2.2269999999999754,"text":"좋아하시는 분들은 진짜 좋아하실 거 같은"},{"start":578.002,"duration":1.6880000000001019,"text":"그런 중독성 있는 카레였습니다!"},{"start":579.692,"duration":1.5439999999999827,"text":"다음 집으로 바로 갈게요"},{"start":581.238,"duration":3.1269999999999527,"text":"사실 100만 원을 쓰려면 멀고도 험하기 때문에"},{"start":584.367,"duration":3.1480000000000246,"text":"스태프분들 것도 함께 제가 결제하겠습니다"},{"start":596.733,"duration":2.632000000000062,"text":"지금 생각보다 되게 빨리 쓰고 있는데...?"},{"start":600.828,"duration":1.927000000000021,"text":"아니에요, 아직 멀었습니다"},{"start":602.757,"duration":0.8029999999999973,"text":"착각이었어요"},{"start":603.561,"duration":2.0739999999999554,"text":"먹고 싶은 거 맘껏 먹어야겠어!"},{"start":613.655,"duration":3.1000000000000227,"text":"확실히 밤이 되니까 야시장이 훨씬 예쁘다"},{"start":616.757,"duration":1.4370000000000118,"text":"확실히 다르네~"},{"start":619.513,"duration":2.2719999999999345,"text":"밥 먹었으니까 약간 음료수 하나 먹어줘야 되지 않나?"},{"start":621.7860000000001,"duration":2.088999999999942,"text":"레몬티 한 잔만 먹을까?"},{"start":623.877,"duration":4.16700000000003,"text":"패션프루트 레몬소다"},{"start":631.799,"duration":2.9020000000000437,"text":"진짜 엄청 열심히 만들어주신다...!"},{"start":636.479,"duration":2.6259999999999764,"text":"거의 칵테일 만들 듯이 이렇게 만들어주세요"},{"start":642.258,"duration":1.0190000000000055,"text":"아 시원해"},{"start":643.279,"duration":1.6760000000000446,"text":"나는 네가 왜 시켰나 했어"},{"start":644.957,"duration":1.3880000000000337,"text":"카피르라임 들어가 있어"},{"start":646.347,"duration":1.7530000000000427,"text":"레몬이라고 쓰여있길래"},{"start":649.293,"duration":2.29200000000003,"text":"그 야시장 근처에 완탕집이 하나 있더라고요-!"},{"start":651.587,"duration":1.1680000000000064,"text":"되게 오래되고"},{"start":652.757,"duration":2.3630000000000564,"text":"무려 100년 된 완탕집이라고 하더라고요"},{"start":655.122,"duration":2.22300000000007,"text":"웨이팅이 없어야 될 텐데...~"},{"start":659.507,"duration":1.83400000000006,"text":"여기 웨이팅 있는 거 같아"},{"start":661.343,"duration":1.4750000000000227,"text":"아니네, 안 기네?"},{"start":662.819,"duration":1.0330000000000155,"text":"먹을 수 있겠다"},{"start":663.853,"duration":1.3610000000001037,"text":"이 정도면 괜찮은데?"},{"start":667.985,"duration":1.5769999999999982,"text":"특이하게 생긴 족발 이거랑"},{"start":669.564,"duration":2.2810000000000628,"text":"완탕 하나 맛봐 볼게요"},{"start":671.847,"duration":1.7810000000000628,"text":"지금 홍콩 와서 완탕을 먹어봤어야 했는데"},{"start":673.63,"duration":1.79200000000003,"text":"완탕을 제대로 못 먹었어요"},{"start":675.424,"duration":1.600999999999999,"text":"100년 전통 완탕집"},{"start":677.026,"duration":2.274000000000001,"text":"여기 오면 제대로 된 완탕 먹을 수 있겠지?"},{"start":679.985,"duration":1.6119999999999663,"text":"이게 완탕 국물인가?"},{"start":681.598,"duration":2.0270000000000437,"text":"완탕 국물인 거 같은데"},{"start":688.512,"duration":3.65300000000002,"text":"뭔가 진한 새우, 게 같은 향"},{"start":695.145,"duration":0.90300000000002,"text":"진하다"},{"start":696.05,"duration":1.7710000000000719,"text":"국물 맛있다"},{"start":697.823,"duration":1.620999999999981,"text":"이거 제가 좋아하는 국물인데"},{"start":718.622,"duration":1.3330000000000837,"text":"그릇이 조그맣다고 들었는데"},{"start":719.957,"duration":1.4980000000000473,"text":"되게 조그맣긴 하다"},{"start":721.457,"duration":2.2770000000000437,"text":"- - 딱 들춰내면 이렇게 완탕이 있대요"},{"start":735.425,"duration":2.1130000000000564,"text":"어... 향이 있다아...!"},{"start":741.54,"duration":2.25100000000009,"text":"국물은 제 입맛에 딱 맞거든요?"},{"start":743.793,"duration":3.391999999999939,"text":"면에 고수처럼 못 먹는 그런 향이 들어가 있는 거 같아요"},{"start":758,"duration":2.1000000000000227,"text":"너무 맛있다!"},{"start":760.102,"duration":2.1030000000000655,"text":"만두 속에 있는 새우가"},{"start":762.207,"duration":2.7930000000000064,"text":"진짜 이를 이렇게 팅 하고 튕겨낼 정도로"},{"start":765.002,"duration":2.1650000000000773,"text":"엄청 탱글탱글한데"},{"start":767.169,"duration":4.121999999999957,"text":"이 만두피도 너무 두껍지 않고 딱 적당해서 야들야들하고"},{"start":780.285,"duration":2.41700000000003,"text":"이거 앞에 있는 족발 PD님 건데..."},{"start":782.704,"duration":1.51400000000001,"text":"족발 하나만 도전해 볼까?"},{"start":788.525,"duration":1.830000000000041,"text":"족발은 제가 싫어하는 향 안 나요"},{"start":790.357,"duration":0.7280000000000655,"text":"맛있어요"},{"start":795.638,"duration":3.1499999999999773,"text":"우리 한국처럼 한방 맛 많이 나고..."},{"start":804.745,"duration":1.9700000000000273,"text":"자극적인 맛이에요"},{"start":810.277,"duration":2.5949999999999136,"text":"간단하게 일단 간식을 즐겼으니까"},{"start":812.873,"duration":1.8819999999999482,"text":"다음 장소로 또 먹으러 가겠습니다"},{"start":814.757,"duration":1.9150000000000773,"text":"완탕집 바로 앞에 나오면"},{"start":816.674,"duration":1.0310000000000628,"text":"여기 바로 앞에 또..."},{"start":817.707,"duration":1.2989999999999782,"text":"3초 밀크티라고 불린대요"},{"start":819.007,"duration":1.9250000000000682,"text":"'3초 만에 만들어지는 밀크티'라고 해서"},{"start":820.934,"duration":2.3310000000000173,"text":"그럼 제가 3초 만에 먹어보도록 하겠습니다"},{"start":831.107,"duration":0.65300000000002,"text":"진짜 바로 나왔어"},{"start":831.762,"duration":1.4510000000000218,"text":"- 진짜 빨리 나오네 - 진짜 빨리 나왔어"},{"start":834.135,"duration":1.2519999999999527,"text":"진짜 빨리 나왔다"},{"start":835.388,"duration":2.7799999999999727,"text":"손님 없을 때 오면 진짜 3초 만에 나올 거 같거든요?"},{"start":838.17,"duration":1.1870000000000118,"text":"어떻게 이렇게 빨리 만드시지...?"},{"start":839.358,"duration":1.532000000000039,"text":"밀크티"},{"start":840.891,"duration":1.1829999999999927,"text":"냄새 좋은데?"},{"start":847.055,"duration":1.3570000000000846,"text":"와!"},{"start":848.414,"duration":1.197999999999979,"text":"진짜 진하다"},{"start":853,"duration":1.5779999999999745,"text":"너무 내 취향이야"},{"start":854.579,"duration":1.600999999999999,"text":"한국인이 좋아하는"},{"start":856.181,"duration":1.9739999999999327,"text":"그 우유 넣은 제티 같은 맛도 나요-!"},{"start":861.778,"duration":0.8769999999999527,"text":"진짜 맛있어요"},{"start":862.656,"duration":2.0130000000000337,"text":"진짜 이건 우유 고소한 맛이다"},{"start":864.67,"duration":2.275000000000091,"text":"진짜 색깔 엄청 진해요~"},{"start":875.242,"duration":1.3710000000000946,"text":"진짜 