40000000001146,"text":"크기 봐"},{"start":763.81,"duration":1.1100000000000136,"text":"으에?"},{"start":766.7,"duration":1.4499999999999318,"text":"엉?"},{"start":768.151,"duration":3.1090000000000373,"text":"약간 갈비찜계의 투뿔인데?"},{"start":771.262,"duration":1.3680000000000518,"text":"말도 안 되게 부드럽다"},{"start":779.41,"duration":1.4300000000000637,"text":"뚝뚝 떨어지는데?"},{"start":790.31,"duration":2.0400000000000773,"text":"와 무슨 약간..."},{"start":792.352,"duration":1.45799999999997,"text":"브리스킷 먹는 거 같아요"},{"start":801.57,"duration":2.92999999999995,"text":"갈비찜에도 당면이 있네...?"},{"start":824.21,"duration":2.099999999999909,"text":"여기가 진짜 좋은 게"},{"start":826.311,"duration":3.1089999999999236,"text":"막 식당에서 김치나 반찬이 너무 맛있으면"},{"start":829.421,"duration":1.6689999999999827,"text":"되게 사 가고 싶은데"},{"start":831.092,"duration":2.298000000000002,"text":"사장님께 약간 민망해서 못 물어보거든요"},{"start":833.391,"duration":2.70900000000006,"text":"저기 마음에 드는 반찬 사 갈 수 있게"},{"start":836.102,"duration":2.187999999999988,"text":"저렇게 카운터에 있어요"},{"start":838.2909999999999,"duration":6.77900000000011,"text":"임연수가"},{"start":854.25,"duration":2.990000000000009,"text":"생선 결이 있잖아요, 살 사이사이"},{"start":857.242,"duration":0.9080000000000155,"text":"다 촉촉해요!"},{"start":858.64,"duration":1.4700000000000273,"text":"밥 하나 더 해야겠어"},{"start":860.112,"duration":1.5080000000000382,"text":"아 이번엔 흑미밥 가잇 하잇"},{"start":861.622,"duration":0.9880000000000564,"text":"흑미밥도 궁금해"},{"start":862.612,"duration":1.038000000000011,"text":"밥만 먹어볼래요"},{"start":863.651,"duration":1.4990000000000236,"text":"여기 밥이 너무 맛있어서..."},{"start":869.06,"duration":2.330000000000041,"text":"여기 밥이 진짜 달다"},{"start":871.391,"duration":1.469000000000051,"text":"밥 자체가 맛이네"},{"start":872.862,"duration":1.3380000000000791,"text":"솥밥을 하면 더 맛있긴 해요"},{"start":874.202,"duration":1.3980000000000246,"text":"솥밥이 더 맛있긴 한데"},{"start":875.602,"duration":1.9680000000000746,"text":"흑미도 일반 밥보다 충분히 맛있어요"},{"start":903.2,"duration":4.099999999999909,"text":"장훈 님이 제일 추천하신 묵은지고등어조림"},{"start":907.301,"duration":1.7989999999999782,"text":"통무!"},{"start":917.86,"duration":2.6100000000000136,"text":"와 근데 진짜 김장훈 님 맛잘알이신 것 같아요"},{"start":920.472,"duration":3.1680000000000064,"text":"나도 이거 지점 내고 싶다"},{"start":923.641,"duration":1.3090000000000828,"text":"다 맛있네!"},{"start":924.952,"duration":1.52800000000002,"text":"원래 약간 무등은지 고등어"},{"start":926.482,"duration":0.36800000000005184,"text":"뭐라는 거야ㅋ"},{"start":926.852,"duration":2.368000000000052,"text":"묵은지고등어조림을 먹으면"},{"start":929.222,"duration":2.4680000000000746,"text":"살짝 비린 맛이 국물에 많이 나잖아요"},{"start":931.692,"duration":1.8279999999999745,"text":"국물도 깔끔하고"},{"start":933.521,"duration":1.0890000000000555,"text":"안에 묵은지가"},{"start":934.612,"duration":2.6779999999999973,"text":"입안에서 사르르 녹는 묵은지예요"},{"start":937.2909999999999,"duration":1.7390000000000327,"text":"진짜 입에서 엄청 부드러워요"},{"start":939.95,"duration":4.0499999999999545,"text":"무를 스테이크..."},{"start":944.002,"duration":1.3070000000000164,"text":"무슨 케이크야?"},{"start":951.81,"duration":1.9200000000000728,"text":"역대급으로 부드러운 무다"},{"start":961.24,"duration":1.9800000000000182,"text":"고등어가 뚱뚱해"},{"start":1000.13,"duration":1.490000000000009,"text":"와 이제 굴비 먹어야겠다"},{"start":1001.622,"duration":1.038000000000011,"text":"굴비 먹어야 돼!"},{"start":1002.6610000000001,"duration":1.6389999999998963,"text":"굴비는 모둠에 없는 메뉴거든요?"},{"start":1004.301,"duration":1.8239999999999554,"text":"제가 또 굴비를 좋아하거든요"},{"start":1012.72,"duration":2.0799999999999272,"text":"맛있는뎁?"},{"start":1014.801,"duration":2.738999999999919,"text":"원래 굴비 먹을 때는 찬밥에!"},{"start":1017.5409999999999,"duration":1.6760000000000446,"text":"그냥 먹어도 찰지고 맛있어"},{"start":1026.25,"duration":2.400000000000091,"text":"굴비도 이것보다 더 맛있어진다니까"},{"start":1028.652,"duration":2.268000000000029,"text":"진짜 너무 괜찮을 것 같은데?"},{"start":1030.922,"duration":2.9279999999998836,"text":"원래 굴비는 이렇게 싹 한 번에 발라서"},{"start":1033.851,"duration":0.7389999999998054,"text":"뭔지 아시죠?"},{"start":1034.591,"duration":1.3740000000000236,"text":"얼음물에"},{"start":1045.65,"duration":1.7799999999999727,"text":"밥이 진짜 시원해"},{"start":1047.432,"duration":1.268000000000029,"text":"기분 좋아"},{"start":1063.97,"duration":1.0499999999999545,"text":"게장을 발라야겠어!"},{"start":1065.022,"duration":7.298000000000002,"text":"사이사이 야무지게 꾹- 꾹- 눌러주면 살이 나옵니다"},{"start":1082.805,"duration":3.4479999999998654,"text":"이거는 10만 원에 팔아도 싸겠는데?"},{"start":1098.46,"duration":1.8299999999999272,"text":"맛있어, 좀 짭짤하긴 한데"},{"start":1100.292,"duration":1.4980000000000473,"text":"막 짜진 않아요, 오..."},{"start":1101.792,"duration":1.2280000000000655,"text":"진짜 고소하다!"},{"start":1104,"duration":1.115000000000009,"text":"완벽해"},{"start":1133.88,"duration":1.6099999999999,"text":"볼락!"},{"start":1146.4,"duration":1.599999999999909,"text":"1등은 볼락입니다"},{"start":1148.002,"duration":2.407000000000153,"text":"2등이 고등어랑 임연수"},{"start":1150.411,"duration":3.3769999999999527,"text":"3등이 가자미"},{"start":1153.79,"duration":2.3900000000001,"text":"4등이 굴비, 요 정도?"},{"start":1156.182,"duration":1.0979999999999563,"text":"아 근데 오늘의 MVP는"},{"start":1157.282,"duration":1.0579999999999927,"text":"밥이에요"},{"start":1158.341,"duration":2.609000000000151,"text":"다른 게 맛이 없어서 밥이 맛있다는 게 아니에요"},{"start":1160.952,"duration":2.02800000000002,"text":"진짜 밥이 진짜 진짜 맛있어요"},{"start":1167.252,"duration":1.2380000000000564,"text":"짭짤해"},{"start":1172.55,"duration":1.2200000000000273,"text":"가자미 솥밥 말고"},{"start":1173.772,"duration":2.178000000000111,"text":"가자미누룽지밥 만들어 먹어야겠다"},{"start":1186.36,"duration":1.0800000000001546,"text":"이거는..."},{"start":1187.442,"duration":2.3079999999999927,"text":"일단 뼈를 바른 다음에"},{"start":1189.752,"duration":2.6010000000001128,"text":"뼈에 붙어있는 살이 바삭바삭해서 맛있어요"},{"start":1192.355,"duration":1.1749999999999545,"text":"여기 살을 이렇게"},{"start":1196.119,"duration":1.0310000000001764,"text":"떼주고"},{"start":1199.26,"duration":2.2000000000000455,"text":"이렇게 쪽 빨아 먹으면 살 더 나와요"},{"start":1218.62,"duration":1.5200000000002092,"text":"너무 잘 먹었다"},{"start":1220.142,"duration":2.6679999999998927,"text":"오랜만에 약간 집밥 먹은 거 