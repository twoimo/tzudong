{"youtube_link":"https://www.youtube.com/watch?v=AX-qyFkuDhk","channel_name":"tzuyang","language":"ko","collected_at":"2026-04-29T01:57:28.216+09:00","transcript":[{"start":0.002,"duration":3.498,"text":"저도 요즘 맵부심이 많이 올라온 사람으로서"},{"start":3.502,"duration":1.6480000000000006,"text":"이분께 도전을 해보겠습니다...!"},{"start":5.66,"duration":2.99,"text":"안녕하세요, 가수 소유입니다, 반갑습니다"},{"start":8.652,"duration":3.008000000000001,"text":"불냉면 중에 가장 유명한 '송주불냉면'"},{"start":19.302,"duration":0.9980000000000011,"text":"더 매워요?"},{"start":20.67,"duration":1.629999999999999,"text":"'별로 안 매운데...?' 약간 이런 느낌"},{"start":22.302,"duration":1.097999999999999,"text":"이것도 안 매운데"},{"start":23.8,"duration":5.84,"text":"여기 소스 조금만 더 주실 수 있어요?"},{"start":44.597,"duration":1.8629999999999995,"text":"안녕하세요, 여러분"},{"start":46.462,"duration":2.6729999999999947,"text":"제가 오늘은 여기 안양에 왔는데"},{"start":49.137,"duration":2.6629999999999967,"text":"여기 제가 5년 만에 재방문하는 곳이거든요"},{"start":51.802,"duration":2.5279999999999987,"text":"사실 또 이제 여름이고 지금 더워요"},{"start":54.332,"duration":1.1379999999999981,"text":"햇빛도 엄청 세고 더운데"},{"start":55.472,"duration":1.4679999999999964,"text":"더우면 냉면의 계절이잖아요"},{"start":57,"duration":2.3049999999999997,"text":"이제 불냉면을 먹으러 왔습니다"},{"start":59.307,"duration":1.7929999999999993,"text":"불냉면 중에서 가장 유명한"},{"start":61.102,"duration":3.243000000000002,"text":"'송주불냉면' 안양 본점"},{"start":64.346,"duration":1.8340000000000032,"text":"제가 예전에 여기 왔던 적이 있는데"},{"start":66.182,"duration":2.1979999999999933,"text":"그때도 되게 맵게 맛있게 먹고 갔는데"},{"start":68.381,"duration":1.5339999999999918,"text":"오늘은 저희 또..."},{"start":69.917,"duration":1.8629999999999995,"text":"게스트분께서 오시거든요"},{"start":71.782,"duration":1.838000000000008,"text":"그분께서 매운 걸 좋아하세요"},{"start":73.622,"duration":1.1979999999999933,"text":"매운 거 잘 드시고"},{"start":74.821,"duration":2.439000000000007,"text":"그래서 제가 매운 음식으로 골랐습니다"},{"start":77.262,"duration":1.8329999999999984,"text":"'송주불냉면' 당연히 드셔보셨겠죠?"},{"start":79.09700000000001,"duration":2.3929999999999865,"text":"어렸을 때부터 너무 좋아하는..."},{"start":81.491,"duration":2.7690000000000055,"text":"마음속의 언니 같은"},{"start":84.262,"duration":1.8379999999999939,"text":"일단 가보겠습니다"},{"start":86.97,"duration":2.0600000000000023,"text":"- 사장님 진짜 오랜만이에요! - 진짜요"},{"start":89.032,"duration":1.8680000000000092,"text":"- 방송으로는 봤어요! - 아 정말요? 감사합니다ㅎㅎ"},{"start":90.902,"duration":1.2980000000000018,"text":"삿포로 카레 드시는 것도 보고"},{"start":92.202,"duration":2.337999999999994,"text":"여기 물냉면, 비빔냉면, 열무냉면도 있고"},{"start":94.542,"duration":2.1680000000000064,"text":"제가 기억하기론 돈가스도 있거든요?"},{"start":96.711,"duration":2.0290000000000106,"text":"돈가스도 있네, 매운 불돈가스!"},{"start":98.741,"duration":3.8089999999999975,"text":"저도 요즘 맵부심이 많이 올라온 사람으로서"},{"start":102.551,"duration":1.9989999999999952,"text":"이분께 도전을 해보겠습니다...!"},{"start":104.55199999999999,"duration":2.598000000000013,"text":"사장님 2단계랑 3단계랑 차이 많이 나요?"},{"start":107.152,"duration":2.567999999999998,"text":"2단계는 불닭보다 맵고"},{"start":109.72200000000001,"duration":2.5679999999999836,"text":"3단계가 엽떡보다 매워요!"},{"start":112.35,"duration":2.480000000000004,"text":"- 안녕하세요 - 오 안녕하세요!!"},{"start":115.2,"duration":1.75,"text":"스태프분들 거는 조금 이따 옵니다"},{"start":116.952,"duration":1.1479999999999961,"text":"너무 감사해요"},{"start":118.101,"duration":0.9989999999999952,"text":"여기 앉을까요?"},{"start":120.63,"duration":1.2199999999999989,"text":"이게 원래는 저희가"},{"start":121.851,"duration":1.4989999999999952,"text":"- 고도수 - 하이볼을 하시는 거예요?"},{"start":123.351,"duration":1.4939999999999998,"text":"네, 2년째 하고 있는데"},{"start":124.847,"duration":3.6629999999999967,"text":"- 저도 별거는 아니고 모자...ㅎㅎ - 감사합니다...!!"},{"start":128.512,"duration":1.9279999999999973,"text":"네 안녕하세요! 가수 소유입니다"},{"start":130.442,"duration":0.8979999999999961,"text":"반갑습니다~!"},{"start":132.38,"duration":2.3300000000000125,"text":"어색하네요"},{"start":134.712,"duration":3.3380000000000223,"text":"- 저희 언제 봤죠? - 저희 예전에..."},{"start":138.052,"duration":2.3680000000000234,"text":"홈쇼핑 비슷한 거..."},{"start":140.422,"duration":3.1280000000000143,"text":"뭔지 기억나세요?"},{"start":143.552,"duration":2.1380000000000052,"text":"이거 진짜 너무 옛날이다"},{"start":145.692,"duration":2.1680000000000064,"text":"아기인 게 보여..."},{"start":147.862,"duration":2.2680000000000007,"text":"나도 아기야"},{"start":150.132,"duration":2.397999999999996,"text":"저는 '송주불냉면' 직접 와서 먹은 적은 없고"},{"start":152.53199999999998,"duration":2.4380000000000166,"text":"- 배달시켜서 집에서 많이 먹었어요! - 정말요?"},{"start":154.972,"duration":2.2680000000000007,"text":"매운 거 평소에 얼마나 잘 드세요?"},{"start":157.242,"duration":1.4629999999999939,"text":"저는 원래 옛날에는..."},{"start":158.707,"duration":2.5430000000000064,"text":"미친 자 급으로 잘 먹었는데"},{"start":161.252,"duration":1.822999999999979,"text":"지금 저도 다이어트해서"},{"start":163.077,"duration":3.3629999999999995,"text":"- 저는 열무냉면을 좋아해요! - 아 그래요?"},{"start":166.442,"duration":2.012999999999977,"text":"여기 열무 들어간 게 다 맛있어서"},{"start":168.457,"duration":1.1980000000000075,"text":"매운 단계는..."},{"start":169.65699999999998,"duration":1.2930000000000064,"text":"도로시불맛으로"},{"start":170.952,"duration":1.2680000000000007,"text":"- 그게 제일 매운 맛이에요? - 네"},{"start":172.222,"duration":1.7680000000000007,"text":"지금 다이어트하고 있어서..."},{"start":173.992,"duration":1.0980000000000132,"text":"- 원래 새 모이만큼 먹는데 - 준비하시느라"},{"start":175.09199999999998,"duration":1.8280000000000314,"text":"- 오늘 좀 열심히 먹어볼게여 - 아하ㅋㅋㅋㅋㅋ"},{"start":176.922,"duration":1.2980000000000018,"text":"저도 같은 걸로 먹을게요!"},{"start":178.222,"duration":1.8029999999999973,"text":"저도 열무냉면 제일 매운 걸로!"},{"start":180.027,"duration":2.90300000000002,"text":"그럼 불돈가스 하나랑 그냥 돈가스 하나 시킬까요?"},{"start":182.932,"duration":3.6680000000000064,"text":"그리고 불갈비만두도 하나 부탁드립니다"},{"start":186.83,"duration":2.299999999999983,"text":"- 위장약 같은 거 드셨어요? - 아 제가..."},{"start":189.132,"duration":1.9679999999999893,"text":"챙겨왔어요"},{"start":191.102,"duration":2.407999999999987,"text":"저도 원래 안 먹었는데..."},{"start":193.512,"duration":2.0080000000000098,"text":"먹을 때가 돼서"},{"start":195.522,"duration":2.0579999999999927,"text":"저도 이제 나이가 나이인지라"},{"start":197.582,"duration":1.2980000000000018,"text":"저도 이제 스케줄이 많으니까"},{"start":198.882,"duration":2.2280000000000086,"text":"- 혹시나 해서! - 혹시나 해서 드셔야 될 것 같아요!"},{"start":201.112,"duration":2.1430000000000007,"text":"오랜만에 드시는 거니까"},{"start":203.257,"duration":2.7930000000000064,"text":"어릴 때 저희 세대 때 안 좋아한 사람 없죠"},{"start":206.052,"duration":1.3979999999999961,"text":"있을 수도 있죠"},{"start":207.452,"duration":1.538000000000011,"text":"진짜 없었어요"},{"start":208.992,"duration":2.397999999999996,"text":"진짜... 실... 실물이..."},{"start":211.392,"duration":1.1680000000000064,"text":"아 근데 저도"},{"start":212.562,"duration":1.367999999999995,"text":"- 그 말 하려고 했어요! - 아 그래요?ㅎㅎ"},{"start":213.93200000000002,"duration":1.7579999999999814,"text":"역시나 피부가 좋다..."},{"start":215.692,"duration":1.608000000000004,"text":"마지막 만남 6년이 지났으니까..."},{"start":217.302,"duration":2.433000000000021,"text":"근데 그때보다 더..."},{"start":219.737,"duration":1.2630000000000052,"text":"아 근데 저는 좀 부러운 게"},{"start":221.002,"duration":2.2029999999999745,"text":"저는 30대를 엄청 기대했었거든요"},{"start":223.207,"duration":3.2930000000000064,"text":"30살 때 코로나 시기여서 2년이 날아갔으니까..."},{"start":226.502,"duration":1.9979999999999905,"text":"뭔가 내가 30살이 됐을 때"},{"start":228.502,"duration":2.3479999999999848,"text":"내가 하고 싶었던 버킷 리스트도 되게 많았고"},{"start":230.852,"duration":3.4480000000000075,"text":"그냥 뭔가 30살이 되면 내가 안정적일 것 같은 느낌이 있었어요"},{"start":234.485,"duration":3.0649999999999977,"text":"딱 32살 때 진짜 크게 온 것 같아요"},{"start":237.552,"duration":2.52800000000002,"text":"2주 빡세게 운동하고 다이어트하면 쏙쏙 빠졌는데"},{"start":240.082,"duration":0.6680000000000064,"text":"안 돼, 안 돼..."},{"start":240.752,"duration":3.108000000000004,"text":"- 안 빠져요? - 지금은 무조건 3개월, 6개월, 1년 이렇게 잡아야 돼요"},{"start":243.862,"duration":1.328000000000003,"text":"저도 30 되면..."},{"start":245.192,"duration":1.3979999999999961,"text":"체질이 바뀔 수 있을 것 같다고"},{"start":246.592,"duration":0.867999999999995,"text":"생각은 했거든요"},{"start":247.462,"duration":2.2379999999999995,"text":"아직 지금 딱 30이라서"},{"start":249.702,"duration":1.1580000000000155,"text":"아직까지는"},{"start":250.862,"duration":2.288000000000011,"text":"나왔다"},{"start":253.152,"duration":0.9980000000000189,"text":"- 돈가스 크다 - 맛있겠다"},{"start":254.152,"duration":1.1980000000000075,"text":"근데 양이 많다"},{"start":255.6,"duration":2.505000000000024,"text":"'아 내가 매운 걸 잘 먹나...?'"},{"start":258.10699999999997,"duration":2.333000000000027,"text":"라고 느끼지 않다가..."},{"start":260.442,"duration":1.2679999999999723,"text":"사람들이랑 같이 먹을 때"},{"start":261.712,"duration":1.1580000000000155,"text":"사람들이 '아 매워' 이러니까"},{"start":262.872,"duration":1.1379999999999768,"text":"'이게 매워...???' 이러면서"},{"start":264.012,"duration":1.538000000000011,"text":"내가 매운 걸 잘 먹는다는 걸"},{"start":265.552,"duration":1.092999999999961,"text":"알았던 것 같아요"},{"start":266.647,"duration":1.3330000000000268,"text":"인생 첫 불닭을 먹을 때도"},{"start":267.98199999999997,"duration":1.268000000000029,"text":"안 매우셨어요?"},{"start":269.252,"duration":1.5279999999999632,"text":"그래서 엄청 기대를 했는데..."},{"start":270.782,"duration":0.8180000000000405,"text":"먹었는데"},{"start":271.602,"duration":1.77800000000002,"text":"'별로 안 매운데...?' 약간 이런 느낌"},{"start":273.382,"duration":0.8079999999999927,"text":"처음 먹었을 때 진짜"},{"start":274.192,"duration":1.858000000000004,"text":"눈물, 콧물 다 짜고 난리였는데..."},{"start":276.052,"duration":1.8979999999999677,"text":"초등학교 때 처음 먹었거든요!"},{"start":277.952,"duration":1.8380000000000223,"text":"초등학생 때구나"},{"start":280.6,"duration":1.5,"text":"- 매운 거예요 - 이게 매운 거예요?"},{"start":282.435,"duration":1.2649999999999864,"text":"부먹인가요?"},{"start":283.702,"duration":1.5980000000000132,"text":"이게 소스구나"},{"start":285.302,"duration":1.2479999999999905,"text":"아예 그냥 다 부을까요?"},{"start":286.552,"duration":0.8979999999999677,"text":"상관없어요"},{"start":287.452,"duration":0.9979999999999905,"text":"- 편하신 대로 - 알겠습니다"},{"start":288.452,"duration":1.7980000000000018,"text":"맛있겠다"},{"start":290.252,"duration":2.4979999999999905,"text":"- 진짜 맛있겠다 - 소스 이렇게 많이 드세요?"},{"start":293.1,"duration":2.609999999999957,"text":"옛날에는 아예 큰 팩