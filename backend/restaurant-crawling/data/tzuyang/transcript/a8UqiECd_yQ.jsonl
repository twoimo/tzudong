{"youtube_link":"https://www.youtube.com/watch?v=a8UqiECd_yQ","channel_name":"tzuyang","language":"ko","collected_at":"2026-05-31T04:40:02.676+09:00","transcript":[{"start":0.002,"duration":1.248,"text":"명인님이세요?"},{"start":1.445,"duration":2.835,"text":"아까 사진에서 뵀어"},{"start":4.282,"duration":4.038,"text":"여기가 김치 명인분께서 만든 맛집이래요"},{"start":15.152,"duration":0.9979999999999993,"text":"잘 먹겠습니다"},{"start":17.5,"duration":4.699999999999999,"text":"이 평가하는 명인의 상은...)"},{"start":22.202,"duration":1.2979999999999983,"text":"완벽한 동태탕인데?"},{"start":23.502,"duration":0.9480000000000004,"text":"끝났다..."},{"start":24.452,"duration":0.7479999999999976,"text":"맛집이다!"},{"start":25.202,"duration":5.017999999999997,"text":"모자라면 1층으로 연락 줘요"},{"start":37.052,"duration":1.7280000000000015,"text":"안녕하세요, 여러분"},{"start":38.782,"duration":3.1380000000000052,"text":"제가 오늘은 지금 신도림에 왔어요"},{"start":41.922,"duration":1.838000000000001,"text":"동태탕을 먹으러 왔습니다"},{"start":43.762,"duration":2.637999999999998,"text":"사실 여기가 엄청 핫한 곳이거든요"},{"start":46.402,"duration":1.347999999999999,"text":"2년 전쯤에 생겼는데"},{"start":47.752,"duration":1.9979999999999976,"text":"여기가 원래 2층에서 시작했대요"},{"start":49.752,"duration":2.097999999999999,"text":"근데 장사가 너무 잘돼서"},{"start":51.852,"duration":1.7980000000000018,"text":"1층까지 확장을 하시고"},{"start":53.652,"duration":4.2479999999999976,"text":"2년 만에 거의 150개 지점 가까이 생겼다고 하더라고요"},{"start":57.902,"duration":3.368000000000002,"text":"그리고 여기가 김치 명인분께서 만든 맛집이래요"},{"start":61.272,"duration":4.568000000000005,"text":"동태탕, 보쌈 이런 안주류들을 파는 곳이잖아요"},{"start":65.842,"duration":3.308000000000007,"text":"근데 지금 점심시간에 왔는데"},{"start":69.152,"duration":1.597999999999999,"text":"1층이 벌써 만석이거든요"},{"start":70.752,"duration":2.3980000000000103,"text":"그래서 아쉽게 2층으로 가기로 했습니다"},{"start":73.152,"duration":2.667999999999992,"text":"맛도 좋고 가성비도 되게 좋다고 하니까"},{"start":75.821,"duration":1.968999999999994,"text":"빨리 가서 먹어보도록 하겠습니다"},{"start":79.59,"duration":3.3100000000000023,"text":"여기 있다, 명인 증서"},{"start":82.902,"duration":1.9479999999999933,"text":"김치 명인분께서 만드셨대요"},{"start":85.7,"duration":3.5,"text":"오늘 술 마시면 안 되는데"},{"start":89.202,"duration":1.847999999999999,"text":"술이 안 당길 수가 없는 메뉴인걸?"},{"start":92.47,"duration":1.4000000000000057,"text":"어 안녕하세요!"},{"start":93.872,"duration":1.4680000000000035,"text":"명인님이세요?"},{"start":95.342,"duration":2.7680000000000007,"text":"아까 사진에서 뵀어"},{"start":98.112,"duration":3.1380000000000052,"text":"- 어 그럼 회장님이신가요? - 예~"},{"start":101.25200000000001,"duration":3.9979999999999905,"text":"- 원래 장사는 어떤 거 하셨어요? - 족발집도 하고 고깃집도 하고"},{"start":105.25200000000001,"duration":1.6479999999999961,"text":"- 경력 50년 - 50년이요?"},{"start":107.35,"duration":3.0700000000000074,"text":"와 그럼 김치 명인은 보통 어떻게 돼요?"},{"start":110.422,"duration":4.807999999999993,"text":"열심히, 정직하게, 맛있게, 정성을 들여서!"},{"start":115.232,"duration":3.1980000000000075,"text":"동태탕하고 나오는 세트로 먼저 드시고..."},{"start":118.432,"duration":3.4980000000000047,"text":"서운하다 하면 꼬막비빔밥 하나 드시고"},{"start":121.932,"duration":1.9080000000000013,"text":"세트가 3인인데 약간 많죠?"},{"start":123.842,"duration":1.328000000000003,"text":"아 제가 좀 많이 먹어요..."},{"start":125.172,"duration":1.8329999999999984,"text":"저는 혼자 무조건 다 먹습니다!"},{"start":127.006,"duration":2.4639999999999986,"text":"아 그래요, 그럼 시켜요"},{"start":129.472,"duration":0.5379999999999825,"text":"좀 많이 먹어서"},{"start":130.012,"duration":2.068000000000012,"text":"- 네, 저한테 주문하세요! - 네, 그러면..."},{"start":132.082,"duration":3.1680000000000064,"text":"세트랑... 그리고 꼬막무침이랑... 그리고 오징어파전이랑..."},{"start":135.252,"duration":2.127999999999986,"text":"- 걍 찍으세요... - 네, 그럴게요"},{"start":137.382,"duration":2.9679999999999893,"text":"- 손님들이 김치 맛있다고 그러세요! - 김치 아직도 직접 하세요?"},{"start":140.352,"duration":1.9979999999999905,"text":"- 예예! - 아 정말요???"},{"start":142.352,"duration":1.907999999999987,"text":"- 오 감사합니다ㅎㅎ - 예예"},{"start":144.262,"duration":1.538000000000011,"text":"일단 물냉을 하고"},{"start":145.802,"duration":2.8880000000000052,"text":") 고기 추가도 있고 동태탕 추가도 있네요"},{"start":148.692,"duration":1.5079999999999814,"text":"오징어파전 먹어줘야지"},{"start":150.202,"duration":2.7280000000000086,"text":"꼬막무침 추천해 줬으니까 꼬막무침 &amp; 소면 먹어볼게요"},{"start":152.93200000000002,"duration":1.6379999999999768,"text":"아까 보니까 콩국수 있더라고요"},{"start":154.572,"duration":1.4579999999999984,"text":"명태회냉면으로 가겠습니다"},{"start":156.03199999999998,"duration":2.4680000000000177,"text":"그리고 수제비도 하나 같이 시켜야지"},{"start":158.502,"duration":2.5979999999999848,"text":"주문 완료"},{"start":231.3,"duration":1.25,"text":"냉면 그릇 엄청 크다"},{"start":234.37,"duration":2.5500000000000114,"text":"- 명태회냉면 - 맛있겠다"},{"start":236.922,"duration":2.7580000000000098,"text":"- 많아서 뺏어 먹어도 되겠다ㅎ - 감사합니다"},{"start":239.68200000000002,"duration":4.97799999999998,"text":"모자라면 1층으로 연락 줘요"},{"start":244.662,"duration":1.8979999999999961,"text":"원래 세트에 나오는 게"},{"start":246.562,"duration":4.567999999999984,"text":"얼큰동태탕이랑 오징어보쌈이랑 냉면까지 3개가"},{"start":251.132,"duration":1.3979999999999961,"text":"4만 8,000원이거든요"},{"start":252.532,"duration":0.667999999999978,"text":"가성비 진짜 괜찮다"},{"start":253.202,"duration":1.5980000000000132,"text":"보쌈이 제대로 나오는데?"},{"start":254.802,"duration":3.748000000000019,"text":"안에 알이랑 곤이랑 진짜 많은데?"},{"start":258.552,"duration":1.2479999999999905,"text":"알 진짜 많은데?"},{"start":260.552,"duration":1.5979999999999563,"text":"뭐야? 원래 양이 이렇게 많아?"},{"start":269.912,"duration":2.6380000000000337,"text":"너무 내 취향이야..."},{"start":275.35,"duration":2.109999999999957,"text":"와 진짜 얼큰 시원..."},{"start":284.53,"duration":1.170000000000016,"text":"아 끝났다..."},{"start":285.702,"duration":1.3980000000000246,"text":"소주 마셔야겠다"},{"start":287.102,"duration":2.368000000000052,"text":"제가 한 딱 2달 전쯤에"},{"start":289.472,"duration":1.7280000000000086,"text":"동태탕에 빠진 적이 있어요"},{"start":291.202,"duration":1.1380000000000337,"text":"동태땅 맛집 막..."},{"start":292.342,"duration":1.3980000000000246,"text":"동때땅 집 근처에..."},{"start":293.742,"duration":1.4279999999999973,"text":"동택딱집 찾아..."},{"start":295.172,"duration":1.4979999999999905,"text":"찾으면서 돌아다녔는데"},{"start":296.672,"duration":1.467999999999961,"text":"입에 맞는 곳이 없는 거예요"},{"start":298.142,"duration":1.7679999999999723,"text":"동태탕 특유의 해물 맛 있잖아요"},{"start":299.912,"duration":1.768000000000029,"text":"그게 잘 안 나는 곳들이 많았는데"},{"start":301.682,"duration":3.3979999999999677,"text":"여기 그 동태탕 특유의 동태 맛이랑 해물 맛이랑"},{"start":305.082,"duration":1.9080000000000155,"text":"감칠맛이 너무너무 잘 느껴지고"},{"start":306.992,"duration":2.027999999999963,"text":"간도 완벽하고"},{"start":309.022,"duration":1.6380000000000337,"text":"약간 완벽한 동태탕인데?"},{"start":310.662,"duration":1.0880000000000223,"text":"와사비 살짝 풀어서"},{"start":318.425,"duration":1.3050000000000068,"text":"진짜 맛있다"},{"start":319.73199999999997,"duration":2.3380000000000223,"text":"근데 동태탕 알이 좀 뻑뻑한 데도 많거든요"},{"start":322.072,"duration":1.8980000000000246,"text":"알 진짜 부드러워요"},{"start":328.67,"duration":1.3700000000000045,"text":"나오자마자 알 먹어야 돼요"},{"start":330.04200000000003,"duration":1.4379999999999882,"text":"아무것도 안 찍고 하나만"},{"start":339.02,"duration":1.6299999999999955,"text":"보쌈 맛집이다"},{"start":340.652,"duration":0.9979999999999905,"text":"진짜 맛있다"},{"start":347.775,"duration":1.955000000000041,"text":"고기만 먹어도 맛있는데?"},{"start":349.73199999999997,"duration":2.268000000000029,"text":"아 안 돼, 여기..."},{"start":352.002,"duration":1.3979999999999677,"text":"김치 명인이시잖아요"},{"start":365.24,"duration":1.3700000000000045,"text":"보쌈김치 달잖아요"},{"start":366.612,"duration":4.108000000000004,"text":"단맛이 양념에서 나는 인위적인 단맛이 아니라"},{"start":370.722,"duration":1.6580000000000155,"text":"배추가 진짜 달고"},{"start":372.382,"duration":1.5679999999999836,"text":"양념게장 같기도 하고"},{"start":373.952,"duration":2.127999999999986,"text":"약간 회냉면 그 양념 같기도 하고"},{"start":376.082,"duration":1.7379999999999995,"text":"양념 자체가 진짜 입에 착 붙어요"},{"start":377.822,"duration":2.937999999999988,"text":"무슨 이 감칠맛이 입에서 되게 많이 난다"},{"start":390.1,"duration":2.269999999999982,"text":"와 고기랑 먹으니까 진짜 극락이다"},{"start":404.48,"duration":2.5399999999999636,"text":"무김치는 되게 달짝지근하게 맛있네"},{"start":407.022,"duration":4.333000000000027,"text":"오징어숙회가 같이 나오거든요"},{"start":420.16,"duration":2.2099999999999795,"text":"숙회도 진짜 부드럽고"},{"start":422.372,"duration":1.4979999999999905,"text":"말랑말랑하게 잘 삶아졌는데"},{"start":423.872,"duration":1.697999999999979,"text":"이 약간 초고추장이 킥이에요"},{"start":425.572,"duration":2.3980000000000246,"text":"거친 질감이거든요"},{"start":427.972,"duration":3.5680000000000405,"text":"고추장과 초고추장을 약간 황금 비율로 섞어서"},{"start":431.542,"duration":1.5080000000000382,"text":"여기 있습니다"},{"start":433.052,"duration":0.9979999999999905,"text":"감사합니다"},{"start":437.52,"duration":1.9600000000000364,"text":"알 부드러워"},{"start":439.48199999999997,"duration":2.4680000000000177,"text":"맛도 맛인데 식재료는 되게 좋은 것 같아요"},{"start":441.952,"duration":1.0980000000000132,"text":"곤이도 맛있겠지?"},{"start":448.7,"duration":1,"text":"식감 예술이다"},{"start":456.3,"duration":1.8000000000000114,"text":"동태 살을 발라서"},{"start":467.35,"duration":2.5299999999999727,"text":"동태도 안 뻑뻑하고 딱 맛있다"},{"start":479.89,"duration":2.3600000000000136,"text":"1잔만 하자"},{"start":482.252,"duration":1.4379999999999882,"text":"국물 때문에 안 되겠다"},{"start":483.95,"duration":1.009999999999991,"text":"짠"},{"start":484.962,"duration":1.0980000000000132,"text":"1잔만 하겠습니다ㅎ"},{"start":490.07,"duration":3.1999999999999886,"text":"와 근데 보쌈이 나온다길래 솔직히"},{"start":493.272,"duration":1.768000000000029,"text":"이 가격에 한 2인분 막 이렇게 나올 줄 알았는데"},{"start":495.042,"duration":2.938000000000045,"text":"진짜 김치에 무김치에 회무침까지"},{"start":497.98199999999997,"duration":1.2980000000000018,"text":"제대로 나오네요"},{"start":503.88,"duration":1.4399999999999977,"text":"배추의 즙이 많은 건지"},{"start":505.322,"duration":3.2280000000000086,"text":"뭔가 그 즙이 막 씹을 때마다 착착착 나오거든요?"},{"start":508.552,"duration":3.5079999999999245,"text":"배추가 수분을 가득 머금은 그런 배추 같아요"},{"start":521.065,"duration":2.034999999999968,"text":"국물에 으깨 먹어야 맛있는 거 아시죠?"},{"start":523.102,"duration":1.768000000000029,"text":"여기다 밥 말아야 최곤데"},{"start":538.88,"duration":1.8700000000000045,"text":"세트 메뉴로 시킨 냉면이거든요"},{"start":540.752,"duration":1.9980000000000473,"text":"오이가 원래 엄청 수북이 들어가는데"},{"start":542.752,"duration":1.768000000000029,"text":"오이는 빼고 부탁드렸습니다"},{"start":551.8,"duration":1.1600000000000819,"text":"맛있어ㅎ"},{"start":561.8,"duration":2.2100000000000364,"text":"여기 본점 와서 먹어보면"},{"start":564.012,"duration":1.6880000000001019,"text":"체인 하고 싶을 것 같아요"},{"start":565.702,"duration":1.3479999999999563,"text":"다 맛있다"},{"start":567.35,"duration":1,"text":"고기랑 같이 싸 먹어"},{"start":580.93,"duration":4.230000000000018,"text":"이거는 명태회무침인데"},{"start":609.49,"duration":2.269999999999982,"text":"사장님 너무 맛있어요ㅎㅎ"},{"start":611.762,"duration":2.788000000000011,"text":"김치도 끝내주고 동태탕 너무너무 맛있고"},{"start":614.551,"duration":2.1989999999999554,"text":"보쌈 고기도 맛있고 냉면도 다 맛있어요"},{"start":616.752,"duration":1.0080000000000382,"text":"최고!"},{"start":617.762,"duration":2.368000000000052,"text":"감사합니다ㅎㅎ"},{"start":620.132,"duration":1.9980000000000473,"text":"제가 지금 세트 메뉴만 먹었잖아요"},{"start":622.132,"duration":1.1980000000000928,"text":"양이 꽤 되네"},{"start":623.332,"duration":2.868000000000052,"text":"세트 메뉴 다 먹었으니까 파전으로 한번 가볼까?"},{"start":637.32,"duration":2.5,"text":"계란물로 만든..."},{"start":641.92,"duration":1.1000000000000227,"text":"엄청 고소해요"},{"start":643.021,"duration":1.3690000000000282,"text":"계란 고소한 맛!"},{"start":652.5,"duration":2.769999999999982,"text":"안에 파도 너무 달고 맛있다"},{"start":655.271,"duration":0.9990000000000236,"text":"채소가 달아요!"},{"start":656.271,"duration":2.399000000000001,"text":"뭔가 더 기름지지 않고 좀 더"},{"start":658.671,"duration":1.899000000000001,"text":"담백하면서 고소한 느낌?"},{"start":684.46,"duration":2.939999999999941,"text":"파전이 생각보다 굉장히 큰데?"},{"start":700.47,"duration":2.42999999999995,"text":"여기 육수가 무한 리필이에요"},{"start":702.901,"duration":1.0990000000000464,"text":"제대로 흔들어 줘야 돼요"},{"start":705.55,"duration":1.4500000000000455,"text":"이 빨간 육수 좋아"},{"start":707.99,"duration":0.7599999999999909,"text":"수제비"},{"start":708.752,"duration":2.298000000000002,"text":"이거 손으로 직접 떼는 건가 봐"},{"start":713.59,"duration":2.740000000000009,"text":"저는 너무 얇게 뜬 수제비를 안 좋아하기 