ion":2.4980000000000473,"text":"두 번째로 중요하게 여기는 게 도우인데"},{"start":607.002,"duration":4.448000000000093,"text":"도우까지 치즈 기름이 적셔져서 축축해지거든요?"},{"start":611.452,"duration":2.697999999999979,"text":"밑에 진짜 바삭하게..."},{"start":627.3,"duration":1.1000000000000227,"text":"맛있다"},{"start":638.65,"duration":4.5,"text":"피자는 아무래도 금방 물리는 감이 있어서"},{"start":645.1,"duration":1.5,"text":"많이는 잘 못 먹어요"},{"start":646.602,"duration":6.34800000000007,"text":"오늘 뭔가 좀 잘 들어가네?"},{"start":652.952,"duration":1.4980000000000473,"text":"기름기가 없어"},{"start":658.1,"duration":3.3500000000000227,"text":"저기 피지헛 알바생이었던 친구 있거든요...?"},{"start":661.452,"duration":2.197999999999979,"text":"얼마나 했어?"},{"start":663.651,"duration":1.0990000000000464,"text":"저 1년이요!"},{"start":664.752,"duration":1.7980000000000018,"text":"그럼 학생 때 피자 많이 먹었겠네..."},{"start":666.551,"duration":1.99899999999991,"text":"- 부럽당... - 그래서 살찜ㅎ"},{"start":668.551,"duration":1.149000000000001,"text":"아 맞아, 이게..."},{"start":669.702,"duration":2.0979999999999563,"text":"로고가 이번에 바뀐 거거든요?"},{"start":671.801,"duration":2.0989999999999327,"text":"아니 모자라고 생각했는데 저게"},{"start":673.901,"duration":0.9490000000000691,"text":"오두막이래요"},{"start":674.852,"duration":1.7980000000000018,"text":"'Hut'이 오두막이라는 뜻이래요"},{"start":676.651,"duration":2.4990000000000236,"text":"그래서 뜻이 피자 오두막이래요"},{"start":679.151,"duration":4.549000000000092,"text":"미국에서 생긴 피자헛 1호점이 오두막이었어요"},{"start":683.702,"duration":2.0979999999999563,"text":"아 그건 아니고?"},{"start":690.901,"duration":1.6990000000000691,"text":"피자헛이 저 태어나기 전부터 있었다는 게"},{"start":692.602,"duration":0.59800000000007,"text":"너무 신기해요"},{"start":693.202,"duration":2.3980000000000246,"text":"미국 1호점부터 40년인 거죠?"},{"start":695.602,"duration":2.3980000000000246,"text":"한국에서만 40년이에요?"},{"start":704.901,"duration":2.0990000000000464,"text":"3개"},{"start":730.6,"duration":3.1499999999999773,"text":"하나씩 먹을게요, 이게 뭐 하는 짓이야"},{"start":741.5,"duration":2.25,"text":"2판 CLEAR"},{"start":767.801,"duration":3.8489999999999327,"text":"얘는 한근... 와 무거워, 얘 1kg 넘네!"},{"start":771.651,"duration":3.3490000000000464,"text":"진짜 오버 아니에요"},{"start":781.502,"duration":2.84800000000007,"text":"얘는 치즈가 거의 폭포처럼 흘러!"},{"start":809.55,"duration":1.8500000000000227,"text":"치즈가 이렇게 많다고?"},{"start":811.401,"duration":1.0990000000000464,"text":"거짓말!"},{"start":812.502,"duration":2.4980000000000473,"text":"와 이거 1판 먹을 수 있을까?"},{"start":848.8,"duration":2.7000000000000455,"text":"원래 워낙에 베이컨포테이토를 좋아하거든요"},{"start":851.502,"duration":2.6980000000000928,"text":"베이컨포테이토에 들어가는"},{"start":854.202,"duration":1.5480000000000018,"text":"마요네즈가 너무 좋아요"},{"start":855.752,"duration":4.84800000000007,"text":"치즈 고소함과 마요네즈 고소함이 같이 섞이면"},{"start":860.602,"duration":2.09800000000007,"text":"2배로 고소한 느낌이라"},{"start":862.702,"duration":2.5979999999999563,"text":"개인적으로 고구마도 나왔으면 좋겠다"},{"start":865.301,"duration":1.4489999999999554,"text":"달달하니 진짜 맛있을 것 같아"},{"start":866.752,"duration":3.1480000000000246,"text":"이거 치즈가 되게 짭짤한 그런 치즈거든요"},{"start":869.901,"duration":2.299000000000092,"text":"쯔양 님이 얘기해 주시면..."},{"start":872.202,"duration":3.298000000000002,"text":"정말요?"},{"start":880.8,"duration":1.650000000000091,"text":"피자 광고 중에..."},{"start":882.452,"duration":2.298000000000002,"text":"가장 익숙한 노래가 피자헛 아니에요?"},{"start":886.401,"duration":0.9490000000000691,"text":"맛있당ㅎ"},{"start":894.5,"duration":2.6499999999999773,"text":"와 근데 진짜 치즈 원 없이 먹는 것 같아"},{"start":902.651,"duration":2.549000000000092,"text":"제가 지금 먹으면서 계속 데워먹고 있긴 한데"},{"start":905.202,"duration":3.3980000000000246,"text":"굳으면 진짜 질겅질겅 맛없는 치즈가 있고"},{"start":908.602,"duration":2.7480000000000473,"text":"그래도 굳어도 부드럽게 맛있는 치즈가 있잖아요"},{"start":911.352,"duration":3.048000000000002,"text":"얘가 되게 부드럽게 맛있는 치즈거든요"},{"start":914.401,"duration":1.899000000000001,"text":"근데 확실히 굳으면"},{"start":916.301,"duration":1.5989999999999327,"text":"모든 피자가 그렇듯이"},{"start":917.901,"duration":2.699000000000069,"text":"치즈가 뚝뚝 끊기는 느낌이 다 있는데"},{"start":920.602,"duration":4.148000000000025,"text":"오히려 너무 인위적으로 쭉쭉 늘어나는 것보다"},{"start":924.752,"duration":3.84800000000007,"text":"이렇게 툭 금방 끊기는 이런 치즈가"},{"start":928.602,"duration":1.8980000000000246,"text":"가공이 덜 된 치즈라고 하더라고요"},{"start":930.502,"duration":2.4480000000000928,"text":"그리고 실제로 맛도"},{"start":932.952,"duration":2.3980000000000246,"text":"굳었을 때 이런 치즈가 좀 더 맛있어요"},{"start":945.3,"duration":2.050000000000068,"text":"지금 피자 3kg을 먹고 있는 거잖아?"},{"start":947.352,"duration":2.548000000000002,"text":"고기 3kg도 많은데"},{"start":949.901,"duration":1.899000000000001,"text":"아 그리고 제가 오늘 먹으려고 그랬는데"},{"start":951.801,"duration":3.74899999999991,"text":"지금 약간 치즈 과다 섭취해서 못 먹을 것 같거든요?"},{"start":955.551,"duration":2.3489999999999327,"text":"오늘 이거 먹으려고 했는데 치즈 폭탄 파스타"},{"start":957.901,"duration":1.2490000000000236,"text":"이것도 신메뉴예요"},{"start":959.151,"duration":1.5990000000000464,"text":"치즈가 3배나 들어가 있대요"},{"start":960.752,"duration":0.84800000000007,"text":"다른 피자 시키실 때"},{"start":961.602,"duration":1.9980000000000473,"text":"요거 사이드로 같이 먹어도 좋을 것 같아요"},{"start":1009.852,"duration":1.5480000000000018,"text":"마지막 피자!"},{"start":1011.95,"duration":3.2999999999999545,"text":"1판 더... 드실래요...?"},{"start":1015.252,"duration":2.34800000000007,"text":"아니요, 저 포기하겠습니다"},{"start":1017.602,"duration":1.2980000000000018,"text":"포장해 갈게요"},{"start":1018.901,"duration":2.699000000000069,"text":"저희 스태프분들 드시려고 시킨 건데"},{"start":1021.602,"duration":1.4980000000000473,"text":"치즈피자예요"},{"start":1023.102,"duration":1.0480000000001155,"text":"한근 치즈피자"},{"start":1024.152,"duration":2.3479999999999563,"text":"치즈만 있으니까 진짜 치즈 더 많아 보인다"},{"start":1026.502,"duration":2.2480000000000473,"text":"치즈 진짜 덕후분들은"},{"start":1028.752,"duration":2.0979999999999563,"text":"이것도 너무 좋은 메뉴일 것 같아요"},{"start":1043.75,"duration":1.400000000000091,"text":"한근 600g 시리즈는 진짜"},{"start":1045.152,"duration":2.647999999999911,"text":"치즈 덕후분들한테 맞을 것 같고"},{"start":1047.801,"duration":0.8490000000001601,"text":"반근 300g 시리즈는 정말"},{"start":1048.652,"duration":3.548000000000002,"text":"누구나 느끼하지 않고 맛있게 먹을 수 있는"},{"start":1052.202,"duration":1.2980000000000018,"text":"5월 이벤트는"},{"start":1053.502,"duration":2.6480000000001382,"text":"반근 치즈 콤비네이션이라서"},{"start":1056.152,"duration":2.2480000000000473,"text":"누구나 좋아할 만한 그런 맛이거든요?"},{"start":1058.402,"duration":1.2980000000000018,"text":"그래서 오히려 좋은 것 같아요"},{"start":1069.65,"duration":1.6499999999998636,"text":"벌써 마지막 조각이라니..."},{"start":1079.65,"duration":1.349999999999909,"text":"오늘 먹은 치즈 이거래!"},{"start":1083.202,"duration":3.0979999999999563,"text":"- 이게 1.5kg이거든? - 무거워"},{"start":1086.302,"duration":0.7980000000000018,"text":"이게 뱃속에 있는 거 아냐..."},{"start":1087.101,"duration":2.8989999999998872,"text":"빵도 있는 거 아냐..."},{"start":1091,"duration":1.7000000000000455,"text":"어떻게 들어갔지?"},{"start":1092.702,"duration":1.3979999999999109,"text":"5판을 먹었어도"},{"start":1094.101,"duration":1.7989999999999782,"text":"치즈가 저렇게 많지는 않았거든요"},{"start":1095.902,"duration":2.5979999999999563,"text":"굉장히 묵직한 피자였어요"},{"start":1098.502,"duration":1.8479999999999563,"text":"가격 면으로도 너무 괜찮고"},{"start":1100.351,"duration":4.198999999999842,"text":"평일, 주말 쉬지 않고 할인하는 것도 너무 좋네요"},{"start":1104.552,"duration":2.6480000000001382,"text":"배달 할인 같은 경우는"},{"start":1107.202,"duration":2.0979999999999563,"text":"피자헛 앱으로 이용할 수 있고"},{"start":1109.302,"duration":2.5980000000001837,"text":"그리고 포장하면 싸니까"},{"start":1111.902,"duration":1.8979999999999109,"text":"포장 이용하시면 정말 좋을 것 같아요"},{"start":1113.802,"duration":4.648000000000138,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
