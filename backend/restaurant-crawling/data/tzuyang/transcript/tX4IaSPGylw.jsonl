046.127,"duration":1.3179999999999836,"text":"저는 유튜브 유튜브"},{"start":1047.446,"duration":2.7360000000001037,"text":"너무 감사한 것 중에 또 하나가..."},{"start":1050.184,"duration":1.2110000000000127,"text":"JYP에서 데뷔한 거"},{"start":1051.397,"duration":3.2250000000001364,"text":"인성을 정말 중요하게 여기거든요"},{"start":1054.624,"duration":3.933999999999969,"text":"어릴 때 데뷔하니까 좋은 어른이기가 쉽지 않잖아요"},{"start":1058.56,"duration":4.125,"text":"근데 그거를 회사에서 너무 든든하게 지도해 주셔서"},{"start":1062.687,"duration":1.7040000000001783,"text":"그게 되게 감사한 거 같아요"},{"start":1074.882,"duration":2.3869999999999436,"text":"진짜 너무 맛집이다!"},{"start":1080.99,"duration":2.229000000000042,"text":"우와...ㅋㅋㅋ"},{"start":1083.221,"duration":2.9710000000000036,"text":"이렇게 고기에 쌈을 싸서 고기로"},{"start":1086.194,"duration":1.3279999999999745,"text":"고급 기술이다"},{"start":1087.878,"duration":2.691000000000031,"text":"- 오늘 딱 하필 비가 와서... - 그니까요!"},{"start":1090.571,"duration":1.1010000000001128,"text":"딱 잘 어울려요!"},{"start":1091.674,"duration":1.7100000000000364,"text":"딱 고기 먹기 좋은 날!"},{"start":1101.414,"duration":1.29300000000012,"text":"제가 싸드리면 안 돼요?"},{"start":1104.563,"duration":2.6499999999998636,"text":"- 왜요?ㅋㅋㅋㅋ - 오늘 세 번째 심쿵인데ㅋㅋㅋ"},{"start":1107.215,"duration":1.4830000000001746,"text":"근데 채소를 안 좋아하시니까..."},{"start":1108.7,"duration":1.768000000000029,"text":"괜찮아요 괜찮아요, 다 좋아해요"},{"start":1110.47,"duration":3.632000000000062,"text":"와 영광이에요"},{"start":1114.104,"duration":1.0009999999999764,"text":"아주 좋은"},{"start":1118.099,"duration":0.9350000000001728,"text":"므므므므"},{"start":1119.036,"duration":1.4980000000000473,"text":"먹여주시나요...?"},{"start":1124.561,"duration":1.2989999999999782,"text":"됐다"},{"start":1127.616,"duration":2.3859999999999673,"text":"우와 쌈 누구 먹여준 건 처음이에요"},{"start":1130.004,"duration":0.9900000000000091,"text":"정말요?!?"},{"start":1130.995,"duration":3.83400000000006,"text":"- 너무 영광이에요... - 제가 더 영광이에요ㅋㅋㅋ"},{"start":1134.831,"duration":2.9610000000000127,"text":"- 쌈 싸주시면 안 돼요...? - 제가요?!?!?"},{"start":1137.793,"duration":0.4330000000002201,"text":"진짜..."},{"start":1138.228,"duration":1.6419999999998254,"text":"어머 이거 제 젓가락 아니..."},{"start":1139.871,"duration":1.849999999999909,"text":"어머 죄송해요..."},{"start":1143.572,"duration":1.5970000000002074,"text":"영상... 영상 찍어주세요"},{"start":1145.171,"duration":1.6399999999998727,"text":"저도 영상 찍어주시면 안 돼요?"},{"start":1148.881,"duration":0.9369999999998981,"text":"어우 잠깐만요"},{"start":1149.82,"duration":1.1390000000001237,"text":"이걸 어떻게 드려야 돼"},{"start":1150.961,"duration":2.872000000000071,"text":"진짜 왜 떠는 거야?"},{"start":1153.835,"duration":1.793999999999869,"text":"잠시만요, 이거 괜찮으세요?"},{"start":1160.999,"duration":1.0450000000000728,"text":"괜찮으세요?"},{"start":1168.279,"duration":1.3450000000000273,"text":"이번에 곡 내신다고 해서"},{"start":1169.626,"duration":2.2029999999999745,"text":"아이스크림 디저트를 준비했거든요!"},{"start":1172.035,"duration":2.0809999999999036,"text":"'배스킨라빈스' 무슨 맛 좋아하세요?"},{"start":1174.118,"duration":1.8279999999999745,"text":"- 와 다 좋아하는데... - 1등 1등"},{"start":1175.9470000000001,"duration":2.758999999999787,"text":"- 사빠딸 - 사랑에 빠진 딸기?"},{"start":1178.855,"duration":3.076000000000022,"text":"- 레인보우샤베트 - 레인보우샤베트 저도 좋아해요! 2등"},{"start":1181.933,"duration":1.0850000000000364,"text":"아 근데 궁금한 건데..."},{"start":1183.02,"duration":1.4639999999999418,"text":"혹시 민초 좋아하세요?"},{"start":1184.485,"duration":2.509999999999991,"text":"안 좋아하시는구나"},{"start":1186.996,"duration":2.1599999999998545,"text":"여기 이거 사빠딸이고..."},{"start":1189.158,"duration":1.2820000000001528,"text":"레인보우샤베트!"},{"start":1190.442,"duration":0.8820000000000618,"text":"그리고 여기는..."},{"start":1191.326,"duration":3.5729999999998654,"text":"죄송해요, 제가 제 취향을 가미했는데"},{"start":1194.9,"duration":1.33199999999988,"text":"저는 민초를"},{"start":1196.867,"duration":1.711999999999989,"text":"빨리 먹어서 없애버리겠습니다"},{"start":1202.148,"duration":1.1330000000000382,"text":"맛있다"},{"start":1203.283,"duration":1.48700000000008,"text":"저 근데 약간 생각보다 진짜..."},{"start":1204.772,"duration":3.1520000000000437,"text":"- 정신 줄 놓고 먹어서...ㅋㅋㅋ - 근데 진짜 많이 드셨어요!"},{"start":1207.926,"duration":3.5260000000000673,"text":"- 2인분은 좀 넘게 드신 것 같아요 - 밥 1공기에!"},{"start":1211.454,"duration":3.5930000000000746,"text":"아이스크림 워낙 좋아해서"},{"start":1215.049,"duration":2.076999999999998,"text":"근데 아이스크림 할인점 가면 보통..."},{"start":1219.546,"duration":1.5639999999998508,"text":"좀 있다가 같이..."},{"start":1221.111,"duration":2.686999999999898,"text":"안무 알려드리면서"},{"start":1229.106,"duration":3.2999999999999545,"text":"손 많이 가는 스타일이세요 언니"},{"start":1233.666,"duration":3.421000000000049,"text":"유나의 많이 많이 예뻐해 주세요~"},{"start":1238.464,"duration":1.8430000000000746,"text":"그럼 마지막 챌린지하고 끝낼까요?"},{"start":1242.15,"duration":1.163000000000011,"text":"아니면"},{"start":1243.315,"duration":2.310999999999922,"text":"쯔양 님께서 아이스크림을 드시고 계시면..."},{"start":1245.628,"duration":0.5720000000001164,"text":"제가 뒤에서..."},{"start":1246.202,"duration":1.2889999999999873,"text":"춤을 출까요?"},{"start":1247.493,"duration":2.4710000000000036,"text":"- 각자 잘하는 거, 괜찮죠? - 그래도 되나요?"},{"start":1249.966,"duration":1.5390000000002146,"text":"됐나요?"},{"start":1251.507,"duration":0.9890000000000327,"text":"네, 가겠습니다"},{"start":1273.859,"duration":1.308999999999969,"text":"이거 맞아요?"},{"start":1278.299,"duration":1.3430000000000746,"text":"'오늘도' 제가 이렇게 하면"},{"start":1279.644,"duration":1.1330000000000382,"text":"'잘 먹었습니다~'"},{"start":1280.779,"duration":0.8479999999999563,"text":"오늘도"},{"start":1281.629,"duration":2.3980000000001382,"text":"잘 먹었습니다~!"},{"start":1284.029,"duration":1.6730000000000018,"text":"식당 갈 때 쓰시라고"},{"start":1285.704,"duration":1.622000000000071,"text":"- 모자 선물! - 오 감사해요"},{"start":1287.328,"duration":2.4529999999999745,"text":"- 진짜 엄청 커요! - 너무 좋아요ㅎㅎ"},{"start":1290.99,"duration":0.5630000000001019,"text":"이거 혹시..."},{"start":1291.555,"duration":1.9399999999998272,"text":"- 기부하는 그거예요? - 오 맞아요!"},{"start":1293.496,"duration":2.494999999999891,"text":"- 어떻게 아세요? - 알고 있었어요ㅎㅎ"},{"start":1295.993,"duration":2.671000000000049,"text":"- 기부도 하시고 멋있으시다... - 아닙니다"},{"start":1298.666,"duration":2.104000000000042,"text":"아니 저 너무 어색한데요?"},{"start":1300.772,"duration":1.5109999999999673,"text":"약간 좀 연기를 해볼까?"},{"start":1302.284,"duration":1.268999999999778,"text":"관심이 없고 그냥 먹기만 하는 걸로ㅎ"},{"start":1303.555,"duration":0.8479999999999563,"text":"오케이, 그게 낫겠다..."}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
