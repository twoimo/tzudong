{"youtube_link":"https://www.youtube.com/watch?v=UO0aZl7a6dc","channel_name":"tzuyang","language":"ko","collected_at":"2026-05-17T04:34:21.067+09:00","transcript":[{"start":9.2,"duration":3.6000000000000014,"text":"제가 이번에는 인도네시아에 네 번째 방문이에요, 벌써!"},{"start":12.802,"duration":3.298000000000002,"text":"사실 인도네시아에서 정말 많이 봐주시거든요"},{"start":16.102,"duration":3.1980000000000004,"text":"먼 나라에서 이렇게 과분한 사랑을 주시고"},{"start":19.302,"duration":1.998000000000001,"text":"항상 이렇게 응원해 주셔서"},{"start":21.302,"duration":3.3979999999999997,"text":"그래서 '뭔가 보답드릴 수 있는 게 없을까' 생각하다가"},{"start":24.702,"duration":2.7979999999999983,"text":"인도네시아에 맹그로브 나무가 최대 서식지래요"},{"start":27.502,"duration":4.797999999999998,"text":"이렇게 도움이 되도록 심는 건 어떤가 해서 이번에"},{"start":32.302,"duration":2.9979999999999976,"text":"약간 도움을 보태고자 왔습니다"},{"start":35.302,"duration":3.048000000000002,"text":"부족한 저에게 이렇게 많은 관심을 주셔서"},{"start":38.352,"duration":1.8980000000000032,"text":"다시 한번 너무너무 감사드립니다"},{"start":55.15,"duration":1.75,"text":"저의 기록을 깨도록 하겠습니다"},{"start":60.55,"duration":0.9000000000000057,"text":"무서워"},{"start":62.35,"duration":0.8999999999999986,"text":"너... 너무..."},{"start":63.252,"duration":0.8479999999999919,"text":"너무 매워"},{"start":76.25,"duration":1.4500000000000028,"text":"인도네시아 최고 기록이에요"},{"start":147.15,"duration":1.5999999999999943,"text":"안녕하세요 여러분"},{"start":148.752,"duration":2.2479999999999905,"text":"제가 이번에 인도네시아가 네 번째거든요"},{"start":151.002,"duration":2.798000000000002,"text":"자카르타 두 번 갔었고 발리 한 번 갔었고"},{"start":153.802,"duration":1.6980000000000075,"text":"'이번에는 어디를 갈까' 하다가..."},{"start":155.502,"duration":3.897999999999996,"text":"요즘 진짜 스케줄이 많이 바빠서"},{"start":159.402,"duration":2.498000000000019,"text":"일정을 길게 가지 못 하고 좀 짧게 와야 될 것 같아서"},{"start":161.902,"duration":3.348000000000013,"text":"자카르타에서 좀 가깝게 갈 수 있는 반둥으로 왔어요!"},{"start":165.252,"duration":2.947999999999979,"text":"정말 인도네시아분들 말씀으로는"},{"start":168.202,"duration":1.1980000000000075,"text":"미식의 도시래요!"},{"start":169.402,"duration":3.6980000000000075,"text":"실제로 자카르타에서 거주를 하시는 분들이"},{"start":173.102,"duration":2.298000000000002,"text":"여기 반둥으로 정말 많이 놀러 오신대요"},{"start":175.402,"duration":2.9480000000000075,"text":"여기가 옷 쇼핑 하기도 좋고 맛있는 음식도 많고"},{"start":178.352,"duration":2.647999999999996,"text":"화산도 가서 힐링하기 좋다 그래서"},{"start":181.002,"duration":2.897999999999996,"text":"화산 진짜 엄청 해발도 높고 좋다고 하더라고요"},{"start":183.902,"duration":1.6480000000000246,"text":"그리고 날씨도 확실히"},{"start":185.552,"duration":1.5980000000000132,"text":"반둥이 훨씬 선선해요!"},{"start":187.152,"duration":2.298000000000002,"text":"약간 더 시원하고 쾌적한 것 같습니다"},{"start":189.452,"duration":2.147999999999996,"text":"사실 오늘 뭘 먹으러 왔냐면"},{"start":191.602,"duration":1.3979999999999961,"text":"사테를 먹으러 왔어요"},{"start":193.002,"duration":2.697999999999979,"text":"제가 자카르타 1편 때 사테를 먹었었거든요"},{"start":195.702,"duration":2.1980000000000075,"text":"여기 약간 좀 비슷한 곳이더라고요"},{"start":197.902,"duration":1.4980000000000189,"text":"그때는 'Sate Maranggi Haji Yetty'였는데"},{"start":199.402,"duration":2.348000000000013,"text":"여기는 'Sate Maranggi Haji Maya'예요"},{"start":201.752,"duration":4.4979999999999905,"text":"좌석도 야외에 이렇게 쫙 깔려있는 것도 살짝 비슷하고"},{"start":206.252,"duration":2.147999999999996,"text":"짠, 오늘의 모자"},{"start":209.05,"duration":1.6499999999999773,"text":"요즘 이 색 진짜 많이 써요"},{"start":210.702,"duration":3.6980000000000075,"text":"약간 어디나 잘 어울려서 요즘 최애 템입니다"},{"start":216.202,"duration":2.397999999999996,"text":"언니~"},{"start":218.602,"duration":1.6980000000000075,"text":"알고 있죠, 한국 먹방 유튜버"},{"start":220.302,"duration":0.7980000000000018,"text":"쯔양!"},{"start":221.102,"duration":2.298000000000002,"text":"밥 먹을 때마다 열심히 보고 있어요!"},{"start":223.402,"duration":1.8980000000000246,"text":"200개 레츠 고"},{"start":225.302,"duration":2.498000000000019,"text":"제가 그때 몇 개 먹었더라?"},{"start":227.802,"duration":1.6980000000000075,"text":"맞아, 101개였던 거 같아요"},{"start":229.502,"duration":2.3479999999999848,"text":"오늘은 적당히 먹을게요"},{"start":231.852,"duration":2.5979999999999848,"text":"적당히, 적당히"},{"start":234.452,"duration":2.4480000000000075,"text":"근데 여기가 점심시간인데"},{"start":236.902,"duration":2.348000000000013,"text":"지금 평일이거든요, 그래서 평일이어서"},{"start":239.252,"duration":1.4979999999999905,"text":"꽉 찬 분위기는 아닌데"},{"start":240.752,"duration":3.447999999999979,"text":"주말 같은 경우에는 손님이 많이 오신다고 하더라고요"},{"start":247.652,"duration":1.5980000000000132,"text":"'SAPI'가 소고"},{"start":249.252,"duration":1.8979999999999961,"text":"'KAMBING'이 염소"},{"start":251.152,"duration":2.098000000000013,"text":"'AYAM'이 닭"},{"start":253.252,"duration":3.048000000000002,"text":"'KAMPUNG'이 시골 닭이래요"},{"start":256.302,"duration":2.048000000000002,"text":"'Gurame'는 민물생선인데"},{"start":258.352,"duration":1.8480000000000132,"text":"인도네시아에서 되게 많이 먹는 생선입니다"},{"start":260.202,"duration":3.098000000000013,"text":"그리고 'Nila'도 인도네시아에서 많이 먹는 민물생선인데"},{"start":263.302,"duration":1.697999999999979,"text":"Gurame를 조금 더 많이 먹는다고 하더라고요"},{"start":265.002,"duration":2.098000000000013,"text":"이 정도면 마스터한 거 같은데?"},{"start":267.102,"duration":2.4980000000000473,"text":"이게 꼬치를 시키면 1접시에 10개 나오거든요"},{"start":269.602,"duration":1.7480000000000473,"text":"한 우리나라 돈으로 5,500원 정도 해요"},{"start":271.352,"duration":1.1480000000000246,"text":"SAPI 20개, KAMBING 20개, AYAM 20개씩"},{"start":272.502,"duration":1.2479999999999905,"text":"일단 먹어봐야겠다"},{"start":273.752,"duration":1.447999999999979,"text":"SOP IGA는 많이 먹어봤으니까"},{"start":275.202,"duration":1.447999999999979,"text":"SOP BUNTUT으로 먹어보겠습니다"},{"start":341.652,"duration":3.448000000000036,"text":"와 갈비탕 너무 맛있겠는데?"},{"start":345.102,"duration":2.6480000000000246,"text":"잠깐 따뜻할 때 국물부터 한 입 먼저 먹을까?"},{"start":347.752,"duration":1.5480000000000018,"text":"잘 먹겠습니다~!"},{"start":353.4,"duration":1.1000000000000227,"text":"밥 말아 먹고 싶다!"},{"start":354.502,"duration":1.947999999999979,"text":"이거 진짜 맛있어, 밥 말아 먹고 싶어!"},{"start":356.452,"duration":1.6480000000000246,"text":"감칠맛 나는 조미료..."},{"start":359.152,"duration":1.7479999999999905,"text":"치킨스톡 같은 거 막..."},{"start":362.152,"duration":1.2980000000000018,"text":"배합을 잘해서..."},{"start":364.802,"duration":1.3479999999999563,"text":"섞은 그런 맛이거든요?"},{"start":366.152,"duration":1.2980000000000018,"text":"와 오늘 끝났다..."},{"start":367.452,"duration":1.5480000000000018,"text":"맛집이다"},{"start":371.6,"duration":1.599999999999966,"text":"멜론주스 왜 이렇게 맛있어?"},{"start":373.202,"duration":2.798000000000002,"text":"맨 위에 엄청 단 촉촉한 부분 있죠?"},{"start":376.002,"duration":3.048000000000002,"text":"거기만 다 도려내서 갈아서 만든 맛인데?"},{"start":379.052,"duration":7.447999999999979,"text":"'AYAM'인데 치킨을 먼저 먹어볼게요"},{"start":392.2,"duration":2.900000000000034,"text":"더 맛있는 것 같은데?"},{"start":405.05,"duration":2,"text":"당황스러울 정도로 맛있어"},{"start":407.85,"duration":1.599999999999966,"text":"닭도 촉촉하고 부드럽고"},{"start":409.452,"duration":1.4979999999999905,"text":"겉에 양념이 진짜 맛있거든요"},{"start":410.952,"duration":2.848000000000013,"text":"약간 우리나라로 치면 숯불간장양념인데"},{"start":413.802,"duration":3.1479999999999677,"text":"숯불 향이 진짜 좋아요, 깊고"},{"start":416.952,"duration":3.7479999999999905,"text":"안에서 우러나는 찐 불맛의 숯불 향에"},{"start":422.15,"duration":0.9500000000000455,"text":"양념이..."},{"start":430.1,"duration":2.25,"text":"먹어본 사테 중에 진짜 수준급이에요"},{"start":432.352,"duration":2.6480000000000246,"text":"한국인이라면 거의..."},{"start":435.002,"duration":2.7479999999999905,"text":"99.9%가 좋아할 맛이거든요"},{"start":441.25,"duration":1.1000000000000227,"text":"죄송해요, 잘못 말했어요"},{"start":442.352,"duration":1.3980000000000246,"text":"'한국인이라면'이 아니라..."},{"start":443.752,"duration":2.348000000000013,"text":"아마 전 세계 사람이 먹어도 다 입에 맞으실 거예요"},{"start":448.15,"duration":1.8000000000000114,"text":"아 Jeruk 주스도 진짜 맛있다"},{"start":449.952,"duration":1.0480000000000018,"text":"이거 뭐지, 진짜?"},{"start":458,"duration":1.5500000000000114,"text":"이거 한번 먹어볼까?"},{"start":459.552,"duration":1.6479999999999677,"text":"토마토?"},{"start":467.752,"duration":1.0480000000000018,"text":"뭐야?"},{"start":472.8,"duration":2.5,"text":"아니 불닭이랑 비교가 안 되게 매운데요?"},{"start":475.302,"duration":4.347999999999956,"text":"한국에서 청양고추 아무 생각 없이 주워서 먹었는데"},{"start":479.652,"duration":0.8980000000000246,"text":"너무 매워서..."},{"start":480.552,"duration":1.8479999999999563,"text":"'야 먹어봐, 먹어봐' 하는 그 맛 있잖아요"},{"start":482.402,"duration":1.3480000000000132,"text":"1명은 눈물 흘리고"},{"start":483.752,"duration":2.348000000000013,"text":"혀가 진짜 얼얼한데..."},{"start":486.102,"duration":1.5480000000000018,"text":"너무 맛있게 맵다"},{"start":487.652,"duration":1.9979999999999905,"text":"조금씩 먹어야 돼, 이거 진짜 맵거든요"},{"start":501.45,"duration":1.8000000000000114,"text":"얘는 소고기 맛이에요"},{"start":503.252,"duration":8.048000000000002,"text":"아 소고기 맛이 아니라 얘는 소고기예요"},{"start":511.302,"duration":1.2479999999999336,"text":"닭이 좀 더 부드러웠다면"},{"start":512.551,"duration":2.1989999999999554,"text":"소고기는 씹는 식감이 좋네"},{"start":525.25,"duration":1.2999999999999545,"text":"얘가 매우면 얘도 맵겠네?"},{"start":532.7,"duration":1.849999999999909,"text":"진짜 맵다...!!"},{"start":534.551,"duration":2.49899999999991,"text":"반둥에 매운 게 되게 많나 봐요"},{"start":537.051,"duration":1.899000000000001,"text":"답사도 이곳저곳 가보긴 했는데"},{"start":538.952,"duration":1.4980000000000473,"text":"고추가 진짜 매워요"},{"start":550.2,"duration":1.3999999999999773,"text":"삼발소스!"},{"start":557.15,"duration":1.75,"text":"여기 고추 진짜 맵나 봐..."},{"start":566.6,"duration":2.3500000000000227,"text":"얘는 소꼬리거든요"},{"start":568.952,"duration":1.2980000000000018,"text":"완전 맛있을 것 같아"},{"start":575.05,"duration":2.3500000000000227,"text":"완전 부드러워!"},{"start":581.6,"duration":1.4499999999999318,"text":"누린내도 없고"},{"start":583.051,"duration":3.9489999999999554,"text":"진짜 그 고소한 기름진 맛인데"},{"start":589.6,"duration":1.6000000000000227,"text":"살이 진짜 부드러워"},{"start":591.202,"duration":2.947999999999979,"text":"다음으로 바로 먹어보겠습니다, 염소"},{"start":594.151,"duration":2.799000000000092,"text":"염소 왠지 되게 맛있을 거 같아"},{"start":618.25,"duration":1.7999999999999545,"text":"식감이 너무 좋아요"},{"start":620.051,"duration":1.24899999999991,"text":"약간 얘는 부드럽고"},{"start":621.301,"duration":1.74899999999991,"text":"얘는 담백한 느낌이었으면"},{"start":623.052,"duration":4.347999999999956,"text":"말캉말캉하면서도 진짜 스테이크 먹을 