{"youtube_link":"https://www.youtube.com/watch?v=jclR0QeDr54","channel_name":"tzuyang","language":"ko","collected_at":"2026-08-17T02:17:08.557+09:00","transcript":[{"start":0.001,"duration":1.9340000000000002,"text":"대한민국에서 만날 수도 없어"},{"start":1.935,"duration":1.3780000000000001,"text":"이 고기는 만날 수가 없어요"},{"start":3.313,"duration":2.594,"text":"이 가격에 만날 수가 없어요?"},{"start":5.907,"duration":1.7009999999999996,"text":"아니, 고기 자체를 못 만나"},{"start":7.608,"duration":1.5339999999999998,"text":"우리 집은 투쁠만 하거든"},{"start":14.514,"duration":2.1690000000000005,"text":"200g씩 모든 메뉴를 다 먹으면"},{"start":16.683,"duration":1.2010000000000005,"text":"딱 3kg이에요"},{"start":17.884,"duration":2.035,"text":"제가 오늘 전 메뉴 다 먹어볼게요"},{"start":32.299,"duration":2.0350000000000037,"text":"여러분 안녕하세요"},{"start":34.334,"duration":1.4009999999999962,"text":"제가 오늘은 지금 여기"},{"start":35.735,"duration":1.5690000000000026,"text":"전농동에 왔는데"},{"start":37.304,"duration":2.134999999999998,"text":"오늘 날씨 진짜 덥고 완전 여름이에요"},{"start":39.439,"duration":2.703000000000003,"text":"매미 소리 들리세요? 장난 아닌데?"},{"start":42.142,"duration":2.9029999999999987,"text":"제가 저희 피디님 맛집을 뺏었습니다"},{"start":45.278,"duration":1.100999999999999,"text":"항상"},{"start":46.379,"duration":2.6709999999999994,"text":"맛집... 촬영하기 좋은 맛집 발견하시면"},{"start":49.05,"duration":1.166000000000004,"text":"알려주시거든요?"},{"start":50.216,"duration":3.405000000000001,"text":"지인분께 여기 피디님이 자주 다니신다는 정보를 들어서..."},{"start":53.621,"duration":2.067999999999998,"text":"한 일주일 정도 전에 왔었거든요?"},{"start":55.689,"duration":4.405000000000001,"text":"어떻게 이런 맛집을 숨겨놓으셨나 할 정도로"},{"start":60.094,"duration":1.7340000000000018,"text":"너무 맛집인 거예요"},{"start":61.828,"duration":1.4009999999999962,"text":"사실 고깃집인데..."},{"start":63.229,"duration":2.503,"text":"고기가 가격이 말이 안 돼요"},{"start":65.732,"duration":2.236000000000004,"text":"삼겹살이 4,000원이에요...!"},{"start":67.968,"duration":1.6679999999999922,"text":"그리고 더 놀랐던 게"},{"start":69.636,"duration":1.8029999999999973,"text":"한우 투쁠이 진짜 비싸잖아요"},{"start":71.439,"