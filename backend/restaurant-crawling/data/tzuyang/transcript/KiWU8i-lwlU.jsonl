{"youtube_link":"https://www.youtube.com/watch?v=KiWU8i-lwlU","channel_name":"tzuyang","language":"ko","collected_at":"2026-08-17T02:16:56.839+09:00","transcript":[{"start":0.002,"duration":1.633,"text":"술 시키시면 계속 나와요"},{"start":1.636,"duration":1.067,"text":"계속 나와요?"},{"start":2.704,"duration":1.467,"text":"감사합니다, 뭐야? 엄청 금방 나오네"},{"start":4.172,"duration":2.3680000000000003,"text":"감사합니다"},{"start":8.076,"duration":1.8010000000000002,"text":"이렇게 많이 나와요?"},{"start":9.878,"duration":1.0999999999999996,"text":"앵글에 다 안 나와요"},{"start":14.949,"duration":1.9680000000000017,"text":"이거 완전 술 각이다"},{"start":21.955,"duration":0.968,"text":"끝내준다"},{"start":24.458,"duration":1.2010000000000005,"text":"짜앙어~~~"},{"start":25.66,"duration":2.468,"text":"청국장"},{"start":28.129,"duration":1.968,"text":"나 지금 약간 꿈꾸는 것 같아"},{"start":31.633,"duration":1.2330000000000005,"text":"정읍 인심이여~"},{"start":32.867,"duration":1.4000000000000057,"text":"삿갓이네 인심이여~~"},{"start":41.209,"duration":1.8669999999999973,"text":"안녕하세요, 여러분"},{"start":43.077,"duration":2.5690000000000026,"text":"제가 오늘은 전북 정읍에 왔는데"},{"start":45.647,"duration":2.033999999999999,"text":"정읍에 계시는 분이 있는데"},{"start":47.682,"duration":1.7339999999999947,"text":"그분이 여기는 꼭 가야 된다고"},{"start":49.417,"duration":1.4339999999999975,"text":"계속 추천해 주셔서"},{"start":50.852,"duration":1.7010000000000005,"text":"그리고 되게 특이하더라고요?"},{"start":52.554,"duration":2.2010000000000005,"text":"이게 음식값이 따로 있는 게 아니라"},{"start":54.756,"duration":3.2349999999999994,"text":"그냥 술을 시키면 안주를 그냥 계속 주시는"},{"start":57.992,"duration":1.2340000000000018,"text":"약간 통영에서 갔던"},{"start":59.227,"duration":2.4680000000000035,"text":"다찌 같은 그런 곳인데"},{"start":61.696,"duration":3.5360000000000014,"text":"음식도 진짜 맛있어 보이고 리뷰도 엄청 좋고"},{"start":65.233,"duration":1.6670000000000016,"text":"궁금해서 찾아왔습니다"},{"start":66.901,"duration":2.902000000000001,"text":"근데 그분께서 단골이셔서"},{"start":69.804,"duration":1.4339999999999975,"text":"예약을 해주셨어요!"},{"start":71.239,"duration":1.4669999999999987,"text":"그럼 또 안 올 수 없잖아요~"},{"start":72.707,"duration":4.337000000000003,"text":"오픈이 원래 오후 5시인데 5시 조금 넘어서 왔습니다"},{"start":77.045,"duration":3.903000000000006,"text":"'김삿갓막걸리'라는 곳이에요"},{"start":80.949,"duration":1.8670000000000044,"text":"오랜만에 술 마시러 온 거 같은데?!"},{"start":82.81700000000001,"duration":3.168999999999997,"text":"- 오늘 마실 거야? - 아잇...! 여기 왔는데 먹어야죠~"},{"start":85.987,"duration":1.7010000000000076,"text":"출동"},{"start":87.689,"duration":2.868000000000009,"text":"- 안녕하세요 - 안녕하세요"},{"start":90.958,"duration":1.301000000000002,"text":"사장님 안녕하세요"},{"start":92.826,"duration":5.072000000000003,"text":"안이 완전 진짜 옛날 주막 같은 느낌이다"},{"start":98.131,"duration":1.8019999999999925,"text":"김삿갓이어서 그런가?"},{"start":99.934,"duration":1.467000000000013,"text":"조명이 삿갓이네"},{"start":101.402,"duration":0.7669999999999959,"text":"메뉴판이 진짜 특이해요"},{"start":102.17,"duration":1.2000000000000028,"text":"음식은 하나도 없고"},{"start":103.37100000000001,"duration":1.266999999999996,"text":"3만 5,000원인데"},{"start":104.63900000000001,"duration":2.434999999999988,"text":"대신에 안주를 그냥 막 주시는 것 같아요"},{"start":107.075,"duration":2.801000000000002,"text":"아니 근데... 여기 메뉴판에는 안 쓰여있는데"},{"start":109.87700000000001,"duration":1.1669999999999874,"text":"저기에 있거든요?"},{"start":111.045,"duration":2.8020000000000067,"text":"안주는 먹고 싶은데 술 안 먹는 상"},{"start":113.848,"duration":1.1340000000000003,"text":"10만 원 상!"},{"start":114.983,"duration":2.600999999999999,"text":"- 저거는 안주가 더 많이 나와요? - 안주가 더 많이 나와요!"},{"start":117.58500000000001,"duration":1.1339999999999861,"text":"- 술도 나오나요? - 네!"},{"start":118.72,"duration":1.6340000000000003,"text":"얼마나 나와요?"},{"start":120.355,"duration":2.2009999999999934,"text":"- 주전자 3개 정도로 나와요 - 주전자 3개요?!"},{"start":122.557,"duration":3.468999999999994,"text":"혹시 윗물은 막걸리 위에 있는 물이에요?"},{"start":126.027,"duration":2.701999999999984,"text":"그럼 저는 윗물로 부탁드립니다"},{"start":133.166,"duration":1.367999999999995,"text":"감사합니다"},{"start":134.801,"duration":2.069000000000017,"text":"차가워, 진짜 차갑다"},{"start":141.508,"duration":1.367999999999995,"text":"감사합니다, 뭐야? 엄청 금방 나오네"},{"start":142.877,"duration":3.60299999999998,"text":"감사합니다, 죽?"},{"start":146.481,"duration":1.3329999999999984,"text":"뭐가 엄청 나오네"},{"start":148.448,"duration":1.0339999999999918,"text":"감사합니다"},{"start":153.82,"duration":0.7010000000000218,"text":"거짓말"},{"start":154.522,"duration":1.5010000000000048,"text":"사장님 혹시 더 있나요?"},{"start":156.024,"duration":0.8659999999999854,"text":"끝인가요?"},{"start":156.891,"duration":1.600999999999999,"text":"- 다 나왔어요~ - 다 나왔어요?!"},{"start":158.493,"duration":2.7680000000000007,"text":"- 남는 게 없어요 - 남는 게 없다고요?"},{"start":161.262,"duration":1.6340000000000146,"text":"술 시키시면 계속 나와요"},{"start":162.897,"duration":1.200000000000017,"text":"계속 나와요?"},{"start":164.098,"duration":2.2009999999999934,"text":"- 종류가 달라져요? - 네, 달라져요"},{"start":166.3,"duration":2.3689999999999714,"text":"다음 음식 뭔지 궁금해...!"},{"start":168.67000000000002,"duration":1.4329999999999927,"text":"술을 더 마셔야 되나ㅎ?"},{"start":170.10399999999998,"duration":2.068000000000012,"text":"아니 앵글에 다 안 담겨요"},{"start":172.173,"duration":2.701999999999998,"text":"지금 앵글에 다 안 담아져요"},{"start":174.876,"duration":2.234000000000009,"text":"조기는 원래 2마리 나오거든요? 근데..."},{"start":177.111,"duration":1.4680000000000177,"text":"식구들 것까지 주셔서"},{"start":178.57999999999998,"duration":2.5010000000000048,"text":"조기만 4마리가 나왔는데"},{"start":181.082,"duration":1.266999999999996,"text":"일단 따라보자"},{"start":182.55,"duration":3.1689999999999827,"text":"이거 완전 술 각이다"},{"start":186.386,"duration":2.8029999999999973,"text":"완전 막걸리 위에 있는 것만 있어요"},{"start":196.897,"duration":1.835000000000008,"text":"진짜 맛있다...!"},{"start":198.733,"duration":3.468999999999994,"text":"엄청 시원하고... 막걸리가 달아요"},{"start":202.203,"duration":2.068000000000012,"text":"콘치즈 먼저... 따뜻할 때"},{"start":224.191,"duration":3.9369999999999834,"text":"원래 생선구이는 신선도랑 간이 제일 중요하잖아요"},{"start":228.129,"duration":2.2009999999999934,"text":"진짜 비린내 안 나고"},{"start":230.33100000000002,"duration":3.535999999999973,"text":"조기 짭짤한 그 맛에..."},{"start":233.868,"duration":0.967000000000013,"text":"맛있다...!"},{"start":234.836,"duration":2.2679999999999723,"text":"전어도 있어요! 전어!"},{"start":237.105,"duration":1.4330000000000211,"text":"전어가 이제 나올 시즌인가?"},{"start":238.539,"duration":0.7669999999999959,"text":"가을?"},{"start":246.013,"duration":1.6339999999999861,"text":"생선 진짜 맛있다"},{"start":247.981,"duration":2.3019999999999925,"text":"살이 진짜 부드럽고"},{"start":250.284,"duration":1.3010000000000161,"text":"하나도 안 뻑뻑하고"},{"start":252.185,"duration":2.969999999999999,"text":"전어 특유의 되게 고소한 향이"},{"start":256.59,"duration":1.0010000000000332,"text":"기름져"},{"start":258.091,"duration":1.0009999999999764,"text":"맛있어"},{"start":259.226,"duration":1.1340000000000146,"text":"밥이랑 먹기에도 완벽하고"},{"start":260.361,"duration":2.401999999999987,"text":"그냥 먹어도 맛있는...! 딱 그런 간이에요"},{"start":262.764,"duration":1.6669999999999732,"text":"진짜 역대급이다"},{"start":264.432,"duration":1.599999999999966,"text":"여기 제가 못 먹는 것들이 있거든요"},{"start":266.033,"duration":2.4350000000000023,"text":"오이를 일단 못 먹고 이래서..."},{"start":268.469,"duration":2.8349999999999795,"text":"채소는 나눠서 먹도록 하겠습니다..."},{"start":271.305,"duration":3.836999999999989,"text":"잡채"},{"start":284.551,"duration":2.8029999999999973,"text":"양념은 어떨까... 손맛은 어떠실까 궁금했는데"},{"start":287.355,"duration":1.33299999999997,"text":"끝내주세요"},{"start":288.689,"duration":1.9010000000000105,"text":"일단 간을 진짜 잘 맞추시는 거 같아요"},{"start":290.591,"duration":1.5679999999999836,"text":"간이 너무 다 딱 맞아!"},{"start":298.398,"duration":3.4039999999999964,"text":"조개죽 같은데?"},{"start":310.277,"duration":2.2350000000000136,"text":"죽에 콩 들어있는 게 찐이야"},{"start":312.513,"duration":3.0360000000000014,"text":"해물계란죽 같은 느낌이거든요?"},{"start":315.55,"duration":2.1340000000000146,"text":"근데"},{"start":317.685,"duration":1.5339999999999918,"text":"살짝 중식 느낌도 나요"},{"start":319.22,"duration":4.336999999999989,"text":"크기가 예사롭지가 않아요, 말도 안 돼"},{"start":328.028,"duration":3.9039999999999964,"text":"너무 쫀쫀해, 쫄깃쫄깃해"},{"start":340.273,"duration":1.5019999999999527,"text":"속 풀리는 맛!"},{"start":341.776,"duration":4.2029999999999745,"text":"생고기, 육사시미 이런 거 진짜 비싼 거 아시죠?"},{"start":345.98,"duration":1.867999999999995,"text":"근데 3만 5,000원짜리에 이게 나온다?"},{"start":347.849,"duration":1.66700000000003,"text":"서울에서는 없을 거예요"},{"start":349.85,"duration":1.9349999999999454,"text":"'쯔양몇끼'"},{"start":351.786,"duration":1.766999999999996,"text":"'쯔양몇끼'...?"},{"start":361.428,"duration":2.9359999999999786,"text":"단단하면서도 쫄깃쫄깃한"},{"start":364.365,"duration":3.569000000000017,"text":"거의 뭉티기와 육사시미의 중간 정도 되는"},{"start":367.935,"duration":2.6689999999999827,"text":"입에 닿기만 해도 신선한 생고기!"},{"start":377.377,"duration":1.100999999999999,"text":"끝내준다"},{"start":378.479,"duration":2.9350000000000023,"text":"제가 봤을 때 이 정도면 사장님이..."},{"start":381.415,"duration":2.2679999999999723,"text":"테이블마다 음식 다 다르게 주실 것 같아요"},{"start":383.684,"duration":2.134999999999991,"text":"뭐가 나가야 되는지 깜빡하실 거 같아요"},{"start":385.82,"duration":1.16700000000003,"text":"너무 많이 나와서"},{"start":386.988,"duration":1.5670000000000073,"text":"지금 호박잎이 없고 다른 곳은"},{"start":388.556,"duration":1.9010000000000105,"text":"- 도토리묵이 있어 - 에엥~~ 그래요~?!"},{"start":390.45799999999997,"duration":2.368000000000052,"text":"근데 저 호박잎 좋아해요, 의외죠?"},{"start":392.827,"duration":3.701999999999998,"text":"우렁된장 같은데요?"},{"start":396.53,"duration":1.16700000000003,"text":"바로 먹어보겠습니다-"},{"start":406.139,"duration":2.3360000000000127,"text":"된장이 쌈장처럼 약간 달달하거든요"},{"start":408.476,"duration":2.201000000000022,"text":"근데 이..."},{"start":410.678,"duration":1.3340000000000032,"text":"호박잎이 진짜 킥이에요"},{"start":421.054,"duration":3.136000000000024,"text":"고구마순"},{"start":431.865,"duration":1.8349999999999795,"text":"원래 약간 고구마순 하면..."},{"start":433.701,"duration":2.5679999999999836,"text":"물렁거리는 느낌이었는데 얘는 완전..."},{"start":440.273,"duration":2.9699999999999704,"text":"엄청 싱싱하고 두꺼운 콩나물 식감이에요"},{"start":455.289,"duration":2.3010000000000446,"text":"말... 말도 안 돼ㅎㅋ"},{"start":463.631,"duration":3.4360000000000355,"text":"제가 먹은 전어구이 중