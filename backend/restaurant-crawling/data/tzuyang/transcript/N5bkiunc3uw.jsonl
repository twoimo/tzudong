{"youtube_link":"https://www.youtube.com/watch?v=N5bkiunc3uw","channel_name":"tzuyang","language":"ko","collected_at":"2026-08-17T02:17:38.431+09:00","transcript":[{"start":0.767,"duration":1.335,"text":"저거든요"},{"start":2.102,"duration":1.601,"text":"우리 집밖에 없어서"},{"start":9.042,"duration":2.3689999999999998,"text":"우와 뭐야?"},{"start":11.412,"duration":0.8659999999999997,"text":"진짜 크다"},{"start":12.279,"duration":2.702,"text":"1인분ㅋㅋㅋ"},{"start":26.96,"duration":2.803000000000001,"text":"근데 우리 XX예요"},{"start":52.418,"duration":1.9690000000000012,"text":"안녕하세요 여러분"},{"start":54.387,"duration":2.168999999999997,"text":"제가 오늘은 지금 연평도에서"},{"start":56.556,"duration":2.102000000000004,"text":"좀 특이한 메뉴가 있더라고요"},{"start":58.658,"duration":1.2680000000000007,"text":"족발인데"},{"start":59.926,"duration":1.2680000000000007,"text":"족발 바비큐?"},{"start":61.194,"duration":0.9009999999999962,"text":"왕족 구이?"},{"start":62.095,"duration":4.471000000000004,"text":"약간 양념에 족발을 이렇게 해서"},{"start":66.566,"duration":1.7009999999999934,"text":"여튼! 좀 특이한 메뉴가 있는데"},{"start":68.267,"duration":2.7700000000000102,"text":"좀 특이해서 찾아가 보도록 하겠습니다"},{"start":71.037,"duration":2.1019999999999897,"text":"제가 저번에 저길 지나가는데"},{"start":73.139,"duration":1.3020000000000067,"text":"사장님께서 나오셔서"},{"start":74.44200000000001,"duration":2.1999999999999886,"text":"'여기 와, 여기도 한번'"},{"start":76.642,"duration":2.2700000000000102,"text":"족발 먹으러 오라고 하셨었거든요"},{"start":78.912,"duration":2.468999999999994,"text":"여기 이름이 '별미식당'이거든요"},{"start":81.381,"duration":1.5679999999999978,"text":"저기 '별미식당'"},{"start":84.051,"duration":1.4669999999999987,"text":"오두막처럼 생겼는데?"},{"start":86.352,"duration":2.836999999999989,"text":"별미식당에 아주 좋은 기억이 있었으니까"},{"start":89.189,"duration":1.1340000000000146,"text":"여기도 맛있지 않을까?"},{"start":90.656,"duration":1.468999999999994,"text":"아직 사실 여기는..."},{"start":92.125,"duration":1.8019999999999925,"text":"제가 섭외를 안 했어요..."},{"start":93.92699999999999,"duration":2.63600000000001,"text":"사장님이 그때 오라고 하셔서"},{"start":96.563,"duration":2.0690000000000026,"text":"- 안녕하세요 - 안녕하세요"},{"start":98.632,"duration":1.4339999999999975,"text":"어? 엇! 사장님이세요...?"},{"start":100.066,"duration":1.4350000000000023,"text":"사장님"},{"start":101.501,"duration":1.8349999999999937,"text":"우리 쯔양 언니 왔어요ㅎ"},{"start":103.336,"duration":1.4340000000000117,"text":"안녕하세요"},{"start":104.77000000000001,"duration":1.0019999999999811,"text":"사장님이시죠?!"},{"start":105.77199999999999,"duration":0.7670000000000101,"text":"저번에"},{"start":106.539,"duration":2.0690000000000026,"text":"이르케 이르케! 손 흔들어 주셨던!"},{"start":108.608,"duration":1.1999999999999886,"text":"한번 오라고 하셨어서..."},{"start":109.809,"duration":0.8000000000000114,"text":"나거든"},{"start":110.61,"duration":1.402000000000001,"text":"아! 아? 그래요?!"},{"start":112.012,"duration":1.766999999999996,"text":"저거든요"},{"start":113.779,"duration":1.0349999999999966,"text":"- 아, 제가 - 밥 먹었나?"},{"start":114.814,"duration":1.7350000000000136,"text":"십몇인 분 먹고 왔는데"},{"start":116.549,"duration":1.2019999999999982,"text":"우린 족발 맛있어!"},{"start":117.751,"duration":1,"text":"부대찌개도 맛있고"},{"start":118.751,"duration":1.367999999999995,"text":"우리 집밖에 없어 족발은"},{"start":120.12,"duration":0.7669999999999959,"text":"족발은"},{"start":120.887,"duration":2.2690000000000055,"text":"- 그래서 왔구나, 고마워... - 그래서 먹어도 되는 거죠...?"},{"start":123.156,"duration":1.2009999999999934,"text":"- 아 그럼 당연하지~ - 그래요?"},{"start":128.094,"duration":1.100999999999999,"text":"매운 거 잘 드세요?"},{"start":129.195,"duration":1.5020000000000095,"text":"중간 맛이..."},{"start":130.697,"duration":1.1339999999999861,"text":"불닭볶음면 정도"},{"start":131.831,"duration":1.6690000000000111,"text":"엄청 맵네"},{"start":133.5,"duration":1.7350000000000136,"text":"- 약간 매운맛 - 약간 매운맛 정도"},{"start":135.235,"duration":2.8689999999999714,"text":"약간 매운맛으로 대자 맛있는 걸로 주세요"},{"start":138.10399999999998,"duration":1.0010000000000048,"text":"어? 여기 카페도 있네?"},{"start":139.105,"duration":2.0020000000000095,"text":"- 여기서 주문할 수 있어요? - 응응"},{"start":141.107,"duration":1.2680000000000007,"text":"- 아, 정말요? - 응"},{"start":142.375,"duration":2.701999999999998,"text":"카페 음료 시켜야지"},{"start":185.285,"duration":1.3010000000000161,"text":"우와, 뭐야?"},{"start":186.886,"duration":0.8669999999999902,"text":"진짜 크다"},{"start":187.754,"duration":1.9350000000000023,"text":"1인분ㅋㅋㅋ"},{"start":189.689,"duration":1.1670000000000016,"text":"아니 제가"},{"start":190.856,"duration":1.6690000000000111,"text":"카페 음료 시키려고 했는데"},{"start":192.525,"duration":2.102000000000004,"text":"사장님께서 이거 갖다주셨어요"},{"start":196.262,"duration":1.7690000000000055,"text":"너무 맛있어! 너무 진해!"},{"start":198.031,"duration":1.5010000000000048,"text":"잘 먹겠습니다~!"},{"start":199.532,"duration":1.8019999999999925,"text":"일단 시켰는데 메뉴가 진짜 신기하거든요?"},{"start":201.334,"duration":2.8029999999999973,"text":"원래 보통 족발에 양념을 발라서 나오진 않잖아요"},{"start":204.137,"duration":1.7680000000000007,"text":"얘는 바비큐처럼"},{"start":205.906,"duration":2.2109999999999843,"text":"양념이 이렇게 발라져 있거든요"},{"start":208.117,"duration":1.6920000000000073,"text":"야들야들 맛있겠다"},{"start":214.18,"duration":1.2680000000000007,"text":"어? 맵진 않은데?"},{"start":215.448,"duration":2.73599999999999,"text":"중간 맛이 불닭볶음면이라고 하시지 않으셨나...?"},{"start":222.288,"duration":1.7019999999999982,"text":"와! 이거 완전 술안주다!"},{"start":223.99,"duration":1.634999999999991,"text":"약간 진하고 스모크한"},{"start":225.625,"duration":2.468999999999994,"text":"바비큐 소스 양념이 발라져 있거든요?"},{"start":228.094,"duration":1.3340000000000032,"text":"완전 술안주예요!"},{"start":234,"duration":0.8329999999999984,"text":"쌈무랑"},{"start":235.66899999999998,"duration":1.3670000000000186,"text":"너무 잘 어울릴 것 같아"},{"start":237.036,"duration":1.6020000000000039,"text":"약간 오리바비큐 먹을 때"},{"start":238.638,"duration":3.336999999999989,"text":"바비큐 소스 찍어서 쌈무 싸 먹으면 맛있거든요?"},{"start":241.975,"duration":1.9680000000000177,"text":"그런 느낌으로다가"},{"start":250.216,"duration":0.8669999999999902,"text":"잘 어울린다"},{"start":251.55,"duration":1.9019999999999868,"text":"여기도 그거 있나? 미니족 부분?"},{"start":253.452,"duration":1.2019999999999982,"text":"헤에? 미니족 있다!"},{"start":276.008,"duration":1.2690000000000055,"text":"라면 먹고 싶다"},{"start":277.277,"duration":2.302000000000021,"text":"맛있는 김치 먹으면 라면 먹고 싶지 않나요?"},{"start":279.579,"duration":3.3029999999999973,"text":"우동 한 번도 본 적 없는데, 우동 처음 봐"},{"start":282.882,"duration":1.2019999999999982,"text":"참치김치찌개도 있고"},{"start":284.084,"duration":1.8009999999999877,"text":"순두부찌개, 갈비탕, 육개장"},{"start":285.885,"duration":1.7350000000000136,"text":"메뉴가 진짜 많은데요?"},{"start":287.62,"duration":1.4680000000000177,"text":"- 다 하시는 거예요? - 예"},{"start":289.088,"duration":4.170999999999992,"text":"- 연평도에서만 16년? 장사했어요 - 엄청 오래하셨네요"},{"start":293.259,"duration":2.8029999999999973,"text":"주민분들은 다 한 번씩 족발 드시러 오셨겠어요"},{"start":296.062,"duration":2.8689999999999714,"text":"사장님, 그러면 김치우동도 하나만 해주세요"},{"start":298.931,"duration":2.6690000000000396,"text":"우와! 내가 좋아하는 콜라겐 많은 거!"},{"start":303.936,"duration":1.9350000000000023,"text":"완전 쫄깃쫄깃해!"},{"start":311.14300000000003,"duration":0.6679999999999495,"text":"감사합니다"},{"start":311.812,"duration":2.100999999999999,"text":"우와! 이 계란찜 서비스 주신 거예요?"},{"start":314.847,"duration":1.268000000000029,"text":"- 너무 감사합니다 - 맛있게 드세요"},{"start":316.115,"duration":1.5679999999999836,"text":"완전 터질 것 같은데?"},{"start":317.683,"duration":1.302000000000021,"text":"제대로 폼페이 됐네"},{"start":327.76,"duration":3.1030000000000086,"text":"계란찜의 까슬까슬한 식감이 다 느껴지면서도"},{"start":330.863,"duration":2.502999999999986,"text":"입에서 진짜 사르르 녹아내린다..."},{"start":348.782,"duration":2.401999999999987,"text":"우와! 이게 원래 찐이거든요"},{"start":358.424,"duration":1.6350000000000477,"text":"껍데기가 완전 꼬독꼬독거려"},{"start":365.631,"duration":0.8350000000000364,"text":"너무 맛있다"},{"start":367.2,"duration":0.9669999999999845,"text":"이것 봐요!"},{"start":368.167,"duration":1.3010000000000446,"text":"이런 게 맛있는 거 알죠?"},{"start":379.445,"duration":0.8009999999999877,"text":"쌈장"},{"start":392.725,"duration":1.1339999999999577,"text":"너무 잘 어울려!"},{"start":393.859,"duration":1.802000000000021,"text":"중학생 애들이 쯔양 온다고"},{"start":395.661,"duration":1.9019999999999868,"text":"밖에서 지금 우르르 몰려와서…"},{"start":397.563,"duration":1.4020000000000437,"text":"방과 후 땡땡이 친다고 사인 받는다고"},{"start":398.96500000000003,"duration":1.200999999999965,"text":"땡땡이 친다고요?ㅋㅋㅋ"},{"start":400.166,"duration":1.3349999999999795,"text":"안녕하세요"},{"start":401.501,"duration":1.9020000000000437,"text":"- 안녕하세요, 중학생이에요? - 네"},{"start":407.507,"duration":1.0679999999999836,"text":"시원해"},{"start":429.562,"duration":3.8029999999999973,"text":"이제 거의 껍데기 많은 부분만 남았거든요?"},{"start":433.365,"duration":2.069000000000017,"text":"행복하다"},{"start":442.475,"duration":0.83299999999997,"text":"식감"},{"start":444.543,"duration":3.1370000000000005,"text":"콜라겐 부분 식감 진짜 맛있다!"},{"start":447.68,"duration":1.4680000000000177,"text":"야들야들 맛있겠죠?"},{"start":453.986,"duration":2.069000000000017,"text":"매운맛이 아예 없다고 생각했는데"},{"start":456.055,"duration":2.2690000000000055,"text":"살짝 매콤한 맛이 꽤 있네?"},{"start":458.324,"duration":4.471000000000004,"text":"근데 어떻게 갑자기 중간 맛이 불닭볶음면으로 뛰지?"},{"start":462.795,"duration":2.8700000000000045,"text":"우와! 위에 가쓰오부시가..."},{"start":465.665,"duration":3.335999999999956,"text":"김치우동 색깔이 진짜 김치찌개만큼 진한데?"},{"start":477.843,"duration":1.56899999999996,"text":"어? 먹을수록 맛이 올라오네?"},{"start":486.318,"duration":1.2019999999999982,"text":"면 야들야들"},{"start":493.125,"duration":2.0020000000000095,"text":"안에 들어간 김치가 시큼하니 맛있다"},{"start":501.734,"duration":1.100999999999999,"text":"술 먹으면서 먹으면은"},{"start":502.835,"duration":1.0680000000000405,"text":"술 한 잔 먹고 해장하고"},{"start":503.903,"duration":2.0679999999999836,"text":"술 한 잔 먹고 해장하고 이런 느낌 날 것 같은데?"},{"start":510.877,"duration":2.0340000000000487,"text":"아 맞다, 매운 소스 주셨지"},{"start":512.912,"duration":2.7029999999999745,"text":"혹시 중간 맛 소스 따로 조금만 먹어볼..."},{"start":515.615,"duration":2.134999999999991,"text":"있어요?"},{"start":517.75,"duration":1.8350000000000364,"text":"일단 약간 매운맛은 아예! 저한테"},{"start":519.585,"duration":1.7350000000000136,"text":"매운맛 자체가 안 나요!"},{"start":521.32,"duration":2.4689999999999372,"text":"중간 맛이라고 많이 맵겠어?"},{"start":523.789,"duration":1.5349999999999682,"text":"한번 그냥 푹 찍어서"},{"start":538.504,"duration":1.467999999999961,"text":"갑자기 확 매워지네"},{"start":539.972,"duration":1.3680000000000518,"text":"확실히 매운 것 같긴 하거든요?"},{"start":541.34,"duration":1.6680000000000064,"text":"확실히 이거보다 엄청 매운데"},{"start":543.008,"duration":0.9679999999999609,"text":"불닭만큼 맵지는 않은데"},{"start":543.976,"duration":1.4009999999999536,"text":"혀가 되게 얼얼하네?!"},{"start":545.377,"duration":1.100999999999999,"text":"근데"},{"start":546.478,"duration":3.4710000000000036,"text":"제가 놀랄 정도는 아닙니다"},{"start":549.949,"duration":2.1680000000000064,"text":"매운맛을 한번 조금만 받아볼까?"},{"start":552.117,"duration":0.6340000000000146,"text":"매운맛이에요!"},{"start":552.751,"duration":0.7340000000000373,"text":"겁~나게 매워요"},{"start":553.485,"duration":1.0009999999999764,"text":"- 겁나게 매워요? - 응"},{"start":554.486,"duration":1.1019999999999754,"text":"배탈 날 수도 있는데..."},{"start":555.588,"duration":2.7690000000000055,"text":"큰일 났는데?"},{"start":558.357,"duration":3.2029999999999745,"text":"수박 주스 진짜 끝장나요"},{"start":561.56,"duration":2.1690000000000964,"text":"카페 제가 저장해 둔 곳이더라고요"},{"start":563.729,"duration":1.634999999999991,"text":"음료수 맛있어 보여서ㅎ"},{"start":565.364,"duration":1.1019999999999754,"text":"어? 이게 그거예요?"},{"start":566.466,"duration":2.9689999999999372,"text":"- 장... 면장? 면장 라떼? - 응응응"},{"start":569.435,"duration":2.4710000000000036,"text":"연평도 면장님이 저걸 좋아하신다고"},{"start":571.906,"duration":2.3330000000000837,"text":"라떼네, 여기 위에 크림이 있는"},{"start":578.578,"duration":1.9020000000000437,"text":"- 맛있어 - 맛있죠?"},{"start":580.48,"duration":1.8679999999999382,"text":"- 진짜 맛있다 이거 - 나도 맨날 그것만 마셔"},{"start":582.348,"duration":1.3670000000000755,"text":"이거 완전 내 취향이야"},{"start":583.715,"duration":0.7679999999999154,"text":"달달하면서도"},{"start":584.483,"duration":3.23700000000008,"text":"뭔가 약간 풍미가 추가된 다방 커피 맛에다가"},{"start":587.72,"duration":2.2350000000000136,"text":"진짜 부드러운 크림을 얹었거든요?"},{"start":591.724,"duration":1.100999999999999,"text":"끝내준다"},{"start":592.825,"duration":2.1359999999999673,"text":"이제 매운맛을 한번 먹어보겠습니다"},{"start":594.961,"duration":1.634999999999991,"text":"배탈 날 수도 있다고 하셨거든요?"},{"start":602.401,"duration":2.703000000000088,"text":"입에 넣자마자 매운맛이 확 느껴지네...!"},{"start":605.104,"duration":2.4349999999999454,"text":"불닭 소스 같은 류의 매운맛이네 이거"},{"start":607.539,"duration":1.8360000000000127,"text":"못 먹을 정도는 아닌 것 같은데?ㅎ"},{"start":624.523,"duration":2.40300000000002,"text":"여기가 엄청 맵다"},{"start":630.562,"duration":3.203999999999951,"text":"- 살짝만 찍었는데 너무 매운 거 아니에요? - 진짜 매운 거여서"},{"start":634.466,"duration":2.269999999999982,"text":"족발볶음밥은 누가 개발하신 거예요?"},{"start":636.736,"duration":3.0739999999999554,"text":"우리 이거... 체인이에요"},{"start":639.811,"duration":0.6269999999999527,"text":"체인이에요"},{"start":640.439,"duration":2.3360000000000127,"text":"- 상상도 못 했어... - 몇 군데 없어요!"},{"start":642.775,"duration":0.6220000000000709,"text":"대박이다"},{"start":643.398,"duration":1.7049999999999272,"text":"- 족발만 - 족발만"},{"start":645.104,"duration":2.875,"text":"다른 메뉴는 다 직접 하시는 거고"},{"start":647.98,"duration":2.40300000000002,"text":"- 족발볶음밥도 맵기를 정할 수 있어요? - 그렇지!"},{"start":650.383,"duration":2.2690000000000055,"text":"약간 매운맛 정도 먹으면 괜찮을 것 같은데?"},{"start":652.652,"duration":1.4349999999999454,"text":"- 약간 매운맛이요? - 예"},{"start":668.901,"duration":1.3670000000000755,"text":"감사합니다"},{"start":670.269,"duration":0.66599999999994,"text":"진짜 처음 봐요!"},{"start":670.936,"duration":1.7019999999999982,"text":"수많은 사이드를 봤지만"},{"start":672.638,"duration":3.06899999999996,"text":"맛있겠다, 족발 먹고 나니까 볶음밥 맛있겠네"},{"start":682.381,"duration":1.9020000000000437,"text":"짜장면 맛은 아닌데..."},{"start":684.283,"duration":2.7690000000000055,"text":"뭔가 짜장밥 같은 그런... 비슷한 맛인데?"},{"start":688.22,"duration":0.9349999999999454,"text":"올려서"},{"start":699.898,"duration":1.4349999999999454,"text":"맛있네!"},{"start":709.775,"duration":2.0020000000000664,"text":"이런 거 아세요? 힘줄?"},{"start":711.777,"duration":1.90199999999993,"text":"이게 또 포인트예요, 포인트"},{"start":773.972,"duration":0.7680000000000291,"text":"짤... 찰밥?"},{"start":774.74,"duration":1.6689999999999827,"text":"어! 찰밥 맛도 좀 난다!"},{"start":776.409,"duration":1.66700000000003,"text":"무슨 굉장히..."},{"start":778.677,"duration":2.002999999999929,"text":"흔한 맛은 아니에요"},{"start":780.68,"duration":2.369000000000028,"text":"먹으면 먹을수록 다른 맛이 계속 나"},{"start":783.049,"duration":1.8680000000000518,"text":"짜장 맛도 나고, 이 맛도 나고, 저 맛도 나고"},{"start":784.917,"duration":1.9349999999999454,"text":"이게 저기"},{"start":786.852,"duration":4.937999999999988,"text":"저 빨간 메뉴판에 있는 저 메뉴들을 시켜야만"},{"start":791.79,"duration":1.302000000000021,"text":"족발볶음밥을 먹을 수 있대요"},{"start":793.093,"duration":1.8240000000000691,"text":"안 그러면 고기 자투리가 안 남아서"},{"start":794.918,"duration":1.8439999999999372,"text":"수요가 안 돼서"},{"start":801.767,"duration":2.9699999999999136,"text":"철판에 해서 바닥에 밥이 눌어서"},{"start":804.737,"duration":1.9350000000000591,"text":"아주 눌러붙었어요 이렇게"},{"start":806.672,"duration":1.8009999999999309,"text":"안에 족발 껍데기가 조금씩 씹히는데"},{"start":808.473,"duration":1.7019999999999982,"text":"근데 이거 쫀득쫀득한데"},{"start":810.175,"duration":2.9700000000000273,"text":"밥도 쫀득쫀득해서 이거 잘 어울려!"},{"start":830.262,"duration":1.6350000000001046,"text":"어우 맛있게 잘 먹었다!"},{"start":831.897,"duration":2.835999999999899,"text":"계속 당기는 맛이네 이거"},{"start":834.733,"duration":1.9350000000000591,"text":"중독성 있어요!"},{"start":840.873,"duration":1.2349999999999,"text":"오늘은 조금만요"},{"start":842.108,"duration":1.9340000000000828,"text":"저희 먹고 회식하러 가요"},{"start":844.944,"duration":1.2000000000000455,"text":"- 맛있게 먹어요! - 네"},{"start":846.144,"duration":1.9020000000000437,"text":"- 맛있게 드셨어요? - 너무 맛있게 먹었습니다!"},{"start":848.047,"duration":2.369000000000028,"text":"고마워요-"},{"start":866.465,"duration":1.467999999999961,"text":"군 복무 하러 왔다가"},{"start":867.933,"duration":1.995999999999981,"text":"처음으로 여기 와서 먹고"},{"start":869.929,"duration":2.9429999999999836,"text":"그때 생각나서 다시 와서 먹고 간다고"},{"start":872.872,"duration":1.8350000000000364,"text":"진짜 독특한 맛이어서"},{"start":874.707,"duration":2.408999999999992,"text":"다른 데에서는 못 먹어볼 것 같은 맛이거든요"},{"start":877.116,"duration":1.69500000000005,"text":"너무 맛있더라고요"},{"start":879.145,"duration":1.9680000000000746,"text":"먹어줘서 저희가 고맙지요ㅎㅎ"},{"start":881.113,"duration":2.4689999999999372,"text":"저희가 감사합니다ㅎㅎ 맛있는 음식 해주셔서..."},{"start":883.582,"duration":1.8360000000000127,"text":"- 너무 맛있게 잘 먹었어요! - 고마워요~!"},{"start":885.418,"duration":1.5009999999999764,"text":"- 감사합니다 - 예"},{"start":886.919,"duration":1.4010000000000673,"text":"좀 간단하게 먹었는데"},{"start":888.32,"duration":2.4689999999999372,"text":"김치우동도 진짜 너무너무 맛있게 먹었고"},{"start":890.789,"duration":1.6680000000000064,"text":"진짜 이 족발볶음밥은"},{"start":892.457,"duration":2.1019999999999754,"text":"먹을수록 중독되는 그런 맛?"},{"start":894.559,"duration":3.4039999999999964,"text":"카페 음료도 너무 맛있게 잘 먹었고"},{"start":897.963,"duration":1.9020000000000437,"text":"전체적으로 아주 만족스럽게 먹었습니다!"},{"start":899.865,"duration":3.7029999999999745,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
