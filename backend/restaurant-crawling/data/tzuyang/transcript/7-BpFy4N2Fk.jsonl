680000000000007,"text":"위 보호를 살짝 해야 될 나이가 됐기 때문에"},{"start":79.892,"duration":2.298000000000002,"text":"가서 겔포스 하나 먹고 시작해야겠다"},{"start":82.19200000000001,"duration":0.9979999999999905,"text":"여기 있다"},{"start":84.75,"duration":1.5499999999999972,"text":"디지게매운돈까스"},{"start":87.43,"duration":1.9699999999999989,"text":"디진다돈까스랑 맵기가 똑같대요"},{"start":89.402,"duration":3.2379999999999995,"text":"과연 똑같은지 제가 가보도록 하겠습니다"},{"start":94.342,"duration":2.667999999999992,"text":"여기 있네"},{"start":97.012,"duration":3.337999999999994,"text":"여기 디진다 맛이 있고 양념 맛이 있거든요"},{"start":100.351,"duration":2.448999999999998,"text":") 디진다 맛이 오리지널 맛"},{"start":102.801,"duration":1.448999999999998,"text":") 양념 맛은 좀 덜 매운 맛이래요"},{"start":104.25200000000001,"duration":2.3479999999999848,"text":"여기 고추 2개 있고 여기 고추 10개 있어요"},{"start":107.6,"duration":1.3500000000000085,"text":"5배 매운가 보다"},{"start":108.952,"duration":2.1980000000000075,"text":"양념 맛 5개랑"},{"start":111.152,"duration":2.2379999999999995,"text":"디진다 맛 5개"},{"start":113.392,"duration":1.808000000000007,"text":"이거 뭐야? 방금 뭐 떴어"},{"start":115.202,"duration":2.1580000000000013,"text":"이것 봐"},{"start":142.252,"duration":4.807999999999993,"text":"귀여운데 되게 먹으면 힘들 것 같이 생겼다"},{"start":147.062,"duration":2.687999999999988,"text":"일단 제가 지금 아예 빈속이거든요"},{"start":150.6,"duration":1,"text":"약을 먹어야 돼"},{"start":152.5,"duration":2.1999999999999886,"text":"위장 보호를 위해"},{"start":154.702,"duration":0.9979999999999905,"text":"나이가 들었기 때문에"},{"start":159.9,"duration":1.5999999999999943,"text":"이게 이렇게 되어있네"},{"start":161.502,"duration":0.6680000000000064,"text":"여기"},{"start":162.172,"duration":1.4679999999999893,"text":"얘가 디진다 맛이고"},{"start":163.642,"duration":1.3079999999999927,"text":"얘가 양념 맛이에요"},{"start":164.952,"duration":1.7580000000000098,"text":"이렇게 누르면 들어가게 되어있거든요"},{"start":166.712,"duration":2.1680000000000064,"text":"다 구분이 되어있습니다"},{"start":168.882,"duration":1.9180000000000064,"text":"이 캐릭터가 요즘 인기래요"},{"start":170.802,"duration":1.3480000000000132,"text":"이건 귀엽지 않아요?"},{"start":172.152,"duration":2.3980000000000246,"text":"얘네 떼리앙이라고"},{"start":174.552,"duration":1.568000000000012,"text":"캐릭터가 진짜 많거든요"},{"start":176.122,"duration":3.0379999999999825,"text":"처음에 보자마자 되게 귀엽다고 생각했거든요"},{"start":179.65,"duration":1.3799999999999955,"text":"얘네가 이름이 다 있어요"},{"start":181.032,"duration":2.2680000000000007,"text":"얘가 딱 봐도 감자잖아요"},{"start":183.302,"duration":1.7980000000000018,"text":"그래서 얘 이름이 포떼링이고"},{"start":185.102,"duration":3.0979999999999848,"text":"얘가 치떼링, 치즈스틱"},{"start":188.202,"duration":1.5980000000000132,"text":"캐릭터가 진짜 많거든요"},{"start":190.77,"duration":2.3799999999999955,"text":"나중에 이거 피규어로 나오면 좋겠다"},{"start":193.152,"duration":0.9980000000000189,"text":"어린이 세트 하나에"},{"start":194.152,"duration":2.298000000000002,"text":"이거 랜덤으로 하나씩 나오면"},{"start":196.452,"duration":1.0980000000000132,"text":"그러면 다들"},{"start":197.552,"duration":1.5580000000000211,"text":"눈에 불을 켜고 먹을 것 같은데"},{"start":199.112,"duration":3.367999999999995,"text":"일단 당연히 양념 맛부터 먹어봐야지"},{"start":202.482,"duration":2.1680000000000064,"text":"색깔이 왜 이렇게 빨개?"},{"start":204.652,"duration":1.2280000000000086,"text":"안에 이렇게 4개 들어있어요"},{"start":205.882,"duration":3.367999999999995,"text":"매운 양념치킨 맛이라고 하는데 양념 맛이거든요"},{"start":209.252,"duration":1.3979999999999961,"text":"그래도 맵다고"},{"start":211.7,"duration":1.8000000000000114,"text":"제가 한번 먹어보겠습니다, 과연"},{"start":215.19,"duration":3.2700000000000102,"text":"냄새는 그냥 맛있는 냄새 나"},{"start":234.5,"duration":3.180000000000007,"text":"생긴 게 약간 치킨너깃이랑 비슷하게 생겨서"},{"start":237.68200000000002,"duration":2.737999999999971,"text":"약간 그런 맛일 거라고 생각하고 먹었는데"},{"start":240.422,"duration":2.397999999999996,"text":"안의 치킨너깃이랑 고기 느낌이 확 다르다"},{"start":254.63,"duration":1.7699999999999818,"text":"아직까지는 괜찮은데"},{"start":256.402,"duration":2.598000000000013,"text":"예전에 제가 디진다돈까스 먹었을 때는"},{"start":259.002,"duration":2.2379999999999995,"text":"양념이 너무 매워서"},{"start":261.242,"duration":3.537999999999954,"text":"'맛있다'라고 느끼기에는 너무 매웠는데"},{"start":264.782,"duration":2.867999999999995,"text":"얘는 매콤하게 맛있어요"},{"start":275.49,"duration":2.0299999999999727,"text":"그냥 맛있는데?"},{"start":277.522,"duration":1.698000000000036,"text":"매콤한 양념치킨 정도...?"},{"start":279.222,"duration":3.5680000000000405,"text":"이거 별거 아니지 않을까?"},{"start":283.43,"duration":1.9699999999999704,"text":"양념 맛 맛있어요, 하나만 더 먹겠습니다"},{"start":287.75,"duration":1.5,"text":"그냥 맛있어"},{"start":293.1,"duration":3.3700000000000045,"text":"양념 자체가 입에서 확 맵다기보다는"},{"start":296.472,"duration":2.8380000000000223,"text":"먹다 보면 혀가 알싸해지는 그런"},{"start":299.312,"duration":3.038000000000011,"text":"약간 후추 매운맛 같은 그런 맛이에요"},{"start":314.74,"duration":3.1100000000000136,"text":"약간"},{"start":317.852,"duration":4.27800000000002,"text":"지금 혀가 되게 알싸하거든요"},{"start":367.21,"duration":1.240000000000009,"text":"하... 쓰읍..."},{"start":368.452,"duration":2.4979999999999905,"text":"이게 매운 게 아니라 매운 게 쌓여서 그래요"},{"start":370.952,"duration":2.2479999999999905,"text":"그러면 하나 먹으면 '어 안 맵넹?'"},{"start":373.202,"duration":3.348000000000013,"text":"2개 먹으면 '꽤 매콤하넹'"},{"start":376.552,"duration":1.947999999999979,"text":"3개 먹으면 '엇 맵네...?ㅎ'"},{"start":378.502,"duration":4.95799999999997,"text":"4개 먹으니까 입이 약간 마비된 것 같아"},{"start":383.462,"duration":4.168000000000006,"text":"일단 양념 맛 5개로 워밍업 하고 디진다 맛 들어갈게요"},{"start":387.632,"duration":1.8380000000000223,"text":"돈가스가 생각보다 되게 묵직하네요"},{"start":389.472,"duration":2.3280000000000314,"text":"뭔가 안이 고기로 꽉 차있는 느낌이에요"},{"start":420.23,"duration":2.3999999999999773,"text":"소스만 살짝 드셔보실래요?"},{"start":422.632,"duration":1.5980000000000132,"text":"이따 하나 먹어보려고"},{"start":424.232,"duration":1.6679999999999495,"text":"- 디진다 맛으로? - ㅇㅇ"},{"start":425.902,"duration":2.937999999999988,"text":"왜냐하면 심지어 디진다돈까스 안 먹어봤거든"},{"start":428.842,"duration":1.3079999999999927,"text":"저도 안 먹어봤어요"},{"start":430.152,"duration":4.758000000000038,"text":"진짜 죽을 수도 있어요..."},{"start":434.912,"duration":2.538000000000011,"text":"이따 우리 애들 사다 줘야겠다"},{"start":437.452,"duration":2.268000000000029,"text"