{"youtube_link":"https://www.youtube.com/watch?v=ofR_0UIt_wo","channel_name":"tzuyang","language":"ko","collected_at":"2026-03-26T04:53:44.224+09:00","transcript":[{"start":33.109,"duration":1.3129999999999953,"text":"이거 너무 맛있다"},{"start":68.91,"duration":1.9070000000000107,"text":"안녕하세요 여러분"},{"start":70.818,"duration":1.0100000000000051,"text":"제가 오늘은"},{"start":71.83,"duration":2.340999999999994,"text":"지금 여기 홍콩섬에 있는"},{"start":74.173,"duration":2.930000000000007,"text":"이제 타이항이라는 지역에 왔는데"},{"start":77.104,"duration":1.9170000000000016,"text":"차찬텡을 먹으러 왔어요"},{"start":79.023,"duration":1.3530000000000086,"text":"홍콩식 아침 식사를"},{"start":80.378,"duration":1.5660000000000025,"text":"차찬텡이라고 부르는데"},{"start":81.946,"duration":1.5490000000000066,"text":"홍콩에서 진짜 유명한 게"},{"start":83.497,"duration":2.0720000000000027,"text":"밀크티랑 프렌치토스트잖아요!"},{"start":85.571,"duration":2.9080000000000013,"text":"프렌치토스트랑 밀크티랑 국수 이런"},{"start":88.481,"duration":1.7600000000000051,"text":"아침 식사들을 파는 곳이에요"},{"start":90.243,"duration":2.6580000000000155,"text":"여기가 거의 70년 정도 된 곳이거든요"},{"start":92.902,"duration":2.4450000000000074,"text":"관광객분들보다는 현지인분들이 많이 오시고"},{"start":95.348,"duration":2.6480000000000103,"text":"'Bing Kee Cha Dong'이라고 하는"},{"start":97.997,"duration":2.918999999999997,"text":"한국어로는 '빙키'라고 쓰더라고요"},{"start":100.917,"duration":2.774000000000001,"text":"야장에서 즐기는 분위기예요"},{"start":103.693,"duration":1.7550000000000097,"text":"그래서 완전 로컬 느낌이거든요"},{"start":105.449,"duration":1.816999999999993,"text":"직접 이렇게 또 열심히 찾아서"},{"start":107.268,"duration":1.813999999999993,"text":"아침밥을 먹으러 왔습니다"},{"start":109.083,"duration":4.067000000000007,"text":"지금 아침이라 웨이팅도 생겼는데, 인기도 굉장히 많은 곳 같아요"},{"start":113.152,"duration":1.3829999999999956,"text":"가보겠습니다"},{"start":114.536,"duration":3.4919999999999902,"text":"제가 생각하는 딱 노포 느낌의"},{"start":122.446,"duration":2.352000000000004,"text":"여기에 토핑이 계란도 있고"},{"start":124.8,"duration":1.5589999999999975,"text":"뭐 엄청 많이 있거든요"},{"start":126.36,"duration":3.2900000000000063,"text":"토스트가 혹시 어떤 종류가 있나요?"},{"start":129.652,"duration":3.369000000000028,"text":"연유, 피넛버터, 버터 총 세 가지가 있습니다"},{"start":133.023,"duration":1.2220000000000084,"text":"피넛버터가 제일 유명해요!"},{"start":134.247,"duration":3.462999999999994,"text":"면은 토핑이 어떤 종류가 인기가 많아요?"},{"start":137.712,"duration":4.376000000000005,"text":"햄, 닭 날개, 차슈가 인기가 제일 많아요!"},{"start":148.894,"duration":0.7939999999999827,"text":"안녕하세요!"},{"start":149.69,"duration":1.0649999999999977,"text":"오 안녕하세요!"},{"start":150.757,"duration":0.59699999999998,"text":"어머..."},{"start":151.356,"duration":2.1059999999999945,"text":"- 여길 어떻게 아시고...! - 아 저 여기요?"},{"start":153.464,"duration":1.2849999999999966,"text":"그... 어... 뭐... 어잇"},{"start":154.751,"duration":0.6479999999999961,"text":"찾다가...!"},{"start":155.401,"duration":1.2649999999999864,"text":"여기 많이 오세요?"},{"start":156.668,"duration":2.2309999999999945,"text":"- 저는 잠깐 여기 거주하고 있어서 - 그래요?"},{"start":158.901,"duration":2.908999999999992,"text":"감사합니다, 맛있게 드세요"},{"start":225.72,"duration":1.8839999999999861,"text":"계란프라이 맛있겠다"},{"start":227.606,"duration":3.2050000000000125,"text":"반숙으로 나와, 대박 사건"},{"start":230.813,"duration":1.6480000000000246,"text":"일단 여기 웨이팅이 있어요"},{"start":232.463,"duration":0.9840000000000089,"text":"장난 아니에요"},{"start":233.449,"duration":1.7519999999999811,"text":"비가 추적추적 떨어지는데"},{"start":235.203,"duration":2.116000000000014,"text":"아침부터 웨이팅이 엄청 길게 있거든요?"},{"start":237.321,"duration":1.3530000000000086,"text":"잘 먹겠습니다~!"},{"start":238.676,"duration":1.349000000000018,"text":"일단은"},{"start":246.227,"duration":1.6639999999999873,"text":"너무 익숙한 맛이에요"},{"start":247.893,"duration":2.3710000000000093,"text":"삼계탕이랑 갈비탕 섞은 맛"},{"start":250.266,"duration":1.4980000000000189,"text":"그 양저우볶음밥 있잖아요"},{"start":251.766,"duration":2.866000000000014,"text":"양저우볶음밥 먹으면 볶음밥인데 삼계탕 냄새 나잖아요"},{"start":254.63400000000001,"duration":1.1809999999999832,"text":"그거랑 약간 비슷해요"},{"start":257.413,"duration":2.058999999999969,"text":"한국인 입맛에 딱이다"},{"start":259.474,"duration":1.6270000000000095,"text":"삼계탕집 온 것 같아!"},{"start":261.103,"duration":3.0190000000000055,"text":"토핑은 2개 얹을 수 있고 추가할 수도 있는데"},{"start":264.124,"duration":2.895999999999958,"text":"일단 저는 계란 토핑으로 먼저 시켰습니다"},{"start":274.98199999999997,"duration":2.2420000000000186,"text":"라면에 계란 풀어 먹듯이 풀어 먹어볼까?"},{"start":277.226,"duration":3.269999999999982,"text":"과연 맛이 달라질까?"},{"start":282.894,"duration":2.089999999999975,"text":"오 엄청 고소해, 맛있어졌어"},{"start":284.986,"duration":3.4460000000000264,"text":"면은 우리가 아는 인스턴트 누들이에요, 라면"},{"start":316.466,"duration":2.3799999999999955,"text":"식감은 살짝 육개장이랑 비슷한데"},{"start":318.848,"duration":2.6850000000000023,"text":"조금 더 두꺼운 면을 써서"},{"start":321.535,"duration":1.700999999999965,"text":"라면을 만든 것 같아요"},{"start":323.238,"duration":1.7839999999999918,"text":"밀크티 하나 먹어보겠습니다"},{"start":325.024,"duration":2.5439999999999827,"text":"여기 밀크티가 색깔이 진짜 맛있어 보이거든요"},{"start":327.57,"duration":2.1170000000000186,"text":"보이세요?"},{"start":334.397,"duration":2.752999999999986,"text":"제가 홍콩 와서 사실 밀크티를 많이 못 먹었는데"},{"start":337.152,"duration":1.0610000000000355,"text":"와서 먹은 밀크티 중에..."},{"start":338.21500000000003,"duration":1.301999999999964,"text":"일단 1등이에요"},{"start":339.519,"duration":2.228999999999985,"text":"이런 밀크티 시키면 보통 안 달게 많이 나오더라고요"},{"start":341.75,"duration":1.7699999999999818,"text":"근데 저는 단 걸 좋아해서..."},{"start":343.522,"duration":2.386000000000024,"text":"설탕을 좀"},{"start":346.929,"duration":1.7660000000000196,"text":"맛있어"},{"start":348.697,"duration":2.8290000000000077,"text":"버터랑 피넛버터! 땅콩잼"},{"start":365.107,"duration":2.4879999999999995,"text":"이 2개가 진짜 잘 어울려요"},{"start":373.702,"duration":2.7719999999999914,"text":"약간 가볍고 되게 달아요"},{"start":382.908,"duration":2.2479999999999905,"text":"땅콩 맛이 엄청 세지 않고"},{"start":385.158,"duration":4.575999999999965,"text":"달짝지근하면서 약간 설탕 같은 그런 맛이 느껴져서"},{"start":389.736,"duration":1.275000000000034,"text":"오히려 제 취향이에요"},{"start":397.36,"duration":0.9359999999999786,"text":"좋다"},{"start":407.565,"duration":2.915999999999997,"text":"여기 양상추가 안에 크게 들어가 있거든요...?"},{"start":410.483,"duration":1.103999999999985,"text":"나 줘!"},{"start":411.589,"duration":1.9220000000000255,"text":"진짜로 많긴 많아"},{"start":413.513,"duration":4.310000000000002,"text":"감사합니다, 양상추를 제외해 달라고 말씀드려야 될 거 같아요"},{"start":431.777,"duration":0.8050000000000068,"text":"면이"},{"start":432.584,"duration":1.1539999999999964,"text":"쫄깃쫄깃한 면은 아니고요"},{"start":433.74,"duration":2.464999999999975,"text":"약간 뚝뚝 끊기는 그런 식감의 면이에요"},{"start":436.207,"duration":1.8269999999999982,"text":"국물에 계란 풀어 먹어도 맛있어요"},{"start":438.036,"duration":1.507000000000005,"text":"국물 자체가 되게 고소해져요"},{"start":441.92,"duration":1.5369999999999777,"text":"되게 잘 어울려요, 고소해요"},{"start":451.413,"duration":2.61099999999999,"text":"여기는 가장 인기 메뉴가..."},{"start":454.026,"duration":4.175000000000011,"text":"돼지갈비랑 닭 날개가 들어간 국수가 가장 인기 메뉴거든요"},{"start":458.203,"duration":3.1850000000000023,"text":"진짜 홍콩 음식 다 입에 너무 맞고 맛있게 잘 먹는데"},{"start":461.39,"duration":2.809000000000026,"text":"딱 항상 안 맞았던 게..."},{"start":464.201,"duration":0.9869999999999663,"text":"돼지갈비거든요"},{"start":465.19,"duration":1.1100000000000136,"text":"닭 날개랑"},{"start":466.302,"duration":1.88900000000001,"text":"일단 그러면 면에 넣지 말고"},{"start":468.193,"duration":1.3940000000000055,"text":"따로 부탁을 드려서"},{"start":469.589,"duration":3.2560000000000286,"text":"접시에 받아서 이렇게 따로 한번 먹어볼게요"},{"start":477.036,"duration":1.9359999999999786,"text":"이 국수는 똑같은 국수고"},{"start":478.974,"duration":3.4680000000000177,"text":"요게 갈비인데..."},{"start":490.688,"duration":2.6680000000000064,"text":"난다..."},{"start":493.358,"duration":2.6569999999999823,"text":"표현할 수가 없는데 무슨 약간 향이 있거든요?"},{"start":496.017,"duration":3.1170000000000186,"text":"근데 그게 들어간 거치고 굉장히 먹을만하다"},{"start":499.136,"duration":1.4659999999999513,"text":"1접시 먹을 수 있을 것 같아요"},{"start":500.604,"duration":1.9050000000000296,"text":"이게 어디 어디 있었냐면요"},{"start":510.135,"duration":2.616999999999962,"text":"근데 얘는 들어간 것치곤 괜찮은 것 같아"},{"start":521.646,"duration":1.6410000000000764,"text":"고추기름을 넣어 먹으면"},{"start":523.289,"duration":2.022000000000048,"text":"콩나물국 맛이 난다고"},{"start":526.717,"duration":1.0249999999999773,"text":"좋아요"},{"start":527.743,"duration":2.2329999999999472,"text":"지금은 삼계탕 맛인데"},{"start":531.326,"duration":1.1269999999999527,"text":"과연 어떤 맛일지"},{"start":535.535,"duration":1.7939999999999827,"text":"어 약간 라면 같아졌는데?"},{"start":545.283,"duration":1.975999999999999,"text":"육개장이다, 육개장!"},{"start":547.261,"duration":1.2870000000000346,"text":"육개장이다!"},{"start":548.55,"duration":2.1380000000000337,"text":"면이 조금 안 어울린다고 생각했거든요?"},{"start":550.689,"duration":1.5,"text":"근데 요걸 넣으니까"},{"start":552.19,"duration":3.2329999999999472,"text":"면이랑 국물이 완벽하게 잘 어울리는 마법이 일어나요"},{"start":566.658,"duration":2.0610000000000355,"text":"한 요만큼만 더 넣어볼게요"},{"start":581.892,"duration":3.6369999999999436,"text":"국물이 진짜 원샷 하고 싶은 그런 얼큰함이다"},{"start":589.537,"duration":1.0960000000000036,"text":"토핑 종류, 닭고기"},{"start":590.635,"duration":4.312999999999988,"text":"소시지, 차슈, 소고기, 계란, 햄, 내장, 채소"},{"start":594.949,"duration":2.591000000000008,"text":"이번에는 햄이 좀 궁금합니다"},{"start":597.5409999999999,"duration":2.0830000000000837,"text":"햄 토핑으로...!"},{"start":599.626,"duration":0.6399999999999864,"text":"ㅇㅋㅇㅋ"},{"start":600.267,"duration":2.0419999999999163,"text":"대단하셔...ㅎ"},{"start":602.31,"duration":1.9740000000000464,"text":"여기 밀크티가 진짜 맛있다"},{"start":604.286,"duration":1.9480000000000928,"text":"엄청 그 우유..."},{"start":606.236,"duration":1.594000000000051,"text":"굉장히 진하고 크리미하고"},{"start":607.832,"duration":1.7720000000000482,"text":"약간, 약간"},{"start":609.606,"duration":1.8880000000000337,"text":"믹스커피 있잖아요"},{"start":611.496,"duration":2.75,"text":"물 탄 게 있고 '약간' 살짝 우유 탄 맛이 있잖아요"},{"start":614.247,"duration":0.8790000000000191,"text":"약간"},{"start":615.127,"duration":1.5650000000000546,"text":"그런 것 중에서 '약간'"},{"start":616.694,"duration":1.441000000000031,"text":"좀 이렇게 가벼운 '약간'"},{"start":618.137,"duration":2.04200000000003,"text":"좀 진한? 굉장히 좀 크리미한?"},{"start":631.6,"duration":1.0480000000000018,"text":"맛있겠다"},{"start":632.65,"duration":2.4329999999999927,"text":"햄, 햄, 햄"},{"start":635.0840000000001,"duration":1.2659999999999627,"text":"햄라면"},{"start":643.072,"duration":2.8719999999999573,"text":"홍콩분께서 알아보셨어요, 뿌듯!"},{"start":645.945,"duration":1.74899999999991,"text":"잘 모르실 줄 알았는데!"},{"start":647.695,"duration":3.2199999999999136,"text":"냉정하게 맛 평가, 과연 한국이랑 똑같은지!"},{"start":650.9159999999999,"duration":1,"text":"먹어보겠습니다"},{"start":655.34,"duration":2.1649999999999636,"text":"첫맛은 똑같아"},{"start":657.507,"duration":2.0470000000000255,"text":"스팸이랑..."},{"start":659.555,"duration":2.344000000000051,"text":"분홍햄 소시지랑 섞었어요"},{"start":661.901,"duration":3.171000000000049,"text":"약간 씹으면 씹을수록 뒤쪽에 그"},{"start":665.074,"duration":2.858000000000061,"text":"분홍햄 소시지 맛이 약간 같이 나요"},{"start":673.886,"duration":2.58400000000006,"text":"면은 확실한 건 이걸 넣어야 맛있어요"},{"start":677.805,"duration":1.1700000000000728,"text":"이번엔 진짜 많이 넣었어"},{"start":689.731,"duration":2.552000000000021,"text":"아까가 적당해, 너무 많이 넣었어..."},{"start":711.574,"duration":1.4279999999999973,"text":"밀크티 원 모어..."},{"start":713.003,"duration":2.6409999999999627,"text":"어멈머... 대단혀"},{"start":724.606,"duration":1.6639999999999873,"text":"토스트와 밀크티 하나에"},{"start":726.271,"duration":1.6180000000000518,"text":"국수에 고추기름 넣어서 딱 먹으면"},{"start":727.891,"duration":1.9650000000000318,"text":"진짜 아침 식사로 끝장이에요"},{"start":743.18,"duration":2.1030000000000655,"text":"이거 밀크티 따듯한 버전도 한번 먹어볼까?"},{"start":745.285,"duration":2.937000000000012,"text":"그리고 밀크티랑 커피랑 섞은 버전도 있대요"},{"start":748.223,"duration":1.2100000000000364,"text":"그것도 궁금하다"},{"start":757.21,"duration":1.26299999999992,"text":"줄이 없었다고 생각했는데"},{"start":758.474,"duration":2.411999999999921,"text":"또 웨이팅이 생겼습니다"},{"start":760.887,"duration":2.341000000000008,"text":"빨리 먹어야겠다"},{"start":763.229,"duration":3.2539999999999054,"text":"워침이니까 간단하게 국수 하나만 더 먹을게요!"},{"start":766.484,"duration":0.8079999999999927,"text":"보이테이?"},{"start":767.294,"duration":2.0650000000000546,"text":"보이? 보이? 버들? 보리?"},{"start":769.361,"duration":0.7690000000000055,"text":"보레? 버레이!"},{"start":770.132,"duration":2.577000000000112,"text":"님 최고하셔..."},{"start":772.71,"duration":0.80499999999995,"text":"너무 놀랐어요..."},{"start":773.516,"duration":1.120999999999981,"text":"남자도 안 돼요"},{"start":774.638,"duration":2.06899999999996,"text":"4그릇이라니..."},{"start":776.7090000000001,"duration":2.463999999999942,"text":"와 잘 먹겠습니다!"},{"start":779.175,"duration":0.88900000000001,"text":"다른 맛으로!"},{"start":780.065,"duration":1.9599999999999227,"text":"어떤 게 가장 맛있는지 볼 거예요"},{"start":782.026,"duration":1.9569999999999936,"text":"이 정도 넣고"},{"start":783.984,"duration":2.466000000000008,"text":"계란을 풀어서"},{"start":788.22,"duration":2.536999999999921,"text":"매콤 계란 국물 버전"},{"start":795.717,"duration":1.7989999999999782,"text":"얘는 딱 반반이다 뭔가"},{"start":797.517,"duration":3.1509999999999536,"text":"한국인분들 약간 한국이이이인"},{"start":800.67,"duration":2.080000000000041,"text":"약간 대중적인 입맛으로 따지자면"},{"start":802.752,"duration":2.618000000000052,"text":"계란 안 풀고 맑은 국물에"},{"start":805.372,"duration":1.719000000000051,"text":"기름은 많이 넣지 말고"},{"start":807.093,"duration":3.3070000000000164,"text":"건더기 이런 거 많이 넣어서 해 먹는 게"},{"start":810.401,"duration":1.1000000000000227,"text":"가장 맛있을 것 같아요"},{"start":837.52,"duration":0.9790000000000418,"text":"잉여? 잉어?"},{"start":838.501,"duration":1.3330000000000837,"text":"인여? 인유?"},{"start":839.835,"duration":1.655999999999949,"text":"아..."},{"start":854.724,"duration":2.4849999999999,"text":"와 이건 달게 해주셨다, 맛있다!"},{"start":860.668,"duration":1.282000000000039,"text":"이거 너무 맛있다!"},{"start":861.952,"duration":2.0170000000000528,"text":"다방커피 있잖아요, 밀크커피"},{"start":863.971,"duration":1.4629999999999654,"text":"그거랑 진짜 비슷한데"},{"start":865.435,"duration":2.4820000000000846,"text":"거기다 밀크티 향을 살짝 한 방울 섞었어요"},{"start":867.919,"duration":2.0130000000000337,"text":"제 아까 발음 들으셨죠?"},{"start":869.934,"duration":1.8330000000000837,"text":"그대로 주문하시면 됩니다"},{"start":872.988,"duration":1.4539999999999509,"text":"뭐였지?ㅎ"},{"start":874.444,"duration":1.5579999999999927,"text":"인율"},{"start":883.557,"duration":2.163000000000011,"text":"최고다, 최고..."},{"start":885.722,"duration":1.8000000000000682,"text":"여기 햄이 있어요"},{"start":887.524,"duration":2.506999999999948,"text":"이 햄은 아침에 우리가 먹는"},{"start":890.032,"duration":1.5919999999999845,"text":"식빵에 넣어 먹는 그 슬라이스 햄 같은데"},{"start":891.626,"duration":1.1689999999999827,"text":"저 이거 진짜 좋아하거든요?"},{"start":896.45,"duration":1.0199999999999818,"text":"얜 똑같다"},{"start":917.618,"duration":2.548999999999978,"text":"개인적인 취향으로는"},{"start":920.169,"duration":2.0190000000000055,"text":"맑은 국물에"},{"start":922.189,"duration":1.8810000000000855,"text":"요거 타 먹는 게 가장 맛있어요"},{"start":924.072,"duration":2.7859999999999445,"text":"전 마지막으로 그거 하나 먹고 마치겠습니다"},{"start":929.216,"duration":1.7730000000000246,"text":"토핑을 안 얹으니까 그냥 라면이네요"},{"start":931.896,"duration":1.1890000000000782,"text":"라면 1그릇"},{"start":933.087,"duration":2.538000000000011,"text":"근데 홍콩은 합석하는 게 굉장히 많은 것 같아요"},{"start":935.627,"duration":1.4420000000000073,"text":"여기 1명 앉으면 여기"},{"start":937.07,"duration":1.4470000000000027,"text":"2명 또 합석하고"},{"start":938.519,"duration":1.6620000000000346,"text":"3명도 합석할 수 있고 약간..."},{"start":940.183,"duration":2.3980000000000246,"text":"웨이팅이 있는 밥집들이 워낙 많다 보니까"},{"start":942.583,"duration":1.9260000000000446,"text":"약간 합석하는 게 문화가 돼서"},{"start":944.511,"duration":1.9220000000000255,"text":"분위기가 굉장히 좋습니다"},{"start":946.435,"duration":1.0990000000000464,"text":"넣어줍니다"},{"start":947.93,"duration":1.2700000000000955,"text":"섞어서"},{"start":950.271,"duration":1.5410000000000537,"text":"맛있게 먹으면 끝"},{"start":990.43,"duration":2.84800000000007,"text":"또요...?"},{"start":996.68,"duration":1.0400000000000773,"text":"NINE"},{"start":998.671,"duration":1.4029999999999063,"text":"와, 밑에 시럽 보이세요?"},{"start":1000.075,"duration":3.1509999999999536,"text":"제가 설탕을 이만큼씩 뿌려 먹으니까"},{"start":1003.228,"duration":1.79200000000003,"text":"시럽을 이렇게 많이 주셨어요"},{"start":1009.5889999999999,"duration":1.9180000000000064,"text":"고기는 죄송합니다"},{"start":1011.508,"duration":3.1059999999999945,"text":"식으니까 제가 못 먹는 향신료가 확 올라와서"},{"start":1014.616,"duration":2.5750000000000455,"text":"아... 1잔 더..."},{"start":1017.193,"duration":1.01400000000001,"text":"이런 사람 본 적도 없어요..."},{"start":1018.2090000000001,"duration":2.0159999999999627,"text":"맛있어요!"},{"start":1020.227,"duration":1.5919999999999845,"text":"감사합니다"},{"start":1021.82,"duration":2.991999999999848,"text":"마지막 10잔째는 포장해 가도록 하겠습니다"},{"start":1024.813,"duration":0.9989999999997963,"text":"밀크티가 진짜 맛있었어요"},{"start":1025.813,"duration":2.675999999999931,"text":"밀크티가 좀 진하고 좀 더 약간..."},{"start":1028.491,"duration":1.1089999999999236,"text":"크리미하다고 해야 되나?"},{"start":1029.601,"duration":1.856999999999971,"text":"차찬텡이"},{"start":1031.46,"duration":1.0609999999999218,"text":"- - 원래 이제 홍콩식"},{"start":1032.522,"duration":1.3940000000000055,"text":"- - 아침 식사래요"},{"start":1033.917,"duration":1.4850000000001273,"text":"- - 이런 메뉴들이"},{"start":1035.404,"duration":0.8369999999999891,"text":"- - 있다고 하는데"},{"start":1041.149,"duration":1.6710000000000491,"text":"기념품으로 이렇게 주시나 봐요"},{"start":1043.212,"duration":5.009999999999991,"text":"오늘도 잘 먹었습니다~!"}],"recollect_id":0,"recollect_vars":["new_video"],"collector_source":"yt-dlp"}
