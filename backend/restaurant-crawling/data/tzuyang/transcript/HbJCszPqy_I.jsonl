00009,"text":"맛있어요..."},{"start":1175.632,"duration":3.1979999999998654,"text":"저 진짜 냉정하게 말한 거예요..."},{"start":1192.79,"duration":2.4600000000000364,"text":"진짜 샌드위치 먹을 때 사실... 이런 거 막"},{"start":1195.252,"duration":5.268000000000029,"text":"매콤 치킨양념 들어간 샌드위치 먹잖아요"},{"start":1200.522,"duration":1.5679999999999836,"text":"그냥 그런 느낌이에요!"},{"start":1202.091,"duration":3.0690000000001874,"text":"안 어울린다거나 이질감이 있다거나 그런 건 없어요"},{"start":1205.162,"duration":3.5389999999999873,"text":"근데 이거랑은 안 어울리지 않을까?"},{"start":1208.703,"duration":1.1469999999999345,"text":"이건 달아요"},{"start":1210.3,"duration":2.7999999999999545,"text":"단 거에다 참깨소스 조합"},{"start":1213.101,"duration":1.9249999999999545,"text":"이 정도면 안 어울리는 걸 찾아야 해"},{"start":1222.99,"duration":4.460000000000036,"text":"역시나 맛있어"},{"start":1227.452,"duration":1.4980000000000473,"text":"아니 왜 맛있냐고...!"},{"start":1228.952,"duration":1.6479999999999109,"text":"진짜 맛있어요"},{"start":1230.601,"duration":1.9989999999997963,"text":"잘 어울리지?"},{"start":1232.601,"duration":1.7109999999997854,"text":"왜 맛있는지 모르겠어"},{"start":1238.39,"duration":2.769999999999982,"text":"건강이나 다이어트를 위해서 건강 호밀빵"},{"start":1241.162,"duration":1.6579999999999018,"text":"잼은 좀 부담스럽고 할 때"},{"start":1242.8220000000001,"duration":4.007999999999811,"text":"마라곤약젤리를 얹어서 먹으면 굉장히 자극적이고 맛있어져요"},{"start":1249.45,"duration":1.5,"text":"저게 뭐야ㅋㅋ"},{"start":1250.952,"duration":2.048000000000002,"text":"배달을 시켰는데..."},{"start":1253.002,"duration":3.3780000000001564,"text":"출장 배달이 나왔습니다, 감사합니다"},{"start":1257.691,"duration":1.3329999999998563,"text":"감사합니다"},{"start":1259.78,"duration":1.4700000000000273,"text":"진짜 맛있겠다"},{"start":1261.252,"duration":3.367999999999938,"text":"배달 음식으로 이렇게 맛있게..."},{"start":1264.621,"duration":1.7989999999999782,"text":"잘 먹겠습니다, 감사합니다ㅎ"},{"start":1269.38,"duration":2.0799999999999272,"text":"와 진짜 맑거든요?"},{"start":1271.462,"duration":0.9980000000000473,"text":"진짜 맛있다..."},{"start":1272.462,"duration":1.4980000000000473,"text":"닭고기 육수라서"},{"start":1273.962,"duration":2.2380000000000564,"text":"진짜 기름기 같은 거 하나 없고"},{"start":1276.202,"duration":3.52800000000002,"text":"너무 깔끔하고 담백한데"},{"start":1279.732,"duration":1.9680000000000746,"text":"안에 감칠맛 진짜 제대로 있어요!"},{"start":1291.002,"duration":1.2480000000000473,"text":"감사합니다"},{"start":1303.69,"duration":2.0699999999999363,"text":"와 이거 진짜 맛있다!"},{"start":1305.762,"duration":2.02800000000002,"text":"엄청 달짝지근한데"},{"start":1307.792,"duration":1.9380000000001019,"text":"겉에"},{"start":1309.732,"duration":2.268000000000029,"text":"소스 코팅이 진짜 기가 막히게 되어있어요!"},{"start":1312.002,"duration":1.0850000000000364,"text":"내가 봤을 때"},{"start":1314.57,"duration":1.900000000000091,"text":"잠만 나 몇 개 먹은 거야? 하나, 둘"},{"start":1316.472,"duration":2.286000000000058,"text":"다 먹은 거는 하나, 둘, 셋, 넷"},{"start":1318.76,"duration":1.099999999999909,"text":"다섯, 여섯, 일곱, 여덟"},{"start":1319.861,"duration":1.1489999999998872,"text":"9개고요"},{"start":1321.012,"duration":2.8680000000001655,"text":"뜯어서 먹는 것까지 하면"},{"start":1323.882,"duration":1.3279999999999745,"text":"10개 먹었어요ㅎ"},{"start":1325.212,"duration":1.788000000000011,"text":"이건 안 어울릴 수가 없어요"},{"start":1327.002,"duration":2.3859999999999673,"text":"제가 봤을 땐 무조건 더 맛있어"},{"start":1339.15,"duration":1.5809999999999036,"text":"이거 시켜서"},{"start":1341.356,"duration":1.7010000000000218,"text":"반 정도 다 먹고"},{"start":1343.059,"duration":2.341000000000122,"text":"나머지 반에 얘를 넣어서"},{"start":1345.402,"duration":3.897999999999911,"text":"마라쌀국수 만들어 먹으면 마라탕 먹는 거처럼 진짜 맛있거든요"},{"start":1369.96,"duration":2.769999999999982,"text":"피자"},{"start":1372.732,"duration":2.367999999999938,"text":"여기도 되게 유명한 가게인데"},{"start":1375.101,"duration":3.328999999999951,"text":"여기는 페퍼로니피자 유명하대요"},{"start":1378.9,"duration":1.6889999999998508,"text":"일단 쌀국수 먼저 먹고"},{"start":1380.591,"duration":1.2550000000001091,"text":"닫아놔 봐"},{"start":1388.6,"duration":1.956000000000131,"text":"마라 얼얼함이 그대로 올라온다"},{"start":1423.65,"duration":2.1699999999998454,"text":"불 향 엄청 많이 나"},{"start":1432.89,"duration":4.12999999