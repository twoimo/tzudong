.4350000000000023,"text":"이게 진짜 테라 슬러시 생맥주 전용 기계예요"},{"start":100.607,"duration":2.9639999999999986,"text":"원래처럼 생맥주를 따르고"},{"start":103.572,"duration":3.367999999999995,"text":"그다음에 그 위에 이 슬러시거품을 얹는 거래요"},{"start":106.941,"duration":3.23599999999999,"text":"오늘 날씨가 딱 봐도 더워 보이지 않나요?"},{"start":110.178,"duration":3.068000000000012,"text":"슬러시 생맥주 먹으면서 싹 내리도록 하겠습니다"},{"start":113.247,"duration":1.4009999999999962,"text":"여기 메뉴가"},{"start":114.649,"duration":1.4660000000000082,"text":"딱 맥주 메뉴"},{"start":116.116,"duration":2.035000000000011,"text":"맥주랑 먹을 수 있는 메뉴가 완전"},{"start":118.152,"duration":5.070999999999998,"text":"일단은 골뱅이랑 마늘치킨은 무조건 먹어줘야 되고"},{"start":123.224,"duration":2.810999999999993,"text":"나머지, 계란말이 이런 것도 맛있겠다"},{"start":126.036,"duration":1.5919999999999987,"text":"이것저것 시켜보겠습니다"},{"start":127.629,"duration":1.4669999999999987,"text":"그리고 맥주..."},{"start":129.397,"duration":1.7010000000000218,"text":"당연히 먹어야죠"},{"start":131.099,"duration":2.568000000000012,"text":"'테라 슬러시 생맥주' 1잔 주세요!"},{"start":151.541,"duration":1.3449999999999989,"text":"감사합니다"},{"start":152.887,"duration":1.445999999999998,"text":"진짜 슬러시처럼 생겼네"},{"start":154.334,"duration":2.0219999999999914,"text":"완전 신기하지 않아요? 대박이다"},{"start":156.357,"duration":2.5020000000000095,"text":"슬러시 먼저 한번 먹어보겠습니다, 신기해"},{"start":164.031,"duration":1.6329999999999814,"text":"진짜 슬러시야..."},{"start":165.666,"duration":2.5330000000000155,"text":"근데 일반 슬러시는 얼음이라서"},{"start":168.201,"duration":2.0670000000000073,"text":"바로 사르르 녹지 않잖아요"},{"start":170.27,"duration":1.8349999999999795,"text":"얘는 슬러시 식감인데..."},{"start":172.105,"duration":2.436000000000007,"text":"거품이라서 사르르 녹아내리거든요"},{"start":180.28,"duration":0.9339999999999975,"text":"맛있는데?"},{"start":192.526,"duration":2.4669999999999845,"text":"와 목구멍이 열리는 느낌이야..."},{"start":194.995,"duration":4.869,"text":"엄청 시원한 얼음이 되기 직전의 맥주를 먹으면"},{"start":199.86599999999999,"duration":4.102000000000004,"text":"여기 타고 흘러내리는 목구멍이 엄청 시원해지잖아요"},{"start":203.97,"duration":1.33500000000