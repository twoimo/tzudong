#!/bin/bash -p
# Gemini CLI wrapper: execute a verified CLI without exposing provider stderr.
umask 077

# The heredoc below consumes standard input. Keep the caller's descriptor open
# for the supervised child before starting the isolated Python supervisor.
if ! exec 3<&0; then
    printf '%s\n' 'GEMINI_WRAPPER_INTERNAL_ERROR' >&2
    exit 126
fi

# Do not permit Python bootstrap settings from the wrapper's caller to affect
# the fixed supervisor. -I is the enforcement boundary; unsetting also keeps
# these values out of subprocess diagnostics and compatibility paths.
unset BASH_ENV ENV CDPATH
unset PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE PYTHONINSPECT
unset PYTHONWARNINGS PYTHONSAFEPATH PYTHONPLATLIBDIR PYTHONEXECUTABLE
unset PYTHONCASEOK PYTHONNOUSERSITE PYTHONHASHSEED

if [ ! -x /usr/bin/python3 ]; then
    printf '%s\n' 'GEMINI_WRAPPER_INTERNAL_ERROR' >&2
    exit 126
fi

exec /usr/bin/python3 -I - "$0" "$@" 0<<'PY'
