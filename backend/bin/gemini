    fcntl = None  # type: ignore[assignment]
    resource = None  # type: ignore[assignment]


STDERR_CAP_BYTES = 64 * 1024
CREDENTIAL_CAP_BYTES = 256 * 1024
EXECUTABLE_CAP_BYTES = 64 * 1024 * 1024
READ_CHUNK_BYTES = 8192
MAX_ROTATIONS = 8
MAX_GENERATION_RETRIES = 8
MAX_CREDENTIAL_DIRECTORY_ENTRIES = 256
LOCK_RETRY_SECONDS = 0.05
TERMINATE_GRACE_SECONDS = 1.0
CLEANUP_RESERVE_SECONDS = 0.2
TERMINATION_RESERVE_SECONDS = min(TERMINATE_GRACE_SECONDS, CLEANUP_RESERVE_SECONDS)
ORPHAN_REAP_GRACE_SECONDS = 0.05
READER_CLEANUP_RESERVE_SECONDS = 0.05
DEFAULT_WALL_TIMEOUT_SECONDS = 120.0
MAX_WALL_TIMEOUT_SECONDS = 120.0
TRUSTED_CHILD_PATH = "/usr/bin:/bin"
SAVED_STDIN_FD = 3

# These are the only caller-provided values the Gemini CLI can receive. They
# are Gemini/Google authentication or Gemini CLI configuration knobs; wrapper
# controls, runtime hooks, language hooks, and service/database settings are
# deliberately not inherited.
