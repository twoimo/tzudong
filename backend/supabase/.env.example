# Local-only Supabase stack template.
# Generate the real 0600 stack.env with scripts/local-stack.py; never copy cloud secrets here.
PROJECT_NAME=tzudong-local-example
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace-with-generated-local-value
NIGHTLY_ADMIN_EMAIL=nightly-ci@local.invalid
NIGHTLY_ADMIN_PASSWORD=replace-with-generated-local-password
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000
META_PORT=5555
ANALYTICS_PORT=4000
MAIL_SMTP_PORT=2500
MAIL_WEB_PORT=9000
MAIL_POP3_PORT=1100
SITE_URL=http://127.0.0.1:3000
API_EXTERNAL_URL=http://127.0.0.1:8000
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
ANON_KEY=replace-with-generated-local-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-local-service-jwt
JWT_SECRET=replace-with-generated-local-secret
LOCAL_INPUT_ROOT=/absolute/path/to/generated/local-inputs
NIGHTLY_LOCAL_ENV_ONLY=1
NIGHTLY_ENV_FILE_ONLY=1
NODE_ENV=test
# SUPABASE_DB_URL belongs in the generated nightly env only and must use 127.0.0.1.
