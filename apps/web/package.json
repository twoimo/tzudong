    "analyze": "set ANALYZE=true&& next build --webpack",
    "supabase:gen-types": "node scripts/supabase-gen-types.mjs",
    "test:unit": "bun test tests-unit",
    "test:responsive": "node scripts/run-responsive-tests.mjs",
    "dev:webpack": "node scripts/clean-next.mjs --skip-clean -- node node_modules/next/dist/bin/next dev --webpack --port 8080",
    "dev:webpack:clean": "node scripts/clean-next.mjs -- node node_modules/next/dist/bin/next dev --webpack --port 8080",
    "bench:dev": "node scripts/measure-dev-compile.mjs",
    "bench:routes": "node scripts/measure-dev-routes.mjs",
    "bench:compare": "node scripts/compare-dev-route-reports.mjs"
