{
  "name": "web",
  "version": "1.1.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev-prewarm.mjs --port 8080",
    "dev:clean": "node scripts/clean-next.mjs -- node node_modules/next/dist/bin/next dev --webpack --port 8080",
    "dev:playwright": "node scripts/clean-next.mjs -- node node_modules/next/dist/bin/next dev --webpack --port 8080",
    "build": "node scripts/clean-next.mjs -- node node_modules/next/dist/bin/next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "start:playwright": "node scripts/start-standalone.mjs --port 8080 --hostname localhost",
    "lint": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "analyze": "set ANALYZE=true&& next build --webpack",
    "supabase:gen-types": "node scripts/supabase-gen-types.mjs",
    "test:unit": "bun test tests-unit",
    "test:responsive": "node scripts/run-responsive-tests.mjs",
    "dev:webpack": "node scripts/clean-next.mjs --skip-clean -- node node_modules/next/dist/bin/next dev --webpack --port 8080",
    "dev:webpack:clean": "node scripts/clean-next.mjs -- node node_modules/next/dist/bin/next dev --webpack --port 8080",
    "dev:turbopack": "node scripts/dev-prewarm.mjs --port 8080 --turbopack",
    "bench:dev": "node scripts/measure-dev-compile.mjs",
    "bench:routes": "node scripts/measure-dev-routes.mjs",
    "bench:compare": "node scripts/compare-dev-route-reports.mjs",
    "dev:thumbnail-ready": "node scripts/dev-thumbnail-ready.mjs",
    "storyboard:image-proof": "python3 scripts/codex-imagegen-storyboard-provider.py --prove --proof-file .omx/artifacts/gpt-image-2-provenance/latest-verified.json --output-dir .omx/artifacts/gpt-image-2-provenance/latest-proof",
    "thumbnail:release-certify": "node scripts/thumbnail-release-readback-certification.mjs",
    "storyboard:quality-loop": "node scripts/storyboard-quality-loop.mjs",
    "storyboard:local-bridge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/storyboard-local-bridge.ts",
    "storyboard:eight-real-smoke": "bun scripts/storyboard-eight-real-provider-smoke.ts",
    "storyboard:rag-ollama-pull": "node scripts/storyboard-rag-ollama-pull.mjs"
  },
