  "scripts": {
    "dev": "node scripts/dev-prewarm.mjs --port 8080",
    "dev:clean": "node scripts/clean-next.mjs -- node node_modules/next/dist/bin/next dev --port 8080",
    "dev:playwright": "node scripts/clean-next.mjs --skip-clean -- node node_modules/next/dist/bin/next dev --port 8080",
    "build": "node scripts/clean-next.mjs -- node node_modules/next/dist/bin/next build",
