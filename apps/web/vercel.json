{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["icn1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": false,
      "develop": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs"
}
