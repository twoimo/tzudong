diff --git a/apps/web/tests-unit/restaurant-detail-query-functions.test.ts b/apps/web/tests-unit/restaurant-detail-query-functions.test.ts
new file mode 100644
index 00000000..130814de
--- /dev/null
+++ b/apps/web/tests-unit/restaurant-detail-query-functions.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, test } from 'bun:test';
+import type { Restaurant } from '../types/restaurant';
+import { restaurantDetailQueries } from '../lib/restaurant-detail-query-functions';
+import type { supabase } from '../integrations/supabase/client';
+
+const restaurantId = '00000000-0000-4000-8000-000000000001';
+const userId = '00000000-0000-4000-8000-000000000002';
+const restaurant = { id: restaurantId, name: '실험 맛집', approved_name: '실험 맛집',
+    lat: 37.5, lng: 127, categories: ['한식'], road_address: '실험 주소' } as Restaurant;
+const review = { id: '00000000-0000-4000-8000-000000000003', restaurant_id: restaurantId,
+    user_id: userId, content: '합성 리뷰', visited_at: '2026-10-01', created_at: '2026-10-01',
+    food_photos: [], categories: ['한식'], is_verified: true, is_pinned: false,
+    is_edited_by_admin: false, admin_note: null, like_count: 2 };
+type Call = { table: string; ops: Array<[string, ...unknown[]]> };
+
+function fixtureClient(resolve: (call: Call) => { data: unknown; error?: unknown }) {
+    const calls: Call[] = [];
+    const client = {
+        from(table: string) {
+            const call: Call = { table, ops: [] };
+            calls.push(call);
+            const builder: Record<string, unknown> = {};
+            for (const op of ['select', 'eq', 'in', 'or', 'not', 'order', 'range', 'limit']) {
+                builder[op] = (...args: unknown[]) => { call.ops.push([op, ...args]); return builder; };
+            }
+            builder.then = (ok: (value: unknown) => unknown, no: (error: unknown) => unknown) =>
+                Promise.resolve(resolve(call)).then(ok, no);
+            return builder;
+        },
+        async rpc() { return { data: [{ user_id: userId, nickname: '합성 사용자', avatar_url: null }], error: null }; },
+    } as unknown as typeof supabase;
+    return { client, calls };
+}
+
+describe('module-owned detail read callbacks', () => {
+    test('null selection does no database or profile work', async () => {
+        const t = fixtureClient(() => { throw Error('unexpected read'); });
+        const result = await restaurantDetailQueries.reviews(null, [], null, t.client)({});
+        expect(result).toEqual({ reviews: [], nextCursor: null });
+        expect(await restaurantDetailQueries.siblings(null, [], t.client)()).toEqual([]);
+        expect(t.calls).toHaveLength(0);
+    });
+
+    test('keeps verified predicates, page bounds, foreign-restaurant rejection and anonymous likes boundary', async () => {
+        const t = fixtureClient(call => ({ data: call.table === 'reviews'
+            ? [review, { ...review, restaurant_id: 'foreign-restaurant' }] : [] }));
+        const result = await restaurantDetailQueries.reviews(restaurant, ['한식'], null, t.client)({ pageParam: 30 });
+        expect(result.restaurantId).toBe(restaurantId);
+        expect(result.reviews).toHaveLength(1);
+        expect(result.reviews[0]).toMatchObject({ restaurantId, userName: '합성 사용자', isLikedByUser: false });
+        const request = t.calls.find(call => call.table === 'reviews')!;
+        expect(request.ops).toContainEqual(['eq', 'is_verified', true]);
+        expect(request.ops).toContainEqual(['range', 30, 44]);
+        expect(request.ops.filter(op => op[0] === 'order')).toEqual([
+            ['order', 'is_pinned', { ascending: false }], ['order', 'created_at', { ascending: false }],
+        ]);
+        expect(t.calls.some(call => call.table === 'review_likes')).toBe(false);
+    });
+
+    test('retains next page cursor and viewer-bound like lookup', async () => {
+        const rows = Array.from({ length: 15 }, (_, i) => ({ ...review, id: `fixture-review-${i}` }));
+        const t = fixtureClient(call => ({ data: call.table === 'reviews' ? rows
+            : call.table === 'review_likes' ? [{ review_id: 'fixture-review-0' }] : [] }));
+        const result = await restaurantDetailQueries.reviews(restaurant, ['한식'], { id: userId }, t.client)({ pageParam: 15 });
+        expect(result.nextCursor).toBe(30);
+        expect(restaurantDetailQueries.nextPage(result)).toBe(30);
+        expect(result.reviews[0].isLikedByUser).toBe(true);
+        expect(result.reviews[1].isLikedByUser).toBe(false);
+        expect(t.calls.find(call => call.table === 'review_likes')?.ops).toContainEqual(['eq', 'user_id', userId]);
+    });
+
+    test('provider failure keeps bounded feedback without exposing the provider message', async () => {
+        const t = fixtureClient(call => ({ data: [], error: call.table === 'reviews' ? { message: 'PRIVATE_PROVIDER_ERROR' } : null }));
+        const messages: unknown[][] = [];
+        const original = console.error;
+        console.error = (...args) => { messages.push(args); };
+        try {
+            expect(await restaurantDetailQueries.reviews(restaurant, ['한식'], null, t.client)({})).toEqual({ restaurantId, reviews: [], nextCursor: null });
+            expect(JSON.stringify(messages)).not.toContain('PRIVATE_PROVIDER_ERROR');
+            expect(messages).toHaveLength(1);
+        } finally { console.error = original; }
+    });
+
+    test('sibling name fallback admits only one unambiguous review', async () => {
+        const make = (values: string[]) => fixtureClient(call => ({ data: call.ops.some(op => op[0] === 'not')
+            ? values.map(tzuyang_review => ({ tzuyang_review })) : [] }));
+        const one = make(['  합성 쯔양 리뷰  ', '합성 쯔양 리뷰']);
+        expect(await restaurantDetailQueries.siblings(restaurant, [], one.client)()).toEqual(['합성 쯔양 리뷰']);
+        const many = make(['다른 리뷰 A', '다른 리뷰 B']);
+        expect(await restaurantDetailQueries.siblings(restaurant, [], many.client)()).toEqual([]);
+    });
+});
