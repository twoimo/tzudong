diff --git a/apps/web/tests-unit/restaurant-search-query-functions.test.ts b/apps/web/tests-unit/restaurant-search-query-functions.test.ts
new file mode 100644
index 00000000..488f09d9
--- /dev/null
+++ b/apps/web/tests-unit/restaurant-search-query-functions.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, test } from 'bun:test';
+import type { supabase } from '../integrations/supabase/client';
+import { restaurantSearchQueries } from '../lib/restaurant-search-query-functions';
+
+function fixtureClient(rows: unknown[] = [], providerError: unknown = null) {
+    const calls: Array<[string, ...unknown[]]> = [];
+    const chain: Record<string, unknown> = {};
+    for (const name of ['select', 'eq', 'ilike', 'limit', 'contains'])
+        chain[name] = (...args: unknown[]) => { calls.push([name, ...args]); return chain; };
+    chain.then = (ok: (value: unknown) => unknown, no: (error: unknown) => unknown) =>
+        Promise.resolve({ data: rows, error: providerError }).then(ok, no);
+    const client = {
+        from(table: string) { calls.push(['from', table]); return chain; },
+        async rpc(name: string, args: unknown) { calls.push(['rpc', name, args]); return { data: rows, error: providerError }; },
+    } as unknown as typeof supabase;
+    return { client, calls };
+}
+const options = { trimmedDebouncedSearchQuery: '실험', searchType: 'name' as const, normalizedCategoryFilter: [], isKoreanOnly: false };
+const row = (id: number, road_address: string) => ({ id: `fixture-${id}`, name: `실험 식당 ${id}`,
+    approved_name: `실험 식당 ${id}`, lat: 37 + id * 0.01, lng: 127, road_address,
+    categories: ['한식'], status: 'approved' });
+
+describe('module-owned search readers', () => {
+    test('short input makes no request', async () => {
+        const t = fixtureClient();
+        expect(await restaurantSearchQueries.search({ ...options, trimmedDebouncedSearchQuery: '실' }, t.client)()).toEqual([]);
+        expect(t.calls).toHaveLength(0);
+    });
+
+    test('name search preserves approved, category, limit and global geography predicates', async () => {
+        const t = fixtureClient([row(1, '서울특별시 실험로'), row(2, 'Tokyo fixture street')]);
+        const result = await restaurantSearchQueries.search({ ...options, normalizedCategoryFilter: ['한식'] }, t.client)();
+        expect(result).toHaveLength(2);
+        expect(t.calls).toContainEqual(['eq', 'status', 'approved']);
+        expect(t.calls).toContainEqual(['ilike', 'approved_name', '%실험%']);
+        expect(t.calls).toContainEqual(['contains', 'categories', ['한식']]);
+        expect(t.calls).toContainEqual(['limit', 50]);
+        expect(t.calls.filter(call => call[0] === 'eq')).toHaveLength(1);
+    });
+
+    test('domestic mode and ten-result display cap remain intact', async () => {
+        const t = fixtureClient([...Array.from({ length: 15 }, (_, i) => row(i, '서울특별시 실험로')), row(99, 'Tokyo fixture street')]);
+        const result = await restaurantSearchQueries.search({ ...options, isKoreanOnly: true }, t.client)();
+        expect(result).toHaveLength(10);
+        expect(result.every(item => item.road_address?.includes('서울'))).toBe(true);
+    });
+
+    test('YouTube search keeps exact public RPC and approved-only argument', async () => {
+        const t = fixtureClient([row(1, '서울특별시 실험로')]);
+        expect(await restaurantSearchQueries.search({ ...options, searchType: 'youtube', isKoreanOnly: true }, t.client)()).toHaveLength(1);
+        expect(t.calls).toEqual([['rpc', 'search_restaurants_by_youtube_title', {
+            search_query: '실험', max_results: 50, include_all_status: false, korean_only: true,
+        }]]);
+    });
+
+    test('provider failure keeps bounded feedback without its message', async () => {
+        const t = fixtureClient([], { message: 'PRIVATE_PROVIDER_ERROR' });
+        const messages: unknown[][] = [];const original = console.warn;
+        console.warn = (...args) => { messages.push(args); };
+        try {
+            expect(await restaurantSearchQueries.search(options, t.client)()).toEqual([]);
+            expect(JSON.stringify(messages)).not.toContain('PRIVATE_PROVIDER_ERROR');
+            expect(messages).toHaveLength(1);
+        } finally { console.warn = original; }
+    });
+
+    test('popular lookup preserves regional filters and fetch size', async () => {
+        const calls: unknown[] = [];
+        await restaurantSearchQueries.popular({ limit: 5, selectedRegion: '일본', isKoreanOnly: false }, async input => { calls.push(input); return []; })();
+        expect(calls).toEqual([{ limit: 5, selectedRegion: '일본', isKoreanOnly: false, fetchLimit: 20 }]);
+    });
+});
