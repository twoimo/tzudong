  "finding": {
    "verdict": "ACCEPT",
    "counterexample": "The mutation client previously trusted a recognized payload code on every non-OK status. A synthetic HTTP 500 carrying banner_mutation_invalid therefore reached the page as a definite rejection and could delete current-operation uploads even though the server outcome was uncertain.",
    "source_trace_before": [
      "requestAdminBannerMutation selected any recognized payload code without checking response.status.",
      "cleanupDefiniteRejectedBannerUploads accepted banner_mutation_invalid by code alone.",
      "The combined HTTP 500 plus banner_mutation_invalid input reached owned-path deletion."
    ]
  },
  "implemented_contract": {
    "hook_status_binding": {
      "400": "banner_mutation_invalid",
      "403": "banner_mutation_forbidden",
      "404": "banner_not_found",
      "409": "banner_revision_conflict",
      "500": [
        "banner_readback_failed",
        "banner_update_failed",
        "banner_delete_failed"
      ]
    },
    "mismatched_or_unknown_payload": "banner_invalid_response",
    "error_status": "AdminBannerMutationError retains the observed HTTP status for caller decisions.",
    "cleanup_gate": "Owned uploads are deleted only for exact 400/invalid, 403/forbidden, 404/not-found, or 409/conflict pairs.",
    "uncertain_preservation": "HTTP 5xx, transport exceptions, malformed responses, and mismatched status-code pairs preserve uploaded paths."
  },
  "counterexample_results": [
    {
      "case": "HTTP 500 plus banner_mutation_invalid",
      "hook_result": "banner_invalid_response",
      "cleanup_result": "not attempted; owned uploads preserved"
    },
    {
      "case": "HTTP 400 plus banner_mutation_invalid",
      "hook_result": "banner_mutation_invalid with status 400",
      "cleanup_result": "current-operation uploads cleaned"
    },
    {
      "case": "HTTP 403/404/409 plus their matching fixed codes",
      "cleanup_result": "current-operation uploads cleaned"
    },
    {
      "case": "HTTP 500 plus readback/update/delete failure",
      "cleanup_result": "not attempted; result remains uncertain"
    },
    {
      "case": "transport exception or absent/malformed payload",
      "cleanup_result": "not attempted; result remains uncertain"
    }
  ],
