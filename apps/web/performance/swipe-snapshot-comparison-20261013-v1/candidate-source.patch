diff --git a/apps/web/tests-unit/home-map-snapshot-comparison.test.ts b/apps/web/tests-unit/home-map-snapshot-comparison.test.ts
new file mode 100644
index 00000000..55d98632
--- /dev/null
+++ b/apps/web/tests-unit/home-map-snapshot-comparison.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, test } from 'bun:test';
+import type { Restaurant } from '@/types/restaurant';
+import type { HomeMapContextualRestaurantsPayload } from '@/lib/home-map-contextual-restaurants';
+import {
+    captureHomeMapRestaurantIds,
+    matchesHomeMapRestaurantIds,
+    captureHomeMapContextualSnapshot,
+    matchesHomeMapContextualSnapshot,
+} from '@/lib/home-map-snapshot-comparison';
+
+const rows = (ids: string[]) => ids.map((id) => ({ id } as Restaurant));
+const id = (index: number) => `00000000-0000-4000-8000-${String(index).padStart(12, '0')}`;
+const payload = (): HomeMapContextualRestaurantsPayload => ({
+    mode: 'domestic', renderMode: 'individual', zoom: 15, isEligible: true,
+    totalVisibleCount: 2, restaurants: rows([id(1), id(2)]),
+});
+
+describe('home map committed snapshot comparison', () => {
+    test('matches the previous ordered ID equality for independent equivalent and changed lists', () => {
+        for (let size = 0; size <= 32; size += 1) {
+            const original = Array.from({ length: size }, (_, index) => id(index));
+            const candidates = [original.slice(), original.slice().reverse(), [...original, id(99)], original.slice(1)];
+            const snapshot = captureHomeMapRestaurantIds(rows(original));
+            for (const candidate of candidates) {
+                expect(matchesHomeMapRestaurantIds(snapshot, rows(candidate)))
+                    .toBe(original.join('|') === candidate.join('|'));
+            }
+        }
+    });
+
+    test('does not suppress an ID change made after commit through a reused array', () => {
+        const current = rows([id(1), id(2)]), committed = captureHomeMapRestaurantIds(current);
+        current[0].id = id(3);
+        expect(matchesHomeMapRestaurantIds(committed, current)).toBe(false);
+        expect(committed).toEqual([id(1), id(2)]);
+    });
+
+    test('retains existing ID-only semantics across refreshed restaurant metadata', () => {
+        const original = payload(), snapshot = captureHomeMapContextualSnapshot(original);
+        const fresh = { ...original, restaurants: original.restaurants.map((row) => ({ ...row, name: '새 이름' })) };
+        expect(matchesHomeMapContextualSnapshot(snapshot, fresh)).toBe(true);
+    });
+
+    test('publishes every map eligibility, mode, zoom, count, reason and order change', () => {
+        const original = payload(), snapshot = captureHomeMapContextualSnapshot(original);
+        const changes: Partial<HomeMapContextualRestaurantsPayload>[] = [
+            { mode: 'overseas' }, { renderMode: 'supercluster' }, { zoom: null },
+            { isEligible: false }, { ineligibilityReason: 'empty' }, { totalVisibleCount: 3 },
+            { restaurants: original.restaurants.slice().reverse() }, { restaurants: [] },
+        ];
+        for (const change of changes) expect(matchesHomeMapContextualSnapshot(snapshot, { ...original, ...change })).toBe(false);
+    });
+
+    test('keeps the initial publication distinct from a committed null and permits later recovery', () => {
+        expect(matchesHomeMapContextualSnapshot(undefined, null)).toBe(false);
+        expect(matchesHomeMapContextualSnapshot(null, null)).toBe(true);
+        expect(matchesHomeMapContextualSnapshot(null, payload())).toBe(false);
+        expect(matchesHomeMapContextualSnapshot(captureHomeMapContextualSnapshot(payload()), null)).toBe(false);
+    });
+
+    test('captures only the required scalar context and immutable ID values', () => {
+        const original = payload(), snapshot = captureHomeMapContextualSnapshot(original)!;
+        expect('restaurants' in snapshot).toBe(false);
+        original.restaurants.push({ id: id(3) } as Restaurant);
+        expect(snapshot.restaurantIds).toEqual([id(1), id(2)]);
+        expect(matchesHomeMapContextualSnapshot(snapshot, original)).toBe(false);
+    });
+});
