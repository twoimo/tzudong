index 00000000..a5ee5c44
--- /dev/null
+++ b/apps/web/lib/home-map-snapshot-comparison.ts
@@ -0,0 +1,53 @@
+import type { HomeMapContextualRestaurantsPayload } from './home-map-contextual-restaurants';
+
+type RestaurantId = { id: string };
+
+/** Copy only committed IDs, without retaining restaurant records or joined strings. */
+export function captureHomeMapRestaurantIds(restaurants: readonly RestaurantId[]): readonly string[] {
+    return restaurants.map((restaurant) => restaurant.id);
+}
+
+export function matchesHomeMapRestaurantIds(
+    committedIds: readonly string[],
+    restaurants: readonly RestaurantId[],
+): boolean {
+    if (committedIds.length !== restaurants.length) return false;
+    for (let index = 0; index < committedIds.length; index += 1) {
+        if (committedIds[index] !== restaurants[index].id) return false;
+    }
+    return true;
+}
+
+export type HomeMapContextualSnapshot = Omit<HomeMapContextualRestaurantsPayload, 'restaurants'> & {
+    restaurantIds: readonly string[];
+};
+
+export function captureHomeMapContextualSnapshot(
+    payload: HomeMapContextualRestaurantsPayload | null,
+): HomeMapContextualSnapshot | null {
+    if (!payload) return null;
+    return {
+        mode: payload.mode,
+        renderMode: payload.renderMode,
+        zoom: payload.zoom,
+        isEligible: payload.isEligible,
+        ineligibilityReason: payload.ineligibilityReason,
+        totalVisibleCount: payload.totalVisibleCount,
+        restaurantIds: captureHomeMapRestaurantIds(payload.restaurants),
+    };
+}
+
+export function matchesHomeMapContextualSnapshot(
+    snapshot: HomeMapContextualSnapshot | null | undefined,
+    payload: HomeMapContextualRestaurantsPayload | null,
+): boolean {
+    if (snapshot === undefined) return false;
+    if (!snapshot || !payload) return snapshot === payload;
+    return snapshot.mode === payload.mode
+        && snapshot.renderMode === payload.renderMode
+        && (snapshot.zoom ?? null) === (payload.zoom ?? null)
+        && snapshot.isEligible === payload.isEligible
+        && snapshot.ineligibilityReason === payload.ineligibilityReason
+        && snapshot.totalVisibleCount === payload.totalVisibleCount
+        && matchesHomeMapRestaurantIds(snapshot.restaurantIds, payload.restaurants);
+}
