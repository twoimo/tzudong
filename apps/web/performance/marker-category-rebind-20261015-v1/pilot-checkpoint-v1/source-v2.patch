+        setAttribute: (_name: string, value: string) => { domId = value; },
+      });
+      Object.defineProperty(globalThis, 'document', { configurable: true, value: {
+        createElement: () => ({ innerHTML: '', content: { querySelector: () => node(nextId, nextRoot) } }),
+      } });
