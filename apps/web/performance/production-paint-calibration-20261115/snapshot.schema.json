    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observerStats",
        "paintEntries",
        "lcpEntries",
        "longTasks",
        "entryCapReached",
        "observerWorkMs",
        "errors",
        "observedAtMs",
        "paintTimeline",
        "context",
        "frames",
        "milestones",
        "milestoneCounts",
        "initialLatestQueryClaimed",
        "readiness",
        "readbackWorkMs"
      ],
      "properties": {
        "observerStats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paint",
            "largest-contentful-paint",
            "longtask"
          ],
          "properties": {
            "paint": {
              "$ref": "#/$defs/stats"
            },
            "largest-contentful-paint": {
              "$ref": "#/$defs/stats"
            },
            "longtask": {
              "$ref": "#/$defs/stats"
            }
          }
        },
        "paintEntries": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/paint"
          }
        },
        "lcpEntries": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/lcp"
          }
        },
        "longTasks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/longTask"
          }
        },
        "entryCapReached": {
          "type": "boolean"
        },
        "observerWorkMs": {
          "$ref": "#/$defs/nullableNumber"
        },
        "errors": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "FOCUS_READ_FAILED",
              "OBSERVER_ENTRY_HANDLER_FAILED",
              "OBSERVER_REGISTRATION_FAILED",
              "OBSERVER_DRAIN_FAILED",
              "PAINT_TIMELINE_READ_FAILED",
              "RAF_REQUEST_FAILED",
              "OBSERVER_CALLBACK_READ_FAILED"
            ]
          }
        },
        "observedAtMs": {
          "$ref": "#/$defs/nullableNumber"
        },
        "paintTimeline": {
          "$ref": "#/$defs/timeline"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "frames": {
          "$ref": "#/$defs/frames"
        },
        "milestones": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initialLoad",
            "criticalPath"
          ],
          "properties": {
            "initialLoad": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "homeClientCommitted",
                "viewportResolved",
                "dataQueryStarted",
                "dataFetchCompleted",
                "dataMergeCompleted",
                "dataReady",
                "dataError",
                "naverSdkRequested",
                "naverSdkReady",
                "naverSdkError",
                "mapConstructionStarted",
                "mapConstructed",
                "mapConstructionError",
                "clusterIndexStarted",
                "clusterIndexReady",
                "controlsWrapperMounted",
                "mobileControlsMounted",
                "desktopPanelSettled"
              ],
              "properties": {
                "homeClientCommitted": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "viewportResolved": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "dataQueryStarted": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "dataFetchCompleted": {
