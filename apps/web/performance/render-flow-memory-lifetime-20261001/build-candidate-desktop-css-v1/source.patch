@@ -0,0 +1,7 @@
+/** Only for our generated flex/absolute marker markup, never arbitrary HTML. */
+export function compactGeneratedMarkerHtml(html: string): string {
+    return html.trim()
+        .replace(/>\s+</g, '><')
+        .replace(/\bstyle="([^"]*)"/g, (_attribute, css: string) =>
+            `style="${css.trim().replace(/\s+/g, ' ')}"`);
+}
diff --git a/apps/web/lib/deferred-marker-renders.ts b/apps/web/lib/deferred-marker-renders.ts
new file mode 100644
index 00000000..3f46a1d3
--- /dev/null
+++ b/apps/web/lib/deferred-marker-renders.ts
@@ -0,0 +1,30 @@
+/** Render offscreen tail work after the first paint, with bounded task slices. */
+export function deferMarkerRenders(jobs: Array<(() => void) | undefined>, complete: (finished: boolean) => void) {
+    const channel = new MessageChannel();
+    let cursor = 0;
+    let stopped = false;
+    const stop = () => {
+        if (stopped) return;
+        stopped = true;
+        cancelAnimationFrame(frame);
+        jobs.length = 0;
+        channel.port1.onmessage = null;
+        channel.port1.close();
+        channel.port2.close();
+    };
+    channel.port1.onmessage = () => {
+        if (stopped) return;
+        const end = Math.min(cursor + 32, jobs.length);
+        while (cursor < end && !stopped) {
+            const render = jobs[cursor];
+            jobs[cursor++] = undefined;
+            try { render?.(); }
+            catch { stop(); complete(false); return; }
+        }
+        if (stopped) return;
+        if (cursor === jobs.length) { stop(); complete(true); }
+        else channel.port2.postMessage(null);
+    };
+    const frame = requestAnimationFrame(() => channel.port2.postMessage(null));
+    return stop;
+}
