    - text: "<SidebarMenuItem>\n  <SidebarMenuButton />\n  <SidebarMenuAction  className=\"peer-data-[active=true]/menu-button:opacity-100\" />\n</SidebarMenuItem>"
  - heading [level=2]:
    - link "RTL" [ref=e219]
  - text: "To enable RTL support in shadcn/ui, see the"
  - link "RTL configuration guide" [ref=e220]
