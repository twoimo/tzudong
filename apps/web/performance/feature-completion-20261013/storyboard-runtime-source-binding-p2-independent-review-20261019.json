          },
          "source_sha256": {
            "backend/utils/provider-budget.mjs": "8313b93666a36342bd1c53581c9ec2034a07c23225ac5fb9e6988424fe395f27",
            "backend/utils/provider_budget.py": "edfd9b77125f05a81209fd9799c5e8465f169dbf175d9ca8361adf3cb50b78e7"
          },
          "required_followup": "Bind both first-party runtime files and add a narrow regression that discovers the dynamic import and Python -m target without recursively hashing external packages."
        },
        {
          "id": "STORYBOARD-SOURCE-BINDING-P2-STORAGE-AUTHORITY",
          "severity": "P2",
          "verdict": "ACCEPT",
          "boundary": "storyboard Storage destination and privileged credential admission",
          "counterexample": "apps/web/lib/admin/storyboard/production-store.ts routes every storyboard upload, download, list and remove through apps/web/lib/supabase/storage-server.ts. That helper enforces the production-versus-loopback URL/key pairing and chooses the Storage authority, but it is absent from STORYBOARD_RUNTIME_SOURCE_PATHS; those rules can therefore change without changing the storyboard source or canonical policy digest.",
          "import_chain": [
            "apps/web/lib/admin/storyboard/production-store.ts:3 -> apps/web/lib/supabase/storage-server.ts",
            "apps/web/lib/admin/storyboard/production-store.ts:126-150 -> upload/download/list/remove"
          ],
          "source_binding_membership": {
            "apps/web/lib/supabase/storage-server.ts": false
          },
          "source_sha256": {
            "apps/web/lib/supabase/storage-server.ts": "7efee141365fb88c8504a16bfe4a5865ff2c875be78c9a17b4fa542fdb6d507e"
