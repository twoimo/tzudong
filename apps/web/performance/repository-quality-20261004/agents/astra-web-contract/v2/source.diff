+    let endpoint: URL;
+    try {
+        endpoint = new URL(url);
+    } catch {
+        throw new Error('supabase_rest_config_invalid');
+    }
+    if (endpoint.protocol !== 'https:' && endpoint.protocol !== 'http:') {
+        throw new Error('supabase_rest_config_invalid');
+    }
+    return { url, key };
