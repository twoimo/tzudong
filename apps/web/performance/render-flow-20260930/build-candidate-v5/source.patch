+// Expanded IDs remain in the list/swipe snapshot; only provider DOM is culled.
+// Keep the selected/search marker so detail focus and its next pan still work.
+export function shouldRenderExpandedClusterMarker(
+    restaurant: Restaurant,
+    selectedRestaurantId: string | null,
+    searchedRestaurantId: string | null,
+    extendedBounds: ExtendedBounds | null,
+    viewportFilterEnabled: boolean,
+): boolean {
+    return !viewportFilterEnabled || !extendedBounds
+        || restaurant.id === selectedRestaurantId
+        || restaurant.id === searchedRestaurantId
+        || isRestaurantInViewport(restaurant, extendedBounds);
+}
