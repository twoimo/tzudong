# Admin insight chatbot + storyboard agent
# Canonical public HTTPS origin used for same-origin mutation checks; no path/query/fragment.
NEXT_PUBLIC_SITE_URL=https://tzudong.example
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Cloudflare-issued r2.dev origin for oversized pipeline artifacts. Do not invent DNS.
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-966471b3a9f0473ab2d25f21066c3605.r2.dev
# Do not copy generated local stack credentials or nightly trust markers here.
# `bun run dev` (`dev:local`) and `bun run supabase:gen-types:local` validate the
# owner-only stack.env/provenance pair and map loopback values at runtime.
# This example is read by the explicit `bun run dev:hosted` path only; the
# default development command never falls back to these hosted values.
# The nightly runner injects its test-only markers after the same validation.
# Server-only: used by API routes for trusted DB writes; never expose as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Privacy controls (server-only; generate independent high-entropy values)
PRIVACY_ONBOARDING_COOKIE_SECRET=replace_with_at_least_32_random_bytes
PRIVACY_RETENTION_INTERNAL_CAPABILITY=replace_with_an_independent_random_capability
# Consent-gated marketing delivery provider; use an operator-approved HTTPS endpoint.
MARKETING_DELIVERY_PROVIDER_URL=https://approved-provider.example/v1/deliver
MARKETING_DELIVERY_PROVIDER_TOKEN=replace_with_provider_token

NEXT_PUBLIC_NAVER_CLIENT_ID=your_naver_client_id
NEXT_NAVER_CLIENT_SECRET=your_naver_client_secret

# Server-only: used by admin KPI/API snapshot collectors. Do not expose as NEXT_PUBLIC_*.
YOUTUBE_API_KEY=your_youtube_api_key
# Optional server-side channel stats override for the admin KPI dashboard
YOUTUBE_CHANNEL_HANDLE=@tzuyang6145
# YOUTUBE_CHANNEL_ID=UCfpaSruWW3S4dibonKXENjA
# Optional GitHub Actions KPI snapshot collector tuning
YOUTUBE_KPI_SNAPSHOT_INTERVAL_MINUTES=15
YOUTUBE_KPI_SNAPSHOT_MAX_PLAYLIST_PAGES=30
# Optional server-only GitHub Actions log lookup for the admin KPI dashboard
GITHUB_REPOSITORY=twoimo/tzudong
YOUTUBE_KPI_SNAPSHOT_WORKFLOW_ID=youtube-kpi-snapshot.yml
# GITHUB_TOKEN=<github-actions-read-token>
# Admin system-status monitoring for the canonical local nightly and hosted
# manual fallback. Use a read-only Actions token; responses never expose it.
INSIGHT_NIGHTLY_REGRESSION_STATUS_ENABLED=true
INSIGHT_GITHUB_REPOSITORY=twoimo/tzudong
# INSIGHT_GITHUB_TOKEN=<github-actions-read-token>
GEMINI_API_KEY=your_gemini_api_key
# Review receipt AI auto-fill OCR (server-only)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_OCR_MODEL=meta/llama-4-maverick-17b-128e-instruct,mistralai/mistral-small-4-119b-2603,nvidia/nemotron-nano-12b-v2-vl
# Optional admin AI settings encryption material; falls back to SUPABASE_SERVICE_ROLE_KEY when unset
# AI_SETTINGS_ENCRYPTION_KEY=generate_a_long_random_secret
# Optional comma-separated fallback override and timeout budgets
# NVIDIA_NIM_OCR_MODEL=meta/llama-4-maverick-17b-128e-instruct,mistralai/mistral-small-4-119b-2603,nvidia/nemotron-nano-12b-v2-vl
# NVIDIA_NIM_OCR_TIMEOUT_MS=6000
# NVIDIA_NIM_OCR_TOTAL_TIMEOUT_MS=10000
STORYBOARD_AGENT_GEMINI_API_KEY=your_storyboard_gemini_api_key
STORYBOARD_AGENT_NANO_BANANA_MODEL=gemini-2.5-flash-preview
STORYBOARD_AGENT_NANO_BANANA_PRO_MODEL=gemini-2.5-pro-preview
STORYBOARD_AGENT_DEFAULT_PROFILE=nanobanana
GOOGLE_API_KEY=your_google_api_key

# Storyboard agent (optional)
# 기본 동작은 내부 생성(별도 서버 미필요).
# Local command bridge: backend/storyboard-agent를 Next.js API에서 직접 실행한다.
# apps/web 기준 상대 경로 또는 절대 경로를 직접 설정한다. 셸 메타문자/인자는 허용하지 않는다.
# 기본값은 LangGraph command bridge이며, 로컬 환경에서 Python/runtime 준비가 안 되면 fail-closed fallback으로 내려간다.
# 아래 값은 LangGraph 대신 legacy Codex bridge를 강제로 쓰고 싶을 때만 명시적으로 override 한다.
STORYBOARD_AGENT_COMMAND=../../backend/storyboard-agent/scripts/run-storyboard-agent.py
# Optional: apps/web 기준 상대 경로 또는 절대 경로. 비우면 repo 루트 backend/storyboard-agent를 자동 탐지.
STORYBOARD_AGENT_ROOT=
# Optional: 기본값은 Windows에서 python, macOS/Linux에서 python3.
STORYBOARD_AGENT_PYTHON=
# STORYBOARD_AGENT_RUNTIME=codex_cli_oauth
STORYBOARD_AGENT_CODEX_MODEL=gpt-5.5
STORYBOARD_AGENT_CODEX_EFFORT=low
# milliseconds; command bridge timeout. Keep separate from image generation timeout.
STORYBOARD_AGENT_TIMEOUT_MS=120000

# YouTube thumbnail chat/backend agent (optional)
# 기본 runtime은 채팅/캔버스/생성 brief 작업을 로컬 Codex CLI OAuth 세션의 gpt-5.5 low(고속)로 수행한다.
THUMBNAIL_AGENT_COMMAND=../../backend/thumbnail-agent/scripts/run-thumbnail-agent.py
THUMBNAIL_AGENT_ROOT=
THUMBNAIL_AGENT_PYTHON=python3
THUMBNAIL_AGENT_RUNTIME=codex_cli_oauth
THUMBNAIL_AGENT_CODEX_MODEL=gpt-5.5
THUMBNAIL_AGENT_CODEX_EFFORT=low
THUMBNAIL_AGENT_TIMEOUT_MS=120000

# Remote service bridge: 별도 HTTP 서버를 쓸 때만 활성화한다.
STORYBOARD_AGENT_REMOTE_ENABLED=false
STORYBOARD_AGENT_API_URL=http://localhost:8001
STORYBOARD_AGENT_CHAT_PATH=/chat
STORYBOARD_AGENT_MAX_RETRIES=3
STORYBOARD_AGENT_RETRY_BASE_MS=300
STORYBOARD_AGENT_RETRY_MAX_MS=2000
STORYBOARD_ORCHESTRATOR_MAX_RETRIES=3

# Storyboard web search (예: 최신 트렌드 보강)
STORYBOARD_WEB_SEARCH_ENABLED=false
STORYBOARD_WEB_SEARCH_URL=https://api.tavily.com/search
STORYBOARD_WEB_SEARCH_TOKEN=
STORYBOARD_WEB_SEARCH_TIMEOUT_MS=8000

# 앱 본체 BGE 기반 스토리보드 검색(선택)
STORYBOARD_BGE_ENABLED=false
STORYBOARD_BGE_EMBEDDING_URL=
STORYBOARD_BGE_EMBEDDING_TOKEN=
STORYBOARD_BGE_EMBEDDING_TIMEOUT_MS=8000
STORYBOARD_BGE_MATCH_COUNT=8
STORYBOARD_BGE_MATCH_THRESHOLD=0.5
STORYBOARD_BGE_DENSE_WEIGHT=0.6
# Optional bearer token for scheduled Arena.ai leaderboard snapshot sync.
AI_SETTINGS_CRON_SECRET=

# Receipt OCR Gemini key priority:
# Prefer GEMINI_API_KEY for apps/web. Legacy local fallback aliases are still
# accepted by code for old developer envs, but should not be registered in new
# GitHub/Vercel environments.

# YouTube Thumbnail backend-agent command bridge (optional)
# Keep exact gpt-image-2 generation in the web provider; this command only returns orchestration brief JSON.
THUMBNAIL_AGENT_COMMAND=../../backend/thumbnail-agent/scripts/run-thumbnail-agent.py
THUMBNAIL_AGENT_ROOT=../../backend/thumbnail-agent
THUMBNAIL_AGENT_PYTHON=python3
THUMBNAIL_AGENT_RUNTIME=local_graph
THUMBNAIL_AGENT_TIMEOUT_MS=120000
# Device-location release evidence (server-only; default is blocked).
# Exact evidence references are operator inputs, not a legal-compliance flag.
DEVICE_LOCATION_RELEASE_DECISION=
# Allowed only: not_applicable_verified | filing_receipt_verified
DEVICE_LOCATION_EXTERNAL_STATUS=
# Each evidence reference is a SHA-256 digest (64 lowercase hex characters).
DEVICE_LOCATION_OPERATOR_EVIDENCE_HASH=
DEVICE_LOCATION_PROVIDER_EVIDENCE_HASH=
DEVICE_LOCATION_EXTERNAL_EVIDENCE_HASH=
DEVICE_LOCATION_LEGAL_EVIDENCE_HASH=
# Canonical UTC ISO timestamp, for example 2026-07-12T00:00:00.000Z
DEVICE_LOCATION_RELEASE_CONFIRMED_AT=
# Keyed minimization for request IP/user-agent audit references (server-only, >=32 bytes).
PRIVACY_AUDIT_HASH_KEY=
# Durable account-deletion worker: independent server-only capability (minimum 32 UTF-8 bytes).
# Never expose or reuse this value as NEXT_PUBLIC_*, a session credential, or an admin token.
# Configure the identical value in the production web runtime and repository
# Actions secrets before dispatch. Do not bind a GitHub Environment.
ACCOUNT_DELETION_WORKER_CAPABILITY=
# Required for non-empty storage work: owner-authorized HTTPS adapter with an isolated
# capability (minimum 32 UTF-8 bytes). It MUST conditionally delete the exact supplied
# Storage object ID and immutable version and return the exact bounded binding receipt.
# A path-only Supabase Storage remove fallback is prohibited.
ACCOUNT_DELETION_STORAGE_DELETE_ADAPTER_URL=
ACCOUNT_DELETION_STORAGE_DELETE_ADAPTER_CAPABILITY=
# Storage egress remains fail-closed until this independent owner-authorized proof verifier is configured.
# It receives only opaque provider/object references and returns an opaque receipt reference plus SHA-256 hash.
ACCOUNT_DELETION_STORAGE_PROOF_VERIFIER_URL=
ACCOUNT_DELETION_STORAGE_PROOF_VERIFIER_CAPABILITY=
