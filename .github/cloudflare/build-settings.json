{
  "schemaVersion": 1,
  "workerName": "tzudong-ci-governance",
  "repository": "twoimo/tzudong",
  "execution": {
    "provider": "github-actions",
    "workflow": ".github/workflows/release-governance-ci.yml",
    "requiredCheck": "Release",
    "scope": "governance-contracts-only",
    "cloudflareAutomaticBuilds": "unchanged-quota-limited"
  },
  "productionBranch": "main",
  "branchIncludes": [
    "main"
  ],
  "branchExcludes": [],
  "previewsEnabled": false,
  "rootDirectory": "/.github/cloudflare",
  "buildCommand": "node ../scripts/run-cloudflare-governance.mjs --branch main",
  "deployCommand": "node ../scripts/deploy-cloudflare-governance.mjs --branch main",
  "pathIncludes": [
    "*"
  ],
  "pathExcludes": [],
  "buildCachingEnabled": true,
  "environmentVariables": {
    "NODE_VERSION": "24.22.1",
    "BUN_VERSION": "1.4.0",
    "SKIP_DEPENDENCY_INSTALL": "1",
    "WRANGLER_SEND_METRICS": "false"
  },
  "budget": {
    "providerMonthlyAccountMinutes": 3000,
    "planningTargetMonthlyMinutes": 2100,
    "planningReserveMonthlyMinutes": 900,
    "providerConcurrentAccountBuilds": 1,
    "providerBuildTimeoutMinutes": 20,
    "governanceDeadlineMinutes": 10,
    "deploymentDeadlineMinutes": 7,
    "deploymentReadbackReserveSeconds": 45,
    "planningTargetIsEnforced": false
  }
}
